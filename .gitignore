# OS / editor
.DS_Store
.idea/
.vscode/

# build output / Astro cache
# Tanpa trailing slash: juga meng-ignore `node_modules` yang berupa symlink
# (worktree kadang menautkannya) — pola `node_modules/` hanya cocok direktori.
node_modules
dist/
.astro/
*.tar.gz

# playwright mcp debug artifacts
.playwright-mcp/

# Claude Code local-only settings (personal permission allowlist)
.claude/settings.local.json

# Claude Code git worktrees — transient per-session checkouts, never committed.
.claude/worktrees/

# Design mockups / site-builder exports — local reference only, never imported
# or deployed. Kept on disk for evaluation/iteration; deleted manually when spent.
# All mockups live under mockup/ (legacy/, newpage/, stray *.dc.html exports).
mockup/
*.dc.html
image-slot.js
support.js

# screenshot playwright ad-hoc di root
/*.png

# TLS material. Nothing in this repo should ever hold a certificate or a private
# key: the Cloudflare Origin CA pair is pasted straight into /etc/ssl/cloudflare
# on the VPS and lives nowhere else (deploy/RUNBOOK-tls-origin.md). This is here
# only so that improvising a scratch file during that procedure cannot be staged
# by a reflexive `git add -A`.
*.pem
*.key
*.crt
*.p12

# The CI deploy key, which deploy/README.md tells you to generate at the repo
# root. It has no extension, so none of the patterns above catch it.
deploy_key
deploy_key.pub
