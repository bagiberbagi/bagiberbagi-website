---
import { getEntry } from 'astro:content';
import PhotoSlot from './PhotoSlot.astro';
import HeroSticker from './HeroSticker.astro';
import Container from './Container.astro';
import type { ImageMetadata } from 'astro';

const about = await getEntry('about', 'about');
if (!about) throw new Error('about/about entry not found');
const { hero, mission, values } = about.data;

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Foto opsional. Drop file ke src/assets/images/about/ dengan nama sesuai
// (hero-1..hero-5, nilai) → langsung tampil & dioptimasi; kalau belum ada,
// PhotoSlot render placeholder abu. Ekstensi bebas: jpg/jpeg/png/webp/avif.
const aboutImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/about/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const photo = (name: string) =>
  Object.entries(aboutImages).find(([p]) => p.includes(`/about/${name}.`))?.[1].default;

const VALUE_ICONS = {
  transparansi: '<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path><circle cx="12" cy="12" r="3"></circle>',
  kolaborasi: '<path d="M16 3.13a4 4 0 0 1 0 7.75"></path><path d="M13 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="7" cy="9" r="4"></circle><path d="M21 21v-2a4 4 0 0 0-3-3.87"></path>',
  keberlanjutan: '<path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 3v6h-6"></path>',
  dampak: '<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>',
} as const;
---

<!-- Hero -->
<section id="profil" class="section" data-fade="1">
  <Container class="flex flex-wrap items-center gap-10 lg:gap-14">
    <div class="flex-1 basis-[340px] min-w-0">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1 class="font-sans text-heading md:text-display font-semibold text-ink mb-5">
        {hero.title}
      </h1>
      {hero.paragraphs.map((p) => (
        <p class="text-body text-muted leading-relaxed mb-4 last:mb-0">{p}</p>
      ))}
    </div>

    {/* Kolase sticker: foto sudah cutout dgn bentuk + warna pintu baked-in,
        jadi dirender rasio asli tanpa crop/rounding/bg tambahan — cukup
        drop-shadow biar mengambang. Slot kosong → PhotoSlot placeholder. */}
    <div class="flex-1 basis-[320px] min-w-0 w-full max-w-[480px] grid grid-cols-3 gap-3 sm:gap-4 items-start">
      <div class="mt-6">
        <HeroSticker image={photo('hero-1')} alt="Anak penerima manfaat memegang paket makanan bagiberbagi.id" />
      </div>
      <div class="flex flex-col gap-3 sm:gap-4">
        <HeroSticker image={photo('hero-2')} alt="Anak penerima manfaat bagiberbagi.id" />
        <HeroSticker image={photo('hero-3')} alt="Penerima manfaat memegang paket makanan bagiberbagi.id" />
      </div>
      <div class="flex flex-col gap-3 sm:gap-4 mt-14">
        <HeroSticker image={photo('hero-4')} alt="Anak penerima manfaat memegang paket makanan bagiberbagi.id" />
        <HeroSticker image={photo('hero-5')} alt="Lansia penerima manfaat bagiberbagi.id" />
      </div>
    </div>
  </Container>
</section>

<!-- Mengapa kami ada -->
<section id="misi" class="section bg-brand-orangeTint scroll-mt-24">
  <Container class="flex flex-col gap-14">
    <div class="flex flex-wrap gap-10 lg:gap-14" data-fade="1">
      <div class="flex-1 basis-[280px] min-w-0">
        <div class="eyebrow text-brand-orangeDark">{mission.eyebrow}</div>
        <h2 class="font-sans text-heading-sm md:text-heading-lg font-semibold text-ink leading-snug">
          {mission.title}
        </h2>
      </div>
      <div class="flex-[1.4] basis-[340px] min-w-0 flex flex-col gap-4">
        {mission.paragraphs.map((p) => (
          <p class="text-body text-muted leading-relaxed">{p}</p>
        ))}
      </div>
    </div>

    <div class="flex flex-wrap gap-10 lg:gap-14" data-fade="1">
      <div class="flex-1 basis-[280px] min-w-0">
        <h2 class="font-sans text-title md:text-heading-sm font-semibold text-ink leading-snug">
          {mission.growTitle}
        </h2>
      </div>
      <div class="flex-[1.4] basis-[340px] min-w-0 flex flex-col gap-4">
        {mission.growParagraphs.map((p) => (
          <p class="text-body text-muted leading-relaxed">{p}</p>
        ))}
      </div>
    </div>
  </Container>
</section>

<!-- Nilai -->
<section id="nilai" class="section bg-white scroll-mt-24">
  <Container>
    <div class="text-center max-w-text mx-auto mb-12">
      <div class="eyebrow">{values.eyebrow}</div>
      <h2 class="font-sans text-heading-sm md:text-heading-lg font-semibold text-ink">
        {values.title}
      </h2>
    </div>
    <div class="flex flex-wrap items-center gap-10 lg:gap-12">
      <PhotoSlot image={photo('nilai')} alt="Penyerahan bantuan bagiberbagi.id" class="flex-1 basis-[320px] min-w-0 aspect-4/3 rounded-card" data-fade="1" />

      <div class="flex-1 basis-[320px] min-w-0 flex flex-col gap-7">
        {values.items.map((v) => (
          <div class="flex gap-4 items-start" data-fade="1">
            <span class="w-9 h-9 rounded-lg bg-brand-blue flex-none flex items-center justify-center text-white">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={VALUE_ICONS[v.icon]} />
            </span>
            <div>
              <div class="font-bold text-base text-ink mb-1.5">{v.title}</div>
              <p class="text-body-sm text-muted leading-relaxed">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

