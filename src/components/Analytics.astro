---
import type { ResolvedAnalytics } from '../lib/analytics';

// Menyuntik skrip tiap provider HANYA jika aktif (dicentang + ID terisi).
// Semua di-render `is:inline` supaya benar-benar kondisional (script ter-bundle
// Astro tidak bisa di-gate). Saat semua provider mati (default) komponen ini
// tidak merender apa pun → output situs identik.
//
// Consent: PostHog cookieless jalan langsung. Alat berbasis cookie
// (GA4/Pixel/GTM/Clarity) tunduk consent — Google via Consent Mode v2 (default
// denied), Pixel/Clarity ditunda sampai event `bb:consent-granted`.
const { analytics } = Astro.props as { analytics: ResolvedAnalytics };
const needsConsentMode = analytics.ga4.active || analytics.gtm.active;
---

{
  /* Consent Mode v2 — default semua denied sebelum tag Google apa pun jalan. */
  needsConsentMode && (
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function () {
          dataLayer.push(arguments);
        };
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
    </script>
  )
}

{
  /* Baca consent tersimpan sebelum provider cookie jalan (agar Pixel/Clarity
     yang sudah disetujui sebelumnya langsung init tanpa menunggu klik). */
  analytics.anyCookieProvider && (
    <script is:inline>
      (function () {
        try {
          window.__bbConsent = localStorage.getItem('bb-consent') || 'pending';
        } catch (e) {
          window.__bbConsent = 'pending';
        }
        if (window.__bbConsent === 'granted' && window.gtag) {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            analytics_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
          });
        }
      })();
    </script>
  )
}

{
  analytics.posthog.active && (
    <script
      is:inline
      define:vars={{ phHost: analytics.posthog.host, phKey: analytics.posthog.projectKey }}
    >
      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          ((window.posthog = e),
          (e._i = []),
          (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split('.');
              2 == o.length && ((t = t[o[0]]), (e = o[1])),
                (t[e] = function () {
                  t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
                });
            }
            ((p = t.createElement('script')).type = 'text/javascript'),
              (p.crossOrigin = 'anonymous'),
              (p.async = !0),
              (p.src =
                s.api_host.replace('.i.posthog.com', '-assets.i.posthog.com') +
                '/static/array.js'),
              (r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
            var u = e;
            for (
              void 0 !== a ? (u = e[a] = []) : (a = 'posthog'),
                u.people = u.people || [],
                u.toString = function (t) {
                  var e = 'posthog';
                  return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
                },
                u.people.toString = function () {
                  return u.toString(1) + '.people (stub)';
                },
                o =
                  'init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug'.split(
                    ' '
                  ),
                n = 0;
              n < o.length;
              n++
            )
              g(u, o[n]);
            e._i.push([i, s, a]);
          }),
          (e.__SV = 1));
      })(document, window.posthog || []);
      // Cookieless: memory persistence + no auto person profiles → tanpa cookie,
      // tak butuh consent, tetap melihat semua pengunjung.
      window.posthog.init(phKey, {
        api_host: phHost,
        persistence: 'memory',
        person_profiles: 'identified_only',
        capture_pageview: true,
      });
    </script>
  )
}

{
  /* Umami — analitik ringan cookieless, tanpa consent. */
  analytics.umami.active && (
    <script
      is:inline
      async
      src={`${analytics.umami.host}/script.js`}
      data-website-id={analytics.umami.websiteId}
    />
  )
}

{
  /* GA4 — Consent Mode menahan cookie/hit sampai consent granted. */
  analytics.ga4.active && (
    <script is:inline define:vars={{ gaId: analytics.ga4.measurementId }}>
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )
}

{
  /* GTM — tag di dalamnya sebaiknya diatur consent-aware di UI GTM. */
  analytics.gtm.active && (
    <script is:inline define:vars={{ gtmId: analytics.gtm.containerId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
  )
}

{
  /* Meta Pixel — bukan Consent-Mode-aware, jadi init ditunda sampai consent. */
  analytics.metaPixel.active && (
    <script is:inline define:vars={{ pxId: analytics.metaPixel.pixelId }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      function bbInitPixel() {
        fbq('init', pxId);
        fbq('track', 'PageView');
      }
      if (window.__bbConsent === 'granted') bbInitPixel();
      else document.addEventListener('bb:consent-granted', bbInitPixel, { once: true });
    </script>
  )
}

{
  /* Microsoft Clarity — init ditunda sampai consent. */
  analytics.clarity.active && (
    <script is:inline define:vars={{ clId: analytics.clarity.projectId }}>
      function bbInitClarity() {
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clId);
      }
      if (window.__bbConsent === 'granted') bbInitClarity();
      else document.addEventListener('bb:consent-granted', bbInitClarity, { once: true });
    </script>
  )
}

{
  /* Event layer — satu definisi, di-fan-out ke PostHog + dataLayer (GTM).
     Nyantol ke elemen ber-atribut data-track. No-op bila tak ada yang cocok. */
  analytics.anyProvider && (
    <script is:inline>
      (function () {
        function track(name, props) {
          try {
            if (window.posthog && window.posthog.capture) window.posthog.capture(name, props);
          } catch (e) {}
          try {
            if (window.umami && window.umami.track) window.umami.track(name, props);
          } catch (e) {}
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: name }, props));
        }

        function propsFrom(el) {
          var p = {};
          for (var k in el.dataset) {
            if (k.indexOf('track') === 0 && k !== 'track') {
              var key = k.slice(5);
              p[key.charAt(0).toLowerCase() + key.slice(1)] = el.dataset[k];
            }
          }
          return p;
        }

        document.addEventListener('click', function (e) {
          var el = e.target.closest ? e.target.closest('[data-track]') : null;
          if (!el) return;
          var name = el.dataset.track;
          var props = propsFrom(el);
          // Perkaya donasi dengan kondisi kalkulator terkini bila ada.
          if (name === 'donate_click') {
            var sel = document.getElementById('program-select');
            var pax = document.getElementById('pax-count');
            if (sel && !props.program) props.program = sel.value;
            if (pax && !props.pax) props.pax = pax.textContent.trim();
          }
          track(name, props);
        });

        var sel = document.getElementById('program-select');
        if (sel)
          sel.addEventListener('change', function () {
            track('program_select', { program: sel.value });
          });
      })();
    </script>
  )
}
