---
const photos = [
  'Foto penyaluran ke penerima manfaat',
  'Foto dapur mitra UMKM',
  'Foto relawan di lapangan',
];
---

<section class="px-5 md:px-10 pb-12 md:pb-[88px]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-xl mx-auto mb-8">
      <div class="text-brand-orange font-bold text-[13px] tracking-wide mb-3">DOKUMENTASI</div>
      <h2 class="text-[26px] md:text-[34px] font-extrabold tracking-tight">Bukti Nyata dari Lapangan</h2>
    </div>
    <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
      {photos.map((caption) => (
        <div class="aspect-[4/3] rounded-[20px] overflow-hidden bg-[#F1F5F9] flex items-center justify-center text-center p-4" data-fade="1">
          <span class="text-sm text-muted">{caption}</span>
        </div>
      ))}
    </div>
  </div>
</section>
