---
import { getEntry } from 'astro:content';
import { formatProgramOptionLabel, buildWaLink } from '../lib/format';
import { getProgramsByPintu } from '../lib/programs';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
// Kalkulator per-pax hanya berlaku untuk pintu Food (harga per-pax seragam).
const programs = await getProgramsByPintu('food');
const firstActive = programs.find((p) => p.active)?.label;
const initialWaLink = buildWaLink(site.data.waNumber, 'Halo, saya ingin donasi program "Jumat Berkah" untuk 10 pax (Total: Rp 250.000).');
---

<div id="donasi" class="flex-1 basis-[380px] max-w-[480px] min-w-[280px] bg-white rounded-card p-6 shadow-cardSoft">
  <h2 class="text-title font-semibold mb-1.5">Pilih Program Berbagi</h2>
  <p class="text-body-sm text-muted mb-5">Rp 25.000 per pax, sudah termasuk pengantaran dan dokumentasi.</p>

  <label for="program-select" class="sr-only">Pilih program berbagi</label>
  <select
    id="program-select"
    class="w-full p-4 border border-border rounded-2xl text-body-sm font-semibold text-ink mb-2 bg-white"
  >
    {programs.map((opt) => (
      <option value={opt.label} disabled={!opt.active} selected={opt.label === firstActive}>
        {formatProgramOptionLabel(opt)}
      </option>
    ))}
  </select>

  <div class="flex items-center justify-between border border-border rounded-2xl px-4 py-3.5 mb-4 mt-4">
    <span class="font-semibold text-body-sm">Jumlah pax</span>
    <div class="flex items-center gap-4">
      <button id="pax-dec" aria-label="Kurangi jumlah pax" class="w-11 h-11 rounded-full border-0 bg-gray-100 text-lg font-bold text-ink">–</button>
      <span id="pax-count" aria-live="polite" class="font-bold text-title-sm min-w-[20px] text-center">10</span>
      <button id="pax-inc" aria-label="Tambah jumlah pax" class="w-11 h-11 rounded-full border-0 bg-gray-100 text-lg font-bold text-ink">+</button>
    </div>
  </div>

  <div class="flex items-center justify-between border-t border-dashed border-border pt-4 mb-5">
    <span class="text-body-sm text-muted">Total donasi</span>
    <span id="total-display" class="text-heading-sm font-bold">Rp 250.000</span>
  </div>

  <a
    id="wa-donation-link"
    data-wa-number={site.data.waNumber}
    data-track="donate_click"
    data-track-source="calculator"
    href={initialWaLink}
    target="_blank"
    rel="noopener"
    class="btn-primary flex items-center justify-center gap-2 w-full text-base mb-3"
  >
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.7-.84-1.96-.93-.26-.1-.45-.14-.64.14-.19.28-.73.93-.9 1.12-.16.19-.33.21-.61.07-.28-.14-1.18-.44-2.25-1.39-.83-.74-1.39-1.66-1.55-1.94-.16-.28-.02-.43.12-.57.13-.12.28-.33.42-.49.14-.16.19-.28.28-.47.09-.19.05-.35-.02-.49-.07-.14-.64-1.54-.88-2.11-.23-.55-.46-.48-.64-.49l-.55-.01c-.19 0-.49.07-.75.35-.26.28-.98.96-.98 2.34s1.01 2.72 1.15 2.9c.14.19 1.98 3.03 4.79 4.25.67.29 1.19.46 1.6.59.67.21 1.28.18 1.76.11.54-.08 1.66-.68 1.9-1.33.23-.65.23-1.21.16-1.33-.07-.12-.26-.19-.54-.33M12.05 21.5c-1.55 0-3.07-.42-4.4-1.2l-.32-.19-3.27.86.87-3.19-.21-.33a8.86 8.86 0 0 1-1.36-4.72c0-4.9 3.99-8.88 8.9-8.88 2.38 0 4.61.93 6.29 2.61a8.82 8.82 0 0 1 2.6 6.28c0 4.9-3.99 8.89-8.89 8.89m7.56-16.44A10.5 10.5 0 0 0 12.05 2C6.24 2 1.51 6.72 1.51 12.53c0 1.85.48 3.66 1.4 5.26L1.42 23l5.35-1.4a10.5 10.5 0 0 0 5.28 1.35h.01c5.8 0 10.53-4.72 10.53-10.53 0-2.81-1.1-5.46-3.09-7.45"/></svg>
    Donasi Sekarang
  </a>
  {/* Microcopy metode bayar: jelasin cara bayar itu mudah & fleksibel tepat saat klik. */}
  <p class="flex items-center justify-center gap-1.5 text-micro text-muted text-center mb-5">
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-brand-orange"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>
    Bayar mudah: transfer bank atau e-wallet (OVO, GoPay, DANA)
  </p>

  <div class="flex flex-col gap-2.5">
    <div class="flex gap-2 text-eyebrow text-muted">
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="flex-none mt-0.5 text-brand-orange"><path d="M5 13l4 4L19 7"></path></svg>
      Makanan sehat dan bergizi dari UMKM lokal
    </div>
    <div class="flex gap-2 text-eyebrow text-muted">
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="flex-none mt-0.5 text-brand-orange"><path d="M5 13l4 4L19 7"></path></svg>
      Diantar langsung ke orang yang tepat
    </div>
    <div class="flex gap-2 text-eyebrow text-muted">
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="flex-none mt-0.5 text-brand-orange"><path d="M5 13l4 4L19 7"></path></svg>
      Foto dan videonya dikirim maksimal H+1
    </div>
  </div>
</div>

<script>
  import '../scripts/calculator.js';
</script>
