---
// Kartu donasi: identitas program, agenda berikutnya, pemilih porsi, dan tombol
// WhatsApp yang pesannya ikut berubah. Awalnya menyatu di dalam Hero beranda;
// dipisah ke sini supaya halaman program bisa memakai pemilih porsi yang sama
// tanpa melempar pengunjung balik ke `/#donasi`.
//
// Dua tampilan dari satu komponen:
//   - dengan `photo` → kartu hero, kepala foto plus nama program di atasnya.
//   - tanpa `photo` → panel rata (`is-flat`) untuk dipasang di dalam halaman,
//     bertepi tipis alih-alih berbayang tebal.
//
// Warna aksinya mengikuti `--cat` (warna pintu) kalau ada di induknya, dan
// jatuh ke oranye brand kalau tidak — itu yang bikin kartu ini betah di hero
// kuning maupun di halaman program yang berwarna pintu.
import { Image } from 'astro:assets';
import { calcTotal, buildWaLink, formatRupiah } from '../lib/format';
import type { Ajakan } from '../lib/ajakan';

/**
 * ISI DATANG DARI `ajakan`, TAMPILAN TETAP PROP.
 *
 * Sembilan prop yang dulu dirakit tangan di dua tempat pemasangan kini jadi
 * satu, dan sisanya sengaja TIDAK ikut dilebur. Empat yang bertahan bukan sisa
 * yang belum sempat dibereskan, masing-masing membawa keputusan tampilan yang
 * memang berbeda per tempat:
 *
 * - `photo` — hero mengoper foto sampul program, halaman program sengaja tidak,
 *   dan justru KETIADAAN foto itu yang memilih panel rata lewat `is-flat` di
 *   bawah. Menjadikannya bagian `ajakan` berarti setiap halaman program tumbuh
 *   kepala foto yang tak pernah diminta.
 * - `eyebrow` dan `note` — keduanya cuma benar di atas kartu berjumlah, lihat
 *   catatan di cabang mekanismenya.
 * - `trackSource` dan `id` — analitik dan anchor, keduanya milik halaman.
 *
 * Slot `foot` juga bertahan: hero menaruh "Lihat laporan N penyaluran
 * sebelumnya" di sana, halaman program menaruh baris mitra. Keduanya isi
 * halaman, bukan isi kartu.
 */
interface Props {
  ajakan: Ajakan;
  photo?: ImageMetadata | null;
  eyebrow?: string;
  note?: string;
  trackSource: string;
  id?: string;
}

const { ajakan, photo = null, eyebrow, note, trackSource, id } = Astro.props;

const { aksi, program, waNumber, agenda, schedule } = ajakan;
const mechanism = aksi.mechanism;

const programLabel = program.label;
// Keduanya cuma dirender di dalam kepala foto, jadi mereka tak pernah muncul di
// halaman program yang memang tanpa foto.
const programSummary = program.summary;
const programHref = program.href;

// Dipersempit sekali di sini supaya markup di bawah tak perlu menguji `kind`
// berulang kali untuk mengambil satu angka.
const quantity = mechanism.kind === 'quantity' ? mechanism : null;
const presets = quantity?.presets ?? [];
const packages = quantity?.packages ?? [];

// Pesan percakapan yang kosong berarti tak ada tombol, bukan tombol yang
// membuka WhatsApp tanpa kalimat apa pun. Sama persis dengan aturan
// `resolvePintuHref` di lib/aksi.ts.
const conversationHref =
  mechanism.kind === 'conversation' && mechanism.message
    ? buildWaLink(waNumber, mechanism.message)
    : null;

// Panel agenda hanya muncul kalau editor sudah mengisi lokasinya; bar progres
// butuh target yang masuk akal. Tanpa ini kartunya menampilkan panel kosong
// setiap kali agenda belum disiapkan.
const showAgenda = Boolean(agenda && agenda.location.trim().length > 0);
const showProgress = Boolean(showAgenda && agenda && agenda.targetPorsi > 0);
const collected = agenda ? Math.min(agenda.collectedPorsi, agenda.targetPorsi) : 0;
const remaining = agenda ? Math.max(agenda.targetPorsi - collected, 0) : 0;
const progressPct = showProgress && agenda ? Math.round((collected / agenda.targetPorsi) * 100) : 0;

// Harga datang dari aksinya, bukan dari konstanta di berkas ini. Nol berarti
// mekanismenya bukan "pilih jumlah", dan di situ tak ada satu pun harga yang
// dirender, jadi angka itu tak pernah sampai ke layar.
const pricePerUnit = quantity?.pricePerUnit ?? 0;
const price = calcTotal(1, pricePerUnit);

// Tidak ada porsi terpilih saat halaman dibuka. Sebelumnya 6 porsi sudah
// tercentang, dan angka yang sudah dipilihkan itu membingkai keputusan orang
// sebelum mereka sempat menimbang sendiri.
//
// Konsekuensinya kena ke jalur tanpa JS: dulu href WhatsApp sudah lengkap dari
// server karena jumlahnya diketahui. Sekarang jumlahnya belum ada, jadi pesan
// awalnya cuma tidak menyebut jumlah — ia tetap menyebut program (dan paketnya
// kalau ada) lalu meminta bantuan menentukan porsinya lewat percakapan. Tombol
// itu tetap sahih di titik mana pun: tanpa JS ia mengantar orang ke percakapan
// yang benar, dengan JS ia mendapat angkanya begitu pengunjung memilih.
//
// Pesan ini disusun di sini saja, bukan juga di donation-card.js. Skrip tak
// pernah merangkainya sendiri: teks yang dirender server ia pakai apa adanya,
// dan tiap tombol paket membawa versinya sendiri lewat `data-package-open-msg`.
//
// Paketnya pun tidak dipilihkan lebih dulu, alasannya sama persis dengan porsi.
// Dulu paket pertama sudah `aria-pressed="true"` sejak halaman dibuka, jadi
// orang yang langsung menekan tombol mengirim "Paket Sahur" tanpa pernah
// memilihnya — dua kontrol di kartu yang sama memakai aturan berlawanan.
// Sekarang keduanya kosong sampai pengunjung menyentuhnya.
const hasPackages = packages.length > 0;

const openMessage = (pkg?: string | null) => {
  const label = pkg ? `${programLabel} (Paket ${pkg})` : programLabel;
  // Yang ditanyakan cuma yang memang belum diketahui. Program sepaket tunggal
  // tak pernah menanyakan paket, sebab tidak ada yang bisa dipilih.
  const ask = !pkg && hasPackages ? 'paket dan jumlah porsinya' : 'jumlah porsinya';
  return `Halo, saya ingin donasi program "${label}". Boleh dibantu untuk ${ask}?`;
};

const initialWaLink = buildWaLink(waNumber, openMessage(null));

// Nilai awal panel "Lainnya": 1 adalah porsi terkecil yang masuk akal, dan
// satu-satunya angka yang tidak diam-diam jadi default baru. Kalau pengunjung
// sudah menekan salah satu preset lebih dulu, skrip membawa angka itu ke sini.
const CUSTOM_START_PORSI = 1;

const ARROW = '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>';
---

{/* `scroll-mt-24` menempel kalau kartunya jadi sasaran anchor (`#donasi` di
    beranda maupun di tiap halaman program). Header situs ini `sticky top-0` dan
    `html { scroll-behavior: smooth }` menyala global, jadi tanpa ini kartunya
    mendarat di y=0 dan tepi bawah pil navbar — 84px saat halaman sudah digulir,
    74px saat masih di puncak — menutupi kepalanya. 96px menyisakan 12px napas
    di kasus terburuk. Lihat `.claude/rules/section-ids.md`; catatan di sana
    bahwa seksi paling atas halaman tak memerlukannya tidak berlaku di sini,
    karena kartu ini duduk 464-591px dari puncak dokumen di lebar ponsel. */}
<div
  id={id}
  class:list={['dcard', !photo && 'is-flat', id && 'scroll-mt-24']}
  data-donation-card
  data-weekday={schedule?.weekday}
  data-time={schedule?.time}
  data-price={quantity ? price : undefined}
  data-program={programLabel}
  data-wa={waNumber}
>
  {photo && (
    <div class="dc-photo">
      {/* Kepala kartu ini berdiri di atas fold di beranda, jadi ia kandidat LCP
          dan diberi `fetchpriority="high"` supaya peramban tak menunda-nundanya
          di belakang aset lain.

          Lebar render: kolom kanan hero adalah 0.62fr dari grid `1fr 0.62fr`
          dengan gap 64px di dalam Container tier `wide` (isi 1200px), jadi
          sekitar 435px di layar lebar; di bawah ambangnya kartunya selebar
          kolom. Lebar terbesar dipilih dua kali lebar render untuk layar 2x DPR.
          Sebelumnya tanpa `widths`, sehingga satu berkas 1280w dikirim ke kotak
          setinggi 246px di semua ukuran layar.

          Ambangnya 900, mengikuti tempat `.hero-inner` pecah jadi dua kolom.
          Angkanya sempat tertinggal di 960 setelah hero pindah, dan akibatnya
          di 900 sampai 959 peramban meminta selebar layar penuh untuk kotak
          yang cuma 289px. Kalau split hero bergeser lagi, geser di sini juga. */}
      <Image
        src={photo}
        alt={`Program ${programLabel}`}
        widths={[360, 440, 700, 880]}
        sizes="(min-width: 900px) 440px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="dc-img"
      />
      <div class="dc-scrim" aria-hidden="true"></div>
      <p class="label dc-kick">Program berjalan</p>
      <div class="dc-photo-body">
        <p class="dc-name">{programLabel}</p>
        {programSummary && <p class="dc-desc">{programSummary}</p>}
        {programHref && (
          <a href={programHref} data-track="program_click" data-track-program={programLabel} class="dc-photo-link">
            Detail Program
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW}></svg>
          </a>
        )}
      </div>
    </div>
  )}

  <div class="dc-body">
    {/* Eyebrow-nya cuma dirender di cabang berjumlah, alasan yang sama dengan
        `note` di bawah: "Hitung donasi" adalah label untuk sebuah kalkulator,
        dan di atas panel percakapan ia menjanjikan kontrol yang tidak ada.
        Cabang percakapan membawa eyebrow-nya sendiri. */}
    {quantity && eyebrow && <p class="label dc-eyebrow">{eyebrow}</p>}

    {showAgenda && agenda && (
      <div class="dc-agenda">
        {/* Label dan sisa hari berbagi satu baris karena keduanya pendek,
            sehingga baris tanggal di bawahnya dapat lebar penuh dan muat
            satu baris walau nama lokasinya panjang. */}
        <div class="dc-agenda-top">
          <p class="label dc-agenda-kick">Agenda berikutnya</p>
          <span class="dc-agenda-count" data-agenda-count></span>
        </div>
        {/* Tanggal diisi donation-card.js dari jadwal mingguan, bukan saat
            build, supaya tidak basi begitu Jumatnya lewat. */}
        <p class="dc-agenda-when">
          <span data-agenda-date>Jumat berikutnya</span> <span class="dc-sep">·</span> {agenda.location}
        </p>

        {showProgress && (
          <div class="dc-progress">
            <div
              class="dc-bar"
              role="progressbar"
              aria-valuenow={collected}
              aria-valuemin="0"
              aria-valuemax={agenda.targetPorsi}
              aria-label={`${collected} dari ${agenda.targetPorsi} porsi terkumpul`}
            >
              <span style={`width:${progressPct}%`}></span>
            </div>
            <div class="dc-progress-foot">
              <span class="dc-progress-num">{collected} dari {agenda.targetPorsi} porsi terkumpul</span>
              {agenda.cutoff && <span class="dc-progress-cut">tutup {agenda.cutoff}</span>}
            </div>
          </div>
        )}
      </div>
    )}

    {hasPackages && (
      <div class="dc-pkg" data-package-selector role="radiogroup" aria-label="Pilih paket donasi">
        <p class="dc-pkg-title">Pilih paket</p>
        <div class="dc-pkg-opts">
          {packages.map((pkg) => (
            <button
              type="button"
              class="dc-pkg-opt"
              data-package-option={pkg}
              data-package-open-msg={openMessage(pkg)}
              aria-pressed="false"
            >
              {pkg}
            </button>
          ))}
        </div>
      </div>
    )}

    {quantity && (
    <div class="dc-pick">
      <div class="dc-pick-top">
        <p class="dc-pick-title">
          {showProgress && remaining > 0 ? `Bantu penuhi ${remaining} porsi lagi` : 'Pilih jumlah porsi'}
        </p>
        <span class="dc-price">{formatRupiah(price)} / porsi</span>
      </div>

      {note && <p class="dc-note">{note}</p>}

      {/* Tak satu pun chip tertekan saat halaman dibuka, jadi baris ini tak
          punya "yang terpilih" untuk menerangkan dirinya ke pembaca layar.
          role+label memberi grup itu nama sendiri, memakai kalimat yang sudah
          jadi judul pemilih ini, supaya terdengar sebagai satu pilihan yang
          memang menunggu dijawab dan bukan empat tombol yang berdiri sendiri.
          Bukan radiogroup: chip-nya tombol aria-pressed (dan "Lainnya" membuka
          panel, bukan menetapkan nilai), sementara radiogroup menjanjikan
          navigasi panah antar-radio yang tak dipasang di sini. */}
      <div class="dc-chips" role="group" aria-label="Pilih jumlah porsi">
        {presets.map((n) => (
          <button type="button" class="dc-chip" data-porsi={n} aria-pressed="false">
            <span class="dc-chip-t">{n} porsi</span>
            <span class="dc-chip-s">{formatRupiah(calcTotal(n, pricePerUnit))}</span>
          </button>
        ))}
        <button type="button" class="dc-chip" data-porsi-custom aria-pressed="false">
          <span class="dc-chip-t">Lainnya</span>
          <span class="dc-chip-s">atur sendiri</span>
        </button>
      </div>

      <div class="dc-stepper" data-stepper hidden>
        <button type="button" class="dc-step" data-step-dec aria-label="Kurangi satu porsi">&minus;</button>
        <input
          type="number"
          min="1"
          max="999"
          value={CUSTOM_START_PORSI}
          data-porsi-input
          aria-label="Jumlah porsi"
          class="dc-step-input"
        />
        <button type="button" class="dc-step" data-step-inc aria-label="Tambah satu porsi">+</button>
        <span class="dc-step-unit">porsi</span>
      </div>

      <a
        href={initialWaLink}
        target="_blank"
        rel="noopener"
        data-donasi-cta
        data-track="donate_click"
        data-track-source={trackSource}
        data-track-program={programLabel}
        class="dc-cta"
      >
        {/* Tanpa porsi terpilih tombol ini tak boleh menyebut angka, jadi ia
            menyebut tujuannya: percakapan WhatsApp. Tetap aktif, tidak
            di-disable — pengunjung tanpa JS cuma punya tombol ini, dan tombol
            mati berarti mereka tak bisa berdonasi sama sekali. Skrip kartu
            menukar teksnya jadi "Donasi N Porsi · Rp ..." begitu ada pilihan.

            `data-track-pax` sengaja absen di sini: Analytics.astro menyalin tiap
            `data-track-*` apa adanya jadi properti event, jadi atribut kosong
            akan mengirim pax="" seolah itu jumlah yang dipilih. Skrip yang
            memasangnya begitu porsinya ada. */}
        <span data-donasi-label>Donasi lewat WhatsApp</span>
      </a>
    </div>
    )}

    {/* Cabang percakapan: panel "PAKET CUSTOM" yang dulu berdiri sebagai kartu
        terpisah di program/[program].astro. Ia pindah ke sini utuh, karena yang
        membedakannya dari kartu berjumlah bukan program mana yang dibuka,
        melainkan mekanisme apa yang dideklarasikan aksinya.

        Baris mitra yang dulu duduk DI DALAM panel ini tidak ikut pindah: ia
        naik ke slot `foot`, tempat cabang berjumlah sudah menaruhnya sejak
        awal. Dua cabang yang menaruh baris yang sama di dua tempat berbeda
        adalah persis jenis penyimpangan yang membuat panel ini terpisah dari
        awal. */}
    {mechanism.kind === 'conversation' && (
      <div class="dc-talk">
        <p class="label dc-eyebrow">Paket custom</p>
        <p class="dc-talk-lead">
          Paket, jadwal, dan bentuk laporan disesuaikan lewat diskusi langsung dengan tim kami.
        </p>
        {conversationHref && (
          <a
            href={conversationHref}
            target="_blank"
            rel="noopener"
            data-track="inquiry_click"
            data-track-source={trackSource}
            data-track-program={programLabel}
            class="dc-cta"
          >
            Diskusikan Program {programLabel}
          </a>
        )}
      </div>
    )}

    {Astro.slots.has('foot') && (
      <div class="dc-foot">
        <slot name="foot" />
      </div>
    )}
  </div>
</div>

<style>
  .dcard {
    background: #fff;
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 26px 56px -20px rgba(124, 45, 18, 0.45), 0 2px 6px rgba(124, 45, 18, 0.08);
    /* Baris chip di bawah harus tahu lebar kartunya, bukan lebar layar: kartu
       yang sama muncul selebar 350px di ponsel dan selebar 435px di kolom kanan
       hero desktop, dan di halaman program lebarnya lain lagi. Media query layar
       menjawab pertanyaan yang salah di dua dari tiga tempat itu. */
    container-type: inline-size;
  }
  /* Varian tanpa foto: dipasang di tengah halaman, bukan melayang di atas
     bidang warna hero, jadi bayangan tebalnya diturunkan jadi tepi tipis. */
  .dcard.is-flat {
    border-radius: 20px;
    border: 1px solid #eae7e2;
    box-shadow: 0 10px 30px -18px rgba(28, 25, 23, 0.25);
  }

  .dc-photo { position: relative; height: 246px; display: flex; flex-direction: column; justify-content: space-between; }
  /* Titik fokus digeser ke kanan supaya wajah orang tidak berada tepat di bawah
     blok teks. Orang bukan latar untuk tipografi. */
  .dc-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 76% 42%; }
  .dc-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 16, 14, 0.66) 0%, rgba(18, 16, 14, 0.34) 22%, rgba(18, 16, 14, 0.62) 45%, rgba(18, 16, 14, 0.88) 62%, rgba(18, 16, 14, 0.96) 100%);
  }
  /* Ukuran, ketebalan, jarak huruf, dan huruf besarnya datang dari class .label.
     Yang tersisa di sini cuma yang memang milik tempat ini: posisi dan warna
     terang karena label ini berdiri di atas foto. */
  .dc-kick {
    position: relative;
    margin: 0;
    padding: 16px 18px;
    color: rgba(255, 255, 255, 0.78);
  }
  .dc-photo-body { position: relative; padding: 0 22px 22px; display: flex; flex-direction: column; gap: 7px; }
  .dc-name { margin: 0; font-size: 29px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; color: #fff; }
  .dc-desc { margin: 0; font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, 0.84); max-width: 92%; text-wrap: pretty; }
  .dc-photo-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 700;
    color: #ffd900;
    transition: gap 0.18s ease;
  }
  .dc-photo-link:hover { gap: 13px; color: #ffd900; }
  .dc-photo-link svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .dc-body { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 20px; }

  .dc-eyebrow { margin: 0; color: var(--cat-deep, #c25d0f); }

  /* Panel agenda: bidang hangat yang membedakan "apa yang terjadi minggu ini"
     dari "berapa yang mau kamu kirim" di bawahnya. */
  .dc-agenda {
    background: #fffbeb;
    border: 1px solid #fbe7a8;
    border-radius: 16px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .dc-agenda-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .dc-agenda-kick {
    margin: 0;
    color: #b45309;
  }
  /* Ukurannya ditakar supaya tanggal plus nama lokasi yang panjang tetap muat
     satu baris di lebar kartu. */
  .dc-agenda-when {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #1c1917;
    text-wrap: balance;
  }
  .dc-sep { color: #b45309; font-weight: 600; }
  .dc-agenda-count { flex: none; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; color: #b45309; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .dc-progress { display: flex; flex-direction: column; gap: 8px; }
  .dc-bar { height: 7px; border-radius: 999px; background: rgba(180, 83, 9, 0.15); overflow: hidden; }
  .dc-bar span { display: block; height: 100%; border-radius: 999px; background: var(--cat, #f4791d); }
  .dc-progress-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .dc-progress-num { font-size: 12px; font-weight: 700; color: #92400e; font-variant-numeric: tabular-nums; }
  .dc-progress-cut { font-size: 11px; font-weight: 600; color: #b45309; white-space: nowrap; }

  /* ===== Pemilih paket ===== */
  .dc-pkg { display: flex; flex-direction: column; gap: 9px; }
  .dc-pkg-title { margin: 0; font-size: 15px; font-weight: 800; letter-spacing: -0.02em; color: #1c1917; }
  /* Sama bahasa visual dengan .dc-chip di bawahnya: grid kolom sama-lebar
     (bukan flex-wrap yang bisa menyisakan satu opsi sendirian di baris
     kedua), sudut 13px, dan status terpilih border+tint alih-alih pil penuh
     warna. Beda dari .dc-chip cuma satu: label tunggal, jadi tak perlu
     struktur dua baris judul+harga. */
  .dc-pkg-opts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .dc-pkg-opt {
    border: 1.5px solid #e7e5e4;
    background: #fff;
    border-radius: 13px;
    min-height: 44px;
    padding: 8px 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    color: #57534e;
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
  }
  .dc-pkg-opt:hover { border-color: var(--cat, #f4791d); }
  .dc-pkg-opt[aria-pressed='true'] {
    border: 2px solid var(--cat, #f4791d);
    background: var(--cat-tint, #fff7ed);
    color: var(--cat-deep, #c25d0f);
  }

  /* ===== Pemilih porsi ===== */
  .dc-pick { display: flex; flex-direction: column; gap: 12px; }
  .dc-pick-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
