---
import { getEntry } from 'astro:content';
import Container from './Container.astro';
import { buildWaLink } from '../lib/format';

const CATEGORIES = [
  { slug: 'umum', label: 'Umum' },
  { slug: 'donasi', label: 'Donasi & Pembayaran' },
  { slug: 'penyaluran', label: 'Penyaluran & Transparansi' },
  { slug: 'kemitraan', label: 'Kemitraan' },
  { slug: 'kontak', label: 'Kontak' },
];

const faqEntry = await getEntry('faq', 'faq');
if (!faqEntry) throw new Error('faq/faq entry not found');
// Urutan pertanyaan = urutan array di Keystatic (bisa diseret di admin);
// kategori cuma mengelompokkan, urutan kelompoknya dari CATEGORIES di atas.
const faqs = faqEntry.data.items;
const groups = CATEGORIES.map((c) => ({
  ...c,
  items: faqs.filter((f) => f.category === c.slug),
})).filter((g) => g.items.length > 0);

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waLink = buildWaLink(site.data.waNumber);

---

<section id="faq" class="section bg-white">
  <Container>
    <div class="text-center max-w-text mx-auto mb-12">
      <div class="eyebrow">FAQ</div>
      <h1 class="text-heading md:text-display font-semibold text-ink mb-4">
        Pertanyaan Sering Diajukan
      </h1>
      <p class="text-body text-muted leading-relaxed">
        Temukan jawaban untuk segala pertanyaan kamu dalam menggunakan platform bagiberbagi.id
      </p>
    </div>

    <div class="flex flex-col md:flex-row gap-4 mb-14">
      <div class="flex-1 bg-brand-blueTint rounded-card p-6">
        <label for="faq-search" class="block text-sm font-semibold text-ink mb-2.5">Cari Topik</label>
        {/* Pembungkus ini `label`, bukan `div`, supaya seluruh kotak putih yang
            terlihat sebagai field memang mengaktifkan input-nya. Sebagai `div`,
            kotaknya terukur 302x48 tapi yang menerima ketukan cuma input di
            dalamnya, 241x22: pinggiran atas dan bawah setinggi 13px terlihat
            seperti field biasa dan tidak melakukan apa-apa waktu disentuh.
            Isinya nol teks (svg-nya aria-hidden), jadi nama aksesibel input
            tetap datang dari label "Cari Topik" di atas, tidak berganda. */}
        <label for="faq-search" class="flex items-center gap-2.5 bg-white rounded-xl border border-border px-4 py-3 cursor-text focus-within:ring-2 focus-within:ring-brand-blue/40 focus-within:border-brand-blue">
          <svg aria-hidden="true" class="flex-none text-muted" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            id="faq-search"
            type="text"
            autocomplete="off"
            placeholder="Bagaimana cara berdonasi di bagiberbagi.id?"
            class="w-full bg-transparent text-body-sm text-ink placeholder:text-muted outline-none"
          />
        </label>
      </div>

      <div class="bg-brand-blue rounded-card p-6 md:px-9 text-white text-center flex flex-col justify-center md:min-w-[240px]">
        <div class="font-bold text-title-sm mb-1">Masih ada pertanyaan?</div>
        <p class="text-body-sm text-white/85 mb-4">Tim kami siap membantu lewat WhatsApp.</p>
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="btn-secondary btn-sm inline-flex items-center justify-center gap-2"
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.6 14.3c-.2.6-1.3 1.2-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.6-.6-2.9-1.3-4.8-4.2-4.9-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.6-.1l.6-.7c.2-.3.4-.2.7-.1.3.1 1.7.8 2 .9.3.1.5.2.6.3.1.2.1.9-.1 1.5Z"></path></svg>
          Chat WhatsApp
        </a>
      </div>
    </div>

    <div class="flex flex-col md:flex-row gap-10 lg:gap-14 items-start">
      <nav aria-label="Daftar isi" class="hidden md:block w-[220px] flex-none md:sticky md:top-24">
        <div class="font-bold text-body text-ink mb-4">Daftar Isi:</div>
        <ul class="flex flex-col gap-1">
          {groups.map((g) => (
            <li data-toc-item={g.slug}>
              <a
                href={`#${g.slug}`}
                data-toc-link={g.slug}
                class="block px-3.5 py-2 rounded-lg text-body-sm border-l-[3px] border-transparent text-muted transition-colors"
              >
                {g.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex-1 min-w-0">
        {groups.map((g) => (
          <div class="faq-cat mb-10 last:mb-0 scroll-mt-24" id={g.slug} data-cat={g.slug}>
            <h2 class="text-title-sm font-semibold text-brand-blue mb-2">{g.label}</h2>
            <div class="flex flex-col">
              {g.items.map((faq, i) => (
                <div class="faq-item border-b-0 md:border-b border-border" data-faq data-q={faq.q} data-a={faq.a}>
                  <button
                    type="button"
                    class="faq-trigger w-full flex items-center justify-between gap-4 text-left py-5"
                    aria-expanded="false"
                    aria-controls={`faq-answer-${g.slug}-${i}`}
                  >
                    <span class="text-base font-bold text-ink m-0">{faq.q}</span>
                    <svg aria-hidden="true" class="faq-chevron flex-none transition-transform duration-200 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
                  </button>
                  <p id={`faq-answer-${g.slug}-${i}`} class="faq-answer hidden text-body-sm text-muted leading-relaxed pb-5 -mt-1">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        ))}

        <p id="faq-empty" class="hidden text-body-sm text-muted py-6">
          Tidak ada pertanyaan yang cocok dengan pencarian kamu.
        </p>
      </div>
    </div>
  </Container>
</section>

<script>
  import '../scripts/faq.js';
</script>
