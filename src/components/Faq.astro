---
import { getCollection, getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';

const CATEGORIES = [
  { slug: 'umum', label: 'Umum' },
  { slug: 'donasi', label: 'Donasi & Pembayaran' },
  { slug: 'penyaluran', label: 'Penyaluran & Transparansi' },
  { slug: 'kemitraan', label: 'Kemitraan' },
  { slug: 'kontak', label: 'Kontak' },
];

const faqs = (await getCollection('faqs')).sort((a, b) => a.id.localeCompare(b.id));
const groups = CATEGORIES.map((c) => ({
  ...c,
  items: faqs.filter((f) => f.data.category === c.slug),
})).filter((g) => g.items.length > 0);

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waLink = buildWaLink(site.data.waNumber);
---

<section id="faq" class="section bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-[720px] mx-auto mb-10">
      <div class="eyebrow">FAQ</div>
      <h1 class="text-heading-sm md:text-heading-xl font-extrabold tracking-tight text-ink mb-4">
        Pertanyaan Sering Diajukan
      </h1>
      <p class="text-body text-muted leading-relaxed">
        Temukan jawaban untuk segala pertanyaan Anda dalam menggunakan platform bagiberbagi.id
      </p>
    </div>

    <div class="flex flex-col md:flex-row gap-4 mb-14">
      <div class="flex-1 bg-brand-blueTint rounded-card p-5 md:p-6">
        <label for="faq-search" class="block text-sm font-semibold text-ink mb-2.5">Cari Topik</label>
        <div class="flex items-center gap-2.5 bg-white rounded-xl border border-border px-4 py-3">
          <svg class="flex-none text-gray-400" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            id="faq-search"
            type="text"
            autocomplete="off"
            placeholder="Bagaimana cara berdonasi di bagiberbagi.id?"
            class="w-full bg-transparent text-body-sm text-ink placeholder:text-gray-400 outline-none"
          />
        </div>
      </div>

      <div class="bg-brand-blue rounded-card p-6 md:px-9 text-white text-center flex flex-col justify-center md:min-w-[240px]">
        <div class="font-extrabold text-title-sm mb-1">Masih ada pertanyaan?</div>
        <p class="text-body-sm text-white/85 mb-4">Tim kami siap membantu lewat WhatsApp.</p>
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="btn-secondary inline-flex items-center justify-center gap-2 text-body-sm px-5 py-2.5"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.6 14.3c-.2.6-1.3 1.2-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.6-.6-2.9-1.3-4.8-4.2-4.9-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.6-.1l.6-.7c.2-.3.4-.2.7-.1.3.1 1.7.8 2 .9.3.1.5.2.6.3.1.2.1.9-.1 1.5Z"></path></svg>
          Chat WhatsApp
        </a>
      </div>
    </div>

    <div class="flex flex-col md:flex-row gap-10 lg:gap-14 items-start">
      <nav aria-label="Daftar isi" class="hidden md:block w-[220px] flex-none md:sticky md:top-24">
        <div class="font-bold text-body text-ink mb-4">Daftar Isi:</div>
        <ul class="flex flex-col gap-1">
          {groups.map((g) => (
            <li data-toc-item={g.slug}>
              <a
                href={`#${g.slug}`}
                data-toc-link={g.slug}
                class="block px-3.5 py-2 rounded-lg text-body-sm border-l-[3px] border-transparent text-muted transition-colors"
              >
                {g.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex-1 min-w-0">
        {groups.map((g) => (
          <div class="faq-cat mb-10 last:mb-0 scroll-mt-24" id={g.slug} data-cat={g.slug}>
            <h2 class="text-title-sm font-extrabold text-brand-blue mb-2">{g.label}</h2>
            <div class="flex flex-col">
              {g.items.map((faq) => (
                <div class="faq-item border-b border-border" data-faq data-q={faq.data.q} data-a={faq.data.a}>
                  <button
                    type="button"
                    class="faq-trigger w-full flex items-center justify-between gap-4 text-left py-5"
                    aria-expanded="false"
                  >
                    <span class="text-base font-bold text-ink m-0">{faq.data.q}</span>
                    <svg class="faq-chevron flex-none transition-transform duration-200 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
                  </button>
                  <p class="faq-answer hidden text-body-sm text-muted leading-relaxed pb-5 -mt-1">{faq.data.a}</p>
                </div>
              ))}
            </div>
          </div>
        ))}

        <p id="faq-empty" class="hidden text-body-sm text-muted py-6">
          Tidak ada pertanyaan yang cocok dengan pencarian Anda.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/faq.js';
</script>
