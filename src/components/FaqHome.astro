---
import { getEntry } from 'astro:content';
import Container from './Container.astro';

const faqEntry = await getEntry('faq', 'faq');
if (!faqEntry) throw new Error('faq/faq entry not found');
// Ambil 3 pertanyaan teratas; urutannya = urutan array di Keystatic.
// Daftar lengkap tetap di halaman /faq.
const faqs = faqEntry.data.items.slice(0, 3);
---

{/* PENUTUP NARASI DONATUR (lanjutan Dampak): warna & aksen ikut ImpactSection
    (bg-brand-blue, teks putih, aksen kuning) supaya bidang biru donatur nyambung
    utuh. Di sinilah satu-satunya radius bind di home: rounded-bottom + shadow
    biru-dalam menutup busur donatur, mengambang di atas seksi netral di bawahnya
    (JoinUs, di luar narasi). Layout 2 kolom editorial (kiri framing, kanan
    accordion + baris aksi) supaya ringan. */}
<section id="faq" class="section relative z-10 bg-brand-blue text-white rounded-b-[28px] shadow-[0_34px_52px_-26px_rgba(11,30,77,0.55)] scroll-mt-24">
  <Container width="wide" class="grid gap-10 lg:gap-16 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start">
    <div>
      <div class="eyebrow text-brand-yellow">Masih Ada Pertanyaan?</div>
      <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-4">Yang sering ditanyakan.</h2>
      <p class="text-white/85 text-body-sm leading-relaxed max-w-sm">
        Beberapa hal yang paling sering ditanyakan sebelum berdonasi. Kalau masih ada yang mengganjal, kami siap bantu.
      </p>
    </div>

    <div class="flex flex-col border-t-0 lg:border-t border-white/15">
      {faqs.map((faq, i) => (
        <div class="faq-item border-b-0 lg:border-b border-white/15" data-faq data-q={faq.q} data-a={faq.a}>
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between gap-4 text-left py-5"
            aria-expanded="false"
            aria-controls={`faq-home-answer-${i}`}
          >
            <span class="text-base font-bold text-white m-0">{faq.q}</span>
            <svg aria-hidden="true" class="faq-chevron flex-none transition-transform duration-200 text-white/60" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <p id={`faq-home-answer-${i}`} class="faq-answer hidden text-body-sm text-white/75 leading-relaxed pb-5 -mt-1">{faq.a}</p>
        </div>
      ))}

      {/* Baris aksi: donasi (primer) + link ke FAQ penuh (sekunder). Di lg ke
          atas ini satu baris sejajar, dua ujung, teks+link seperti semula:
          653px lebar sudah cukup buat "kuning menonjol vs putih redup" kebaca
          sebagai primer/sekunder tanpa bantuan bentuk. Di bawah lg lebarnya
          sempit dan keduanya jadi sama tinggi/sama rata kiri kalau dibiarkan
          bentuk teks, jadi donasi jadi tombol kuning solid selebar penuh,
          ditaruh di atas, supaya jelas dia aksi utama; link kedua turun jadi
          teks kecil redup di bawahnya, bukan baris kedua yang sama beratnya. */}
      <div class="flex flex-col gap-4 pt-6 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between lg:gap-x-6 lg:gap-y-3">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-baseline lg:gap-1">
          <p class="text-body-sm text-white/85 m-0">Sudah mantap?</p>
          <a
            href="#donasi"
            data-track="donate_click"
            data-track-source="faq_nudge"
            class="flex w-full items-center justify-center gap-1 rounded-full bg-brand-yellow px-6 py-3.5 text-body-sm font-bold text-brand-blue transition-[gap] hover:gap-2 lg:inline-flex lg:w-auto lg:rounded-none lg:bg-transparent lg:px-0 lg:py-0 lg:text-brand-yellow"
          >
            Donasi sekarang
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
        </div>
        <a href="/faq/" class="text-micro font-medium text-white/50 inline-flex items-center gap-1.5 transition-all hover:text-white hover:gap-2.5 lg:text-body-sm lg:font-semibold lg:text-white/65">
          Lihat semua pertanyaan
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </Container>
</section>

<script>
  import '../scripts/faq.js';
</script>
