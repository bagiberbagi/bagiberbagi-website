{/* CTA penutup: panel biru aksen (senada ImpactSection/JoinUs) dengan radial
    highlight hangat + halo oranye samar, konten terpusat, satu tombol primer
    menuju kalkulator donasi di hero (#donasi). */}
<section class="section">
  <div class="max-w-7xl mx-auto">
    <div class="relative overflow-hidden rounded-card bg-brand-blue text-white text-center px-6 py-14 md:px-8 md:py-16 shadow-[0_30px_60px_-30px_rgba(11,30,77,0.55)]">
      <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_-10%,rgba(244,121,29,0.28),transparent_60%)]"></span>
      <span aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-28 w-72 h-72 rounded-full bg-brand-orange/10"></span>
      <div class="relative max-w-2xl mx-auto">
        <h2 class="text-heading-sm md:text-heading-lg font-extrabold tracking-tight mb-4">Jumat depan, jadilah alasan seseorang tersenyum.</h2>
        <p class="text-base leading-relaxed text-white/85 mb-8">
          Mulai dari Rp 25.000. Satu porsi makanan, satu pengantaran, satu bukti nyata bahwa sedekahmu sampai.
        </p>
        <a href="#donasi" data-track="donate_click" data-track-source="final_cta" class="btn-primary">Donasi Sekarang</a>
      </div>
    </div>
  </div>
</section>
