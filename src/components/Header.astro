---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { NAV_LINKS, PINTU, PINTU_LABEL } from '../consts';
import type { ProgramMenuCategoryData } from '../consts';
import { getProgramsByPintu } from '../lib/programs';
import ProgramMenuCategory from './ProgramMenuCategory.astro';
import logoHorizontal from '../assets/images/logo/logo-horizontal-color.png';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Mega-menu = lima kategori program (Impact dikecualikan, ia lapisan hasil
// bukan channel donasi). Ditampilkan sebagai satu baris horizontal di bawah
// label "Pintu Berbagi". Kategori ber-program menampilkan daftar programnya;
// yang belum jalan menampilkan tagline-nya (lihat ProgramMenuCategory).
const PROGRAM_MENU: ProgramMenuCategoryData[] = await Promise.all(
  PINTU.map(async (cat) => ({
    label: cat.label,
    icon: cat.icon,
    href: `/berbagi/${cat.slug}/`,
    color: cat.color,
    colorTint: cat.colorTint,
    tagline: cat.tagline,
    // Aktif dulu, lalu yang belum jalan — keduanya tetap urut `order`
    // (sort stabil di atas hasil getProgramsByPintu yang sudah ter-order).
    items: (await getProgramsByPintu(cat.id))
      .map((p) => ({
        label: p.label,
        desc: p.summary,
        active: p.active,
        href: p.href,
      }))
      .sort((a, b) => Number(b.active) - Number(a.active)),
  }))
);

// Active-nav: tandai current-page berdasar route (SSR, per-halaman statis).
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navActive = (link: (typeof NAV_LINKS)[number]) => {
  if (link.id === 'home') return pathname === '/';
  if (link.href.includes('#')) return false;
  return pathname === link.href.replace(/\/$/, '');
};
---

<header
  data-header
  class="sticky top-0 z-50 transition-[background-color,border-color,box-shadow] duration-300"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-4 py-4">
    <a href="/#top" class="flex items-center">
      <Image src={logoHorizontal} alt="bagiberbagi.id" class="h-8 w-auto md:h-9" />
    </a>

    {/* Grup kanan: logo tetap di kiri (justify-between), menu + CTA berkumpul
        di kanan sebagai satu unit. */}
    <div class="hidden nav:flex items-center gap-7">
    <nav class="flex items-center gap-7">
      {NAV_LINKS.map((link) => (
        link.id === 'program' ? (
          <div class="relative" data-program-menu>
            <button
              type="button"
              data-program-trigger
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="program-panel"
              class="nav-link flex items-center gap-1.5 text-body-sm font-semibold tracking-tight text-ink transition-colors hover:text-brand-orange"
            >
              {link.label}
              <svg aria-hidden="true" data-program-chevron width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div
              id="program-panel"
              data-program-panel
              class="hidden absolute left-1/2 -translate-x-1/2 top-full mt-3 w-[1120px] max-w-[calc(100vw-2rem)] bg-white rounded-card shadow-menu border border-border p-6 z-50"
            >
              <div class="eyebrow text-brand-orange mb-1">{PINTU_LABEL}</div>
              <div class="divide-y divide-border">
                {PROGRAM_MENU.map((col) => (
                  <ProgramMenuCategory category={col} />
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            aria-current={navActive(link) ? 'page' : undefined}
            class:list={['nav-link text-body-sm tracking-tight text-ink transition-colors hover:text-brand-orange', navActive(link) ? 'font-extrabold' : 'font-semibold']}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>
    {/* CTA navbar = level "medium" (btn-sm), lebih kecil dari CTA besar di hero
        agar hierarki ukuran jelas — bukan semua tombol seukuran. */}
    <a
      href="/#donasi"
      data-nav-donasi
      class="btn-primary btn-sm whitespace-nowrap"
    >
      Donasi Sekarang
    </a>
    </div>

    <button
      id="nav-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      class="nav:hidden bg-gray-50 border-0 w-11 h-11 rounded-xl flex items-center justify-center text-ink"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
    </button>
  </div>

  <nav id="mobile-nav-panel" class="hidden nav:hidden flex-col gap-0.5 px-5 md:px-10 pb-5 pt-2 border-t border-border">
    {NAV_LINKS.map((link) => (
      link.id === 'program' ? (
        <div data-program-menu-mobile>
          <button
            type="button"
            data-program-trigger-mobile
            aria-expanded="false"
            aria-controls="mobile-program-panel"
            class="w-full flex items-center justify-between px-1 py-3 font-medium text-muted"
          >
            {link.label}
            <svg aria-hidden="true" data-program-chevron-mobile width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <div id="mobile-program-panel" data-program-panel-mobile class="hidden flex-col gap-6 pl-3 pb-3">
            <div class="eyebrow text-brand-orange">{PINTU_LABEL}</div>
            {PROGRAM_MENU.map((cat) => (
              <ProgramMenuCategory category={cat} iconSize={14} />
            ))}
            <a href="/jumat-berkah/" class="btn-primary btn-sm text-center">Lihat Program Jumat Berkah</a>
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          aria-current={navActive(link) ? 'page' : undefined}
          class:list={['px-1 py-3', navActive(link) ? 'font-bold text-ink' : 'font-medium text-muted']}
        >{link.label}</a>
      )
    ))}
    <a href="/#donasi" class="mt-2 btn-primary text-center">
      Donasi Sekarang
    </a>
  </nav>
</header>

<style>
  /* Awal (belum scroll): navbar TRANSPARAN — foto+overlay zona hero (index)
     menembus di belakangnya, jadi kesan pertama full seamless kuning. Tanpa
     garis/shadow. Setelah scroll (.is-scrolled) atau saat menu mobile terbuka
     (.menu-open, agar panel tak transparan menembus foto): putih solid + border
     + shadow lembut. border selalu ada agar transisi warna halus. */
  [data-header] {
    border-bottom: 1px solid transparent;
  }
  [data-header].is-scrolled,
  [data-header].menu-open {
    background-color: rgba(255, 255, 255, 0.95);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom-color: #eef0f3;
    box-shadow: 0 12px 24px -16px rgba(15, 23, 42, 0.25);
  }

  /* Di puncak (belum scroll) tombol Donasi jadi OUTLINE: transparan, teks ink,
     garis ink tipis. Border selalu ada 1.5px (transparan saat scroll) agar tak
     ada layout shift dan warnanya bertransisi halus. Setelah scroll balik ke pill
     oranye (btn-primary). */
  [data-nav-donasi] {
    border: 1.5px solid transparent;
  }
  [data-header]:not(.is-scrolled) [data-nav-donasi],
  [data-header]:not(.is-scrolled) [data-nav-donasi]:hover {
    background-color: transparent;
    color: #0f172a;
    border-color: rgba(15, 23, 42, 0.28);
  }

  /* Nav link: indikator hover/fokus selain warna — garis bawah yang tumbuh dari
     kiri. Hadir juga saat focus-visible (keyboard), bukan cuma hover. */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/header-scroll.js';
  import '../scripts/mobile-nav.js';
  import '../scripts/program-menu.js';
</script>
