---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { NAV_LINKS, PINTU, PINTU_LABEL } from '../consts';
import type { ProgramMenuCategoryData } from '../consts';
import { getProgramsByPintu } from '../lib/programs';
import ProgramMenuCategory from './ProgramMenuCategory.astro';
import logoHorizontal from '../assets/images/logo/logo-horizontal-color.png';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Mega-menu desktop = panel 2 kolom: kiri promo "Pintu Berbagi" + kartu flagship
// program aktif (Jumat Berkah), kanan grid kartu pintu (ProgramMenuCategory)
// + strip trust/dampak. PROGRAM_MENU dirakit dari PINTU + program per pintu;
// items[].active dipakai kartu untuk menentukan status Aktif/Segera.
const PROGRAM_MENU: ProgramMenuCategoryData[] = await Promise.all(
  PINTU.map(async (cat) => ({
    label: cat.label,
    icon: cat.icon,
    href: `/berbagi-${cat.slug}/`,
    color: cat.color,
    colorTint: cat.colorTint,
    tagline: cat.tagline,
    // Aktif dulu, lalu yang belum jalan — keduanya tetap urut `order`
    // (sort stabil di atas hasil getProgramsByPintu yang sudah ter-order).
    items: (await getProgramsByPintu(cat.id))
      .map((p) => ({
        label: p.label,
        desc: p.summary,
        active: p.active,
        href: p.href,
      }))
      .sort((a, b) => Number(b.active) - Number(a.active)),
  }))
);

// Kartu flagship di panel desktop = program pintu Makanan yang aktif
// (Jumat Berkah). CTA-nya "Pelajari ..." mengarah ke halaman program, bukan
// tombol donasi — navbar sudah punya CTA donasi sendiri.
const flagship = (await getProgramsByPintu('food')).find((p) => p.active);

// Active-nav: tandai current-page berdasar route (SSR, per-halaman statis).
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navActive = (link: (typeof NAV_LINKS)[number]) => {
  if (link.id === 'home') return pathname === '/';
  if (link.href.includes('#')) return false;
  return pathname === link.href.replace(/\/$/, '');
};
---

<header
  data-header
  class="sticky top-0 z-50 px-3 sm:px-4 pt-2.5"
>
  {/* Padding kanan (pr-2.5) sengaja lebih kecil dari kiri: CTA/hamburger di
      ujung kanan (rounded-full) harus NEST konsentris di dalam cap kanan pil —
      inset kanan disamakan dengan inset vertikal (= py-2.5). Kiri tetap lega
      untuk logo. */}
  {/* Tinggi pil dikunci di 64px. Dikunci, bukan dibiarkan mengikuti isi, supaya
      tombol Donasi atau hamburger yang berubah ukuran tidak diam-diam menggeser
      tinggi navbar, dan supaya angka tarik-naik hero tetap sahih. Total tinggi
      header = 10px margin atas + 64px pil = 74px. */}
  <div data-nav-pill class="max-w-wide mx-auto flex h-16 items-center gap-5 rounded-full border border-transparent pl-4 md:pl-5 pr-2.5 transition-all duration-300">
    <a href="/#top" class="flex items-center shrink-0">
      {/* Slot logo dikunci tingginya (h-9 = 36px), dan rasio berkas sumber
          2522x451 membuat lebar terpakainya selalu 201px di lebar layar mana
          pun. Karena itu `sizes` boleh berupa angka tetap, bukan vw: tidak ada
          keadaan di mana slot ini melar. Tanpa widths+sizes, Astro memancarkan
          satu berkas seukuran sumber tanpa srcset, dan logo 2522px 76 KB itu
          ikut terunduh di SETIAP halaman cuma untuk mengisi 201px. */}
      <Image
        src={logoHorizontal}
        alt="bagiberbagi.id"
        class="h-9 w-auto"
        width={201}
        widths={[201, 402, 603]}
        sizes="201px"
      />
    </a>

    {/* Nav links di kiri dekat logo; CTA Donasi didorong ke kanan pil (ml-auto).
        nav:ml-4 kasih napas ekstra antara logo dan menu pertama (gap pil sendiri
        terasa sempit relatif lebar logo). */}
    <nav class="hidden nav:flex items-center gap-1 nav:ml-5">
      {NAV_LINKS.map((link) => (
        link.id === 'program' ? (
          <div data-program-menu>
            <button
              type="button"
              data-program-trigger
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="program-panel"
              class="nav-link flex items-center gap-1.5 text-body-sm font-semibold text-ink transition-colors hover:text-brand-orange"
            >
              {link.label}
              <svg aria-hidden="true" data-program-chevron width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div
              id="program-panel"
              data-program-panel
              class="hidden absolute left-0 right-0 top-full mt-2 max-w-wide mx-auto bg-white rounded-card shadow-menu border border-border p-5 z-50 grid grid-cols-[288px_1fr] gap-6"
            >
              {/* KIRI: promo pintu + kartu flagship program aktif */}
              <div class="flex flex-col">
                <div class="eyebrow text-brand-orange">{PINTU_LABEL}</div>
                {/* Jumlah pintu sengaja tidak disebut angka di sini maupun di
                    judul kolom kanan: setiap kali pintu bertambah, kalimatnya
                    ikut basi dan itu ketahuan paling belakangan. */}
                <h3 class="text-title font-semibold mt-2 mb-2">Banyak pintu, satu gerakan berbagi.</h3>
                <p class="text-body-sm text-muted leading-relaxed mb-4">Mulai dari makanan, meluas ke barang, waktu, ruang, dana, dan pohon. Satu tempat untuk semua cara berbagi sumber daya.</p>

                {flagship && (
                  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-orange to-brand-orangeDark text-white p-4 mt-auto">
                    <span aria-hidden="true" class="pointer-events-none absolute -right-8 -bottom-10 w-32 h-32 rounded-full bg-white/10"></span>
                    <span class="inline-block rounded-full bg-white/20 px-2.5 py-1 text-micro font-bold uppercase tracking-wider">Program Aktif</span>
                    <h4 class="text-title-sm font-semibold mt-2.5 mb-1.5">{flagship.label}</h4>
                    <p class="text-body-sm leading-relaxed text-white/85 mb-3.5">{flagship.summary}</p>
                    {flagship.href && (
                      <a
                        href={flagship.href}
                        data-track="program_click"
                        data-track-program={flagship.label}
                        class="group inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-body-sm font-bold text-brand-orangeDark"
                      >
                        Pelajari {flagship.label}
                        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                      </a>
                    )}
                  </div>
                )}
              </div>

              {/* KANAN: kartu tiap pintu + strip trust/dampak */}
              <div class="flex flex-col">
                <div class="flex items-center justify-between gap-4 mb-3.5">
                  <span class="text-micro font-bold uppercase tracking-wider text-muted">Semua Pintu</span>
                  {/* Dulu menuju #program milik ProgramHighlights. Seksi itu
                      sudah dilepas dari beranda, jadi tujuannya jadi peta
                      pintu, tempat tiap pintu mengantar ke daftar programnya. */}
                  <a href="/#pintu" class="group inline-flex items-center gap-1 text-body-sm font-bold text-ink transition-colors hover:text-brand-orange">
                    Lihat semua program
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  </a>
                </div>
                <div class="grid grid-cols-3 grid-rows-2 gap-2 flex-1">
                  {PROGRAM_MENU.map((col) => (
                    <ProgramMenuCategory category={col} />
                  ))}
                </div>
                <div class="mt-4 border-t border-border pt-3.5 flex items-center justify-between gap-4 flex-wrap">
                  <span class="text-body-sm text-muted">Setiap donasi terdokumentasi dan sampai ke yang tepat.</span>
                  <a href="/jejak/" class="group inline-flex items-center gap-1.5 text-body-sm font-bold text-brand-orange">
                    Lihat jejak & dampak
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            aria-current={navActive(link) ? 'page' : undefined}
            class:list={['nav-link text-body-sm text-ink transition-colors hover:text-brand-orange', navActive(link) ? 'font-bold' : 'font-semibold']}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>
    {/* CTA navbar btn-sm; didorong ke kanan pil (ml-auto), disembunyikan di mobile. */}
    <a
      href="/#donasi"
      data-nav-donasi
      class="hidden nav:inline-flex items-center btn-primary btn-sm whitespace-nowrap ml-auto h-[42px] py-0"
    >
      Donasi Sekarang
    </a>

    <button
      id="nav-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      class="nav:hidden ml-auto border-0 w-11 h-11 rounded-full flex items-center justify-center text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-ink"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
    </button>
  </div>

  <nav id="mobile-nav-panel" class="hidden nav:hidden max-w-wide mx-auto mt-2 flex-col gap-0.5 bg-white border border-border rounded-2xl shadow-cardSm px-5 pb-5 pt-3">
    {NAV_LINKS.map((link) => (
      link.id === 'program' ? (
        <div data-program-menu-mobile>
          <button
            type="button"
            data-program-trigger-mobile
            aria-expanded="false"
            aria-controls="mobile-program-panel"
            class="w-full flex items-center justify-between px-1 py-3 font-medium text-muted"
          >
            {link.label}
            <svg aria-hidden="true" data-program-chevron-mobile width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <div id="mobile-program-panel" data-program-panel-mobile class="hidden flex-col gap-6 pl-3 pb-3">
            <a href="/#pintu" class="eyebrow text-brand-orange inline-flex items-center gap-1 hover:text-brand-orangeDark transition-colors">
              {PINTU_LABEL}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </a>
            {PROGRAM_MENU.map((cat) => (
              <ProgramMenuCategory category={cat} iconSize={14} />
            ))}
            <a href="/program/jumat-berkah/" class="btn-primary btn-sm text-center">Lihat Program Jumat Berkah</a>
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          aria-current={navActive(link) ? 'page' : undefined}
          class:list={['px-1 py-3', navActive(link) ? 'font-bold text-ink' : 'font-medium text-muted']}
        >{link.label}</a>
      )
    ))}
    <a href="/#donasi" class="mt-2 btn-primary text-center">
      Donasi Sekarang
    </a>
  </nav>
</header>

<style>
  /* Panel nav mobile dibatasi tingginya dan diberi guliran sendiri.

     Ini bukan soal estetika. [data-header] itu `position: sticky; top: 0`,
     jadi begitu panel lebih tinggi dari viewport ia terpaku di tempatnya dan
     sisa isinya TIDAK PERNAH bisa dicapai: menggulir halaman sampai dasar pun
     tidak menggeser panel sedikit pun. Terukur 4 Agustus 2026: membuka submenu
     Pintu Berbagi membuat panel jadi 1483px di viewport 844px, dan 8 dari 13
     tautannya di luar layar, yang terakhir tombol "Donasi Sekarang".

     Angkanya: tepi atas panel ada di 82px (10px pt-2.5 + 64px pil = --nav-h,
     lalu mt-2). Sisa 1rem menyisakan napas di tepi bawah layar.

     `vh` ditulis lebih dulu sebagai cadangan buat Safari lama yang belum
     mengenal `dvh`; di peramban yang mengenalnya, baris kedua yang menang.
     `overscroll-behavior: contain` menahan guliran supaya tidak diteruskan ke
     halaman di belakang panel begitu ujungnya tercapai. */
  #mobile-nav-panel {
    max-height: calc(100vh - var(--nav-h) - 1rem);
    max-height: calc(100dvh - var(--nav-h) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Navbar HYBRID: di puncak halaman pil TRANSPARAN/flat supaya konteks hero
     kuning tembus (seamless, seperti sebelumnya). Setelah scroll (.is-scrolled)
     atau saat menu mobile terbuka (.menu-open) skin pil muncul: putih + blur +
     border + shadow, jadi pil mengambang. Transisi halus (transition-all di kelas). */
  [data-header].is-scrolled [data-nav-pill],
  [data-header].menu-open [data-nav-pill] {
    background-color: rgba(255, 255, 255, 0.95);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-color: #eef0f3;
    box-shadow: 0 14px 28px -18px rgba(15, 23, 42, 0.3);
  }

  /* Di puncak halaman pil menempel rapat ke tepi atas karena ia masih satu
     kesatuan dengan hero. Begitu halaman digulir, pil turun sedikit sehingga
     jaraknya ke tepi bertambah dan ia terbaca benar-benar mengambang di atas
     konten. Dikerjakan lewat transform, bukan padding, supaya tinggi header
     tidak berubah dan konten di bawahnya tidak bergeser saat ambang terlewati. */
  [data-header].is-scrolled [data-nav-pill] {
    transform: translateY(6px);
  }
  @media (min-width: 860px) {
    [data-header].is-scrolled [data-nav-pill] { transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header].is-scrolled [data-nav-pill] { transform: none; }
  }

  /* Tombol Donasi: di puncak jadi OUTLINE (transparan, teks ink) agar kebaca di
     hero kuning; setelah scroll (pil putih) balik ke pill oranye solid. Border
     selalu 1.5px agar tak ada layout shift dan warnanya bertransisi halus. */
  [data-nav-donasi] {
    border: 1.5px solid transparent;
  }
  [data-header]:not(.is-scrolled) [data-nav-donasi],
  [data-header]:not(.is-scrolled) [data-nav-donasi]:hover {
    background-color: transparent;
    color: #0f172a;
    border-color: rgba(15, 23, 42, 0.28);
  }

  /* Nav link: indikator hover/fokus berupa bidang latar membulat, bukan garis
     bawah. Bentuk pil-di-dalam-pil ini sekeluarga dengan tombol Donasi dan chip
     lain di situs, jadi hover-nya terbaca sebagai bagian dari sistem, bukan
     sebagai aksen sendiri.
     Warnanya tint ink transparan, bukan gray-100 solid, karena pil navbar
     berganti latar: tembus pandang di atas hero kuning, putih setelah digulir.
     Satu nilai transparan bekerja benar di kedua keadaan. */
  .nav-link {
    padding: 4px 12px;
    border-radius: 999px;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    background-color: rgba(15, 23, 42, 0.07);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }

  /* Hamburger: bentuk dan cincin fokus mengikuti tombol ikon bundar 44px yang
     sudah ada di Share.astro, tapi latar diamnya DIBUANG. Di dalam pil, latar
     abu solid berarti satu permukaan ditumpuk di atas permukaan yang sudah ada,
     dan persegi-membulat di dalam bentuk yang serba 999px terbaca sebagai benda
     dari sistem lain. Kotak sentuh 44x44 tidak ikut berubah.

     Umpan baliknya meminjam .nav-link di atas, bukan `hover:bg-gray-100` milik
     Share.astro, dengan alasan yang sama seperti yang tertulis di sana: latar
     pil berganti-ganti (tembus pandang di atas hero kuning, putih setelah
     digulir), dan satu nilai tint transparan bekerja benar di kedua keadaan
     sementara satu warna solid hanya benar di salah satunya. Cincin fokusnya
     menyimpang dari Share.astro karena alasan yang sama: brand-orange di atas
     hero kuning cuma 1.9:1, di bawah 3:1 yang dituntut indikator fokus,
     sedangkan ink 12.9:1 di atas kuning dan 17.9:1 di atas pil putih. */
  #nav-toggle {
    background-color: transparent;
    transition: background-color 0.18s ease;
  }
  #nav-toggle:hover,
  #nav-toggle:focus-visible {
    background-color: rgba(15, 23, 42, 0.07);
  }
  /* Ditekan dan sedang terbuka memakai tint yang sama satu langkah lebih pekat.
     Begitu panel terbuka tombol ini berperan sebagai tombol tutup, dan tanpa
     latar diam tidak ada lagi yang menandai peran itu selain keadaan ini. */
  #nav-toggle:active,
  #nav-toggle[aria-expanded='true'] {
    background-color: rgba(15, 23, 42, 0.12);
  }
  @media (prefers-reduced-motion: reduce) {
    #nav-toggle {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/header-scroll.js';
  import '../scripts/mobile-nav.js';
  import '../scripts/program-menu.js';
</script>
