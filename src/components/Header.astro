---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { NAV_LINKS, PROGRAM_MENU } from '../consts';
import ProgramMenuCategory from './ProgramMenuCategory.astro';
import programPromoImage from '../assets/images/program-promo.png';
import logoHorizontal from '../assets/images/logo/logo-horizontal-color.png';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const [makananMenu, bantuanMenu, pendidikanMenu] = PROGRAM_MENU;

// Active-nav: tandai current-page berdasar route (SSR, per-halaman statis).
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navActive = (link: (typeof NAV_LINKS)[number]) => {
  if (link.id === 'home') return pathname === '/';
  if (link.href.includes('#')) return false;
  return pathname === link.href.replace(/\/$/, '');
};
---

<header class="sticky top-0 z-50 bg-white border-b border-border">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-5 md:px-10 py-4">
    <a href="/#top" class="flex items-center">
      <Image src={logoHorizontal} alt="bagiberbagi.id" class="h-8 w-auto md:h-9" />
    </a>

    <nav class="hidden nav:flex items-center gap-8">
      {NAV_LINKS.map((link) => (
        link.id === 'program' ? (
          <div class="relative" data-program-menu>
            <button
              type="button"
              data-program-trigger
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="program-panel"
              class="flex items-center gap-1.5 font-medium text-muted transition-colors hover:text-brand-blue"
            >
              {link.label}
              <svg aria-hidden="true" data-program-chevron width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div
              id="program-panel"
              data-program-panel
              class="hidden absolute left-1/2 -translate-x-1/2 top-full mt-3 w-[920px] bg-white rounded-card shadow-[0_24px_48px_-24px_rgba(15,23,42,0.22)] border border-border p-6 grid grid-cols-[1fr_1fr_1fr_240px] gap-6 z-50"
            >
              <ProgramMenuCategory category={makananMenu} />
              <ProgramMenuCategory category={bantuanMenu} />
              <ProgramMenuCategory category={pendidikanMenu} />
              <div class="bg-gray-50 rounded-card overflow-hidden self-start">
                <Image src={programPromoImage} alt="Relawan bagiberbagi.id menyalurkan bantuan langsung ke masyarakat" width={480} height={300} class="w-full h-28 object-cover" />
                <div class="p-4">
                  <div class="font-bold text-title-sm mb-1.5">Peduli Lewat Makanan</div>
                  <p class="text-body-sm text-muted leading-relaxed mb-3.5">Setiap donasi makanan yang Anda berikan, kami salurkan langsung kepada mereka yang membutuhkan dengan transparan dan terdokumentasi.</p>
                  <a href="/jumat-berkah" class="btn-primary btn-sm text-center block">Lihat Program</a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            aria-current={navActive(link) ? 'page' : undefined}
            class:list={['transition-colors hover:text-brand-blue', navActive(link) ? 'font-bold text-ink' : 'font-medium text-muted']}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>
    <a
      href="/#donasi"
      class="hidden nav:inline-block btn-primary whitespace-nowrap"
    >
      Donasi Sekarang
    </a>

    <button
      id="nav-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      class="nav:hidden bg-gray-50 border-0 w-11 h-11 rounded-xl flex items-center justify-center text-ink"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
    </button>
  </div>

  <nav id="mobile-nav-panel" class="hidden nav:hidden flex-col gap-0.5 px-5 md:px-10 pb-5 pt-2 border-t border-border">
    {NAV_LINKS.map((link) => (
      link.id === 'program' ? (
        <div data-program-menu-mobile>
          <button
            type="button"
            data-program-trigger-mobile
            aria-expanded="false"
            aria-controls="mobile-program-panel"
            class="w-full flex items-center justify-between px-1 py-3 font-medium text-muted"
          >
            {link.label}
            <svg aria-hidden="true" data-program-chevron-mobile width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <div id="mobile-program-panel" data-program-panel-mobile class="hidden flex-col gap-6 pl-3 pb-3">
            {PROGRAM_MENU.map((cat) => (
              <ProgramMenuCategory category={cat} iconSize={14} />
            ))}
            <a href="/jumat-berkah" class="btn-primary btn-sm text-center">Lihat Program Jumat Berkah</a>
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          aria-current={navActive(link) ? 'page' : undefined}
          class:list={['px-1 py-3', navActive(link) ? 'font-bold text-ink' : 'font-medium text-muted']}
        >{link.label}</a>
      )
    ))}
    <a href="/#donasi" class="mt-2 btn-primary text-center">
      Donasi Sekarang
    </a>
  </nav>
</header>

<script>
  import '../scripts/mobile-nav.js';
  import '../scripts/program-menu.js';
</script>
