---
import DonationCalculator from './DonationCalculator.astro';
import Container from './Container.astro';
import { getEntry } from 'astro:content';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
// Jadwal program dari Keystatic menyetir target hitung mundur (bukan hardcode).
const schedule = site.data.schedule;
---

{/* Foto lapangan + overlay kuning kini hidup di wrapper zona (index.astro) yang
    dibagi bersama Stats — section ini transparan agar background tembus. */}
<section class="relative pt-8 md:pt-16 pb-6 md:pb-10">
  <Container width="wide" class="relative flex flex-wrap gap-12 items-center">
    <div class="flex-1 basis-[440px] min-w-[280px]">
      <div class="eyebrow">Program Perdana Jumat Berkah</div>
      <h1 class="text-heading-lg md:text-display-lg leading-[1.08] font-semibold mb-5 text-ink">
        Kamu berbagi, <span class="text-brand-orange">kami yang membagi.</span>
      </h1>
      <p class="text-base md:text-lg leading-relaxed text-muted max-w-[520px] mb-7">
        Sedekah Jumat kamu kami masak lewat UMKM lokal, lalu antar langsung ke jamaah, petugas kebersihan, dan panti asuhan. Dokumentasinya balik ke kamu maksimal H+1.
      </p>
      <div class="flex flex-wrap gap-4 mb-7">
        <a href="#cara-kerja" class="group text-brand-blue font-bold text-base inline-flex items-center gap-2">
          Lihat Cara Kerjanya
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><path d="M9 6l6 6-6 6"></path></svg>
        </a>
      </div>
      {/* Chip hitung mundur ke Jumat Berkah berikutnya (Jumat 06:00). Pill gelap
          khas hero: badge "JUMAT BERKAH BERIKUTNYA", lalu empat segmen angka tebal
          (opsi B) sebagai elemen dinamisnya. countdown.js mengisi tiap segmen dan
          meredupkan unit nol di depan (class .jb-dim) agar fokus ke waktu tersisa. */}
      <div
        class="inline-flex items-center gap-2.5 bg-ink pl-2 pr-4 py-1.5 rounded-full font-semibold text-white shadow-pill"
        data-jb-weekday={schedule.weekday}
        data-jb-time={schedule.time}
      >
        <span class="bg-brand-orange/25 text-brand-yellow text-micro font-bold tracking-wide uppercase px-2.5 py-1 rounded-full">Jumat Berkah Berikutnya</span>
        <span class="inline-flex items-baseline gap-1.5 text-[13px] text-white/70">
          <span class="jb-unit"><b id="jb-d" class="text-title-sm font-bold text-brand-yellow tabular-nums">00</b>hari</span>
          <span class="jb-unit"><b id="jb-h" class="text-title-sm font-bold text-brand-yellow tabular-nums">00</b>jam</span>
          <span class="jb-unit"><b id="jb-m" class="text-title-sm font-bold text-brand-yellow tabular-nums">00</b>mnt</span>
          <span class="jb-unit"><b id="jb-s" class="text-title-sm font-bold text-brand-yellow tabular-nums">00</b>dtk</span>
        </span>
      </div>
    </div>

    <DonationCalculator />
  </Container>
</section>

<style>
  /* Tiap segmen unit countdown. Unit nol di depan diberi .jb-dim oleh countdown.js
     supaya meredup dan mata fokus ke waktu yang benar-benar tersisa. */
  .jb-unit {
    transition: opacity 0.3s ease;
  }
  .jb-dim {
    opacity: 0.3;
  }
  @media (prefers-reduced-motion: reduce) {
    .jb-unit {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/countdown.js';
</script>
