---
import { STEPS } from '../consts';
---

<section id="cara-kerja" class="section bg-gray-50 scroll-mt-24">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow">CARA KERJA</div>
      <h2 class="text-heading-sm md:text-heading-lg font-extrabold tracking-tight">Lima Langkah Menciptakan Dampak</h2>
    </div>

    {/* Timeline tersambung — garis menegaskan urutan langkah. Horizontal di
        desktop, tumpuk vertikal di mobile. Nomor sudah urutan nyata (01–05). */}
    <ol class="grid gap-8 md:grid-cols-5 md:gap-3">
      {STEPS.map((s, i) => (
        <li class="relative md:text-center before:content-[''] before:absolute before:hidden md:before:block before:top-[19px] before:right-1/2 before:w-[calc(100%+0.75rem)] before:h-0.5 before:bg-border first:before:hidden">
          <div class="flex items-center gap-4 md:block">
            <span class:list={['relative z-10 flex-none w-10 h-10 rounded-full flex items-center justify-center text-white font-extrabold tabular-nums md:mx-auto', i % 2 === 0 ? 'bg-brand-orange' : 'bg-brand-blue']}>{s.n}</span>
            <div class="md:mt-4">
              <h3 class="text-title-sm font-extrabold mb-1 md:mb-1.5">{s.title}</h3>
              <p class="text-body-sm text-muted leading-relaxed md:px-1">{s.desc}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
