---
import Icon from './Icon.astro';
import { IMPACTS } from '../consts';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waLaporanLink = buildWaLink(site.data.waNumber, 'Halo, saya ingin melihat laporan penyaluran Jumat Berkah.');
---

<section class="section bg-brand-blue text-white">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow text-brand-yellow">Dampak Berputar</div>
      <h2 class="text-heading-sm md:text-heading-lg font-extrabold tracking-tight mb-4">Satu paket, dampak yang berputar.</h2>
      <p class="text-base leading-relaxed text-white/85">
        Donasi kamu tidak berhenti di satu tangan. Tiap paket Jumat Berkah menggerakkan rantai sosial-ekonomi di lingkungan tempat ia disalurkan.
      </p>
    </div>

    {/* Cascade: satu donasi (seed) memancar ke empat dampak. Seed diberi halo
        (ring+glow), konektor berbentuk kipas 1→4 menegaskan "berganda", dan tiap
        dampak jadi kartu kaca dengan chip ikon kuning — benang warna dari seed
        menyatukan section. */}
    <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-7">
      <div class="flex-none mx-auto lg:mx-0 w-32 h-32 md:w-36 md:h-36 rounded-full bg-brand-yellow text-ink flex flex-col items-center justify-center text-center ring-8 ring-brand-yellow/15 shadow-[0_24px_60px_-20px_rgba(255,217,0,0.55)]">
        <span class="text-eyebrow font-bold uppercase tracking-wide text-ink/55">mulai</span>
        <span class="text-title font-extrabold leading-tight mt-0.5">Satu<br />Donasi</span>
      </div>

      {/* Konektor: kipas 1→4 di desktop, panah turun di mobile. */}
      <div aria-hidden="true" class="flex-none self-center text-brand-yellow/55">
        <svg class="hidden lg:block" width="42" height="152" viewBox="0 0 42 152" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="4" cy="76" r="3.2" fill="currentColor" stroke="none"></circle>
          <path d="M4 76h11"></path>
          <path d="M15 76C28 76 27 22 40 22"></path>
          <path d="M15 76C28 76 28 58 40 58"></path>
          <path d="M15 76C28 76 28 94 40 94"></path>
          <path d="M15 76C28 76 27 130 40 130"></path>
        </svg>
        <svg class="lg:hidden mx-auto" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
      </div>

      <div class="flex-1 grid gap-4 sm:grid-cols-2">
        {IMPACTS.map((im) => (
          <div class="flex gap-4 rounded-2xl bg-white/[0.06] border border-white/10 p-4 md:p-5 transition-colors hover:bg-white/[0.1]" data-fade="1">
            <span class="w-11 h-11 rounded-xl bg-brand-yellow/15 flex items-center justify-center flex-none">
              <Icon name={im.icon} color="#FFD900" size={20} />
            </span>
            <div>
              <h3 class="text-title-sm font-bold mb-1">{im.title}</h3>
              <p class="text-body-sm leading-snug text-white/75">{im.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Penutup: rule kuning pendek terpusat (aksen dekoratif, bukan garis
        full-width yang motong) + kalimat intisari. */}
    <div class="mt-12 text-center">
      <div class="w-11 h-0.75 rounded bg-brand-yellow/85 mx-auto mb-4"></div>
      <p class="max-w-150 mx-auto text-body-sm leading-relaxed text-white/90">
        <strong class="text-white">Ekonomi kebaikan yang berputar lokal.</strong> Dana donatur dibelanjakan ke UMKM setempat, dikerjakan warga setempat, dinikmati mustahik setempat. Berkahnya tinggal di lingkungan itu.
      </p>
      {/* Kaitan tipis ke halaman laporan, bukan blok CTA. Masih dalam konteks
          Dampak Berputar. Target sementara WA sampai halaman laporan ada. */}
      <a href={waLaporanLink} target="_blank" rel="noopener" data-track="laporan_click" data-track-source="impact_penutup" class="inline-flex items-center gap-1.5 mt-5 text-brand-yellow font-bold text-body-sm hover:gap-2.5 transition-[gap]">
        Lihat laporan penyaluran
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>
