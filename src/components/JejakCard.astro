---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatMetric } from '../lib/format';
import type { Jejak } from '../lib/jejak';
import type { Pintu } from '../consts';

export interface Props {
  jejak: Jejak;
  /** Pintu induk (lewat program). Opsional karena relasi bisa belum terpetakan. */
  pintu?: Pintu;
  /**
   * wide    = kartu unggulan lebar, dua kolom di md+ (foto sejajar isi).
   * stack   = kartu setara, foto menumpuk di atas isi, isi lengkap + tautan.
   * compact = kartu grid ringkas (tanpa summary, tanpa tautan).
   * Satu markup untuk tiga mode feed supaya kartu tak diduplikasi per mode.
   */
  variant: 'wide' | 'stack' | 'compact';
  /** Badge "Terbaru" hanya benar saat kartu ini memang unggulan di feed panjang. */
  featured?: boolean;
  /** Kartu pertama saja: cover-nya di atas fold, jadi tak perlu di-lazy. */
  eager?: boolean;
  /**
   * Tingkat heading judul kartu. Turun ke 4 saat feed pemanggil menyisipkan
   * heading grup (mis. heading bulan di arsip /jejak) yang sudah memakai h3,
   * supaya urutan h2 -> h3 -> h4 tak melompat.
   */
  titleLevel?: 3 | 4;
  /**
   * Label organisasi yang menggerakkan kegiatan ini, kalau ada. Sengaja label
   * mentah, bukan objek ber-href: akar kartu ini sudah `<a>`, jadi tautan di
   * dalamnya akan jadi anchor bersarang yang tak valid. Pemanggil yang butuh
   * tautan ke organisasi memakainya di halaman detail, bukan di kartu.
   *
   * Dikosongkan saat kartu tampil DI halaman organisasi itu sendiri: di sana
   * atribusinya mubazir, seluruh halaman sudah tentang organisasi tersebut.
   */
  organisasiLabel?: string;
}

const { jejak, pintu, variant, featured = false, eager = false, titleLevel = 3, organisasiLabel } = Astro.props;

// Fallback oranye brand supaya --cat selalu terisi: kartu tetap punya aksen
// walau relasi pintu-nya belum ketemu. Warna datang dari data, tak di-hardcode
// per pintu.
const color = pintu?.color ?? '#F4791D';
const tint = pintu?.colorTint ?? '#FDEEE1';

const isWide = variant === 'wide';
const isCompact = variant === 'compact';
const metrics = jejak.metrics.slice(0, 3);

// Chip metrik cuma selebar sepertiga kartu, jadi nilai panjang (mis.
// "Rp 5.500.000") membungkus jadi 2 baris dan tinggi kartu antar jejak jadi tak
// seragam. Sizing sadar-panjang: string lebih dari 8 karakter turun satu tingkat
// ukuran dan dipaksa satu baris, yang pendek tetap ukuran sekarang.
const numClass = (s: string) => (s.length > 8 ? 'text-body-sm whitespace-nowrap' : 'text-title-sm');

// Kartu compact cuma sepertiga grid 3 kolom (sekitar 301px di lebar Container
// `standard`), jadi satu chip hanya menyisakan ~65px untuk angkanya, sementara
// "Rp 2.500.000" butuh ~89px dan meluber keluar kotak. Mengecilkan font tak
// menyelesaikan: di 12px pun angkanya masih lebih lebar dari chip, dan ukuran
// segitu sudah tak terbaca. Jadi chip-nya yang dilebarkan, cuma saat memang ada
// nilai panjang: dua kolom, dan chip terakhir mengisi sisa baris kalau jumlah
// metriknya ganjil supaya tak ada sel bolong. Varian lain (wide/stack) chip-nya
// sudah >110px, tetap 3 kolom.
const hasLongMetric = metrics.some((m) => formatMetric(m).length > 8);
const metricCols = isCompact && hasLongMetric ? 'grid-cols-2' : 'grid-cols-3';
const spanLastMetric = isCompact && hasLongMetric && metrics.length % 2 === 1;

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

// `[&[hidden]]:hidden` menjaga kontrak filter: script menyembunyikan kartu lewat
// atribut `hidden`, tapi utility display (grid/flex) menimpa default UA sheet.
// Selector class+atribut ini menang tanpa bergantung urutan CSS.
const rootClass = isWide
  ? 'group grid overflow-hidden rounded-card border border-border bg-white shadow-cardSm transition-shadow hover:shadow-card md:grid-cols-2 [&[hidden]]:hidden'
  : 'group flex flex-col overflow-hidden rounded-card border border-border bg-white shadow-cardSm transition-transform hover:-translate-y-1 [&[hidden]]:hidden';

const bodyClass = isWide ? 'flex flex-col p-6 md:p-8' : isCompact ? 'flex flex-1 flex-col p-5' : 'flex flex-1 flex-col p-6';
const titleClass = isWide
  ? 'text-title md:text-heading-sm font-semibold text-ink leading-snug mb-2.5 group-hover:text-brand-orange transition-colors'
  : isCompact
    ? 'text-title-sm font-semibold text-ink leading-snug mb-4 group-hover:text-brand-orange transition-colors'
    : 'text-title font-semibold text-ink leading-snug mb-2.5 group-hover:text-brand-orange transition-colors';

// Lebar render cover berbeda jauh antar varian, jadi `sizes` tak boleh seragam:
// tanpa ini browser mengunduh berkas selebar kartu unggulan untuk kartu grid
// yang cuma sepertiga lebarnya. Angkanya diturunkan dari isi Container tier
// `standard` di /jejak (1024 dikurangi padding md:px-10 = 944px), dikurangi gap
// grid feed:
//   wide    -> kolom foto = separuh grid 2 kolom kartu (tanpa gap), ~472px
//   stack   -> kartu mode "pair", separuh grid 2 kolom gap-5, ~462px
//   compact -> sepertiga grid 3 kolom gap-5, ~301px di lg+
// Di antara md dan lg kontainer masih ikut lebar layar, jadi ada langkah vw
// sebelum angka tetapnya. Lebar terbesar dipilih dua kali lebar render supaya
// layar 2x DPR tetap tajam.
const coverSizes = isWide
  ? '(min-width: 1024px) 472px, (min-width: 768px) 50vw, 100vw'
  : isCompact
    ? '(min-width: 1024px) 301px, (min-width: 640px) 50vw, 100vw'
    : '(min-width: 1024px) 462px, (min-width: 768px) 50vw, 100vw';
const coverWidths = isCompact ? [240, 301, 460, 602] : [360, 472, 700, 944];

// Narrowing untuk template: properti opsional di dalam ternary bersarang tak
// dipersempit otomatis oleh TypeScript.
const cover = jejak.cover;

const placeholderBadge = isWide ? 'w-16 h-16' : 'w-14 h-14';
const placeholderIcon = isWide ? 30 : 26;
const placeholderBg =
  'background:linear-gradient(135deg, color-mix(in srgb, var(--cat) 16%, #fff), color-mix(in srgb, var(--cat) 6%, #fff))';
---

<a
  href={jejak.href}
  data-jcard
  data-pintu={pintu?.slug}
  data-track="jejak_click"
  data-track-jejak={jejak.slug}
  style={`--cat:${color}`}
  class={rootClass}
>
  {cover ? (
    isWide ? (
      /* Aspect-ratio dipakai di mobile; di md+ dilepas agar sel grid ikut
         tinggi kolom isi (foto di-crop lewat object-cover). */
      <div class="relative w-full aspect-[16/10] md:aspect-auto bg-gray-100">
        <Image
          src={cover}
          alt=""
          widths={coverWidths}
          sizes={coverSizes}
          loading={eager ? 'eager' : 'lazy'}
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    ) : (
      <Image
        src={cover}
        alt=""
        widths={coverWidths}
        sizes={coverSizes}
        loading={eager ? 'eager' : 'lazy'}
        class="aspect-[16/10] w-full object-cover"
      />
    )
  ) : (
    <div
      class:list={['w-full flex items-center justify-center', isWide ? 'aspect-[16/10] md:aspect-auto' : 'aspect-[16/10]']}
      style={placeholderBg}
    >
      {pintu && (
        <span class:list={['rounded-2xl bg-white flex items-center justify-center shadow-cardSm', placeholderBadge]} style="color:var(--cat)">
          <Icon name={pintu.icon} size={placeholderIcon} />
        </span>
      )}
    </div>
  )}

  <div class={bodyClass}>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      {pintu && (
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-micro font-bold uppercase tracking-wide" style={`color:var(--cat);background:${tint}`}>
          <span class="w-1.5 h-1.5 rounded-full" style="background:var(--cat)"></span>
          {pintu.label}
        </span>
      )}
      {featured && (
        <span class="rounded-full bg-gray-100 px-2.5 py-1 text-micro font-bold uppercase tracking-wide text-muted">Terbaru</span>
      )}
    </div>

    <div class="text-micro font-semibold text-muted mb-2">
      {fmtDate(jejak.date)} &middot; {jejak.location}
      {organisasiLabel && (
        <>
          <span aria-hidden="true" class="text-gray-300 mx-1">&middot;</span>
          <span class="text-ink">bersama {organisasiLabel}</span>
        </>
      )}
    </div>
    {/* Tag ditulis eksplisit, bukan lewat variabel tag dinamis: nama komponen
        berhuruf besar yang isinya string bikin inferensi tipe sisa template ini
        runtuh (metrics.map jadi implicit any). Dua cabang lebih murah. */}
    {titleLevel === 4 ? (
      <h4 class={titleClass}>{jejak.title}</h4>
    ) : (
      <h3 class={titleClass}>{jejak.title}</h3>
    )}
    {!isCompact && <p class="text-body-sm text-muted leading-relaxed mb-5">{jejak.summary}</p>}

    {metrics.length > 0 && (
      <div class:list={['grid gap-2', metricCols, isCompact ? 'mt-auto' : 'mb-5']}>
        {metrics.map((m, i) => {
          const value = formatMetric(m);
          return (
            /* Label boleh 2 baris (truncate dulu memotong jadi "donasi tersa..."):
               chip tetap rata tinggi karena sel grid saling stretch. */
            <div
              class:list={[
                'flex h-full flex-col rounded-xl bg-gray-50 px-2 py-2.5 text-center',
                spanLastMetric && i === metrics.length - 1 && 'col-span-2',
              ]}
            >
              <div class:list={['font-bold tabular-nums leading-none', numClass(value)]} style="color:var(--cat)">{value}</div>
              <div class="text-micro text-muted leading-tight mt-1 line-clamp-2">{m.label}</div>
            </div>
          );
        })}
      </div>
    )}

    {!isCompact && (
      <span class="mt-auto inline-flex items-center gap-1.5 font-bold text-body-sm" style="color:var(--cat)">
        Lihat dokumentasi lengkap
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      </span>
    )}
  </div>
</a>
