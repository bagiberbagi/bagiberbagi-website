---
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waMitraLink = buildWaLink(site.data.waNumber, 'Halo, saya tertarik untuk bergabung sebagai Mitra Dapur UMKM di bagiberbagi.id.');
const waCsrLink = buildWaLink(site.data.waNumber, 'Halo, kami tertarik menjalankan program CSR Korporasi bersama bagiberbagi.id.');

const mitraBenefits = [
  'Order berulang & bayar tepat waktu',
  'Pendampingan sertifikasi higiene',
  'Branding usaha di laporan donatur',
];
const csrBenefits = [
  'Laporan dampak profesional & video',
  'Branding perusahaan pada kemasan',
  'Skala fleksibel sesuai kebutuhan',
];
---

{/* Seksi SEKUNDER di LUAR narasi donatur (jalan korporat/mitra). Karena bukan
    bagian busur donatur, ia TIDAK memakai warna biru narasi dan TIDAK memegang
    radius bind (radius bind = penutup narasi, ada di FAQ di atas). Ground netral
    putih; identitas visual datang dari dua kartu (orange + slate) di dalamnya. */}
<section id="tentang" class="section bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-10">
      <div class="eyebrow">BERGABUNG LEBIH JAUH</div>
      <h2 class="text-heading-sm md:text-heading-lg font-bold mb-3 text-ink">Bangun Dampak Bersama</h2>
      <p class="text-muted text-base leading-relaxed">
        Tidak hanya sebagai donatur. Kamu juga bisa menggerakkan ekosistem kebaikan dari sisi lain, jadi mitra dapur atau lewat program korporasi.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {/* Mitra — kartu orange (pop hangat, hero) */}
      <div class="relative overflow-hidden rounded-card bg-brand-orange text-white p-7 md:p-8 shadow-[0_22px_44px_-26px_rgba(11,30,77,0.55)]" data-fade="1">
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_88%_-10%,rgba(255,255,255,0.22),transparent_60%)]"></span>
        <span aria-hidden="true" class="pointer-events-none absolute -right-16 -bottom-20 w-56 h-56 rounded-full bg-white/[0.07]"></span>
        <div class="relative">
          <div class="w-[52px] h-[52px] rounded-2xl bg-white/15 flex items-center justify-center mb-5 text-white">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M9 21v-6M15 21v-6M6 10a4 4 0 0 1 3-6.8A4 4 0 0 1 12 2a4 4 0 0 1 3 1.2A4 4 0 0 1 18 10c0 2-1 3-2 4H8c-1-1-2-2-2-4Z"></path></svg>
          </div>
          <div class="text-micro font-bold uppercase tracking-wide text-white/65 mb-1">Untuk UMKM</div>
          <h3 class="text-title font-bold mb-2">Jadi Mitra Dapur UMKM</h3>
          <p class="text-white/80 text-body-sm leading-relaxed mb-4">Dapatkan order pasti setiap minggu. Kami bantu standar higiene dan kemasan. Kamu fokus memasak.</p>
          <ul class="flex flex-col gap-2.5 mb-6">
            {mitraBenefits.map((b) => (
              <li class="flex gap-2 text-body-sm text-white/85">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="flex-none mt-0.5 text-brand-yellow"><path d="M5 13l4 4L19 7"></path></svg>
                {b}
              </li>
            ))}
          </ul>
          <a href={waMitraLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-bold text-white border-b-2 border-white/45 pb-1 hover:border-white transition-colors">
            Jadi Mitra Dapur UMKM
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>

      {/* CSR — kartu gelap ink, seragam dgn chip countdown (satu keluarga gelap,
          bukan slate liar tersendiri). */}
      <div class="relative overflow-hidden rounded-card bg-ink text-white p-7 md:p-8 shadow-[0_22px_44px_-26px_rgba(15,23,42,0.6)]" data-fade="1">
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_88%_-10%,rgba(255,255,255,0.16),transparent_60%)]"></span>
        <span aria-hidden="true" class="pointer-events-none absolute -right-16 -bottom-20 w-56 h-56 rounded-full bg-white/[0.06]"></span>
        <div class="relative">
          <div class="w-[52px] h-[52px] rounded-2xl bg-white/14 flex items-center justify-center mb-5 text-white">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"></rect><path d="M9 8h.01M9 12h.01M9 16h.01M15 8h.01M15 12h.01M15 16h.01"></path></svg>
          </div>
          <div class="text-micro font-bold uppercase tracking-wide text-white/65 mb-1">Untuk Perusahaan</div>
          <h3 class="text-title font-bold mb-2">CSR Korporasi</h3>
          <p class="text-white/80 text-body-sm leading-relaxed mb-4">Jalankan program Jumat Berkah atas nama perusahaan. Kami yang jalankan dari dapur sampai laporan.</p>
          <ul class="flex flex-col gap-2.5 mb-6">
            {csrBenefits.map((b) => (
              <li class="flex gap-2 text-body-sm text-white/85">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="flex-none mt-0.5 text-brand-yellow"><path d="M5 13l4 4L19 7"></path></svg>
                {b}
              </li>
            ))}
          </ul>
          <a href={waCsrLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-bold text-white border-b-2 border-white/45 pb-1 hover:border-white transition-colors">
            Jalankan CSR Korporasi
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
