---
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waLaporanLink = buildWaLink(site.data.waNumber, 'Halo, saya ingin melihat laporan penyaluran Jumat Berkah.');
---

<section class="section">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto">
      <div class="eyebrow">Laporan Penyaluran</div>
      <h2 class="text-heading-sm md:text-heading-lg font-extrabold tracking-tight mb-4">Lihat sendiri ke mana donasi mengalir.</h2>
      <p class="text-muted text-base leading-relaxed mb-8">
        Tiap distribusi Jumat kami catat: jumlah pax, titik penyaluran, UMKM yang memasak, plus foto dan video dari lapangan.
      </p>
      <a href={waLaporanLink} target="_blank" rel="noopener" data-track="laporan_click" data-track-source="laporan_section" class="btn-primary">Buka Laporan Penyaluran</a>
    </div>
  </div>
</section>
