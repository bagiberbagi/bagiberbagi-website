---
import Icon from './Icon.astro';
import { PILLARS } from '../consts';
---

<section id="pilar" class="section scroll-mt-24">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow">PILAR KAMI</div>
      <h2 class="text-heading-sm md:text-heading-lg font-extrabold tracking-tight mb-4">Enam Pilar Berbagi</h2>
      <p class="text-base leading-relaxed text-muted">
        Enam sumber daya yang kami pegang dan salurkan untuk komunitas, sekolah, panti, sampai UMKM. Uang hanya satu di antaranya.
      </p>
    </div>

    <div class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {PILLARS.map((pillar, i) => (
        <div class="h-full rounded-card border border-border bg-white p-6 flex flex-col transition-all hover:shadow-[0_20px_40px_-24px_rgba(15,23,42,0.22)] hover:border-brand-orange/30">
          <span
            class:list={[
              'w-12 h-12 rounded-xl flex items-center justify-center flex-none mb-5',
              i % 2 === 0 ? 'bg-brand-orangeTint text-brand-orange' : 'bg-brand-blueTint text-brand-blue',
            ]}
          >
            <Icon name={pillar.icon} size={22} />
          </span>
          <h3 class="text-title-sm font-bold mb-1">{pillar.label}</h3>
          <div class="eyebrow text-muted mb-3">{pillar.english}</div>
          <p class="text-sm text-muted leading-relaxed">{pillar.tagline}</p>
        </div>
      ))}
    </div>
  </div>
</section>
