---
import Icon from './Icon.astro';
import type { ProgramMenuCategoryData } from '../consts';

export interface Props {
  category: ProgramMenuCategoryData;
  iconSize?: number;
  /**
   * `card` = kartu bertumpuk untuk grid mega-menu desktop, yang punya enam sel
   * berdampingan dan ruang untuk tagline.
   *
   * `row` = baris ringkas untuk panel nav mobile. Di sana keenam pintu berdiri
   * satu kolom, dan bentuk kartu membuat submenu jadi 936px tinggi cuma untuk
   * daftar enam tujuan. Baris menyisakan ikon, nama, dan statusnya — persis apa
   * yang dipakai orang untuk memilih tujuan — dan taglinenya diserahkan ke
   * halaman pintu yang dituju, tempat kalimat itu memang jadi kalimat pembuka.
   */
  variant?: 'card' | 'row';
}

const { category, variant = 'card', iconSize = variant === 'row' ? 16 : 19 } = Astro.props;

// Pintu aktif kalau minimal satu program di dalamnya aktif.
const isActive = category.items.some((i) => i.active);
---

{variant === 'row' ? (
  <a
    href={category.href}
    data-track="menu_category"
    data-track-category={category.label}
    class="group flex items-center gap-2.5 rounded-xl border border-border bg-white px-2.5 py-2 transition-colors hover:border-[var(--cat)] hover:bg-[var(--cat-tint)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)]"
    style={`--cat:${category.color};--cat-tint:${category.colorTint}`}
  >
    <span class="w-8 h-8 flex-none rounded-lg bg-[var(--cat-tint)] text-[var(--cat)] grid place-items-center transition-colors group-hover:bg-white">
      <Icon name={category.icon} size={iconSize} />
    </span>

    <span class="min-w-0 flex-1 font-bold text-body-sm text-ink transition-colors group-hover:text-[var(--cat)]">
      {category.label}
    </span>

    <span
      class:list={[
        'flex-none inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider',
        isActive ? 'text-[var(--cat)]' : 'text-gray-400',
      ]}
    >
      <span
        class:list={[
          'w-1.5 h-1.5 rounded-full',
          isActive ? 'bg-[var(--cat)]' : 'bg-gray-300',
        ]}
      ></span>
      {isActive ? 'Aktif' : 'Segera'}
    </span>
  </a>
) : (
<a
  href={category.href}
  data-track="menu_category"
  data-track-category={category.label}
  class="group flex flex-col rounded-xl border border-border bg-white p-3 transition-all hover:border-[var(--cat)] hover:bg-[var(--cat-tint)] hover:shadow-cardSm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)] focus-visible:ring-offset-2"
  style={`--cat:${category.color};--cat-tint:${category.colorTint}`}
>
  <span class="w-9 h-9 rounded-lg bg-[var(--cat-tint)] text-[var(--cat)] grid place-items-center mb-2.5 transition-colors group-hover:bg-white">
    <Icon name={category.icon} size={iconSize} />
  </span>

  <span class="flex items-center gap-1 font-bold text-sm text-ink transition-colors group-hover:text-[var(--cat)]">
    {category.label}
    <svg
      aria-hidden="true"
      class="ml-auto flex-none opacity-0 -translate-x-1 transition-all group-hover:opacity-100 group-hover:translate-x-0"
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M9 6l6 6-6 6"></path>
    </svg>
  </span>

  <span class="flex-1 text-xs text-muted leading-snug mt-1.5">{category.tagline}</span>

  <span
    class:list={[
      'inline-flex items-center gap-1.5 mt-2.5 text-[10px] font-bold uppercase tracking-wider',
      isActive ? 'text-[var(--cat)]' : 'text-gray-400',
    ]}
  >
    <span
      class:list={[
        'w-1.5 h-1.5 rounded-full',
        isActive ? 'bg-[var(--cat)]' : 'bg-gray-300',
      ]}
    ></span>
    {isActive ? 'Aktif' : 'Segera'}
  </span>
</a>
)}
