---
import Icon from './Icon.astro';
import type { ProgramMenuCategory as ProgramMenuCategoryType } from '../consts';

export interface Props {
  category: ProgramMenuCategoryType;
  iconSize?: number;
}

const { category, iconSize = 16 } = Astro.props;
---

<div>
  <div class="flex items-center gap-2.5 mb-3 pb-2.5 border-b border-border">
    <span class="w-7 h-7 rounded-lg bg-brand-blueTint text-brand-blue flex items-center justify-center flex-none">
      <Icon name={category.icon} size={iconSize} />
    </span>
    <span class="text-brand-blue font-bold text-eyebrow">{category.label}</span>
  </div>
  <div class="flex flex-col gap-0.5">
    {category.items.map((item) => (
      item.active && item.href ? (
        <a href={item.href} class="group block rounded-lg px-2 py-2 hover:bg-gray-50 transition-colors">
          <div class="text-sm font-bold text-ink group-hover:text-brand-blue transition-colors">{item.label}</div>
          <p class="text-xs text-muted leading-relaxed mt-0.5">{item.desc}</p>
        </a>
      ) : (
        <div class="px-2 py-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-sm font-bold text-ink/60">{item.label}</span>
            <span class="badge-coming-soon">Segera Hadir</span>
          </div>
          <p class="text-xs text-muted leading-relaxed mt-0.5">{item.desc}</p>
        </div>
      )
    ))}
  </div>
</div>
