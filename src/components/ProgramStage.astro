---
// "Panggung Bergilir": one full-bleed photo band that cycles through the active
// food programs, one slide each. It replaces WhyFood.astro and absorbs it whole:
// slide 1 carries that section's kicker, h2, lead, and closing pill word for
// word, so the homepage keeps the single big photo moment it already had while
// the three remaining programs finally get a face.
//
// Full-bleed, so no Container. The inner wrapper is locked to 80rem, the same
// value as tier `wide`, so its left edge stays flush with every other homepage
// section. Styling is bespoke scoped CSS rather than Tailwind utilities because
// the markup nests too deep for utilities to stay readable (same reasoning as
// the WhyFood component it replaces).
//
// Motion is pure CSS scroll-snap. Chips and arrows are real anchors pointing at
// slide ids, every slide is server-rendered, and nothing is hidden behind JS:
// with scripting off the whole section still reads and every control still
// moves the band. A timer advances it on top of that, and it lives entirely in
// program-stage.js, so scripting off costs navigation nothing.
//
// Nothing here is hand-written copy. Every slide reads its own words from the
// `stage` object on its program entry, slide 1 reads the section's own words
// from the `home` singleton, and the photo plus the dormant treatment are
// derived from what the data actually holds. There is no per-slug record in
// this file on purpose: an owner changing one sentence must never need a
// developer.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getPrograms, getProgramCover } from '../lib/programs';
import { getProgramStageIntro } from '../lib/home';
import { buildWaLink } from '../lib/format';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waNumber = site.data.waNumber;

const intro = await getProgramStageIntro();

// Every active program becomes a slide, and what it looks like follows from its
// data alone: a program with a cover of its own shows it, and one without has
// nothing to document yet, so it takes the shared stand-in behind a grey wash
// and says what it is waiting for.
//
// `getProgramCover` is the single answer to "what does this program look like",
// shared with the hero donation card, the program page, and the jejak CTA, so
// this band cannot drift into showing a different face from the rest of the
// site. An earlier version of this component slipped a third layer in between,
// falling back to the newest jejak cover before the stand-in. That is the same
// chain `programs.ts` tried and removed: "newest" is a date order rather than a
// choice, so it promoted whichever frame happened to be latest to be the face
// of the program, and changed that face again on every new jejak.
//
// The same test decides the running order. Programs carrying a cover come first
// and the ones still waiting sink to the back, so the band opens on its
// strongest evidence and the grey slides land at the end where they read as
// what is coming rather than as a gap in the middle of the run. Sorting happens
// before the second map because `index` there decides both the counter and
// which slide inherits the h2. `sort` is stable, so inside each group the
// collection's own `order` still decides.
const programs = await getPrograms();
const slides = programs
  .filter((program) => program.active)
  .map((program) => {
    const stage = program.stage;
    const photo = getProgramCover(program);
    const dormant = program.image === null;
    const alt = dormant
      ? `Foto ilustrasi untuk program ${program.label}`
      : `Dokumentasi program ${program.label}`;

    return {
      slug: program.slug,
      label: program.label,
      summary: program.summary,
      stage,
      photo,
      alt,
      dormant,
      // A status line only tells the truth while the program has nothing to
      // show, so it is tied to the same test as the grey treatment instead of
      // to a switch an editor could leave stale.
      status: dormant ? stage.status.trim() : '',
      caption: stage.caption.trim(),
      ctaLabel: stage.ctaLabel.trim() || 'Lihat program',
      whatsapp: stage.ctaWhatsapp,
      href: stage.ctaWhatsapp
        ? buildWaLink(waNumber, stage.ctaMessage.trim())
        : (program.href ?? '/berbagi-makanan/'),
    };
  })
  .sort((a, b) => Number(a.dormant) - Number(b.dormant))
  .map((slide, index) => {
    // Slide 1 inherits the h2 slot the old WhyFood section held, and it carries
    // that section's words too, which belong to the homepage rather than to
    // whichever program happens to lead. The rest are h3, so the heading order
    // on the homepage never skips a level.
    const isLead = index === 0;
    return {
      ...slide,
      isLead,
      kicker: (isLead ? intro.kicker || slide.stage.kicker : slide.stage.kicker).trim(),
      heading: (isLead ? intro.title || slide.label : slide.label).trim(),
      lead: (isLead ? intro.lead || slide.stage.lead || slide.summary : slide.stage.lead || slide.summary).trim(),
      // The closing pill belongs to slide 1 only, and only while the homepage
      // actually has a sentence for it.
      statement: isLead ? intro.statement.trim() : '',
      domId: `stage-${slide.slug}`,
      number: String(index + 1).padStart(2, '0'),
    };
  });

const total = String(slides.length).padStart(2, '0');
const idAt = (index: number) => slides[(index + slides.length) % slides.length].domId;
---

{slides.length > 0 && (
  <section class="pstage" data-stage aria-labelledby="stage-title">
    <div class="ps-track" data-stage-track>
      {slides.map((slide, index) => (
        <article
          class:list={['ps-slide', slide.dormant && 'ps-slide--dormant']}
          id={slide.domId}
          data-stage-slide
          aria-label={`Program ${slide.label}`}
        >
          <div class="ps-media">
            <Image
              src={slide.photo}
              alt={slide.alt}
              class="ps-photo"
              widths={[640, 960, 1280]}
              sizes="100vw"
              loading={slide.isLead ? 'eager' : 'lazy'}
              fetchpriority={slide.isLead ? 'high' : 'auto'}
            />
            {slide.dormant && <span class="ps-dormant"></span>}
          </div>
          <div class="ps-scrim" aria-hidden="true"></div>

          {/* Wrap-around on purpose: with four slides every arrow always has a
              target, so neither arrow ever sits there dead. The script keeps a
              wrap jump instant instead of blurring past every slide between. */}
          <a class="ps-arrow ps-arrow--prev" href={`#${idAt(index - 1)}`} data-stage-goto="arrow" aria-label="Program sebelumnya">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg>
          </a>
          <a class="ps-arrow ps-arrow--next" href={`#${idAt(index + 1)}`} data-stage-goto="arrow" aria-label="Program berikutnya">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>

          <div class="ps-inner">
            {slide.caption && <p class="ps-caption">{slide.caption}</p>}

            <div class="ps-body">
              <p class="ps-index ps-index--top" aria-hidden="true">{slide.number}<span>/{total}</span></p>
              {slide.kicker && (
                <p class="ps-kick" data-fade={slide.isLead ? '' : undefined}>{slide.kicker}</p>
              )}

              {slide.isLead ? (
                <h2 class="ps-h" id="stage-title" data-fade>{slide.heading}</h2>
              ) : (
                <h3 class="ps-h">{slide.heading}</h3>
              )}

              <p class="ps-lead" data-fade={slide.isLead ? '' : undefined}>{slide.lead}</p>
              {slide.status && (
                <p class="ps-status"><span class="ps-status-dot" aria-hidden="true"></span>{slide.status}</p>
              )}
            </div>

            <div class="ps-foot">
              {slide.statement ? (
                /* Slide 1's closing pill, kept exactly as WhyFood had it: the
                   sentence itself is the point, the link is secondary. The bold
                   half is the leading program's own name, so the sentence stays
                   true if a different program ever opens the band, and only its
                   tail is editor copy. */
                <a
                  href={slide.href}
                  class="ps-cta ps-cta--statement"
                  data-track="program_stage_cta"
                  data-track-program={slide.slug}
                  target={slide.whatsapp ? '_blank' : undefined}
                  rel={slide.whatsapp ? 'noopener' : undefined}
                  data-fade
                >
                  <span class="ps-cta-text"><b>{slide.label}</b> {slide.statement}</span>
                  <span class="ps-cta-go">
                    {slide.ctaLabel}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                  </span>
                </a>
              ) : (
                <a
                  href={slide.href}
                  class="ps-cta"
                  data-track="program_stage_cta"
                  data-track-program={slide.slug}
                  target={slide.whatsapp ? '_blank' : undefined}
                  rel={slide.whatsapp ? 'noopener' : undefined}
                >
                  <span class="ps-cta-go">
                    {slide.ctaLabel}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                  </span>
                </a>
              )}

            </div>

          </div>
        </article>
      ))}
    </div>

    {/* Position marker, not a menu, and it belongs to the section rather than to
        any one slide. It used to be rendered once per slide, which put it inside
        the scrolling track: swiping dragged the bar off with the outgoing slide
        and brought an identical one back in, so it read as part of the moving
        picture instead of as a fixed reference for where you are.

        Living outside the track costs one thing: with scripting off the active
        mark cannot follow the scroll, so it stays on the first program. Every
        tick is still a working anchor, so nothing becomes unreachable, and the
        script marks the right one the moment it runs. Named chips sat here
        before and read as four competing buttons beside the slide's own CTA;
        these carry their program name in the accessible name instead, so
        assistive tech keeps four labelled destinations while the eye only
        registers position. */}
    <nav class="ps-nav" aria-label="Pilih program">
      <ul class="ps-ticks">
        {slides.map((target) => (
          <li>
            <a
              class="ps-tick"
              href={`#${target.domId}`}
              data-stage-goto="chip"
              aria-current={target.isLead ? 'true' : undefined}
            >
              <span class="ps-tick-label">{target.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
)}

<style>
  .pstage { position: relative; }

  .ps-track {
    position: relative;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    /* Keeps a horizontal swipe inside the band instead of handing it to the
       browser's back gesture. */
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .ps-track::-webkit-scrollbar { display: none; }

  .ps-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    display: grid;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* min-height, not height: a long lead on a narrow phone grows the band
       instead of getting clipped. */
    min-height: 560px;
    overflow: hidden;
  }
  @media (min-width: 768px) { .ps-slide { min-height: 78vh; } }

  /* Photo and wash share an isolated stacking context so the layer below can
     never reach the scrim or the page behind it. */
  .ps-media { position: absolute; inset: 0; isolation: isolate; }
  .ps-photo { width: 100%; height: 100%; object-fit: cover; }

  /* Slides whose program has no documentation yet. The treatment is deliberately neutral
     grey: orange is the brand's "this is live" colour, so tinting a dormant
     program with it says the opposite of the truth, and a saturated wash also
     reads as a photo that failed rather than as a decision. Grey states plainly
     that there is nothing to document yet, and the caption says so in words.
     Plain filter plus a flat wash, no blend modes: an earlier attempt stacked a
     `multiply` gradient inside a `lighten` parent, where the child only ever
     blended against its parent's own fill and never reached the photo. */
  .ps-slide--dormant .ps-photo { filter: grayscale(1) contrast(0.94) brightness(0.86); }
  .ps-dormant {
    position: absolute;
    inset: 0;
    background: rgba(23, 28, 37, 0.52);
  }

  .ps-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 18, 30, 0.86), rgba(10, 18, 30, 0.28) 58%, rgba(10, 18, 30, 0.06));
  }
  .ps-slide--dormant .ps-scrim {
    background: linear-gradient(to top, rgba(14, 18, 25, 0.9), rgba(14, 18, 25, 0.38) 58%, rgba(14, 18, 25, 0.1));
  }

  .ps-inner {
    position: relative;
    grid-area: 1 / 1;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    /* Bottom padding leaves room for the indicator bar, which is pinned to the
       section underneath this column rather than flowing after it. */
    padding: 32px 20px 76px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 2;
  }
  @media (min-width: 768px) { .ps-inner { padding: 32px 40px 96px; } }
  .ps-body { max-width: 640px; }

  .ps-caption {
    font-size: 11px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.55);
    margin: 12px 0 0;
  }
  @media (min-width: 768px) {
    .ps-caption {
      position: absolute;
      top: 32px;
      right: 40px;
      margin: 0;
      text-align: right;
      max-width: 40ch;
    }
  }

  .ps-index {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 14px;
  }
  .ps-index span { color: rgba(255, 255, 255, 0.4); }

  .ps-kick {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffc98f;
    margin: 0 0 18px;
  }
  .ps-h {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .ps-lead {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 52ch;
  }
  .ps-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
    margin: 14px 0 0;
  }
  .ps-status-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: rgba(255, 201, 143, 0.85);
  }

  /* The CTA has this row to itself now. It used to share the row with a nav
     carrying four named chips, which together overflowed the 1200px inner width
     and squeezed slide 1's statement pill into a tall wrapped lump. */
  .ps-foot {
    display: flex;
    align-items: center;
    margin-top: 32px;
  }

  .ps-cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 13px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
    flex-wrap: wrap;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .ps-cta:hover { background: rgba(255, 255, 255, 0.18); border-color: rgba(255, 255, 255, 0.34); }
  .ps-cta-text { font-size: 14.5px; color: rgba(255, 255, 255, 0.85); }
  /* The "live programme" mark used to be its own `<span>`, a flex sibling of
     the sentence. `.ps-cta--statement` stacks that row into a column below
     768px, which turned the mark into an orphan row of its own, floating in
     the pill's top-left corner. Carrying it as a `::before` on the sentence
     itself means it can never be stranded: it is always the sentence's own
     first glyph, whichever direction the pill flows. */
  .ps-cta-text::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 14px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.22);
    vertical-align: middle;
  }
  .ps-cta-text b { color: #fff; font-weight: 700; }
  .ps-cta-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
  }
  .ps-cta-go svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  .ps-cta:hover .ps-cta-go svg { transform: translateX(3px); }

  /* Pinned to the section, not to a slide. It sits low on the band on purpose:
     high enough to clear the edge, low enough to read as a footer rule for the
     whole section rather than as another element in the text column. Because it
     is a child of `.pstage` and the slides scroll inside `.ps-track`, it holds
     still while the pictures move past it. */
  .ps-nav {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    z-index: 4;
  }
  .ps-ticks { display: flex; align-items: center; gap: 8px; list-style: none; margin: 0; padding: 0; }

  /* The bar itself stays a 3px hairline; the anchor around it is 44px tall so
     the tap target clears the 44px minimum even though the mark it paints
     does not. Below 768 the arrows are hidden (see `.ps-arrow` below), which
     makes these ticks the only slide control a phone user has, so the anchor
     size is not cosmetic. Size and colour change directly rather than through
     a transform: scaling a 3px bar lands it on half pixels and it renders
     furry. */
  .ps-tick {
    display: flex;
    align-items: center;
    width: 44px;
    height: 44px;
  }
  .ps-tick::before {
    content: '';
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
    transition: background-color 0.25s ease;
  }
  .ps-tick:hover::before { background: rgba(255, 255, 255, 0.62); }
  .ps-tick[aria-current='true']::before { background: #fff; }
  /* The program name lives in the accessible name, not on screen: a screen
     reader and a no-JS visitor still get four clearly labelled destinations. */
  .ps-tick-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .ps-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    transition: background-color 0.2s ease;
  }
  .ps-arrow:hover { background: rgba(0, 0, 0, 0.55); }
  .ps-arrow--prev { left: 24px; }
  .ps-arrow--next { right: 24px; }
  .ps-arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 768px) { .ps-arrow { display: inline-flex; } }

  /* Phone layout. The CTA becomes a full-width block and the source caption
     drops underneath it, since there is no top-right corner to spare. The ticks
     stay last and stay centred, the same role they have on desktop. */
  @media (max-width: 767px) {
    .ps-cta { width: 100%; min-height: 48px; justify-content: center; }
    .ps-cta--statement { flex-direction: column; align-items: flex-start; gap: 10px; padding: 14px 18px; }
    /* The 44px tick anchor (up from 22px) eats 22px more headroom than the
       inner padding below was budgeted for, which put it flush against the
       CTA above. `padding-bottom` grows by that same 22px so the reserved
       strip stays clear of the CTA at every width; `.ps-nav`'s own offset is
       untouched. */
    .ps-inner { padding-bottom: 98px; }
    .ps-nav { bottom: 16px; }
    .ps-tick { width: 30px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ps-cta-text::before { animation: psPulse 2.4s ease-in-out infinite; }
  }
  @keyframes psPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
    50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
  }
</style>

<script>
  import '../scripts/program-stage.js';
</script>
