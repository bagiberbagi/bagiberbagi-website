---
import { getEntry } from 'astro:content';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
---

{/* Background kuning + foto diwarisi dari wrapper zona (index.astro) — section
    transparan agar nyambung mulus dengan Hero di atasnya. */}
<section
  id="stats-section"
  class="relative px-5 md:px-10 pt-6 md:pt-8 pb-10 md:pb-14"
  data-target-dana={site.data.statTargets.dana}
  data-target-donatur={site.data.statTargets.donatur}
  data-target-berbagi={site.data.statTargets.berbagi}
  data-target-area={site.data.statTargets.area}
>
  <div class="max-w-7xl mx-auto grid gap-6 text-center" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
    <div>
      <div id="stat-dana" class="text-heading-sm md:text-heading-lg font-bold tabular-nums">0</div>
      <div class="text-body-sm text-ink/70 mt-1">{site.data.statLabels[0]}</div>
    </div>
    <div>
      <div id="stat-donatur" class="text-heading-sm md:text-heading-lg font-bold tabular-nums">0</div>
      <div class="text-body-sm text-ink/70 mt-1">{site.data.statLabels[1]}</div>
    </div>
    <div>
      <div id="stat-berbagi" class="text-heading-sm md:text-heading-lg font-bold tabular-nums">Rp 0,0 jt</div>
      <div class="text-body-sm text-ink/70 mt-1">{site.data.statLabels[2]}</div>
    </div>
    <div>
      <div id="stat-area" class="text-heading-sm md:text-heading-lg font-bold tabular-nums">0%</div>
      <div class="text-body-sm text-ink/70 mt-1">{site.data.statLabels[3]}</div>
    </div>
  </div>
  {/* Microcopy kredibilitas: framing angka (akumulatif/periode) supaya tak dibaca
      sebagai klaim tanpa konteks. */}
  <p class="max-w-7xl mx-auto text-micro text-ink/55 text-center mt-5">{site.data.statsNote}</p>
</section>

<script>
  import '../scripts/stats-counter.js';
</script>
