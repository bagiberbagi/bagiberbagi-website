---
// Kepercayaan: lima langkah penyaluran yang masing-masing meninggalkan bukti.
// Diadopsi dari seksi "Platform dalam aksi" di revamp, tapi dibingkai ulang jadi
// argumen kepercayaan lewat eyebrow dan judulnya, jadi yang dibaca bukan "ini
// prosesnya" melainkan "prosesnya bisa kamu cek".
//
// Bar program berjalan yang ada di versi revamp sengaja tidak dibawa: di beranda
// ini ProgramHighlights sudah memegang tugas itu, dan kartu hero sudah memegang
// ajakan donasinya. Sebagai gantinya seksi ditutup satu baris ringan yang
// menunjuk ke rekam jejak, memakai jumlah yang benar-benar tercatat.
import Container from './Container.astro';
import { getGlobalImpact } from '../lib/impact';

const impact = await getGlobalImpact();

const STEPS = [
  { t: 'Donatur memulai', d: 'Satu pintu masuk yang jelas.' },
  { t: 'Mitra dikurasi', d: 'UMKM lokal disiapkan dan dinilai kelayakannya.' },
  { t: 'Penerima diverifikasi', d: 'Didata bersama komunitas setempat.' },
  { t: 'Penyaluran berjalan', d: 'Dikerjakan relawan di wilayah itu.' },
  { t: 'Bukti dikirim', d: 'Dokumentasi kembali ke donatur maksimal H+1.' },
];
const CHECK = '<path d="M20 6 9 17l-5-5"></path>';
const ARROW = '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>';
---

<section id="kepercayaan" class="trust py-24 md:py-32 bg-surface-warm scroll-mt-24">
  <Container width="wide">
    <header class="tr-head">
      <p class="eyebrow" data-fade>Cara kami menjaga kepercayaan</p>
      <h2 class="tr-h2" data-fade>Setiap langkah meninggalkan jejak yang bisa dicek.</h2>
      <p class="tr-lead" data-fade>
        Bukan janji transparansi, melainkan langkah yang memang tercatat satu per satu, sejak donasi masuk sampai buktinya kembali ke donatur.
      </p>
    </header>

    <div class="rail" data-rail>
      <span class="rail-line" aria-hidden="true"></span>
      {STEPS.map((s, i) => (
        <div class="rail-step" style={`--i:${i}`}>
          <span class="rail-marker"><svg viewBox="0 0 24 24" set:html={CHECK}></svg></span>
          <span class="rail-t">{s.t}</span>
          <span class="rail-d">{s.d}</span>
          <span class="rail-badge">terekam</span>
        </div>
      ))}
    </div>

    {/* CTA ringan: satu baris, bukan tombol, supaya seksi ini tetap terbaca
        sebagai bukti dan bukan sebagai ajakan donasi kedua. */}
    <div class="tr-foot" data-fade>
      <p class="tr-foot-text">
        {impact.jejakCount > 0
          ? `Sampai hari ini ada ${impact.jejakCount.toLocaleString('id-ID')} kegiatan penyaluran yang catatannya lengkap dengan tanggal, lokasi, dan angkanya.`
          : 'Setiap penyaluran dicatat lengkap dengan tanggal, lokasi, dan angkanya.'}
      </p>
      <a href="/jejak/" class="tr-foot-link">
        Lihat catatannya
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW}></svg>
      </a>
    </div>
  </Container>
</section>

<style>
  .trust svg { fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }

  .tr-head { max-width: 46rem; margin: 0 0 44px; }
  .tr-h2 {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
    color: #0f172a;
    margin: 0;
  }
  .tr-lead {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.65;
    color: #505d6f;
    max-width: 58ch;
    margin: 18px 0 0;
    text-wrap: pretty;
  }

  /* ===== Pita proses =====
     900px di bawah ini = breakpoint `wide` (tailwind.config.mjs `screens`),
     ambang beranda berganti dari bertumpuk jadi tata letak lebar. Empat
     komponen lain memakai ambang yang sama dan berganti serentak dengannya,
     jadi mengubah angka di satu berkas saja akan memecah barisan. Angkanya
     ditulis literal karena CSS tak bisa membaca custom property di kondisi
     media query; namanya yang jadi acuan, bukan angkanya. */
  .rail { position: relative; display: grid; grid-template-columns: 1fr; gap: 26px; }
  @media (min-width: 900px) { .rail { grid-template-columns: repeat(5, 1fr); gap: 18px; } }

  /* Garis: tegak di layar sempit, mendatar di layar lebar. */
  .rail-line { position: absolute; left: 19px; top: 20px; bottom: 20px; width: 2px; background: linear-gradient(to bottom, #fdeee1, #f4791d, #fdeee1); }
  @media (min-width: 900px) {
    .rail-line { left: 10%; right: 10%; top: 19px; bottom: auto; width: auto; height: 2px; background: linear-gradient(to right, #fdeee1, #f4791d, #fdeee1); }
  }

  .rail-step { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 7px; padding-left: 54px; }
  @media (min-width: 900px) { .rail-step { align-items: center; text-align: center; padding-left: 0; } }
  .rail-marker {
    position: absolute; left: 0; top: 0;
    width: 38px; height: 38px; border-radius: 50%;
    display: grid; place-items: center;
    background: #fff; border: 2px solid #059669; color: #059669;
  }
  @media (min-width: 900px) { .rail-marker { position: static; } }
  .rail-marker svg { width: 16px; height: 16px; }
  .rail-t { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: #0f172a; }
  .rail-d { font-size: 13.5px; line-height: 1.5; color: #505d6f; max-width: 24ch; }
  .rail-badge {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: #059669; background: #ecfdf5; border-radius: 999px; padding: 3px 10px;
  }

  /* ===== Penutup ringan ===== */
  .tr-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid #e9e7e1;
  }
  .tr-foot-text { margin: 0; font-size: 14.5px; line-height: 1.6; color: #505d6f; max-width: 62ch; }
  .tr-foot-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: 14.5px;
    font-weight: 700;
    color: #0f172a;
    transition: color 0.18s ease, gap 0.18s ease;
  }
  .tr-foot-link:hover { color: #c25d0f; gap: 12px; }
  .tr-foot-link svg { width: 16px; height: 16px; }

  /* ===== Animasi: langkah muncul berurutan saat masuk viewport ===== */
  @media (prefers-reduced-motion: no-preference) {
    .rail-step { opacity: 0; transform: translateY(12px); }
    .rail.in .rail-step {
      animation: railIn 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--i) * 0.14s);
    }
  }
  @keyframes railIn { to { opacity: 1; transform: none; } }
</style>

<script>
  const rail = document.querySelector('[data-rail]');
  if (rail) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      rail.classList.add('in');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              rail.classList.add('in');
              io.disconnect();
            }
          });
        },
        { threshold: 0.25 }
      );
      io.observe(rail);
    }
  }
</script>
