---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { JejakVideo } from '../lib/jejak';

export interface Props {
  video: JejakVideo;
  /** Dipakai saat video tak punya poster sendiri; di halaman jejak = cover-nya. */
  fallbackPoster?: ImageMetadata | null;
  /** Judul jejak, untuk alt poster dan label tombol putar. */
  title: string;
  /** Video ada di puncak halaman, jadi posternya tak perlu ditunda. */
  eager?: boolean;
  /** Jarak bawah; pemanggil yang tahu apa yang menyusul di bawahnya. */
  class?: string;
}

const { video, fallbackPoster = null, title, eager = false, class: className = 'mb-8' } = Astro.props;

const poster = video.poster ?? fallbackPoster;
const isPortrait = video.orientation === 'portrait';

// Video tegak dibatasi selebar 20rem lalu ditengahkan: dibiarkan selebar kolom,
// tingginya jadi hampir dua kali lipat lebar isi dan mendorong seluruh angka
// penyaluran keluar layar.
const frameClass = isPortrait
  ? 'relative mx-auto w-full max-w-[min(100%,20rem)] aspect-[9/16] overflow-hidden rounded-card bg-ink'
  : 'relative w-full aspect-video overflow-hidden rounded-card bg-ink';

// Lebar render poster mengikuti bingkainya, sama seperti foto lain di halaman
// ini: isi Container tier `article` 688px di layar lebar, dan 320px untuk yang
// tegak. Angka terbesar dua kali lipatnya, untuk layar 2x DPR.
const posterWidths = isPortrait ? [320, 480, 640] : [480, 688, 1000, 1376];
const posterSizes = isPortrait ? '(min-width: 768px) 320px, 100vw' : '(min-width: 768px) 688px, 100vw';

// Elemen <video> menerima poster sebagai URL, bukan modul gambar, jadi berkasnya
// dibuat saat build. Hanya untuk video berkas sendiri; jalur embed memakai
// <Image> biasa yang menyiapkan beberapa lebar sekaligus.
const filePoster =
  video.source.kind === 'file' && poster
    ? (await getImage({ src: poster, format: 'webp', quality: 80, width: isPortrait ? 640 : 1376 })).src
    : undefined;
---

<figure class={className}>
  {video.source.kind === 'embed' ? (
    /* Facade: yang dirender server cuma poster dan tombol. Iframe pemutarnya
       baru dibuat oleh embed-facade.js saat tombolnya ditekan, jadi sebelum itu
       tak ada skrip, cookie, maupun permintaan ke Google untuk pengunjung yang
       tak pernah menonton. Sejalan dengan consent gating di Analytics.astro. */
    <div
      data-embed-facade
      data-embed={video.source.embedUrl}
      data-embed-title={title}
      class={frameClass}
    >
      <button
        type="button"
        data-embed-play
        data-track="jejak_video_play"
        data-track-provider={video.source.provider}
        aria-label={`Putar video dokumentasi: ${title}`}
        class="group absolute inset-0 h-full w-full cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)] focus-visible:ring-inset"
      >
        {poster ? (
          <Image
            src={poster}
            alt=""
            widths={posterWidths}
            sizes={posterSizes}
            loading={eager ? 'eager' : 'lazy'}
            class="absolute inset-0 h-full w-full object-cover"
          />
        ) : (
          <span
            aria-hidden="true"
            class="absolute inset-0"
            style="background:linear-gradient(135deg,var(--cat-deep),var(--cat))"
          ></span>
        )}
        <span aria-hidden="true" class="absolute inset-0 bg-ink/35 transition-colors group-hover:bg-ink/45"></span>
        <span
          aria-hidden="true"
          class="absolute left-1/2 top-1/2 grid h-16 w-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white shadow-card transition-transform duration-300 group-hover:scale-110"
        >
          {/* Segitiga digeser 2px ke kanan: bentuknya berat di sisi kiri, jadi
              yang tampak seimbang bukan titik tengah geometrisnya. */}
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class="translate-x-0.5 text-[var(--cat)]">
            <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.29-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"></path>
          </svg>
        </span>
      </button>
    </div>
  ) : video.source.kind === 'file' ? (
    /* Berkas sendiri: pemutar bawaan peramban sudah cukup, dan preload="metadata"
       hanya mengambil header berkasnya supaya durasi terbaca tanpa mengunduh
       isinya. */
    <div class={frameClass}>
      <video
        src={video.source.src}
        poster={filePoster}
        controls
        playsinline
        preload="metadata"
        data-track="jejak_video_play"
        class="absolute inset-0 h-full w-full bg-ink object-contain"
      >
        <p class="p-4 text-body-sm text-white">
          Peramban ini tidak bisa memutar videonya.
          <a href={video.source.src} class="font-semibold underline">Unduh berkasnya</a>.
        </p>
      </video>
    </div>
  ) : (
    /* Alamatnya benar tapi pemutarnya tak bisa dipasang di halaman (folder Drive,
       Instagram, TikTok). Ditampilkan sebagai tautan keluar, bukan dihilangkan:
       yang hilang diam-diam tak pernah ketahuan editornya, dan pengunjung tetap
       punya jalan menuju dokumentasinya. */
    <a
      href={video.source.href}
      target="_blank"
      rel="noopener noreferrer"
      data-track="jejak_video_link"
      class="group flex items-center gap-4 rounded-card border border-border bg-white p-4 no-underline transition-shadow hover:shadow-cardSm"
    >
      <span class="grid h-11 w-11 flex-none place-items-center rounded-xl text-white" style="background:var(--cat)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.29-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"></path>
        </svg>
      </span>
      <span class="min-w-0">
        <span class="block font-bold text-ink">Tonton dokumentasi di {video.source.label}</span>
        <span class="block text-body-sm text-muted">Terbuka di tab baru</span>
      </span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ml-auto flex-none text-[var(--cat)] transition-transform group-hover:translate-x-0.5">
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </a>
  )}

  {video.caption && (
    <figcaption class="mt-2.5 text-center text-body-sm text-muted">{video.caption}</figcaption>
  )}
</figure>

{/* Tanpa kondisi: <script> bundel di-hoist saat build, jadi membungkusnya dalam
    ternary tak membuatnya hilang dari halaman (alasan yang sama membuat
    Analytics.astro memakai is:inline). Yang membatasi jangkauannya adalah
    komponen ini sendiri, yang hanya dirender saat jejaknya punya video. Untuk
    video berkas sendiri skripnya menganggur, sekitar setengah kilobyte. */}
<script>
  import '../scripts/embed-facade.js';
</script>
