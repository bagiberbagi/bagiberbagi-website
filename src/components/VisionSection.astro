---
// Arah kami: pintu berbagi, dibuka satu per satu. Narasinya baru (hari ini
// langkah pertama menuju infrastruktur berbagi, label "Hari Ini" dan "Tahap
// Berikutnya", bukan "Coming Soon"), visualnya yang lama dan memang disukai:
// kartu putih di latar abu dengan ikon watermark besar berwarna identitas pintu.
//
// Versi garis waktu sempat dipasang di sini lalu dilepas: ikon besar itu yang
// memberi tiap pintu wajah sendiri, dan itu hilang begitu diringkas jadi titik
// kecil di rel.
//
// id="pintu" dipertahankan karena mega-menu, footer, dan redirect /program
// semuanya menautkan /#pintu.
import { getEntry } from 'astro:content';
import Container from './Container.astro';
import Icon from './Icon.astro';
import { PINTU, type Pintu, type PintuId, pintuPath } from '../consts';
import { getProgramsByPintu } from '../lib/programs';
import { buildWaLink } from '../lib/format';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waResourceLink = buildWaLink(
  site.data.waNumber,
  'Halo, saya punya sumber daya untuk dibagikan lewat bagiberbagi.id.'
);

// Nama pendek + kalimat perjalanan tiap pintu. Sengaja dipisah dari `blurb` di
// consts karena di sini kalimatnya bercerita soal tahap, bukan soal isi pintunya.
const META: Record<PintuId, { name: string; desc: string }> = {
  food: { name: 'Pangan', desc: 'Berjalan hari ini, menyalurkan makanan bergizi bersama dapur-dapur warga.' },
  empowerment: { name: 'Pemberdayaan', desc: 'Tumbuh dari dapur yang sudah memasak bersama kami: order yang pasti, lalu alat dan modal usahanya.' },
  education: { name: 'Pendidikan', desc: 'Menyiapkan beasiswa dan perlengkapan sekolah bagi anak yang terancam berhenti belajar karena biaya.' },
  humanitarian: { name: 'Kemanusiaan', desc: 'Menyiapkan respons agar bantuan sampai di hari-hari pertama, saat paling menentukan.' },
  health: { name: 'Kesehatan', desc: 'Membuka akses pemeriksaan dan pengobatan bagi warga yang selama ini menundanya.' },
  environment: { name: 'Lingkungan', desc: 'Menumbuhkan pohon dan menjaga kebersihan agar kota lebih teduh bagi generasi berikutnya.' },
};

// Urutan tampil sengaja beda dari urutan PINTU di consts: yang aktif lebih dulu,
// lalu tahap berikutnya sesuai rencana pembukaan.
const ORDER = ['food', 'empowerment', 'education', 'humanitarian', 'health', 'environment'] as const;

// Status "sudah jalan" diturunkan dari data program, tidak pernah ditulis tangan,
// supaya klaim di halaman tidak bisa lebih maju dari kenyataan.
const byId = new Map<PintuId, Pintu>(PINTU.map((p) => [p.id, p]));
const STAGES = await Promise.all(
  ORDER.map(async (id) => {
    const pintu = byId.get(id);
    if (!pintu) throw new Error(`Pintu "${id}" tidak ada di PINTU (src/consts.ts)`);
    const active = (await getProgramsByPintu(id)).some((prog) => prog.active);
    return { ...pintu, ...META[id], active };
  })
);
---

<section id="pintu" class="vision relative overflow-hidden bg-gray-50 py-24 md:py-32 scroll-mt-24">
  <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/3 w-[42rem] h-[28rem] opacity-70" style="background:radial-gradient(closest-side,rgba(244,121,29,0.07),transparent);"></div>

  <Container width="wide" class="relative">
    <header class="vs-head">
      <p class="eyebrow" data-fade>Arah kami</p>
      <h2 class="vs-h2" data-fade>Perjalanan ini baru dimulai.</h2>
      <p class="vs-lead" data-fade>
        Jumat Berkah adalah langkah pertama kami. Ke depan, Bagiberbagi akan menghadirkan lebih banyak cara agar setiap orang dapat berbagi sesuai kemampuan, sumber daya, dan kepeduliannya.
      </p>
    </header>

    {/* Kartu identitas pintu. Ikon watermark besar itu yang memberi tiap kartu
        wajahnya sendiri, jadi ukurannya sengaja 150px dengan opasitas rendah:
        cukup kuat untuk dikenali, tetap terbaca sebagai latar. */}
    {/* Enam kartu berhenti di tiga kolom, bukan enam: satu baris enam bikin
        kolomnya selebar 200px dan kalimat tahapnya pecah jadi enam baris. Dua
        baris tiga terbaca sebagai satu blok utuh.

        Alasan yang sama berlaku ke bawah, dan dulu dilanggar di sini. Dua kolom
        di lebar HP menyisakan 165px per kartu, tinggal 117px untuk teks setelah
        padding, sehingga kalimat tahapnya pecah jadi enam baris persis seperti
        yang dihindari di atas. Satu kolom di bawah 640 mengembalikan lebar baca
        kartunya, lalu naik dua kolom sebelum tiga supaya perubahannya bertahap
        dan tidak melompat dari satu langsung ke tiga.

        Tiga kolom sengaja menunggu `lg` (1024), bukan `md` (768): 768 sampai
        1023 itu wilayah tablet portrait, dan di sana tiga kolom mengembalikan
        kartu ke 216px, persis kesempitan yang sedang dihindari. Dua kolom
        memegang seluruh rentang tablet, tiga kolom baru muncul di desktop.

        Kartunya tidak lagi punya tinggi paksa sama sekali. `min-h-64` dulu ada
        untuk menyamakan kartu yang sebaris, padahal grid sudah melakukan itu
        sendiri lewat stretch, jadi yang tersisa dari 256px itu cuma ruang
        kosong. Diukur setelah dilepas: kartu 256px jadi 174px di 768 dan
        154,8px di 1280, seksinya 1345px jadi 1099px di 768 dan 1096px jadi
        913px di 1280, dan kartu sebaris tetap sama tinggi. */}
    <div class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {STAGES.map((pintu) => (
        <a
          href={pintuPath(pintu.slug)}
          data-track="pintu_click"
          data-track-pintu={pintu.slug}
          data-fade
          style={`--cat:${pintu.color}`}
          class="group relative overflow-hidden h-full rounded-card bg-white border border-border p-6 flex flex-col shadow-[0_8px_22px_-16px_rgba(15,23,42,0.28)] transition-all hover:-translate-y-1 hover:border-[var(--cat)]"
        >
          <span aria-hidden="true" class="pointer-events-none absolute -right-5 -bottom-7 text-[var(--cat)] opacity-[0.13] transition-opacity duration-300 group-hover:opacity-25">
            <Icon name={pintu.icon} size={150} color="currentColor" />
          </span>

          <h3 class="relative text-title-sm font-semibold text-ink">{pintu.name}</h3>
          <p class="relative text-body-sm text-muted leading-snug mt-2 mb-4 flex-1">{pintu.desc}</p>

          {/* Status label moved down here from the top eyebrow slot, sharing
              this foot row with the hover arrow rather than stacking above it:
              both are small foot-anchored elements, and pairing them is what
              actually reclaims the eyebrow's vertical space instead of just
              relocating it as a second bottom line. */}
          <span class="relative flex items-center justify-between gap-2 mt-auto">
            {pintu.active ? (
              <span class="inline-flex items-center gap-1.5 text-micro font-bold uppercase tracking-wide text-[#10803A]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#16A34A]"></span>Hari Ini
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 text-micro font-bold uppercase tracking-wide text-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-muted/50"></span>Tahap Berikutnya
              </span>
            )}
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-[var(--cat)] opacity-0 -translate-x-1 transition-all group-hover:opacity-100 group-hover:translate-x-0"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </a>
      ))}
    </div>

    {/* Ajakan kontribusi sumber daya: pintu berikutnya belum tentu kami yang tahu. */}
    <p class="mt-8 text-body-sm text-muted" data-fade>
      Punya sumber daya lain untuk dibagi?{' '}
      <a href={waResourceLink} target="_blank" rel="noopener" data-track="pintu_contribute" class="font-semibold text-brand-blue hover:underline underline-offset-2">Ceritakan ke kami</a>, kami bantu wujudkan pintunya.
    </p>

    {/* Pernyataan misi dulu menumpang di sini sebagai penutup dan selalu kalah,
        karena jangkar seksi ini kartu pintu dan misi jadi ide kedua di ruang yang
        sama. Sekarang dia punya seksinya sendiri, MissionSection, yang berdiri
        tepat sebelum seksi ini. */}
  </Container>
</section>

<style>
  /* Kepala seksi disamakan dengan seksi lain di beranda supaya tepi kiri dan
     skala judulnya lurus dari atas sampai bawah halaman. */
  .vs-head { max-width: 46rem; margin: 0 0 48px; }
  @media (min-width: 768px) { .vs-head { margin-bottom: 64px; } }
  .vs-h2 {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
    color: #0f172a;
    margin: 0;
  }
  .vs-lead {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.65;
    color: #505d6f;
    max-width: 58ch;
    margin: 18px 0 0;
    text-wrap: pretty;
  }
</style>
