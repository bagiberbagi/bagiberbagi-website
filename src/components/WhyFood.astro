---
// Jembatan platform ke program pertama: kenapa memulai dari makanan. Visualnya
// foto lapangan full-bleed dengan konten editorial di bawahnya, ditutup satu
// strip ringkas yang menegaskan Jumat Berkah sebagai langkah pertama sekaligus
// mengantar ke seksi program. Sengaja tanpa kartu bertumpuk supaya seksi ini
// punya bobot visual sendiri, yaitu fotonya.
//
// Seksi ini full-bleed, jadi tidak memakai Container. Lebar isinya dikunci di
// 80rem, sama dengan tier `wide`, supaya tepi kirinya tetap lurus dengan seksi
// lain di beranda.
import { Image } from 'astro:assets';
import { getPrograms } from '../lib/programs';
import photo from '../assets/images/jumat-berkah-distribusi.png';

// Strip penutup dulu menunjuk anchor #program milik ProgramHighlights. Seksi itu
// sudah dilepas dari beranda, jadi tujuannya diarahkan langsung ke halaman
// program yang sedang berjalan. Diturunkan dari data, bukan slug yang ditulis
// tangan, supaya tidak putus kalau program aktifnya berganti.
const programs = await getPrograms();
const active = programs.find((p) => p.active);
const programHref = active?.href ?? '/berbagi-makanan/';
---

<section class="whyfood">
  <Image src={photo} alt="Penyaluran paket makanan bersama warga, mitra UMKM, dan relawan" class="wf-bg" />
  <div class="wf-scrim" aria-hidden="true"></div>

  <div class="wf-inner">
    <div class="wf-col">
      <p class="wf-kick" data-fade>Mengapa mulai dari makanan</p>
      <h2 class="wf-h2" data-fade>Setiap perjalanan besar dimulai dari satu langkah.</h2>
      <p class="wf-lead" data-fade>
        Makanan adalah kebutuhan paling dasar. Kami memulai dari yang paling dekat dengan kehidupan sehari-hari, bersama UMKM dan relawan di sekitar.
      </p>

      {/* Strip penutup: pernyataan "langkah pertama" + antar ke seksi program. */}
      <a href={programHref} class="wf-strip group" data-fade>
        <span class="wf-dot" aria-hidden="true"></span>
        <span class="wf-strip-text">
          <b>Jumat Berkah</b> bukan tujuan akhir, melainkan langkah pertama.
        </span>
        <span class="wf-strip-cta">
          Lihat program
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .whyfood {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 78vh;
    overflow: hidden;
  }
  .wf-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wf-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 18, 30, 0.86), rgba(10, 18, 30, 0.28) 58%, rgba(10, 18, 30, 0.06));
  }

  .wf-inner {
    position: relative;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 20px 64px;
  }
  @media (min-width: 768px) { .wf-inner { padding: 0 40px 96px; } }
  .wf-col { max-width: 640px; }

  .wf-kick {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffc98f;
    margin: 0 0 18px;
  }
  .wf-h2 {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .wf-lead {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 52ch;
  }

  .wf-strip {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
    padding: 13px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
    flex-wrap: wrap;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .wf-strip:hover { background: rgba(255, 255, 255, 0.18); border-color: rgba(255, 255, 255, 0.34); }
  .wf-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.22);
  }
  .wf-strip-text { font-size: 14.5px; color: rgba(255, 255, 255, 0.85); }
  .wf-strip-text b { color: #fff; font-weight: 700; }
  .wf-strip-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
  }
  .wf-strip-cta svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  .group:hover .wf-strip-cta svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: no-preference) {
    .wf-dot { animation: wfPulse 2.4s ease-in-out infinite; }
  }
  @keyframes wfPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
    50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
  }
</style>
