---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Container from './Container.astro';
import { PINTU } from '../consts';
import { getProgramsByPintu } from '../lib/programs';
import { buildWaLink } from '../lib/format';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waResourceLink = buildWaLink(site.data.waNumber, 'Halo, saya punya sumber daya untuk dibagikan lewat bagiberbagi.id.');

// Status pintu diturunkan dari data program (single-source): sebuah pintu
// "sudah jalan" bila punya ≥1 program aktif. Kini hanya Makanan (Jumat Berkah).
const pintuStatus = await Promise.all(
  PINTU.map(async (p) => ({
    ...p,
    active: (await getProgramsByPintu(p.id)).some((prog) => prog.active),
  }))
);
---

<section id="pintu" class="section bg-gray-50 scroll-mt-24">
  <Container width="wide">
    <div class="max-w-text mb-12">
      <div class="eyebrow">ARAH KAMI</div>
      <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-4">Berbagi Tak Berhenti di Makanan</h2>
      <p class="text-base leading-relaxed text-muted">
        Jumat Berkah baru langkah pertama. Kami sedang membuka lima pintu untuk berbagi sumber daya, satu per satu, begitu tim dan mitra siap.
      </p>
    </div>

    {/* Lima kanal setara: ukuran seragam, bukan tangga. Warna identitas tiap
        pintu; status ("Sudah jalan"/"Segera") ditandai badge, bukan ukuran. */}
    <div class="grid gap-5 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
      {pintuStatus.map((pintu) => (
        <a
          href={`/berbagi-${pintu.slug}/`}
          data-track="pintu_click"
          data-track-pintu={pintu.slug}
          style={`--cat:${pintu.color}`}
          class="group relative overflow-hidden h-full min-h-60 rounded-card bg-white border border-border p-6 flex flex-col shadow-[0_8px_22px_-16px_rgba(15,23,42,0.28)] transition-all hover:-translate-y-1 hover:border-[var(--cat)]"
        >
          {/* Ikon watermark — glyph besar warna pintu, tembus dari pojok. Ini
              pembawa identitas warna (bukan tint penuh), foreground tetap netral. */}
          <span aria-hidden="true" class="pointer-events-none absolute -right-5 -bottom-7 text-[var(--cat)] opacity-[0.13] transition-opacity duration-300 group-hover:opacity-25">
            <Icon name={pintu.icon} size={150} color="currentColor" />
          </span>

          <h3 class="relative text-title-sm font-semibold">{pintu.label}</h3>
          <p class="relative text-body-sm text-muted leading-snug mt-2 mb-4 flex-1">{pintu.blurb}</p>
          <div class="relative flex items-center justify-between gap-2 mt-auto">
            {pintu.active ? (
              <span class="inline-flex items-center gap-1.5 text-micro font-bold uppercase tracking-wide text-[#10803A]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#16A34A]"></span>Sudah jalan
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 text-micro font-bold uppercase tracking-wide text-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-muted/50"></span>Segera
              </span>
            )}
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-[var(--cat)] opacity-0 -translate-x-1 transition-all group-hover:opacity-100 group-hover:translate-x-0"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </div>
        </a>
      ))}
    </div>

    {/* Ajakan kontribusi — mengundang sumber daya untuk pintu yang belum jalan. */}
    <p class="mt-8 text-body-sm text-muted">
      Punya sumber daya lain untuk dibagi?{' '}
      <a href={waResourceLink} target="_blank" rel="noopener" data-track="pintu_contribute" class="font-semibold text-brand-blue hover:underline underline-offset-2">Ceritakan ke kami</a>, kami bantu wujudkan pintunya.
    </p>
  </Container>
</section>
