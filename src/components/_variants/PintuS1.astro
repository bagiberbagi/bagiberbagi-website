    border-right: 1.5px solid var(--cat-deep);
    border-bottom: 1.5px solid var(--cat-deep);
    transform: rotate(-45deg);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .s1-rail-nav a:hover,
  .s1-rail-nav a:focus-visible { color: #0f172a; }
  .s1-rail-nav a:hover::after,
  .s1-rail-nav a:focus-visible::after { opacity: 1; }

  /* ---------- Neraca angka ---------- */
  /* Satu rantai menerus, satu baris per metrik: angka di tepi kiri, labelnya di
     tepi kanan, barisnya membentang penuh lebar kolom. Bentuk grid sudah
     ditolak DESIGN_PRINCIPLES sebagai dashboard. */
  .s1-ledger { display: flex; flex-direction: column; }
  .s1-metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    border-top: var(--hairline) solid var(--line);
  }
  .s1-metric:last-child { border-bottom: var(--hairline) solid var(--line); }
  .s1-num {
    flex: none;
    /* heading-lg 34 → display-lg 56 */
    font-size: clamp(34px, 6.2cqw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--cat-deep);
    font-variant-numeric: tabular-nums;
  }
  .s1-metric-label {
    /* token body 16px */
    font-size: 16px;
    line-height: 1.5;
    color: #505d6f;
    text-align: right;
  }

  .s1-foot {
