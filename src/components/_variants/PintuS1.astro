---
/**
 * SINTESIS S1 halaman pintu: "Rel Garis".
 *
 * Dasarnya varian 5 (Tipografi Lapang) dan konsepnya rel lengket dari varian 3.
 * Pertanyaan yang harus dijawab desainnya: rel itu hidup sebagai APA di halaman
 * yang lapang. Jawabannya BUKAN kartu yang ditempel di kolom samping, karena
 * kartu padat di halaman tanpa satu pun kartu langsung terbaca sebagai tambalan
 * dari desain lain.
 *
 * Jawabannya: rel di sini adalah KEPALA BERJALAN, kolom marginalia seperti di
 * buku. Isinya tipografi telanjang di atas latar halaman, dipisah garis rambut
 * horizontal persis seperti pemisah seksi di badan halaman, tanpa bidang latar,
 * tanpa radius, tanpa shadow. Yang menandainya sebagai satu kolom cuma satu
 * GARIS VERTIKAL 2px berwarna pintu di tepi kirinya, dan garis itu membentang
 * penuh setinggi badan halaman, bukan setinggi relnya. Jadi rel terbaca sebagai
 * kolom teks yang kebetulan diam, dan halaman tetap halaman garis, bukan
 * halaman kotak.
 *
 * Keputusan yang perlu dicatat supaya tidak "diperbaiki" tanpa sengaja:
 *
 * 1. REL ADA DI KOLOM KANAN, bukan kiri. Ini koreksi terhadap versi pertama S1,
 *    yang menaruh rel di kiri dan akibatnya tepi kiri halaman pecah jadi tiga
 *    posisi: h1 hero di tepi Container, semua h2 badan halaman tergeser sejauh
 *    lebar rel plus gap, lalu seksi #pintu-lain dan penutup balik lagi ke tepi
 *    Container. Varian 5 menyebut tepi kiri lurus dari hero sampai penutup
 *    sebagai identitasnya, dan itu identitas yang dibawa ke sini. Dengan rel di
 *    kanan, hero, tiap h2, #pintu-lain, dan penutup duduk di satu garis tegak
 *    yang sama. Arahnya sendiri tidak berubah: garis identitas tetap di TEPI
 *    KIRI REL, cuma sekarang tepi kiri itu jatuh di antara kolom baca dan rel.
 *    (Penutup tetap ditengahkan. Itu satu-satunya pengecualian yang memang
 *    diizinkan DESIGN_PRINCIPLES untuk minimal closing CTA.)
 *
 * 2. REL TIDAK MEMBAWA TOMBOL DAN TIDAK MEMBAWA ANGKA. Isinya cuma kepala
 *    berjalan (ikon, nama Inggris, nama pintu) dan daftar "Di halaman ini".
 *    Dua alasannya:
 *    - Rel yang lengket sambil membawa CTA itu bar konversi dalam bentuk lain,
 *      dan itu berbenturan dengan "trust over attention" serta "participation
 *      over conversion". Versi pertama S1 punya enam tujuan WhatsApp di halaman
 *      yang isinya dua seksi.
 *    - Rel yang membawa angka atau daftar contoh memberi tiap seksi anchor
 *      kedua yang permanen, dan itu melanggar "one anchor per section". Paling
 *      telanjang di seksi Rekam Jejak: rel dan kaki seksi sempat menampilkan
 *      tautan yang sama persis kata per kata di satu layar.
 *    Sekarang aksi halaman ini cuma dua: tombol di hero dan penutup. Isi yang
 *    dulu dititipkan ke rel dikembalikan ke kolom baca (lihat nomor 3).
 *
 * 3. TINGGI REL DIBATASI OLEH BENTUKNYA, bukan oleh media query tebakan. Versi
 *    pertama memakai `@media (max-height: 760px)` untuk melepas daftar isi, dan
 *    760 itu angka mati yang tidak diturunkan dari apa pun: tinggi rel berubah
 *    menurut jumlah tautan, jadi ada pita tinggi 761px sampai 815px di mana rel
 *    terpotong DAN daftar isinya belum dilepas, sementara `overflow-y` memang
 *    dilarang (nomor 6), jadi yang terpotong hilang permanen.
 *    Sekarang tingginya bisa dihitung dan plafonnya kecil:
 *      kepala berjalan 96 + pemisah 56 + label 26 + (paling banyak 7 tautan
 *      x 33) = 409px; ditambah `top` 112px dan napas bawah 24px = 545px.
 *    Jadi rel muat utuh di setiap tinggi viewport 560px ke atas. Di bawah itu
 *    rel berhenti lengket dan ikut bergulir seperti blok biasa. Tidak ada yang
 *    disembunyikan, tidak ada yang terpotong. Kalau nanti ada blok baru
 *    ditambahkan ke rel, hitung ulang plafon ini dan ubah angka 560 bersamanya.
 *
 * 4. ARITMETIKA TABRAKAN HEADER. Dua angka berbeda dipakai di file ini, dan
 *    keduanya benar karena menggambarkan keadaan gulir yang berbeda:
 *    - 74px = 10px margin atas + 64px tinggi pil, keadaan DIAM di puncak
 *      halaman. Ini yang dipakai hero untuk menarik dirinya naik ke belakang
 *      pil. Di puncak halaman pil belum bergeser dan belum punya shadow, jadi
 *      74 memang angka yang benar di sana. Jangan disamakan dengan angka rel.
 *    - 94px = tepi bawah cat pil saat halaman SUDAH DIGULIR. Header.astro
 *      memberi `translateY(10px)` pada lebar >= 860px, jadi tepi bawah pil
 *      turun ke 84px, lalu `box-shadow: 0 14px 28px -18px` menjulur sekitar
 *      10px lagi, jadi ekor bayangannya berakhir di sekitar 94px.
 *    Rel dan seluruh target lompat memakai 94 sebagai dasar, bukan 74. Versi
 *    pertama memakai 96 dan mengklaim "74 + 22 napas"; hasilnya napas
 *    sebenarnya cuma sekitar 2px dan cincin ikon rel duduk tepat di bawah
 *    bayangan header persis di satu-satunya keadaan yang penting.
 *
 * 5. SETIAP TARGET LOMPAT PUNYA `scroll-margin-top`. Tidak ada satu pun di
 *    seluruh `src/` sebelum ini, sementara header `sticky top-0` dan
 *    `html { scroll-behavior: smooth }` diset di BaseLayout. Akibatnya eyebrow
 *    dan sebagian h2 seksi tujuan tertutup header tiap kali tautan diklik, dan
 *    karena gulirnya halus pengunjung menonton animasi yang berakhir di judul
 *    yang tersembunyi. Rel ini yang memperkenalkan daftar isi, jadi
 *    perbaikannya tanggung jawab file ini. Breadcrumb `/#pintu` menunjuk ke
 *    beranda dan tidak bisa dibereskan dari sini.
 *
 * 6. Rel TIDAK memakai overflow-y: auto. Varian 3 memakainya dan itu
 *    menciptakan dua permukaan gulir bersebelahan: kursor di atas rel yang
 *    sudah mentok membuat halaman berhenti bergulir sama sekali.
 *
 * 7. DI BAWAH 900px REL TIDAK DIRENDER SAMA SEKALI, dan tidak ada dok fixed
 *    yang menggantikannya. Versi pertama menumpuk rel di atas badan halaman,
 *    jadi urutan bacanya jadi: nama pintu (lagi), tombol WhatsApp (lagi),
 *    daftar lompat, baru penjelasan pintunya. Pengunjung ketemu CTA sebelum
 *    tahu pintunya apa. Dok fixed-nya sendiri punya dua masalah: ia bar
 *    konversi yang mengikuti pengunjung, dan observernya cuma memeriksa
 *    `isIntersecting` terhadap penutup, jadi begitu penutup keluar layar lewat
 *    ATAS dok menyala lagi dan menutupi footer sampai ujung halaman.
 *    Ganti keduanya: di mobile halaman ini persis halaman varian 5, satu kolom
 *    tanpa marginalia, dan aksinya tetap di hero dan penutup.
 *
 * 8. WARNA PINTU TETAP HADIR SEPANJANG GULIR DI SEMUA LEBAR. Di desktop lewat
 *    garis vertikal rel. Di semua lebar, termasuk mobile, lewat pangkal 40px
 *    berwarna pintu pada setiap garis pemisah antar blok. Halaman ini memakai
 *    garis bukan bidang, jadi warnanya pun naik ke garis. Yang disentuh --cat:
 *    garis rel, pangkal garis pemisah, batang eyebrow, border atas caption
 *    foto, dot penanda, dan watermark penutup. Yang disentuh --cat-deep cuma
 *    yang harus terbaca: angka, nomor urut, panah, cincin ikon.
 *
 * 9. UKURAN HURUF DI KOLOM BACA MEMAKAI `cqw`, BUKAN `vw`. Kolom baca punya
 *    `container-type: inline-size`, jadi acuannya lebar kolom itu sendiri.
 *    Versi pertama memakai `vw` di sembilan tempat, dan akibatnya menyeberang
 *    dari 899px ke 900px kolom baca menyempit sekitar 36% sementara semua
 *    ukuran hurufnya tidak bergerak sedikit pun, jadi hurufnya justru paling
 *    besar secara relatif tepat saat kolomnya paling sempit. Itu gejala yang
 *    sama dengan yang dituduhkan ke varian 3, cuma penyebabnya ukuran huruf.
 *    Ukuran di luar kolom baca (hero, caption foto, #pintu-lain, penutup) tetap
 *    `vw` karena di sana acuannya memang viewport.
 *
 * 10. BREAKPOINT STRUKTURAL SATU, DI 900px, sesuai DESIGN_SYSTEM.md. Versi
 *    pertama memindahkannya ke 1024px dengan alasan yang cuma ditulis di
 *    komentar file, padahal dokumennya menyebut lg 1024 "rarely needed" dan
 *    menutup dengan "Do not add a third structural breakpoint". Ambang
 *    container query di dalam kolom baca diturunkan ke 520 supaya menyala tepat
 *    saat kerangka dua kolomnya menyala: di viewport 900 kolom baca 524px.
 *    Sisa 768px yang ada cuma ritme padding, dan itu memang peran Tailwind `md`
 *    menurut tabel breakpoint yang sama.
 *
 * 11. TIDAK ADA SEKSI YANG BISA TINGGAL JUDUL. Tiap seksi dirender hanya kalau
 *    isinya benar-benar ada, dan penjagaannya memakai apa yang dirender, bukan
 *    apa yang tersedia. Kalimat konsep pintu naik jadi PERNYATAAN PEMBUKA
 *    badan halaman, tanpa eyebrow dan tanpa h2, karena satu paragraf di bawah
 *    kepala seksi setinggi 48px itu persis pola judul-tanpa-isi. Daftar bentuk
 *    berbagi jadi seksi sendiri hanya untuk pintu yang belum punya `contribute`
 *    (kalau punya, `contribute` yang mengerjakan peran itu dengan lebih baik,
 *    dan merender keduanya cuma pengulangan).
 *
 * 12. NERACA DAMPAK SATU BARIS PER METRIK, bukan grid. Versi pertama merender
 *    metrik sebagai grid dua sampai tiga kolom, tiap metrik jadi sel bergaris
 *    dengan angka besarnya sendiri. DESIGN_PRINCIPLES bagian "Resolved
 *    tensions" sudah memutuskan bukti dampak harus satu rantai menerus dan
 *    menyebut grid counter independen sebagai dashboard yang salah. Ini
 *    keputusan yang sudah ditutup, jadi bentuknya kembali ke satu baris per
 *    metrik: angka di kiri, label di kanan, garis rambut di antaranya.
 *
 * 13. Foto: tiga, dan semuanya cuma untuk pintu yang punya dokumentasi (hari
 *    ini cuma makanan). TIDAK ADA slot foto yang bisa jatuh kosong:
 *    `Program.image` tidak dipakai sama sekali karena tidak satu pun entri
 *    program mengisinya, dan pintu tanpa entri di PINTU_PHOTOS merender jalur
 *    tanpa foto, bukan kotak abu penambal.
 *
 * 14. KEADAAN KOSONG DIUCAPKAN SATU KALI, di kaki hero lewat `statusLine`, dan
 *    itu pun sebagai kalimat maju. Versi pertama menulis aturan itu lalu
 *    melanggarnya sendiri tiga kali dalam satu halaman. Kalau nanti ada yang
 *    menambah kalimat "belum ada" di seksi lain, hapus salah satunya. Judul
 *    seksi yang MENDESKRIPSIKAN daftarnya (mis. "Program yang sedang
 *    disiapkan") bukan pelanggaran; kalimat penyangkalan yang berdiri sendiri
 *    itu yang dilarang.
 *
 * 15. Angka tulisan tangan di `content.stats` dan `content.env.stats` tetap
 *    tidak dirender, alasannya sama dengan varian 5: tidak bisa ditelusuri ke
 *    satu entri jejak pun, sementara angka nyata datang dari getPintuImpact.
 *    `env.headline` dipakai karena itu kalimat.
 *
 * 16. SEMUA SEKSI SETARA, TERMASUK KONSEP. Bentuk kepala seksi cuma ada satu di
 *    halaman ini: eyebrow, judul pendek, lalu kalimat pengantar. Versi pertama
 *    melanggarnya di satu tempat, yaitu Konsep, yang slot judulnya diisi
 *    `story.headline`. Akibatnya dua-duanya rusak sekaligus.
 *
 *    Rusak sebagai struktur: audit heading keenam pintu menunjukkan setiap
 *    heading yang terlihat panjangnya 12 sampai 53 karakter, kecuali yang satu
 *    ini, 117 sampai 192 karakter. Heading itu label seksi, bukan isi seksi,
 *    dan alat audit teknis menandai heading di atas ~70 karakter tepat karena
 *    itu gejala isi yang salah tag.
 *
 *    Rusak sebagai bacaan: 46px di kolom 736px cuma memuat sekitar 27 karakter
 *    per baris, jadi judulnya 5 sampai 6 baris di desktop dan 8 baris di 390px.
 *
 *    Perbaikannya menambah yang hilang, bukan mengecilkan yang ada. Konsep
 *    dapat judul pendek seperti lima seksi lain, dan kalimat pemilik situs
 *    turun UTUH ke slot pengantar. Judulnya literal komponen karena semua judul
 *    seksi di sini memang literal komponen dan sama di keenam pintu; ia label
 *    UI, bukan naskah. Naskahnya sendiri nol kata berubah, dan aturan itu ada
 *    di `consts.ts` di atas `story.headline` pintu pohon.
 *
 *    Dua jalan buntu yang sudah dicoba dan ditolak, jangan diulang: mengecilkan
 *    `.s1-h2` khusus Konsep (kalimat 192 karakter tetap salah tag, cuma jadi
 *    kecil), dan menaikkan eyebrow jadi h2 lalu membuang judulnya (Konsep jadi
 *    satu-satunya seksi tanpa judul, masalah setara yang sama persis).
 *
 * 17. DAFTAR PROGRAM SATU BENTUK BARIS, FOTONYA MILIK SEKSI. Versi pertama
 *    merender program aktif sebagai kartu dua kolom dan program yang belum
 *    dibuka sebagai baris kecil, dua bahasa untuk satu jenis benda. Lebih buruk
 *    lagi, foto ditempelkan ke kartu program PERTAMA saja, sehingga kartu itu
 *    berkolom `foto | badan` sementara kartu di bawahnya berkolom
 *    `badan | fitur`: judul programnya berpindah dari x=565 ke x=0 di tengah
 *    daftar. Itu sebab mekanis daftar itu terbaca berantakan, bukan warnanya.
 *
 *    Sekarang fotonya jadi anchor seksi di atas daftar, memenuhi tabel "One
 *    anchor per section" tanpa membuat satu baris berbeda dari saudaranya, dan
 *    keenam program memakai baris yang sama. Statusnya dibawa label kelompok
 *    (disebut sekali, bukan sekali per baris seperti "Sedang berjalan" yang
 *    dulu dicetak empat kali) plus sisi kanan baris. Bullet `detail.features`
 *    tidak ikut karena halaman program sudah merendernya dan halaman pintu itu
 *    channel tipis pemikul DAFTAR program, bukan detailnya.
 *
 * MASIH TERBUKA, DAN BUKAN PEKERJAAN FILE INI: `#pintu-lain` tidak punya
 * heading sama sekali, labelnya `<p class="s1-eyebrow">Pintu Lainnya`, pola
 * yang sama dengan yang diperbaiki di poin 16 dan belum diputuskan.
 *
 * Sejak `getProgramCover` ada di `programs.ts`, tiap program punya cover
 * sendiri, jadi thumbnail per baris daftar program secara data sudah mungkin.
 * Hari ini belum layak dipasang: cuma Jumat Berkah yang punya foto sendiri,
 * lima sisanya jatuh ke `program-promo.png` yang sama, jadi barisnya akan
 * memajang satu foto identik lima kali. Pasang kalau covernya sudah terisi.
 *
 * Ukuran huruf semuanya nilai skala tailwind.config.mjs
 * (11/12/13/14/16/18/22/26/30/34/40/56); clamp boleh asal kedua ujungnya token,
 * dan 56px plafon keras. Lebar shell memakai tier `wide` (1280), menyimpang
 * sengaja dari default `standard` halaman non-beranda, sama seperti varian 5.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import { PINTU, type Pintu, type PintuId, type CategoryContent } from '../../consts';
import type { Program } from '../../lib/programs';
import type { Impact as PintuImpact } from '../../lib/impact';
import { formatMetric } from '../../lib/format';
import heroJumatBerkah from '../../assets/images/hero-jumat-berkah.png';
import jumatBerkahDistribusi from '../../assets/images/jumat-berkah-distribusi.png';
import programPromo from '../../assets/images/program-promo.png';

interface Props {
  pintu: Pintu;
  content: CategoryContent | undefined;
  programs: Program[];
  active: Program[];
  upcoming: Program[];
  otherPintu: Pintu[];
  impact: PintuImpact;
  hasImpact: boolean;
  contactWa: string;
  notifyWa: string;
  jejakHref: string;
}

const {
  pintu,
  content,
  active,
  upcoming,
  otherPintu,
  impact,
  hasImpact,
  contactWa,
  notifyWa,
  jejakHref,
} = Astro.props;

/**
 * Foto per pintu. Cuma makanan yang punya, dan itu memang keadaan repo hari ini:
 * seluruh dokumentasi lapangan bertema penyaluran makanan siap saji. Foto itu
 * tidak dipinjamkan ke pintu lain karena isinya jelas terbaca sebagai pembagian
 * nasi kotak. Pintu tanpa entri di peta ini merender jalur tanpa foto.
 */
interface PintuPhotos {
  lead: ImageMetadata;
  leadAlt: string;
  caption: string;
  program: ImageMetadata;
  programAlt: string;
  story: ImageMetadata;
  storyAlt: string;
  storyCaption: string;
}

const PINTU_PHOTOS: Partial<Record<PintuId, PintuPhotos>> = {
  food: {
    lead: heroJumatBerkah,
    leadAlt:
      'Warga dan anak-anak menerima kotak makan pada penyaluran Jumat Berkah di halaman masjid',
    caption: 'Satu pagi Jumat, satu titik penyaluran, kotak makan yang berpindah tangan.',
    program: programPromo,
    programAlt: 'Relawan bagiberbagi.id menyerahkan tas bantuan kepada warga di gang kampung',
    story: jumatBerkahDistribusi,
    storyAlt: 'Meja penyaluran paket makanan Jumat Berkah bersama jamaah masjid',
    storyCaption:
      'Meja penyaluran di salah satu titik penerima. Semua foto diambil saat kegiatan berlangsung.',
  },
};

const photos = PINTU_PHOTOS[pintu.id];

/**
 * Teks konsep per pintu. Kalimat `what` dipakai di SEMUA pintu sebagai
 * pernyataan pembuka badan halaman, termasuk pintu yang sudah punya
 * `CATEGORY_CONTENT`, karena tidak satu pun pintu punya kalimat "apa ini"
 * di tempat lain. Daftar `examples` cuma dipakai kalau pintunya belum punya
 * `contribute`. Sengaja tanpa angka: yang belum berjalan tidak punya angka
 * yang bisa ditelusuri.
 */
interface PintuConcept {
  what: string;
  examples: string[];
}

const PINTU_CONCEPT: Record<PintuId, PintuConcept> = {
  food: {
    what: 'Berbagi Makanan menghubungkan dapur yang punya lebih dengan meja yang sedang kurang. Yang berpindah bukan cuma porsi, tapi kepastian bahwa hari itu ada yang dimakan.',
    examples: [
      'Donasi paket makan siap antar',
      'Surplus dapur yang masih layak',
      'Jadi mitra dapur penyalur',
      'Menyiapkan titik penerima',
    ],
  },
  goods: {
    what: 'Berbagi Barang memindahkan yang sudah tidak terpakai di satu rumah ke rumah yang masih memerlukannya. Barangnya tetap sama, yang berubah nilainya bagi yang menerima.',
    examples: [
      'Pakaian layak pakai',
