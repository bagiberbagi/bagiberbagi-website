  /* ---------- Program ---------- */
  /* Anchor seksi. 16/9 di kolom 904px jadi sekitar 508px, di bawah plafon 96px
     untuk area kosong karena bidangnya terisi foto, bukan kosong. 4/3 seperti
     versi kartu lama akan jadi 678px dan mendorong seluruh daftar keluar layar
     pertama. */
  .s1-prog-anchor {
    margin: 0 0 40px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--cat-tint);
  }
  .s1-prog-anchor-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .s1-plist-group + .s1-plist-group { margin-top: 34px; }
  .s1-plist-label {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #687281;
  }
  .s1-plist { list-style: none; margin: 0; padding: 0; }
  /* Baris, bukan kartu. `align-items: center` bukan `baseline` supaya sisi kanan
     tetap di tengah baris saat ringkasannya jatuh ke dua baris; dengan baseline
     ia terkunci ke baris pertama dan terlihat melayang. */
  .s1-plist-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    border-bottom: var(--hairline) solid var(--line);
  }
  .s1-plist-item:first-child { border-top: var(--hairline) solid var(--line); }
  .s1-plist-main { min-width: 0; }
  /* 22px, satu langkah skala di atas ringkasannya. Versi lama memakai 34px untuk
     program aktif dan 18px untuk yang belum dibuka, jarak dua langkah yang bikin
     satu daftar terbaca sebagai dua daftar. */
  .s1-plist-title {
    margin: 0 0 5px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #0f172a;
  }
  /* Sengaja TIDAK dipotong: ringkasan yang terputus di tengah kalimat lebih buruk
     daripada baris kedua. */
  .s1-plist-sum {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: #505d6f;
    max-width: 62ch;
  }
  .s1-plist-item.is-soon .s1-plist-title { color: #505d6f; }

  .s1-plist-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--cat-deep);
    text-decoration: none;
  }
  .s1-plist-go svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease-out;
  }
  .s1-plist-go:hover svg, .s1-plist-go:focus-visible svg { transform: translateX(4px); }
  /* Di bawah 520px teksnya disembunyikan dan panahnya tetap, supaya baris tidak
     pecah jadi dua tingkat cuma demi dua kata. */
  @container (max-width: 519px) {
    .s1-plist-go span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }

  .s1-plist-badge {
    flex: none;
    padding: 5px 13px;
    border-radius: 999px;
    border: var(--hairline) solid var(--line-band);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #687281;
    white-space: nowrap;
  }
  .s1-plist-cta { margin-top: 26px; }

  /* ---------- Untuk siapa ---------- */
  .s1-who-wrap { display: grid; gap: 36px; }
  @container (min-width: 520px) {
    /* Kolom pertamanya foto, jadi rasionya 1.5fr 1fr, sama dengan pola di .s1-prog.has-photo. */
    .s1-who-wrap.has-photo { grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: center; }
  }
  .s1-who-photo { margin: 0; }
  .s1-who-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 20px;
    background: var(--cat-tint);
  }
  .s1-who-photo figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 2px solid var(--cat);
    font-size: 14px;
    line-height: 1.55;
    color: #687281;
    max-width: 42ch;
  }
  /* Sengaja tanpa garis, sama seperti .s1-plain: titik di kiri sudah menandai
     tiap baris. */
  .s1-who { list-style: none; margin: 0; padding: 0; }
  .s1-who li {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    /* title-sm 18 → title 22 */
    font-size: clamp(18px, 2.4cqw, 22px);
    letter-spacing: -0.015em;
    color: #0f172a;
  }
  .s1-who li span { width: 9px; height: 9px; border-radius: 999px; background: var(--cat); }
  /* Tanpa foto, daftarnya dua kolom supaya frasa sependek "Panti asuhan" tidak
     menyisakan tiga perempat kolom kosong sebanyak jumlah itemnya. */
  @container (min-width: 520px) {
    .s1-who-wrap:not(.has-photo) .s1-who {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 44px;
    }
  }

  /* ---------- FAQ ---------- */
  .s1-faq { margin: 0; }
  .s1-faq-item {
    display: grid;
    gap: 10px;
    padding: 28px 0;
    border-top: var(--hairline) solid var(--line);
  }
  .s1-faq-item:last-child { border-bottom: var(--hairline) solid var(--line); }
  .s1-faq dt {
    font-size: clamp(18px, 2.4cqw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #0f172a;
    text-wrap: balance;
  }
  .s1-faq dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: #505d6f;
    max-width: 62ch;
