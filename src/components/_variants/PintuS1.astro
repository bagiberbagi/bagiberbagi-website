  /* ---------- Daftar polos (bentuk berbagi) ---------- */
  /* Sengaja tanpa garis antar item: titik bulat di kiri sudah menandai tiap
     baris, garis penuh di atasnya cuma mengulang penanda yang sama. Jaraknya
     dinaikkan dikit (16→20px) supaya jeda itu yang membawa pemisahannya,
     bukan garis. */
  .s1-plain { list-style: none; margin: 0; padding: 0; }
  .s1-plain li {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    font-size: clamp(18px, 2.4cqw, 22px);
    letter-spacing: -0.015em;
    color: #0f172a;
  }
  .s1-plain li span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--cat);
  }

  /* ---------- Daftar bernomor: cara ikut, atau alur ---------- */
  /* Bentuknya satu, dipakai `contribute` kalau ada dan dipakai alur kalau tidak.
     Blok yang memikul halaman tidak boleh memakai gaya catatan kaki. Sengaja
     tanpa garis antar langkah: angkanya sendiri (01, 02, 03...) sudah
     menandai urutan dan batas tiap langkah, garis di atasnya jadi penanda
     kedua untuk hal yang sama. Padding dinaikkan (26→30px) supaya jeda
     udaranya yang memisahkan. */
  .s1-steps { list-style: none; margin: 0; padding: 0; }
  .s1-step {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 4px 16px;
    padding: 30px 0;
  }
  /* 22px bold, bukan 15px: --cat-deep di atas latar terang cuma sekitar 3,9:1
     untuk pintu makanan, dan ambang 3:1 baru berlaku dari 22px bold ke atas. */
  .s1-step-n {
    grid-row: span 2;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--cat-deep);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .s1-step-title {
    margin: 0;
    /* title-sm 18 → heading-sm 26 */
    font-size: clamp(18px, 2.9cqw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #0f172a;
  }
  .s1-step-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #505d6f;
    max-width: 52ch;
  }
  /* Baris, bukan grid kolom: panjang deskripsi antar langkah bisa dua kali lipat
     berbeda, dan grid kolom menyamakan tinggi barisnya sehingga langkah pendek
     menyisakan empat sampai lima baris kosong di bawahnya. */
  @container (min-width: 520px) {
    .s1-step {
      grid-template-columns: 48px minmax(0, 0.85fr) minmax(0, 1.25fr);
      align-items: baseline;
      gap: 32px;
    }
    .s1-step-n { grid-row: auto; padding-top: 0; }
  }

  /* Strip alur, cuma dipakai sebagai ekor blok `contribute`. Isinya selalu
     `content.howItWorks` yang tahapnya pendek dan seragam, jadi grid kolom di
     sini tidak menghasilkan kolom ragged. Alur generik yang deskripsinya panjang
     tidak pernah sampai ke sini: ia naik jadi `.s1-steps`. */
  .s1-strip { margin-top: 56px; padding-top: 28px; border-top: var(--hairline) solid var(--line); }
  .s1-strip-label {
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #687281;
  }
  .s1-strip-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  @container (min-width: 520px) {
    .s1-strip-list { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 32px; }
  }
  .s1-strip-item {
    display: grid;
    gap: 6px;
    align-content: start;
    font-size: 14px;
    line-height: 1.55;
    color: #505d6f;
  }
  .s1-strip-item b { font-size: 16px; font-weight: 700; color: #0f172a; }
  .s1-strip-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--cat);
  }
  .s1-strip-note {
    margin: 28px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #687281;
    max-width: 62ch;
