const concept = PINTU_CONCEPT[pintu.id];

/**
 * Alur penerimaan tawaran, dipakai saat pintu belum punya `howItWorks` sendiri.
 * Isinya cuma apa yang terjadi sesudah pesan masuk, jadi berlaku untuk sumber
 * daya apa pun dan tidak mengklaim penyaluran, penerima terdata, atau laporan
 * foto yang belum pernah ada di pintu itu.
 */
const INTAKE_FLOW = [
  {
    title: 'Kamu kirim pesan',
    desc: 'Ceritakan lewat WhatsApp apa yang bisa kamu bagi lewat pintu ini.',
  },
  {
    title: 'Kami balas dan tanya detailnya',
    desc: 'Bentuknya apa, berapa banyak, kapan tersedia, dan sejauh mana kamu bisa ikut.',
  },
  {
    title: 'Kami carikan pasangannya',
    desc: 'Kalau ada kebutuhan lapangan yang cocok, pintu ini kami buka jadi program. Kalau belum ada, kontakmu kami simpan dan kami kabari begitu muncul.',
  },
];

const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;

const hasPrograms = active.length > 0 || upcoming.length > 0;
const programsAreOpen = active.length > 0;
/**
 * Label kelompok cuma dirender kalau kedua kelompok memang ada. Dengan satu
 * kelompok saja, judul seksinya ("Program di pintu X" vs "Program yang sedang
 * disiapkan") sudah mengatakan statusnya, jadi labelnya cuma pengulangan.
 */
const showProgramGroupLabels = active.length > 0 && upcoming.length > 0;
const forWhom = content?.forWhom ?? [];
const env = content?.env;
const contribute = content?.contribute ?? [];
const faq = content?.faq ?? [];

/**
 * Menukar isi pesan pada tautan wa.me yang sudah jadi. Dipakai karena pesan
 * `notifyWa` dirakit di halaman sebagai "beri tahu saya saat program {label}
 * dibuka", dan untuk pintu yang benar-benar nol program (waktu, ruang) itu
 * menyuruh pengunjung menanyakan program yang tidak pernah ada. Yang dibaca
 * penerima itu isi pesannya, bukan label tombolnya, jadi yang dibetulkan
 * pesannya.
 */
function waWithMessage(link: string, message: string): string {
  const q = link.indexOf('?');
  const base = q === -1 ? link : link.slice(0, q);
  return `${base}?text=${encodeURIComponent(message)}`;
}

const notifyHref = hasPrograms
  ? notifyWa
  : waWithMessage(notifyWa, `Halo, kabari saya kalau pintu ${pintu.label} sudah dibuka.`);

/**
 * Satu kalimat status di kaki hero. Ini SATU-SATUNYA tempat keadaan kosong
 * diucapkan di halaman ini, jadi cabang ketiganya kalimat maju, bukan
 * penyangkalan. Kalau nanti ada yang menambah kalimat "belum ada" di seksi lain,
 * hapus salah satunya.
 */
const statusLine =
  active.length > 0
    ? `Program yang sudah berjalan lewat pintu ini: ${active.map((p) => p.label).join(', ')}.`
    : upcoming.length > 0
      ? `${upcoming.length} program sedang kami siapkan di pintu ini.`
      : 'Pintu ini kami buka begitu mitra dan titik penerimanya siap. Kabarnya kami kirim lewat WhatsApp.';

// Nomor pintu di kaki hero. Fakta kecil yang selalu ada di kelima pintu, jadi ia
// mengisi sisi kanan baris tanpa pernah jatuh kosong.
const pintuIndex = PINTU.findIndex((p) => p.id === pintu.id) + 1;
const pad2 = (n: number) => String(n).padStart(2, '0');

/**
 * Seksi bentuk berbagi cuma untuk pintu yang belum punya `contribute`. Kalau
 * `contribute` ada, ia mengerjakan peran yang sama dengan deskripsi per item,
 * dan untuk makanan tiga dari empat contohnya memang kalimat yang sama.
 */
const showForms = contribute.length === 0;

/**
 * Kepala seksi cerita mengikuti sisi yang benar-benar TERISI DAN TERENDER.
 * `hasStory` dulu cuma `Boolean(env)`, padahal isi seksinya dipagari `photos`
 * dan `forWhom`, jadi pintu yang punya `env` tanpa `forWhom` dan tanpa foto
 * merender eyebrow, h2, jarak 48px, lalu tidak ada apa-apa.
 */
const hasWhomList = forWhom.length > 0;
const storyEyebrow = hasWhomList ? 'Untuk Siapa' : 'Dampak Ikutan';
const storyTitle = hasWhomList ? 'Siapa yang terbantu' : (env?.headline ?? '');
const storyNote = hasWhomList ? env?.headline : undefined;
const hasStory = hasWhomList || Boolean(photos && env?.headline);

/**
 * Satu blok memikul "cara ikut" dan "alur" sekaligus. Kalau `contribute` terisi,
 * ia yang jadi daftar bernomor dan alur turun jadi strip kecil di kakinya. Kalau
 * kosong, ALUR yang naik jadi daftar bernomornya, memakai bentuk blok yang sama
 * persis. Versi pertama menaikkan alur jadi isi utama tapi membiarkan gayanya
 * gaya catatan kaki: item 14px di bawah h2 40px, jadi blok terakhir halaman
 * kosong justru berisi teks terkecil di seluruh halaman.
 */
const flowIsPintuSpecific = Boolean(content?.howItWorks?.length);
const flowSteps = flowIsPintuSpecific ? content!.howItWorks! : INTAKE_FLOW;
const joinAsSteps = contribute.length === 0;
const stepItems = joinAsSteps ? flowSteps : contribute;
const joinId = joinAsSteps ? 'alur' : 'cara-ikut';
const joinEyebrow = joinAsSteps ? 'Alur' : 'Cara Ikut';
const joinTitle = joinAsSteps
  ? flowIsPintuSpecific
    ? 'Alur singkatnya'
    : 'Yang terjadi sesudah kamu mengirim pesan'
  : 'Yang bisa kamu bagi';
const joinLead = joinAsSteps
  ? flowIsPintuSpecific
    ? 'Tahap yang dilalui setiap penyaluran di pintu ini.'
    : 'Ini yang kami kerjakan begitu tawaranmu masuk, dari pesan pertama sampai pasangannya ketemu.'
  : 'Pilih jalan yang paling dekat dengan yang sudah kamu punya. Semuanya berakhir di penerima yang sama.';

// Ekor blok cuma ada di cabang `contribute`, tempat ia benar-benar membawa
// informasi baru. Di cabang alur, judul bloknya sudah mengatakan bahwa ini
// tahap penerimaan tawaran, jadi kalimat tambahan cuma jadi penyangkalan kedua
// dan versi pertama malah melempar pembaca ke rekam jejak yang pasti kosong.
const flowNote = joinAsSteps
  ? undefined
  : 'Detail tiap tahap berbeda antar program, jadi versi lengkapnya ada di halaman program masing-masing.';

// Judul seksi program mendeskripsikan daftar yang benar-benar ada di bawahnya.
const programTitle = programsAreOpen
  ? `Program di pintu ${pintu.label}`
  : 'Program yang sedang disiapkan';
const programLead = programsAreOpen
  ? 'Pintu adalah jalan masuknya, program adalah kegiatan yang benar-benar berjalan di lapangan.'
  : 'Bentuknya sudah dirancang. Yang masih dicari mitra penyalur dan titik penerimanya.';

// Daftar isi rel dirakit dari blok yang benar-benar dirender, urutannya persis
// urutan blok di kolom baca, jadi tidak pernah ada tautan yang menunjuk ke seksi
// yang tidak ada dan tidak pernah ada tautan yang melompat mundur.
const jumpLinks: { href: string; label: string }[] = [];
if (content?.story) jumpLinks.push({ href: '#konsep', label: 'Konsep' });
if (showForms) jumpLinks.push({ href: '#bentuk', label: 'Bentuk berbagi' });
if (hasImpact) jumpLinks.push({ href: '#rekam-jejak', label: 'Rekam jejak' });
jumpLinks.push({ href: `#${joinId}`, label: joinAsSteps ? 'Alurnya' : 'Cara ikut' });
if (hasPrograms) {
  jumpLinks.push({ href: '#program', label: programsAreOpen ? 'Program' : 'Program yang disiapkan' });
}
if (hasStory) {
  jumpLinks.push({ href: '#untuk-siapa', label: hasWhomList ? 'Untuk siapa' : 'Dampak ikutan' });
}
if (faq.length > 0) jumpLinks.push({ href: '#tanya', label: 'Pertanyaan' });
jumpLinks.push({ href: '#pintu-lain', label: 'Pintu lainnya' });

const ARROW_D = 'M5 12h14';
const ARROW_HEAD = 'm13 6 6 6-6 6';
---

<div class="s1" style={styleVars}>
  {/* HERO: satu kolom kiri, judul sebesar mungkin, sisanya ruang. Ditarik naik
      74px supaya bidangnya menembus ke belakang pil navbar. 74 = 10px margin +
      64px pil, TINGGI DIAM di puncak halaman. Di sini pil memang masih diam dan
      belum punya shadow, jadi 74 angka yang benar. Rel dan target lompat
      memakai 94 karena mereka bekerja saat halaman sudah digulir; lihat catatan
      nomor 4 di kepala file sebelum menyamakan kedua angka itu. */}
  <section class="s1-hero">
    <Container width="wide">
      <nav class="s1-crumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href="/#pintu">Pintu Berbagi</a>
        <span aria-hidden="true">/</span>
        <span class="s1-crumb-now">{pintu.label}</span>
      </nav>

      <p class="s1-eyebrow" data-fade>{pintu.english}</p>
      <h1 class="s1-h1" data-fade>{pintu.label}</h1>
      <p class="s1-lead s1-lead-hero" data-fade>{pintu.tagline}</p>

      <div class="s1-actions" data-fade>
        <a
          href={contactWa}
          target="_blank"
          rel="noopener"
          data-track="contact_wa"
          data-track-pintu={pintu.slug}
          class="s1-btn"
        >
          Hubungi Kami
        </a>
        {/* Tombol kedua tidak pernah menyuruh pengunjung keluar dari halaman ini:
            ada jejak ia ke jejak, ada program ia turun ke program, tidak ada
            apa-apa ia jadi jalan untuk dikabari. */}
        {hasImpact ? (
          <a href={jejakHref} class="s1-btn s1-btn-ghost">Lihat rekam jejak</a>
        ) : hasPrograms ? (
          <a href="#program" class="s1-btn s1-btn-ghost">Lihat program di pintu ini</a>
        ) : (
          <a
            href={notifyHref}
            target="_blank"
            rel="noopener"
            data-track="notify_wa"
            data-track-slot="hero"
            data-track-pintu={pintu.slug}
            class="s1-btn s1-btn-ghost"
          >
            Beri tahu saya saat pintu ini dibuka
          </a>
        )}
      </div>

      <div class="s1-hero-foot" data-fade>
        <p class="s1-hero-status">{statusLine}</p>
        <p class="s1-hero-count">
          <b>{pad2(pintuIndex)}</b>
          <span>dari {pad2(PINTU.length)} pintu berbagi</span>
        </p>
      </div>
    </Container>
  </section>

  {/* MOMEN: satu foto full-bleed, cuma untuk pintu yang punya dokumentasi. */}
  {photos && (
    <section class="s1-moment">
      <Image
        src={photos.lead}
        alt={photos.leadAlt}
        widths={[640, 960, 1280]}
        sizes="100vw"
        loading="eager"
        class="s1-moment-img"
      />
      <div class="s1-moment-scrim" aria-hidden="true"></div>
      <Container width="wide" class="s1-moment-inner">
        <p class="s1-caption">{photos.caption}</p>
      </Container>
    </section>
  )}

  {/* BADAN HALAMAN: kolom baca di kiri, rel garis di kanan. Kolom baca lebih
      dulu di DOM, bukan cuma lebih dulu secara visual, jadi di bawah 900px
      (tempat rel tidak dirender sama sekali) urutan bacanya tetap benar dan
      tidak perlu satu pun aturan `order`.

      Satu-satunya elemen yang membungkus rel adalah garis vertikal berwarna
      pintu, dan garis itu milik TRACK-nya (setinggi badan halaman), bukan milik
      rel (setinggi isinya), supaya warnanya menemani seluruh gulir. */}
  <section class="s1-body">
    <Container width="wide">
      <div class="s1-grid">
        <div class="s1-flow">
          {/* KONSEP / PERNYATAAN PEMBUKA. `content.story` menang kalau pintunya
              sudah punya satu: itu tulisan asli pemilik situs (headline,
              paragraf, kutipan penutup), dan `PINTU_CONCEPT[...].what` cuma
              tambalan generik untuk pintu yang belum ditulisi ceritanya
              sendiri. Sekarang keenam pintu produksi sudah punya `story`,
              jadi cabang tambalan ini praktis hanya jaring pengaman untuk
              pintu baru di masa depan. Dua-duanya dibungkus `.s1-blk` yang
              sama supaya jarak dan garis pemisah ke blok berikutnya konsisten
              dengan blok lain; blok pertama sendiri tidak pernah menerima
              garis pemisah di ATASnya karena tidak ada saudara sebelum dia. */}
          {content?.story ? (
            <section id="konsep" class="s1-blk">
              {/* Kepala seksi ini berbentuk sama persis dengan lima saudaranya:
                  eyebrow, judul pendek, lalu kalimat pengantar. Sebelumnya
                  slot judulnya diisi `story.headline`, satu kalimat 117 sampai
                  192 karakter, jadi Konsep satu-satunya seksi yang tidak punya
                  judul sementara semua seksi lain punya.

                  "Kenapa pintu ini ada" ditulis di sini, bukan di `consts.ts`,
                  karena judul seksi di halaman ini memang literal komponen:
                  "Yang sudah tercatat", "Yang bisa kamu bagi", "Siapa yang
                  terbantu", "Yang paling sering ditanyakan", semuanya sama di
                  keenam pintu. Jadi ini label UI, bukan naskah pemilik situs.

                  Kalimat pemiliknya sendiri tidak disentuh sama sekali. Ia
                  turun utuh ke slot ketiga, memakai `.s1-lead` yang sama persis
                  dengan seksi lain. Sempat dicoba memberinya skala sendiri yang
                  lebih besar, dengan alasan ia memikul argumen seksinya, dan
                  hasilnya kepala seksi ini menyimpang di tiga sumbu sekaligus
                  (30px bukan 19px, tinta bukan abu, 24px bukan 18px) sehingga
                  Konsep kembali jadi satu-satunya yang beda. Bobot kalimatnya
                  memang datang dari isinya, bukan dari ukuran hurufnya. */}
              <header class="s1-head">
                <p class="s1-eyebrow" data-fade>Konsep</p>
                <h2 class="s1-h2" data-fade>Kenapa pintu ini ada</h2>
                <p class="s1-lead s1-lead-ink" data-fade>{content.story.headline}</p>
              </header>

              <div class="s1-story">
                {content.story.paragraphs.map((par) => (
                  <p class="s1-story-p" data-fade>{par}</p>
                ))}
              </div>

              {content.story.closing && (
                <p class="s1-story-closing" data-fade>{content.story.closing}</p>
              )}
            </section>
          ) : (
            <div class="s1-blk">
              <p class="s1-open" data-fade>{concept.what}</p>
            </div>
          )}

          {showForms && (
            <section id="bentuk" class="s1-blk">
              <header class="s1-head">
                <p class="s1-eyebrow" data-fade>Bentuk Berbagi</p>
                <h2 class="s1-h2" data-fade>Yang dicari di pintu ini</h2>
              </header>

              <ul class="s1-plain" data-fade>
                {concept.examples.map((item) => (
                  <li><span aria-hidden="true"></span>{item}</li>
                ))}
              </ul>
            </section>
          )}

          {hasImpact && (
            <section id="rekam-jejak" class="s1-blk">
              <header class="s1-head">
                <p class="s1-eyebrow" data-fade>Rekam Jejak</p>
                <h2 class="s1-h2" data-fade>Yang sudah tercatat</h2>
                <p class="s1-lead" data-fade>
                  Angka di bawah dijumlahkan dari {impact.jejakCount.toLocaleString('id-ID')} kegiatan
                  yang sudah kami dokumentasikan di pintu {pintu.label}. Tiap kegiatan punya halaman
                  sendiri berisi foto dan catatan lapangannya.
                </p>
              </header>

              {/* Satu baris per metrik: angka di tepi kiri, labelnya di tepi
                  kanan, garis rambut di antaranya. Bentuk grid sempat dipakai
                  di sini dan itu membalik keputusan "Resolved tensions" yang
                  sudah ditutup, yang menyebut grid counter independen sebagai
                  dashboard. Baris juga membuat 1, 2, atau 5 metrik sama-sama
                  duduk rapi tanpa satu pun sel kosong. */}
              <div class="s1-ledger">
                {impact.metrics.map((m) => (
                  <div class="s1-metric" data-fade>
                    <span class="s1-num">{formatMetric(m)}</span>
                    <span class="s1-metric-label">{m.label}</span>
                  </div>
                ))}
              </div>

              <div class="s1-foot">
                <p class="s1-foot-text">
                  Setiap angka berasal dari kegiatan yang sudah terjadi dan terdokumentasi, bukan
                  dari target.
                </p>
                <a href={jejakHref} class="s1-link">
                  Telusuri jejak {pintu.label}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
                </a>
              </div>
            </section>
          )}

          <section id={joinId} class="s1-blk">
            <header class="s1-head">
              <p class="s1-eyebrow" data-fade>{joinEyebrow}</p>
              <h2 class="s1-h2" data-fade>{joinTitle}</h2>
              <p class="s1-lead" data-fade>{joinLead}</p>
            </header>

            <ol class="s1-steps">
              {stepItems.map((s, i) => (
                <li class="s1-step" data-fade>
                  <span class="s1-step-n">{pad2(i + 1)}</span>
                  <h3 class="s1-step-title">{s.title}</h3>
                  <p class="s1-step-desc">{s.desc}</p>
                </li>
              ))}
            </ol>

            {/* Strip alur cuma muncul saat daftar bernomor di atasnya sudah
                dipakai `contribute`. Kalau tidak, alur ITU daftar bernomornya
                dan strip ini tidak pernah dirender. */}
            {!joinAsSteps && (
              <div class="s1-strip">
                <p class="s1-strip-label">Alur singkatnya</p>
                <ol class="s1-strip-list">
                  {flowSteps.map((s) => (
                    <li class="s1-strip-item" data-fade>
                      <span class="s1-strip-dot" aria-hidden="true"></span>
                      <b>{s.title}</b>
                      <span>{s.desc}</span>
                    </li>
                  ))}
                </ol>
                {flowNote && <p class="s1-strip-note">{flowNote}</p>}
              </div>
            )}
          </section>

          {/* PROGRAM: baris editorial selebar kolom. Program pertama membawa
              fotonya kalau pintunya punya foto; kalau tidak, barisnya berubah
              bentuk jadi teks plus daftar cakupan, bukan menyisakan sel kosong.
              Seluruh seksi, kepala seksinya sekalian, cuma dirender kalau ada
              program. */}
          {hasPrograms && (
            <section id="program" class="s1-blk">
              <header class="s1-head">
                <p class="s1-eyebrow" data-fade>Program</p>
                <h2 class="s1-h2" data-fade>{programTitle}</h2>
                <p class="s1-lead" data-fade>{programLead}</p>
              </header>

              {/* FOTO = ANCHOR SEKSI, BUKAN MILIK SATU PROGRAM. Versi pertama
                  menempelkannya ke kartu program pertama, dan akibatnya kartu
                  itu berkolom `foto | badan` sementara tiga kartu di bawahnya
                  berkolom `badan | fitur`. Judul programnya jadi berpindah dari
                  x=565 ke x=0 di tengah daftar, dan itu sebab utama daftar ini
                  terbaca berantakan. Sebagai anchor seksi ia memenuhi tabel
                  "One anchor per section" di DESIGN_PRINCIPLES tanpa membuat
                  satu baris berbeda dari saudaranya.

                  Cuma pintu makanan yang punya foto, jadi jalur tanpa foto
                  bukan kasus pinggir melainkan keadaan lima pintu lainnya. */}
              {photos && (
                <figure class="s1-prog-anchor" data-fade>
                  <Image
                    src={photos.program}
                    alt={photos.programAlt}
                    widths={[640, 900, 1200, 1600]}
                    sizes="(min-width: 900px) 904px, 100vw"
                    loading="lazy"
                    class="s1-prog-anchor-img"
                  />
                </figure>
              )}

              {/* SATU BENTUK BARIS UNTUK SEMUA PROGRAM, apa pun statusnya.
                  Sebelumnya program aktif dirender sebagai kartu 34px berkolom
                  dua sementara program yang belum dibuka jadi baris 18px, dua
                  bahasa untuk satu jenis benda. Sekarang keduanya baris yang
                  sama dan statusnya dibawa oleh label kelompok plus sisi kanan
                  baris, bukan oleh ukuran hurufnya.

                  Bullet `detail.features` sengaja tidak ikut ke sini. Halaman
                  program sudah merendernya (`program/[program].astro`), dan
                  menurut `routing-taxonomy.md` halaman pintu itu channel tipis
                  yang memikul DAFTAR program, bukan detail tiap program. */}
              {active.length > 0 && (
                <div class="s1-plist-group">
                  {showProgramGroupLabels && <p class="s1-plist-label">Sedang berjalan</p>}
                  <ul class="s1-plist">
                    {active.map((p) => (
                      <li class="s1-plist-item" data-fade>
                        <div class="s1-plist-main">
                          <h3 class="s1-plist-title">{p.label}</h3>
                          <p class="s1-plist-sum">{p.summary}</p>
                        </div>
                        {p.href ? (
                          <a
                            href={p.href}
                            class="s1-plist-go"
                            data-track="pintu_program"
                            data-track-program={p.slug}
                          >
                            <span>Lihat program</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
                          </a>
                        ) : (
                          <span class="s1-plist-badge">Halamannya disiapkan</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {upcoming.length > 0 && (
                <div class="s1-plist-group">
                  {showProgramGroupLabels && <p class="s1-plist-label">Belum dibuka</p>}
                  <ul class="s1-plist">
                    {upcoming.map((p) => (
                      <li class="s1-plist-item is-soon" data-fade>
                        <div class="s1-plist-main">
                          <h3 class="s1-plist-title">{p.label}</h3>
                          <p class="s1-plist-sum">{p.summary}</p>
                        </div>
                        <span class="s1-plist-badge">Segera</span>
                      </li>
                    ))}
                  </ul>
                  <a
                    href={notifyWa}
                    target="_blank"
                    rel="noopener"
                    data-track="notify_wa"
                    data-track-slot="program"
                    data-track-pintu={pintu.slug}
                    class="s1-link s1-plist-cta"
                  >
                    Beri tahu saya saat program di pintu ini dibuka
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
                  </a>
                </div>
              )}
            </section>
          )}

          {/* UNTUK SIAPA: di varian 5 ini seksi paling sepi, isinya satu baris
              frasa pendek di dalam seksi setinggi 350px. Di sini fotonya yang
              membayar ruang itu, dan daftarnya jadi baris bergaris di sebelahnya.
              Pintu tanpa foto merender daftarnya dua kolom, bukan menyisakan sel
              gambar yang menganga. */}
          {hasStory && (
            <section id="untuk-siapa" class="s1-blk">
              <header class="s1-head">
                <p class="s1-eyebrow" data-fade>{storyEyebrow}</p>
                <h2 class="s1-h2" data-fade>{storyTitle}</h2>
                {storyNote && <p class="s1-lead" data-fade>{storyNote}</p>}
              </header>

              <div class:list={['s1-who-wrap', photos && 'has-photo']}>
                {photos && (
                  <figure class="s1-who-photo" data-fade>
                    <Image
                      src={photos.story}
                      alt={photos.storyAlt}
                      widths={[420, 640, 900, 1200]}
                      sizes="(min-width: 900px) 420px, 100vw"
                      loading="lazy"
                      class="s1-who-img"
                    />
                    <figcaption>{photos.storyCaption}</figcaption>
                  </figure>
                )}

                {hasWhomList && (
                  <ul class="s1-who" data-fade>
                    {forWhom.map((who) => (
                      <li><span aria-hidden="true"></span>{who}</li>
                    ))}
                  </ul>
                )}
              </div>
            </section>
          )}

          {/* FAQ: teks utuh, tanpa akordeon. Tiga pertanyaan yang langsung terbaca
              lebih lapang daripada tiga baris yang harus diklik dulu. */}
          {faq.length > 0 && (
            <section id="tanya" class="s1-blk">
              <header class="s1-head">
                <p class="s1-eyebrow" data-fade>Pertanyaan</p>
                <h2 class="s1-h2" data-fade>Yang paling sering ditanyakan</h2>
              </header>

              <dl class="s1-faq">
                {faq.map((item) => (
                  <div class="s1-faq-item" data-fade>
                    <dt>{item.q}</dt>
                    <dd>{item.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
        </div>

        {/* REL. Kepala berjalan plus daftar isi, tidak lebih. Bukan heading
            level apa pun: h1 halaman ini ada di hero, dan kolom samping tidak
            boleh menyela urutan h1 → h2 → h3 di kolom baca. */}
        <div class="s1-rail-track">
          <div class="s1-rail">
            <div class="s1-rail-id" data-fade>
              <span class="s1-rail-mark" aria-hidden="true">
                <Icon name={pintu.icon} size={22} />
              </span>
              <span class="s1-rail-en">{pintu.english}</span>
              <span class="s1-rail-name">{pintu.label}</span>
            </div>

            <nav class="s1-rail-nav" aria-label="Isi halaman ini" data-fade>
              <p class="s1-rail-label">Di halaman ini</p>
              <ul>
                {jumpLinks.map((l) => (
                  <li><a href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* PINTU LAIN: keluar dari grid, jadi rel berhenti lengket persis di batas
      isi halaman ini. Latarnya hangat supaya pergantian band menandai pergantian
      peran, bukan sekadar berkedip.

      SENGAJA TANPA `.s1-head` (eyebrow+h2+lead). Ini seksi tambahan, bukan
      konten utama, dan headline 46px yang sama dengan Konsep/Program membuat
      navigasi silang ini menyita perhatian sebesar isi halaman yang sebenarnya
      dicari pengunjung. Label kecil saja sudah cukup.

      PIL, BUKAN BARIS. Baris penuh lebar (ikon+nama+tagline+panah, satu per
      baris) masih menyita perhatian sebesar isi utama walau headernya sudah
      dikecilkan, karena bentuknya sendiri tetap berat: lima baris setinggi
      penuh, bukan satu kelompok kecil. Pil (ikon 28px + nama, tanpa tagline,
      melipat ke baris berikutnya) menurunkan bobotnya lagi, dan meminjam
      kosakata yang sudah ada di situs ini: chip filter pintu di /jejak/.
      Tagline dibuang karena pengunjung sudah menemuinya di mega-menu dan
      beranda; di seksi tambahan begini nama pintu saja cukup. */}
  <section id="pintu-lain" class="s1-index-band">
    <Container width="wide">
      <p class="s1-eyebrow s1-index-label" data-fade>Pintu Lainnya</p>

      <div class="s1-doors">
        {otherPintu.map((p) => (
          <a
            href={`/berbagi-${p.slug}/`}
            class="s1-door"
            style={`--cat:${p.color};--cat-tint:${p.colorTint};--cat-deep:${p.colorDeep}`}
            data-fade
          >
            <span class="s1-door-icon"><Icon name={p.icon} size={14} /></span>
            <span class="s1-door-label">{p.label}</span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  {/* PENUTUP: satu-satunya bidang gelap dan satu-satunya kepala yang ditengahkan,
      yaitu pengecualian yang memang diizinkan untuk minimal closing CTA.
      Watermark tidak lagi hilang di mobile, cuma mengecil, supaya penutupnya tak
      jadi blok tengah polos di atas bidang ink setinggi 300px. */}
  <section class="s1-close">
    <Container width="wide">
      <div class="s1-close-inner">
        <p class="s1-eyebrow s1-eyebrow-dark" data-fade>{pintu.label}</p>
        <h2 class="s1-h2 s1-h2-dark" data-fade>
          {content?.ctaTitle ?? `Ingin berkontribusi lewat ${pintu.label}?`}
        </h2>
        <p class="s1-lead s1-lead-dark" data-fade>
          {content?.ctaText ?? 'Ceritakan apa yang bisa kamu bagi, tim kami bantu menyalurkannya.'}
        </p>
        <a
          href={contactWa}
          target="_blank"
          rel="noopener"
          data-track="pintu_cta"
          data-track-pintu={pintu.slug}
          class="s1-btn s1-btn-light"
          data-fade
        >
          Hubungi Kami
        </a>
      </div>
      <span class="s1-close-mark" aria-hidden="true">
        <Icon name={pintu.icon} size={220} />
      </span>
    </Container>
  </section>
</div>

<style>
  /* DUA peran garis, dua nilai, dua-duanya token tailwind.config.mjs.
       --line       token `border` #EEF0F3, garis RITME di dalam blok: baris
                    daftar, baris metrik, baris FAQ. Sengaja nyaris tak terlihat.
       --line-band  token gray.300 #B4BCC8, pemisah STRUKTUR antar blok dan di
                    kaki hero. Di halaman yang bahasanya garis, pemisah blok tidak
                    boleh senyap: #EEF0F3 di atas putih cuma sekitar 1,06:1 dan di
                    atas latar hangat benar-benar hilang.
     Batas tombol tidak memakai dua-duanya tapi gray.400 #687281 supaya lolos 3:1.

     --header-clear: tepi bawah cat pil navbar SAAT HALAMAN SUDAH DIGULIR.
     74px tinggi diam + 10px translateY (Header.astro, >= 860px) = 84px tepi pil,
     ditambah ekor `box-shadow: 0 14px 28px -18px` sekitar 10px = 94px. Semua
     angka yang harus lolos header di file ini diturunkan dari sini, jadi kalau
     tinggi atau bayangan header berubah cukup ubah satu baris. Angka 74 di
     komentar hero SENGAJA berbeda: di sana pil masih diam dan belum bershadow. */
  .s1 {
    --line: #eef0f3;
    --line-band: #b4bcc8;
    --header-clear: 94px;
    /* 1px CSS diberi dua piksel perangkat di layar retina, jadi tiap garis
       pemisah di halaman ini terbaca dua kali lebih tebal daripada niatnya.
       Footer sudah menambal masalah yang sama (lihat Footer.astro, commit
       "draw the footer rules as true hairlines on retina"): di atas 2dppx,
       0.5px CSS digambar tepat satu piksel perangkat, garis rambut yang
       sesungguhnya. Di bawah 2dppx dibiarkan 1px karena 0.5px dibulatkan dan
       bisa hilang sama sekali. Satu variabel di sini dipakai oleh SEMUA garis
       pemisah netral di file ini (bukan garis aksen berwarna --cat, yang
       memang sengaja tebal), jadi menebalkan atau menipiskan cukup ubah satu
       angka, tidak perlu menyentuh puluhan selector satu per satu. */
    --hairline: 1px;
  }
  @media (min-resolution: 2dppx), (-webkit-min-device-pixel-ratio: 2) {
    .s1 { --hairline: 0.5px; }
  }

  /* Target lompat mendarat di bawah header, bukan di belakangnya. Tanpa baris
     ini eyebrow dan sebagian h2 seksi tujuan tertutup pil navbar tiap kali
     tautan rel diklik, dan karena `html { scroll-behavior: smooth }` diset di
     BaseLayout pengunjung menonton animasi yang berakhir di judul tersembunyi. */
  .s1 [id] { scroll-margin-top: calc(var(--header-clear) + 24px); }

  /* ---------- Rumus kepala seksi, sama di seluruh halaman ---------- */
  .s1-head { max-width: 46rem; margin: 0 0 48px; }

  /* Disamakan angka per angka dengan `.eyebrow` global (global.css): 13px,
     700, tracking-wide (0.025em), bukan penemuan baru. Beda dari versi Tailwind
     cuma warnanya, dipatok ke identitas pintu (`--cat-deep`) alih-alih
     brand-orange tetap, sama seperti eyebrow "Konsep" di halaman pintu yang
     lama. Tanpa garis dekoratif: `.eyebrow` di seluruh situs tidak pernah
     bawa satu, jadi menambah satu di sini justru bikin halaman pintu terasa
     beda bahasa dari beranda. */
  .s1-eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    color: var(--cat-deep);
  }
  .s1-eyebrow-dark { color: rgba(255, 255, 255, 0.85); }

  /* Ujung clamp selalu nilai token. H1 berhenti di display-lg 56px, step terbesar
     yang ada di config. Acuannya viewport karena hero memang selebar viewport. */
  .s1-h1 {
    margin: 0;
    /* heading-lg 34 → display-lg 56 */
    font-size: clamp(34px, 6.4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: #0f172a;
    text-wrap: balance;
  }
  /* Versi viewport dipakai di luar kolom baca: hero, #pintu-lain, penutup.
     Di dalam kolom baca ia ditimpa versi `cqw` di bawah. */
  .s1-h2 {
    margin: 0;
    /* clamp(30px, 4vw, 46px), identik dengan .tr-h2/.imp-h2 di beranda.
       Ceiling sebelumnya cuma 40px, terasa lebih kalem dari H2 beranda tanpa
       alasan, padahal keduanya seharusnya satu skala. */
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: #0f172a;
    text-wrap: balance;
  }
  .s1-h2-dark { color: #fff; }

  .s1-lead {
    margin: 18px 0 0;
    /* clamp(17px, 1.5vw, 19px), identik dengan lead .tr-head/.imp-head di
       beranda. 18-22px sebelumnya bikin lead halaman pintu terbaca lebih
       berat daripada lead section manapun di beranda. */
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.62;
    color: #505d6f;
    max-width: 58ch;
    text-wrap: pretty;
  }
  .s1-lead-hero { margin-top: 24px; }
  .s1-lead-dark { color: rgba(255, 255, 255, 0.78); }
  /* Lead yang isinya kalimat pemilik situs, bukan kalimat penjelas yang ditulis
     komponen ini. Bedanya cuma warna, dan itu memang satu-satunya sumbu yang
     boleh bergerak di sini: ukuran, bobot, dan jaraknya harus tetap sama dengan
     lead seksi lain supaya kepala seksinya tidak berubah tinggi. Abu 19px di
     atas paragraf abu 16px cuma berbeda 3px tanpa beda warna, jadi kalimat
     sepanjang ini melebur jadi paragraf pertama. Tinta memisahkannya tanpa
     membesarkannya. */
  .s1-lead-ink { color: #0f172a; }

  /* ---------- Hero ---------- */
  /* -74px = 10px margin atas + 64px pil navbar, TINGGI DIAM. Lihat catatan di
     markup: angka ini sengaja bukan 84 dan bukan 94. */
  .s1-hero {
    position: relative;
    margin-top: -74px;
    padding: calc(74px + 72px) 0 96px;
    background: #f7f6f3;
    overflow: hidden;
  }
  .s1-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 88% 0%, var(--cat-tint), transparent 62%);
    pointer-events: none;
  }
  .s1-hero > * { position: relative; }
  @media (min-width: 768px) {
    .s1-hero { padding: calc(74px + 104px) 0 128px; }
  }

  .s1-crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 56px;
    font-size: 13px;
    font-weight: 600;
    color: #687281;
  }
  .s1-crumb a { transition: color 0.18s ease; }
  .s1-crumb a:hover { color: var(--cat-deep); }
  .s1-crumb span[aria-hidden] { color: #b4bcc8; }
  .s1-crumb-now { color: #0f172a; }

  .s1-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .s1-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    border-radius: 999px;
    background: #0f172a;
    color: #fff;
    font-weight: 700;
    /* token body 16px */
    font-size: 16px;
    border: 1.5px solid #0f172a;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .s1-btn:hover { transform: translateY(-2px); }
  /* Batas tombol membawa makna, jadi ia harus lolos 3:1. gray.400 #687281 di atas
     hero hangat #F7F6F3 sekitar 4,5:1. TIDAK ADA tombol berlatar warna pintu:
     putih di atas #F4791D cuma 3,0:1. */
  .s1-btn-ghost {
    background: transparent;
    color: #0f172a;
    border-color: #687281;
  }
  .s1-btn-ghost:hover { border-color: var(--cat); }
  .s1-btn-light { background: #fff; color: #0f172a; border-color: #fff; }

  .s1-hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px 24px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: var(--hairline) solid var(--line-band);
  }
  .s1-hero-status {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #505d6f;
    max-width: 52ch;
  }
  /* Nomor pintu. 22px bold, bukan 15px: --cat-deep di atas band hangat cuma
     sekitar 3,9:1 untuk pintu makanan, dan ambang 3:1 baru berlaku dari 22px
     bold ke atas. Jangan dikecilkan tanpa menukar warnanya ke ink. */
  .s1-hero-count {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: #687281;
  }
  .s1-hero-count b {
    font-size: 22px;
    letter-spacing: 0.02em;
    color: var(--cat-deep);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Momen foto ---------- */
  .s1-moment {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 58vh;
    overflow: hidden;
  }
  .s1-moment-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .s1-moment-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 18, 30, 0.78), rgba(10, 18, 30, 0.18) 55%, rgba(10, 18, 30, 0.04));
  }
  /* `width: 100%` di sini bukan hiasan. `.s1-moment` itu flex container, jadi
     Container tier `wide` di dalamnya jadi flex item dan lebarnya menyusut ke
     lebar isinya (caption dibatasi 46ch), jauh di bawah 1280. Sisa ruang barisnya
     lalu dibagi rata oleh `mx-auto` bawaan tier itu, sehingga caption dan garis
     `--cat` di atasnya berdiri di tengah band foto, tidak sejajar dengan tepi
     kiri hero maupun badan halaman yang memakai tier sama. Dengan lebar penuh,
     `max-w-wide` + padding tier itu lagi yang menentukan tepi kirinya. */
  .s1-moment-inner {
    position: relative;
    width: 100%;
    padding-top: 0;
    padding-bottom: 48px;
  }
  @media (min-width: 768px) {
    .s1-moment { min-height: 66vh; }
    .s1-moment-inner { padding-bottom: 72px; }
  }
  .s1-caption {
    margin: 0;
    padding-top: 18px;
    border-top: 2px solid var(--cat);
    max-width: 46ch;
    /* title-sm 18 → title 22 */
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.45;
    font-weight: 600;
    color: #fff;
    text-wrap: pretty;
  }

  /* ---------- Badan halaman: kolom baca + rel ---------- */
  .s1-body {
    background: #fff;
    padding: 72px 0 96px;
  }
  @media (min-width: 768px) {
    .s1-body { padding: 96px 0 128px; }
  }

  .s1-grid { display: grid; }

  /* Satu breakpoint struktural, 900px, sesuai DESIGN_SYSTEM.md. Gap 56px, angka
     desktop yang diresepkan tabel yang sama.

     Pembagian kolomnya `1fr` + lebar tetap 240px, bukan 1.15fr/1fr maupun
     1.5fr/1fr. Kedua rasio itu menggambarkan komposisi DUA KOLOM ISI, dan rel
     ini bukan kolom isi: ia kolom margin berisi kepala berjalan dan daftar isi.
     Memberinya 1fr dari dua akan membuat daftar tujuh tautan duduk di kolom
     selebar 400px, dan itu bukan marginalia lagi. Di viewport 900 kolom baca
     jadi 524px, dan seluruh ambang container query di bawah diturunkan ke 520
     supaya isinya berubah bentuk tepat saat kerangkanya berubah. */
  @media (min-width: 900px) {
    .s1-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 240px);
      gap: 56px;
    }
  }

  /* ---------- Aliran seksi di kolom baca ---------- */
  /* Acuan layout DAN ukuran huruf di dalam kolom ini adalah LEBAR KOLOM, bukan
     lebar viewport. Semua @container dan semua satuan cqw di bawah bergantung
     pada baris ini. */
  .s1-flow {
    min-width: 0;
    container-type: inline-size;
  }

  /* Versi cqw, cuma untuk isi kolom baca. Kolom ini bergerak dari sekitar 335px
     (mobile) sampai 904px (1440 ke atas), dan tiap clamp di bawah dihitung
     supaya ujung atasnya tercapai persis di 904px. Ceiling 46px disamakan
     dengan .tr-h2/.imp-h2 di beranda (lihat versi vw di atas), jadi 5.1cqw
     (bukan 4.4cqw) supaya 46px tercapai di lebar kolom yang sama. */
  .s1-flow .s1-h2 { font-size: clamp(30px, 5.1cqw, 46px); }
  .s1-flow .s1-lead { font-size: clamp(17px, 2.1cqw, 19px); }

  /* Pernyataan pembuka badan halaman. Bukan seksi, jadi tanpa eyebrow dan tanpa
     heading, tapi ukurannya di atas lead supaya ia terbaca sebagai kalimat
     pembuka, bukan sebagai keterangan. */
  .s1-open {
    margin: 0;
    /* title 22 → heading 30 */
    font-size: clamp(22px, 3.3cqw, 30px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.42;
    color: #0f172a;
    max-width: 42ch;
    text-wrap: pretty;
  }

  /* Konsep: cerita asli pemilik situs, dirender saat `content.story` ada.
     Paragraf memakai ukuran yang sama dengan jawaban FAQ (`.s1-faq dd`) supaya
     satu-satunya blok multi-paragraf di kolom baca tetap dalam kosakata yang
     sudah dipakai file ini, bukan ukuran baru. */
  .s1-story {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .s1-story-p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: #505d6f;
    max-width: 62ch;
  }
  .s1-story-closing {
    margin: 24px 0 0;
    padding-left: 20px;
    border-left: 3px solid var(--cat);
    font-size: clamp(18px, 1.8cqw, 22px);
    font-weight: 600;
    line-height: 1.4;
    color: #0f172a;
    max-width: 52ch;
  }

  /* 32+32 = 64px di SEMUA lebar, plafon "Between blocks inside one section" di
     DESIGN_SYSTEM.md. Angka sebelumnya (56/56 mobile, 72/72 desktop = sampai
     144px) melampaui plafon itu; S3 sudah lebih dulu diperbaiki ke pola yang
     sama persis, disamakan di sini supaya kedua varian konsisten. Yang
     memisahkan tetap garisnya, bukan jaraknya, jadi menyusutkan jarak tidak
     menghilangkan pemisahan visual. Bandingkan dengan jarak kepala seksi ke
     isinya (48px): eyebrow jelas lebih dekat ke seksinya sendiri daripada ke
     seksi sebelumnya.

     Pangkal 40px garis itu berwarna pintu. Itu cara warna identitas ikut
     sepanjang gulir di SEMUA lebar, termasuk di bawah 900px tempat rel dan garis
     vertikalnya tidak dirender sama sekali. Halaman ini memakai garis bukan
     bidang, jadi warnanya pun naik ke garis. */
  .s1-blk { position: relative; }
  .s1-blk + .s1-blk {
    margin-top: 32px;
    padding-top: 32px;
  }
  .s1-blk + .s1-blk::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    /* Bukan border, jadi tidak ikut var(--hairline) di atas, tapi prinsipnya
       sama: setipis yang bisa digambar layarnya. */
    height: var(--hairline);
    background: linear-gradient(to right, var(--cat) 0 40px, var(--line-band) 40px);
  }

  /* ---------- Rel ---------- */
  /* Garis identitas. Ia milik TRACK (yang meregang setinggi badan halaman),
     bukan milik rel (yang setinggi isinya), jadi warnanya menemani seluruh
     gulir dan bukan cuma sepanjang isi relnya. */
  .s1-rail-track { display: none; }

  @media (min-width: 900px) {
    .s1-rail-track {
      display: block;
      position: relative;
      align-self: stretch;
    }
    .s1-rail-track::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      /* Memudar di kaki halaman supaya garisnya berakhir, bukan terpotong. */
      background: linear-gradient(
        to bottom,
        var(--cat) 0%,
        var(--cat) 62%,
        color-mix(in srgb, var(--cat) 10%, transparent) 100%
      );
    }
    /* `top` diturunkan dari --header-clear, bukan ditebak. 18px napas di atas
       ekor bayangan header. SENGAJA tanpa max-height + overflow-y seperti
       varian 3: itu menciptakan permukaan gulir kedua, dan roda mouse di atas
       rel yang sudah mentok membuat halaman berhenti bergulir. Yang menjaga rel
       muat bukan pemotongan, tapi isinya yang memang cuma dua blok. */
    .s1-rail {
      position: sticky;
      top: calc(var(--header-clear) + 18px);
      padding-left: 28px;
    }
  }

  /* Plafon tinggi rel 545px (hitungannya di catatan nomor 3 kepala file). Di
     bawah 560px tinggi viewport rel berhenti lengket dan ikut bergulir seperti
     blok biasa. Tidak ada yang disembunyikan dan tidak ada yang terpotong, jadi
     ekor daftar isinya tetap bisa dijangkau. */
  @media (min-width: 900px) and (max-height: 560px) {
    .s1-rail { position: static; }
  }

  .s1-rail-id { display: grid; justify-items: start; }
  .s1-rail-mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    border-radius: 999px;
    /* --cat-deep, bukan --cat: cincin --cat pintu makanan cuma sekitar 2,6:1. */
    border: 1.5px solid var(--cat-deep);
    color: var(--cat-deep);
  }
  .s1-rail-en {
