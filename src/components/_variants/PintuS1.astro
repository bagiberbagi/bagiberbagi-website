    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #687281;
  }
  .s1-rail-nav ul { list-style: none; margin: 0; padding: 0; }
  .s1-rail-nav li + li { border-top: var(--hairline) solid var(--line); }
  .s1-rail-nav a {
