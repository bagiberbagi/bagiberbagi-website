    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #505d6f;
    max-width: 52ch;
  }

  /* ---------- Tautan panah ---------- */
  .s1-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
    transition: gap 0.18s ease, text-decoration-color 0.18s ease;
  }
  .s1-link:hover,
  .s1-link:focus-visible {
    gap: 14px;
    text-decoration-line: underline;
    text-decoration-color: var(--cat);
  }
  .s1-link svg {
    width: 17px;
    height: 17px;
    flex: none;
    fill: none;
    stroke: var(--cat-deep);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
