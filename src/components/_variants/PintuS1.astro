  /* Pertanyaan dan jawabannya baru dipisah dua kolom kalau kolomnya benar-benar
     lega; di bawah itu bertumpuk, dan bertumpuk memang bentuk yang benar. */
  @container (min-width: 680px) {
    .s1-faq-item { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr); gap: 40px; }
  }

  /* ---------- Indeks pintu lain ---------- */
  .s1-index-band {
    background: #f7f6f3;
    padding: 96px 0;
  }
  @media (min-width: 768px) {
    .s1-index-band { padding: 128px 0; }
  }
  /* Label pengganti .s1-head lengkap (lihat catatan di markup). Jarak ke
     kelompok pil dipangkas jadi 24px, bukan 48px seperti .s1-head, supaya
     labelnya terbaca menempel ke daftar yang dijelaskannya, bukan berdiri
     sebagai judul sendiri. */
  .s1-index-label { margin-bottom: 24px; }

  /* Pil, bukan baris (lihat catatan panjang di markup). Melipat ke baris
     berikutnya sendiri (flex-wrap), jadi lima pintu di layar sempit tidak
     pernah butuh gulir mendatar. Tanpa garis pemisah sama sekali: kontur pil
     itu sendiri sudah jadi batasnya. */
  .s1-doors { display: flex; flex-wrap: wrap; gap: 10px; }
  .s1-door {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    background: #fff;
    border: var(--hairline) solid var(--line);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .s1-door:hover { border-color: var(--cat); box-shadow: 0 2px 10px -4px rgba(15, 23, 42, 0.18); }
  .s1-door-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 999px;
    background: var(--cat-tint);
    color: var(--cat-deep);
  }
  .s1-door-label {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #0f172a;
  }

  /* ---------- Penutup ---------- */
  .s1-close {
    position: relative;
    background: #0f172a;
    overflow: hidden;
    padding: 96px 0;
  }
  @media (min-width: 768px) {
    .s1-close { padding: 128px 0; }
  }
  .s1-close-inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .s1-close-inner .s1-eyebrow { justify-content: center; }
  .s1-close-inner .s1-lead { margin-left: auto; margin-right: auto; }
  .s1-close-inner .s1-btn { margin-top: 36px; }
  /* Watermark tidak lagi dimatikan di mobile, cuma mengecil dan menyingkir ke
     sudut: di varian 5 penutupnya jadi blok tengah polos di atas bidang ink
     setinggi 300px begitu layarnya sempit. */
  .s1-close-mark {
    position: absolute;
    right: -48px;
    bottom: -70px;
    color: var(--cat);
    opacity: 0.16;
    line-height: 0;
    pointer-events: none;
  }
  @media (max-width: 899px) {
    .s1-close-mark {
      right: -70px;
      bottom: -60px;
      opacity: 0.12;
      transform: scale(0.62);
      transform-origin: bottom right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .s1-btn,
    .s1-link,
    .s1-door,
    .s1-rail-nav a { transition: none; }
  }
</style>

<script>
  /* Reveal bersama memakai script global situs; komponen ini cuma menempelkan
     atribut data-fade dan tidak menulis IntersectionObserver sendiri. Itu satu-
     satunya JavaScript yang dibutuhkan halaman ini: rel lengket murni CSS
     sticky, dan dok mobile yang dulu butuh dua observer sudah dibuang. */
  import '../../scripts/fade-in.js';
</script>
