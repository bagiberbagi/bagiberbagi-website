---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import { formatMetric } from '../../lib/format';
import type { Program } from '../../lib/programs';
import type { Impact as PintuImpact } from '../../lib/impact';
import type { CategoryContent, Pintu, PintuId } from '../../consts';
import heroFood from '../../assets/images/hero-jumat-berkah.png';
import distribusiFood from '../../assets/images/jumat-berkah-distribusi.png';
import promoFood from '../../assets/images/program-promo.png';

/**
 * VARIAN "KANVAS HANGAT" untuk halaman pintu (/berbagi-<slug>/).
 *
 * Satu keputusan memayungi semuanya: SELURUH halaman berlatar tint pintu, dan
 * isinya mengambang sebagai kartu putih. Konsekuensinya sengaja diambil:
 *
 * - Nol band putih/abu bergantian. Latar tidak pernah berganti sepanjang
 *   halaman, jadi tidak ada lagi enam pergantian yang tidak menandai apa pun.
 *   Ritme datang dari jarak antar kartu dan dari bobot kartunya (kartu besar
 *   berfoto, kartu sedang, lalu kisi kartu kecil).
 * - Warna identitas pintu hadir dari atas sampai bawah lewat kanvas, bukan
 *   cuma di hero. Di dalam kartu, warna itu tinggal jadi MARKER (titik, bilah,
 *   ring, ikon, watermark).
 * - Foto tinggal DI DALAM kartu. Pintu tanpa foto tidak meninggalkan lubang:
 *   kartunya cuma jadi satu kolom dan lebih ringkas. Ini penting karena empat
 *   dari lima pintu belum punya foto sama sekali.
 *
 * UTANG ATURAN YANG DIAKUI, BUKAN DIBANTAH. DESIGN_SYSTEM.md menulis warna
 * pintu itu "accents, not full-page themes, the page chrome stays neutral".
 * Kanvas penuh di sini melanggarnya, dan pelanggaran itu justru hipotesis yang
 * sedang diuji varian ini. DESIGN_PRINCIPLES.md menuntut aturannya diubah di
 * branch yang sama kalau implementasinya menang, jadi: KALAU VARIAN INI YANG
 * DIPILIH, baris warna pintu di DESIGN_SYSTEM.md harus ikut diubah sebelum
 * merge. Kalau varian lain yang menang, file ini dibuang dan aturannya utuh.
 * Yang tidak dilanggar: chrome-nya sendiri tetap netral, pil navbar transparan
 * di puncak halaman dan berubah putih solid begitu digulir.
 *
 * Angka. Semua angka di halaman ini datang dari `getPintuImpact`, yaitu
 * jumlahan entri jejak yang benar-benar terbit. Dua blok CATEGORY_CONTENT
 * sengaja tidak dirender angkanya:
 * - `stats` (12.400 porsi, 38 titik) ditulis tangan di consts.ts dan tidak bisa
 *   ditelusuri ke satu entri jejak pun.
 * - `env.stats` (8,2 t makanan terselamatkan, 3,1 t emisi CO2) statusnya sama
 *   persis, jadi ia ikut tidak dirender. Yang tersisa dari blok `env` cuma
 *   kalimatnya, dan kalimat itu tidak mengklaim jumlah.
 * `howItWorks` juga tidak dirender: alurnya bisa berbeda antar program sepintu,
 * jadi ia milik halaman program. `contribute` dan `faq` dirender, karena
 * keduanya bicara di level channel dan selama ini menganggur di consts.ts.
 */
interface Props {
  pintu: Pintu;
  content: CategoryContent | undefined;
  programs: Program[];
  active: Program[];
  upcoming: Program[];
  otherPintu: Pintu[];
  impact: PintuImpact;
  hasImpact: boolean;
  contactWa: string;
  notifyWa: string;
  jejakHref: string;
}

const {
  pintu,
  content,
  active,
  upcoming,
  otherPintu,
  impact,
  hasImpact,
  contactWa,
  notifyWa,
  jejakHref,
} = Astro.props;

/**
 * Foto per pintu, ditulis eksplisit dan bukan ditebak dari nama berkas. Hanya
 * pintu Makanan yang punya foto lapangan; empat pintu lain sengaja kosong,
 * karena memasang foto pembagian nasi kotak di halaman Berbagi Ruang jelas
 * terbaca salah. Jalur tanpa foto adalah tampilan bawaan, bukan kasus tepi.
 */
interface PintuPhoto {
  img: ImageMetadata;
  alt: string;
}
interface PintuPhotoSet {
  hero: PintuPhoto;
  program: PintuPhoto;
  cta: PintuPhoto;
}
const PINTU_PHOTOS: Partial<Record<PintuId, PintuPhotoSet>> = {
  food: {
    hero: {
      img: heroFood,
      alt: 'Warga penerima dan relawan berfoto bersama sambil memegang kotak makan seusai penyaluran Jumat Berkah.',
    },
    program: {
      img: distribusiFood,
      alt: 'Paket makanan ditata di meja penyaluran Jumat Berkah di halaman masjid.',
    },
    cta: {
      img: promoFood,
      alt: 'Relawan menyerahkan tas bantuan kepada warga di gang kampung pada sore hari.',
    },
  },
};
const photos = PINTU_PHOTOS[pintu.id];

// Lebar render foto di dalam kartu: Container `standard` (1024) dikurangi
// padding md:px-10 = 944px isi, dibagi dua kolom kartu, jadi sekitar 460px.
// Lebar terbesar dipilih dua kali itu supaya layar 2x DPR tetap tajam.
const PHOTO_WIDTHS = [360, 460, 700, 944];
const PHOTO_SIZES = '(min-width: 1024px) 460px, (min-width: 900px) 48vw, 100vw';

/**
 * Satu program aktif tampil sebagai kartu lebar berfoto, bukan sebagai satu sel
 * dari kisi dua kolom yang separuhnya menganga. Fotonya: unggahan program kalau
 * ada, kalau tidak foto pintu, kalau tidak ada juga barulah blok tint berikon.
 */
const singleActive = active.length === 1 ? active[0] : null;
const singlePhoto: PintuPhoto | null = singleActive
  ? singleActive.image
    ? { img: singleActive.image, alt: `Dokumentasi kegiatan ${singleActive.label}.` }
    : (photos?.program ?? null)
  : null;
/* Tanpa halaman detail, kartunya berhenti jadi tautan. Template asli merender
   <a> tanpa href, yang tampak bisa diklik tapi tidak ke mana-mana. */
const SingleTag = singleActive?.href ? 'a' : 'div';

const hasPrograms = active.length > 0 || upcoming.length > 0;
const forWhom = content?.forWhom ?? [];
const env = content?.env;
const contribute = content?.contribute ?? [];
const faq = content?.faq ?? [];
const hasPair = forWhom.length > 0 || Boolean(env);
/* Kolom pasangan cuma dipasang kalau isinya memang dua. Track kolom eksplisit
   tetap berlaku walau itemnya satu, jadi tanpa penjaga ini kartu tunggal duduk
   di kolom kiri dan menyisakan separuh kanvas kosong di sebelahnya. Kasus itu
   nyata: `env` spesifik pintu makanan (sampah makanan, emisi CO2), sementara
   `forWhom` bisa diisi untuk pintu mana pun. */
const pairBoth = forWhom.length > 0 && Boolean(env);

/**
 * Ajakan di hero mengikuti apa yang benar-benar ada di halaman ini. Tombol
 * WhatsApp cuma muncul kalau ada program yang bisa dibicarakan. Untuk pintu
 * yang belum punya apa-apa, satu-satunya ajakan kontak di halaman ini tinggal
 * di kartu penutup, jadi halaman tidak meminta kontak tiga kali dalam dua layar
 * padahal belum punya apa pun untuk ditawarkan.
 */
const heroFallback =
  active.length > 0 || hasImpact
    ? null
    : upcoming.length > 0
      ? { href: '#program', label: 'Lihat yang sedang disiapkan' }
      : { href: '#pintu-lain', label: 'Lihat pintu yang sudah berjalan' };

/**
 * Kolom kartu "pintu lain" diturunkan dari panjang array, bukan angka tetap.
 * PINTU sekarang berisi lima, jadi otherPintu selalu empat dan kisi empat kolom
 * kebetulan pas. Begitu pintu keenam ditambahkan, angka tetap itu menyisakan
 * satu kartu berdiri sendiri di baris terakhir. Kartu terakhir melebar penuh
 * kalau baris terakhir cuma berisi dia.
 */
const otherColsSm = Math.min(otherPintu.length, 2);
const otherColsLg = Math.min(otherPintu.length, 4);
const smOrphan = otherPintu.length > 1 && otherPintu.length % otherColsSm === 1;
const lgOrphan = otherPintu.length > 1 && otherPintu.length % otherColsLg === 1;
---

<div class="pv2-canvas" style={`--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`}>
  <Container width="standard" class="pb-24 md:pb-32">
    <nav class="pv2-crumb text-body-sm font-semibold text-muted" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="text-gray-300" aria-hidden="true">/</span>
      <a href="/#pintu">Pintu Berbagi</a>
      <span class="text-gray-300" aria-hidden="true">/</span>
      <span class="text-ink">{pintu.label}</span>
    </nav>

    {/* HERO: satu kartu putih. Foto ikut di dalamnya, jadi pintu tanpa foto
        cuma menghasilkan kartu satu kolom yang lebih pendek. */}
    <article
      class:list={[
        'pv2-card pv2-hero bg-white rounded-card shadow-cardSoft',
        photos && 'pv2-hero--photo',
      ]}
      data-fade
    >
      <div class="pv2-hero-body">
        <span class="pv2-badge rounded-2xl" aria-hidden="true">
          <Icon name={pintu.icon} size={28} />
        </span>
        <p class="eyebrow text-muted mt-5 mb-2">{pintu.english}</p>
        <h1 class="pv2-h1 text-heading-lg md:text-display font-bold text-ink">{pintu.label}</h1>
        <p class="pv2-lead text-body md:text-title-sm text-muted mt-4">{pintu.tagline}</p>

        <div class="flex flex-wrap items-center gap-3 mt-7">
          {active.length > 0 && (
            <a
              href={contactWa}
              target="_blank"
              rel="noopener"
              data-track="contact_wa"
              data-track-pintu={pintu.slug}
              class="pv2-btn bg-ink text-white text-body font-bold hover:shadow-cardSm"
            >
              <span class="pv2-dot" aria-hidden="true"></span>
              Hubungi Kami
            </a>
          )}
          {hasImpact && (
            <a href={jejakHref} class="pv2-btn-ghost border-border text-ink text-body font-bold">
              Lihat rekam jejak
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          )}
          {heroFallback && (
            <a href={heroFallback.href} class="pv2-btn-ghost border-border text-ink text-body font-bold">
              {heroFallback.label}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          )}
        </div>
      </div>

      {photos ? (
        <div class="pv2-hero-photo">
          <Image
            src={photos.hero.img}
            alt={photos.hero.alt}
            widths={PHOTO_WIDTHS}
            sizes={PHOTO_SIZES}
            loading="eager"
          />
        </div>
      ) : (
        /* Tanpa foto, sudut kanan bawah kartu diisi watermark ikon pintu
           supaya kartu tetap punya bobot visual tanpa berpura-pura berfoto. */
        <span class="pv2-watermark" aria-hidden="true">
          <Icon name={pintu.icon} size={190} />
        </span>
      )}
    </article>

    {/* DAMPAK: dibuka dengan kalimat dan jumlah kegiatan, angkanya menyusul
        menurun di satu rel warna pintu. Satu rel, bukan kisi counter mandiri:
        bukti harus terbaca sebagai satu rantai, bukan dashboard. */}
    {hasImpact && (
      <section class="pv2-group">
        <article class="pv2-card pv2-block bg-white rounded-card shadow-cardSoft" data-fade>
          <p class="eyebrow text-muted flex items-center gap-2">
            <span class="pv2-dot" aria-hidden="true"></span>
            Yang sudah tercatat
          </p>
          <h2 class="pv2-h2 text-heading-sm md:text-heading font-bold text-ink">
            Setiap kegiatan di pintu ini kami catat satu per satu
          </h2>
          <p class="pv2-lead text-body text-muted mt-4">
            Angka di bawah dijumlahkan dari {impact.jejakCount.toLocaleString('id-ID')} kegiatan yang sudah kami dokumentasikan dan publikasikan, lengkap dengan tanggal, lokasi, dan fotonya.
          </p>

          <div class="pv2-metrics">
            {impact.metrics.map((m) => (
              <div class="pv2-metric">
                <span class="text-heading md:text-heading-lg font-bold text-ink tabular-nums">{formatMetric(m)}</span>
                <span class="text-body-sm text-muted">{m.label}</span>
              </div>
            ))}
          </div>

          <div class="pv2-foot border-t border-border">
            <p class="text-body-sm text-muted">
              Angka ini bergerak setiap kali satu kegiatan baru selesai dan laporannya terbit.
            </p>
            <a href={jejakHref} class="pv2-arrow text-body-sm font-bold text-ink">
              Telusuri semua jejak {pintu.label}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          </div>
        </article>
      </section>
    )}

    {/* PROGRAM. Bentuknya mengikuti jumlah program supaya tidak ada kolom
        menganga: satu program aktif tampil sebagai kartu lebar berfoto, dua
        atau lebih baru masuk kisi dua kolom. Judul seksi juga ikut isinya, jadi
        tidak ada halaman yang berjudul "cara berbagi" lalu isinya menyatakan
        belum ada caranya. */}
    <section class="pv2-group" id="program">
      {hasPrograms && (
        <header class="pv2-head" data-fade>
          <p class="eyebrow text-muted flex items-center gap-2">
            <span class="pv2-dot" aria-hidden="true"></span>
            Program
          </p>
          <h2 class="pv2-h2 text-heading-sm md:text-heading font-bold text-ink">
            {active.length > 0
              ? `Cara berbagi lewat pintu ${pintu.label}`
              : `Yang sedang disiapkan di pintu ${pintu.label}`}
          </h2>
          <p class="pv2-lead text-body text-muted mt-4">
            {active.length > 0
              ? 'Program yang sedang berjalan punya halamannya sendiri: cara kerjanya, kebutuhannya, dan laporan kegiatannya ada di sana.'
              : 'Belum ada satu pun yang berjalan hari ini. Yang tertulis di bawah masih dalam persiapan, dan kami tulis apa adanya.'}
          </p>
        </header>
      )}

      {singleActive && (
        <SingleTag
          href={singleActive.href}
          data-track={singleActive.href ? 'program_click' : undefined}
          data-track-program={singleActive.href ? singleActive.slug : undefined}
          class="pv2-card pv2-prog pv2-prog--wide bg-white rounded-card shadow-cardSoft hover:shadow-card"
          data-fade
        >
          {singlePhoto ? (
            <div class="pv2-prog-photo">
              <Image
                src={singlePhoto.img}
                alt={singlePhoto.alt}
                widths={PHOTO_WIDTHS}
                sizes={PHOTO_SIZES}
                loading="lazy"
              />
            </div>
          ) : (
            <div class="pv2-prog-fallback">
              <span class="pv2-badge rounded-2xl" aria-hidden="true">
                <Icon name={pintu.icon} size={28} />
              </span>
            </div>
          )}
          <div class="pv2-prog-body">
            <span class="pv2-status label text-muted">
              <span class="pv2-dot" aria-hidden="true"></span>
              Program berjalan
            </span>
            <h3 class="pv2-h2 text-title md:text-heading-sm font-bold text-ink mt-3">{singleActive.label}</h3>
            <p class="pv2-lead text-body text-muted mt-3">{singleActive.summary}</p>
            {singleActive.detail.features.length > 0 && (
              <ul class="pv2-feats">
                {singleActive.detail.features.map((f) => (
                  <li class="text-body-sm text-muted">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7"></path></svg>
                    {f}
                  </li>
                ))}
              </ul>
            )}
            {singleActive.href && (
              <span class="pv2-prog-go text-body-sm font-bold text-ink">
                Lihat program
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
              </span>
            )}
          </div>
        </SingleTag>
      )}

      {active.length > 1 && (
        <div class="pv2-grid2">
          {active.map((p) => {
            const Tag = p.href ? 'a' : 'div';
            return (
              <Tag
                href={p.href}
                data-track={p.href ? 'program_click' : undefined}
                data-track-program={p.href ? p.slug : undefined}
                class="pv2-card pv2-prog bg-white rounded-card shadow-cardSoft hover:shadow-card"
                data-fade
              >
                {p.image ? (
                  <div class="pv2-prog-photo">
                    <Image
                      src={p.image}
                      alt={`Dokumentasi kegiatan ${p.label}.`}
                      widths={PHOTO_WIDTHS}
                      sizes={PHOTO_SIZES}
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="pv2-prog-fallback">
                    <span class="pv2-badge rounded-2xl" aria-hidden="true">
                      <Icon name={pintu.icon} size={28} />
                    </span>
                  </div>
                )}
                <div class="pv2-prog-body">
                  <span class="pv2-status label text-muted">
                    <span class="pv2-dot" aria-hidden="true"></span>
                    Program berjalan
                  </span>
                  <h3 class="pv2-h2 text-title-sm font-bold text-ink mt-3">{p.label}</h3>
                  <p class="text-body-sm text-muted mt-2">{p.summary}</p>
                  {p.href && (
                    <span class="pv2-prog-go text-body-sm font-bold text-ink">
                      Lihat program
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                    </span>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      )}

      {upcoming.length > 0 && (
        <article class="pv2-card pv2-block bg-white rounded-card shadow-cardSoft" data-fade>
          {/* Judulnya cuma dipasang kalau kartu ini blok kedua di bawah program
              yang berjalan. Kalau ia satu-satunya isi seksi, judul seksi di atas
              sudah menyebut hal yang sama. */}
          {active.length > 0 && <h3 class="text-title-sm font-bold text-ink">Sedang disiapkan</h3>}
          <ul class="pv2-queue">
            {upcoming.map((p) => (
              <li class="border-t border-border">
                <span class="pv2-ring" aria-hidden="true"></span>
                <div class="min-w-0">
                  <p class="text-body font-bold text-ink">{p.label}</p>
                  <p class="text-body-sm text-muted mt-0.5">{p.summary}</p>
                </div>
                <span class="pv2-chip label bg-gray-100 text-muted">Belum jalan</span>
              </li>
            ))}
          </ul>
          <div class="pv2-foot border-t border-border">
            <p class="text-body-sm text-muted">
              Kami tidak memasang tanggal yang belum pasti. Kalau ingin tahu duluan, titip pesan saja.
            </p>
            <a
              href={notifyWa}
              target="_blank"
              rel="noopener"
              data-track="notify_wa"
              data-track-pintu={pintu.slug}
              class="pv2-arrow text-body-sm font-bold text-ink"
            >
              Beri tahu saya saat dibuka
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          </div>
        </article>
      )}

      {!hasPrograms && (
        /* Dua dari lima pintu belum punya program sama sekali. Kartunya sendiri
           yang memikul judul seksi, jadi tidak ada judul di atas yang
           menjanjikan sesuatu lalu langsung dibantah isinya. Ajakannya cuma
           satu, dan itu ajakan yang berbeda dari kartu penutup. */
        <article class="pv2-card pv2-block bg-white rounded-card shadow-cardSoft" data-fade>
          <span class="pv2-badge rounded-2xl" aria-hidden="true">
            <Icon name={pintu.icon} size={28} />
          </span>
          <p class="eyebrow text-muted flex items-center gap-2 mt-5">
            <span class="pv2-dot" aria-hidden="true"></span>
            Program
          </p>
          <h2 class="pv2-h2 text-title md:text-heading-sm font-bold text-ink">
            Belum ada program yang berjalan di pintu {pintu.label}
          </h2>
          <p class="pv2-lead text-body text-muted mt-3">
            Pintu ini baru kami buka sebagai arah, dan sampai hari ini belum ada satu pun kegiatan
            yang jalan di bawahnya. Kami tulis apa adanya, supaya tidak ada yang menunggu sesuatu
            yang memang belum ada.
          </p>
          <div class="pv2-foot border-t border-border">
            <p class="text-body-sm text-muted">
              Kalau ingin tahu duluan saat pintu ini mulai berjalan, titip pesan saja.
            </p>
            <a
              href={notifyWa}
              target="_blank"
              rel="noopener"
              data-track="notify_wa"
              data-track-pintu={pintu.slug}
              class="pv2-arrow text-body-sm font-bold text-ink"
            >
              Beri tahu saya saat dibuka
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          </div>
        </article>
      )}
    </section>

    {/* CARA IKUT: teks channel yang selama ini menganggur di consts.ts. */}
    {contribute.length > 0 && (
      <section class="pv2-group">
        <header class="pv2-head" data-fade>
          <p class="eyebrow text-muted flex items-center gap-2">
            <span class="pv2-dot" aria-hidden="true"></span>
            Cara ikut
          </p>
          <h2 class="pv2-h2 text-heading-sm md:text-heading font-bold text-ink">
            Tiga jalan masuk yang paling sering dipakai
          </h2>
        </header>
        <article class="pv2-card pv2-block bg-white rounded-card shadow-cardSoft" data-fade>
          <ol class="pv2-steps">
            {contribute.map((step, i) => (
              <li>
