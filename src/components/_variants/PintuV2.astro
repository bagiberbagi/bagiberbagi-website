            <span class="text-body font-bold text-ink mt-4">{p.label}</span>
            <span class="text-body-sm text-muted mt-1.5">{p.blurb}</span>
            <span class="pv2-other-arrow" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* PENUTUP. Satu-satunya ajakan kontak di halaman yang belum punya program,
        dan fotonya ikut masuk kartu kalau pintu ini punya. */}
    <article
      class:list={[
        'pv2-card pv2-cta bg-ink rounded-card shadow-cardSoft',
