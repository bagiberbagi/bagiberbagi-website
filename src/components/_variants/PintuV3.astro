---
/**
 * Varian halaman pintu: REL LENGKET.
 *
 * Bentuknya dua kolom di desktop. Kolom kiri sempit dan lengket (sticky):
 * isinya identitas pintu — ikon, judul, kalimat pembuka, tombol WhatsApp, dan
 * angka ringkas yang benar-benar tercatat. Kolom kanan menggulir dan memikul
 * seluruh isi halaman. Konsekuensinya warna identitas pintu tidak pernah hilang
 * dari layar, jadi masalah "warna berhenti di hero lalu halaman jadi abu-putih"
 * hilang tanpa perlu mewarnai band demi band.
 *
 * Kenapa rel kiri berisi identitas, bukan data: empat dari lima pintu belum
 * punya program aktif, belum punya jejak, dan tidak punya foto sama sekali. Rel
 * yang isinya angka akan kosong di empat halaman. Rel yang isinya identitas
 * selalu penuh, karena `Pintu` tidak punya field opsional satu pun.
 *
 * Enam band putih/abu bergantian juga dibuang. Kolom kanan cuma satu aliran di
 * atas satu latar hangat, tiap blok dipisah garis tipis. Bobotnya diselang-
 * seling lewat isi (foto, kartu, daftar, pil, panel tint), bukan lewat latar.
 *
 * Foto: peta statis per pintu, dan hanya pintu makanan yang punya. Semua jalur
 * yang menyentuh foto berhenti rapi saat petanya kosong, tanpa menyisakan sel
 * grid menganga. Foto pintu makanan sengaja tidak dipinjamkan ke pintu lain,
 * karena isinya jelas terbaca sebagai pembagian nasi kotak.
 *
 * Yang sengaja TIDAK dirender: `CATEGORY_CONTENT.food.stats` (12.400 porsi, 38
 * titik, dan seterusnya) beserta blok `env` (8,2 t makanan terselamatkan, 3,1 t
 * emisi CO2 dihindari). Semua angka itu ditulis tangan di consts.ts dan tidak
 * bisa ditelusuri ke satu entri jejak pun, sementara angka nyata dari jejak
 * pintu makanan baru 220 porsi. Menaruhnya satu layar dengan rel kiri yang
 * jujur menyebut 2 kali kegiatan bukan cuma membingungkan, tapi juga tidak
 * jujur. Angka di halaman ini semuanya datang dari `getPintuImpact`.
 *
 * Blok Alur dijaga seketat itu juga. Pintu yang punya `howItWorks` sendiri
 * menampilkan alur programnya. Pintu yang belum punya program menampilkan alur
 * penerimaan tawaran, yaitu apa yang terjadi sesudah pesanmu masuk. Itu janji
 * proses, bukan klaim penyaluran, jadi tidak ada penerima terdata, penyaluran,
 * atau foto laporan yang disebut di pintu yang belum berjalan.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import { formatMetric } from '../../lib/format';
import type { CategoryContent, Pintu, PintuId } from '../../consts';
import type { Program } from '../../lib/programs';
import type { Impact as PintuImpact } from '../../lib/impact';

import fotoPenerima from '../../assets/images/hero-jumat-berkah.png';
import fotoDistribusi from '../../assets/images/jumat-berkah-distribusi.png';
import fotoRelawan from '../../assets/images/program-promo.png';

interface Props {
  pintu: Pintu;
  content: CategoryContent | undefined;
  programs: Program[];
  active: Program[];
  upcoming: Program[];
  otherPintu: Pintu[];
  impact: PintuImpact;
  hasImpact: boolean;
  contactWa: string;
  notifyWa: string;
  jejakHref: string;
}

const {
  pintu,
  content,
  active,
  upcoming,
  otherPintu,
  impact,
  hasImpact,
  contactWa,
  notifyWa,
  jejakHref,
} = Astro.props;

// Pembagian tugas antar var warna pintu, dipegang konsisten di seluruh file:
// `--cat-tint` untuk bidang latar lembut, `--cat` cuma untuk dekorasi murni
// (garis penghubung alur), dan `--cat-deep` untuk apa pun yang membawa makna,
// yaitu ikon, bulatan penanda, angka, dan tombol. Alasannya kontras: aksen
// terang seperti makanan #F4791D (2,8:1) dan ruang #0EA5C4 (2,9:1) tidak lolos
// lantai 3:1 di atas putih, sementara kelima `--cat-deep` lolos.
const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;

interface PintuPhoto {
  src: ImageMetadata;
  alt: string;
}

// Peta foto per pintu. Cuma makanan yang punya dokumentasi lapangan; empat pintu
// lain memang belum ada fotonya, dan itu keadaan bawaan yang harus tetap rapi.
const PINTU_PHOTOS: Partial<Record<PintuId, PintuPhoto[]>> = {
  food: [
    { src: fotoPenerima, alt: 'Warga dan anak-anak penerima paket Jumat Berkah berkumpul di halaman masjid.' },
    { src: fotoDistribusi, alt: 'Meja penyaluran paket makanan Jumat Berkah bersama jamaah masjid.' },
    { src: fotoRelawan, alt: 'Relawan bagiberbagi menyerahkan tas bantuan kepada warga di gang kampung.' },
  ],
};

const photos = PINTU_PHOTOS[pintu.id] ?? [];
// Foto dibagi dua tempat supaya halaman tidak menumpuk semua gambar di satu
// blok: dua teratas jadi mozaik pembuka, sisanya dipinjamkan ke kartu program
// aktif pertama yang belum punya foto sendiri.
const mosaic = photos.length >= 3 ? photos.slice(0, 2) : photos;
const sparePhoto = photos.length >= 3 ? photos[2] : undefined;
const mosaicClass =
  mosaic.length > 1 ? 'grid gap-3 md:gap-4 md:grid-cols-[1.4fr_minmax(0,1fr)]' : 'grid gap-3';

// Alur penerimaan tawaran, dipakai saat pintu belum punya `howItWorks` sendiri.
// Isinya cuma menjelaskan apa yang terjadi sesudah pesan masuk, jadi berlaku
// untuk sumber daya apa pun dan tidak mengklaim penyaluran, penerima terdata,
// atau foto laporan yang belum pernah ada di pintu itu.
const INTAKE_FLOW = [
  { title: 'Kamu kirim pesan', desc: 'Ceritakan lewat WhatsApp apa yang bisa kamu bagi lewat pintu ini.' },
  { title: 'Kami balas dan tanya detailnya', desc: 'Bentuknya apa, berapa banyak, kapan tersedia, dan sejauh mana kamu bisa ikut.' },
  { title: 'Kami carikan pasangannya', desc: 'Kalau ada kebutuhan di lapangan yang cocok, pintu ini kami buka jadi program. Kalau belum ada, kontakmu kami simpan dan kami kabari begitu muncul.' },
];

const flowSteps = content?.howItWorks?.length ? content.howItWorks : INTAKE_FLOW;
const flowIsPintuSpecific = Boolean(content?.howItWorks?.length);
const flowTitle = flowIsPintuSpecific
  ? 'Perjalanan yang dilalui'
  : 'Yang terjadi sesudah kamu mengirim pesan';
// Kualifikasi dipasang di kedua cabang. Justru cabang alur penerimaan yang
// paling butuh, karena di situ belum ada penyaluran apa pun untuk dilaporkan.
const flowNote = flowIsPintuSpecific
  ? 'Ini gambaran ringkasnya. Detail tiap tahap berbeda antar program, jadi versi lengkapnya ada di halaman program masing-masing.'
  : 'Ini alur penerimaan tawaran, bukan catatan penyaluran. Apa yang sudah benar-benar berjalan bisa kamu lihat di rekam jejak.';

const contributeCount = content?.contribute?.length ?? 0;
const contributeCols =
  contributeCount >= 3 ? 'md:grid-cols-3' : contributeCount === 2 ? 'md:grid-cols-2' : '';

const ctaTitle = content?.ctaTitle ?? `Ingin berkontribusi lewat ${pintu.label}?`;
const ctaText = content?.ctaText ?? 'Ceritakan dulu rencanamu, tim kami bantu menyalurkannya.';

// Blok di kolom kanan dipisah garis tipis lewat selector saudara, bukan lewat
// kelas per blok: blok pertama berganti-ganti tergantung pintu punya foto atau
// tidak, jadi menandai "yang pertama" secara manual pasti meleset.
// Jarak efektif antar blok = margin + padding, jadi 28+28=56px di mobile dan
// 32+32=64px di desktop. Halaman ini satu `<section>` tunggal, jadi plafon yang
// berlaku 64px antar blok dalam satu seksi.
const FLOW_DIVIDERS =
  '[&>*+*]:mt-7 [&>*+*]:border-t [&>*+*]:border-border [&>*+*]:pt-7 md:[&>*+*]:mt-8 md:[&>*+*]:pt-8';

// Panah tautan, path yang sama dengan komponen beranda.
const ARROW = 'M9 6l6 6-6 6';
---

<section class="bg-surface-warm py-24 md:py-32" style={styleVars}>
  <Container width="wide">
    <nav class="text-body-sm font-semibold text-muted mb-6 md:mb-8" aria-label="Breadcrumb">
      <a href="/" class="link hover:text-ink">Beranda</a>
      <span class="text-gray-300 mx-1.5">/</span>
      <a href="/#pintu" class="link hover:text-ink">Pintu Berbagi</a>
      <span class="text-gray-300 mx-1.5">/</span>
      <span class="text-ink">{pintu.label}</span>
    </nav>

    <div class="rail-grid">
      <!-- REL KIRI: identitas pintu. Selalu terisi, karena tidak satu pun field
           `Pintu` yang opsional. Sengaja `div`, bukan `aside`: judul halaman
           duduk di sini, dan h1 tidak boleh berada di landmark complementary.
           Rel ini isi utama halaman, cuma kebetulan berbentuk kolom sempit. -->
      <div class="rail-col">
        <div class="rounded-card border border-border bg-white shadow-cardSoft overflow-hidden">
          <div class="p-6 md:p-7" style="background:var(--cat-tint)">
            <span class="inline-grid place-items-center w-14 h-14 rounded-2xl bg-white shadow-cardSm text-[var(--cat-deep)] mb-4">
              <Icon name={pintu.icon} size={28} />
            </span>
            <p class="flex items-center gap-2 label text-muted mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--cat-deep)]" aria-hidden="true"></span>
              {pintu.english}
            </p>
            {/* Satu tingkat di atas semua h2 kolom kanan (26/28px). Di pintu
                yang belum punya program, identitas ini satu-satunya yang
                dipunya halaman, jadi ia harus jadi headline yang jelas. */}
            <h1 class="text-heading-lg md:text-heading-xl font-bold text-ink leading-tight mb-3">{pintu.label}</h1>
            <p class="text-body-sm text-muted leading-relaxed">{pintu.tagline}</p>
          </div>

          <div class="p-6 md:p-7 flex flex-col gap-5">
            <a
              href={contactWa}
              target="_blank"
              rel="noopener"
              data-track="contact_wa"
              data-track-pintu={pintu.slug}
              class="cta-solid block text-center rounded-full font-bold text-body-sm text-white px-6 py-3.5 transition-transform hover:-translate-y-0.5"
            >
              Hubungi lewat WhatsApp
            </a>

            {hasImpact ? (
              <div>
                <p class="label text-muted mb-3">Yang sudah tercatat</p>
                <dl class="flex flex-col">
                  <div class="flex items-baseline justify-between gap-3 border-b border-border py-2">
                    <dt class="text-body-sm text-muted">kali kegiatan</dt>
                    <dd class="text-title font-bold text-ink tabular-nums">{impact.jejakCount.toLocaleString('id-ID')}</dd>
                  </div>
                  {impact.metrics.map((m) => (
                    <div class="flex items-baseline justify-between gap-3 border-b border-border py-2 last:border-b-0">
                      <dt class="text-body-sm text-muted">{m.label}</dt>
                      <dd class="text-title font-bold text-ink tabular-nums">{formatMetric(m)}</dd>
                    </div>
                  ))}
                </dl>
                <p class="text-micro text-muted leading-relaxed mt-3">
                  Dijumlahkan dari {impact.jejakCount.toLocaleString('id-ID')} kegiatan yang sudah terdokumentasi di rekam jejak.
                </p>
                <a
                  href={jejakHref}
                  class="rail-link inline-flex items-center gap-2 font-bold text-body-sm text-ink mt-3"
                >
                  Telusuri rekam jejaknya
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ARROW}></path></svg>
                </a>
              </div>
            ) : (
              <div>
                <p class="label text-muted mb-2">Status pintu</p>
                <p class="text-body-sm text-muted leading-relaxed">
                  Belum ada kegiatan yang tercatat di pintu ini. Begitu penyaluran pertama berjalan, angkanya muncul di sini.
                </p>
                {/* Dua hitungan dipisah. Sebelumnya cabang ini memakai seluruh
                    program lalu menyebutnya "sedang disiapkan", padahal program
                    aktif ikut terhitung, jadi rel bisa membantah kartu program
                    di kolom kanan yang berlabel "Sedang berjalan". */}
                {active.length > 0 && (
                  <p class="text-body-sm text-muted leading-relaxed mt-2">
                    {active.length.toLocaleString('id-ID')} program sudah berjalan di pintu ini. Catatannya menyusul setelah kegiatan pertama terdokumentasi.
                  </p>
                )}
                {upcoming.length > 0 && (
                  <p class="text-body-sm text-muted leading-relaxed mt-2">
                    {upcoming.length.toLocaleString('id-ID')} program sedang disiapkan.
                  </p>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- KOLOM KANAN: seluruh isi halaman, satu aliran, dipisah garis tipis. -->
      <div class:list={['min-w-0', FLOW_DIVIDERS]}>
        {mosaic.length > 0 && (
          <div data-fade>
            <div class={mosaicClass}>
              {mosaic.map((ph, i) => (
                <div
                  class:list={[
                    'relative overflow-hidden rounded-card bg-gray-100',
                    i === 0 ? 'aspect-[4/3]' : 'aspect-[16/10] md:aspect-auto',
                  ]}
                >
                  <Image
                    src={ph.src}
                    alt={ph.alt}
                    widths={[360, 460, 720, 900]}
                    sizes="(min-width: 900px) 420px, 100vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
            <p class="text-body-sm text-muted leading-relaxed mt-4 max-w-[58ch]">
              Dokumentasi penyaluran di pintu {pintu.label}. Semua foto diambil saat kegiatan berlangsung, bukan foto stok.
            </p>
          </div>
        )}

        <!-- PROGRAM. Kartu aktif selalu selebar kolom, dan baris "segera" ikut
             lebar yang sama, jadi tidak ada lagi dua lebar berbeda bertumpuk. -->
        <div data-fade>
          <p class="eyebrow text-muted">Program</p>
          <h2 class="text-heading-sm md:text-heading font-bold text-ink">
            Cara berbagi lewat pintu {pintu.label}
          </h2>

          {active.length > 0 && (
            <div class="flex flex-col gap-5 mt-8">
              {active.map((p, i) => {
                const photo = p.image ?? (i === 0 ? sparePhoto?.src : undefined);
                const photoAlt = p.image ? `Dokumentasi ${p.label}` : (sparePhoto?.alt ?? '');
                return (
                  <article class="overflow-hidden rounded-card border border-border bg-white shadow-cardSm md:grid md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
                    {photo ? (
                      <div class="relative aspect-[16/10] md:aspect-auto md:min-h-60 bg-gray-100">
                        <Image
                          src={photo}
                          alt={photoAlt}
                          widths={[360, 460, 720, 900]}
                          sizes="(min-width: 900px) 360px, 100vw"
                          loading="lazy"
                          class="absolute inset-0 h-full w-full object-cover"
                        />
                      </div>
                    ) : (
                      <div class="grid place-items-center aspect-[16/10] md:aspect-auto md:min-h-60" style="background:var(--cat-tint)">
                        <span class="grid place-items-center w-16 h-16 rounded-2xl bg-white shadow-cardSm text-[var(--cat-deep)]">
                          <Icon name={pintu.icon} size={30} />
                        </span>
                      </div>
                    )}

                    <div class="p-6 md:p-7 flex flex-col">
                      <p class="inline-flex items-center gap-2 label text-muted mb-3">
                        <span class="w-1.5 h-1.5 rounded-full bg-[var(--cat-deep)]" aria-hidden="true"></span>
                        Sedang berjalan
                      </p>
                      <h3 class="text-title font-bold text-ink mb-2">{p.label}</h3>
                      <p class="text-body-sm text-muted leading-relaxed">{p.summary}</p>

                      {p.detail.features.length > 0 && (
                        <ul class="flex flex-col gap-2 mt-4">
                          {p.detail.features.map((f) => (
                            <li class="flex items-start gap-2.5 text-body-sm text-ink">
                              <span class="flex-none w-1.5 h-1.5 rounded-full bg-[var(--cat-deep)] mt-2" aria-hidden="true"></span>
                              <span>{f}</span>
                            </li>
                          ))}
                        </ul>
                      )}

                      {/* href opsional: program aktif yang deskripsinya masih kosong
                          tidak punya halaman, jadi jangan dirender sebagai tautan. */}
                      {p.href ? (
                        <a
                          href={p.href}
                          data-track="program_click"
                          data-track-program={p.slug}
                          class="rail-link inline-flex items-center gap-2 font-bold text-body-sm text-ink mt-6"
                        >
                          Lihat halaman program
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ARROW}></path></svg>
                        </a>
                      ) : (
                        <p class="text-micro text-muted mt-6">Halaman program ini sedang kami siapkan.</p>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          )}

          {upcoming.length > 0 && (
            <div class="mt-8">
              <h3 class="text-title-sm font-bold text-ink mb-4">Sedang disiapkan</h3>
              <ul class="flex flex-col gap-2.5">
                {upcoming.map((p) => (
                  <li class="flex flex-wrap items-start gap-x-4 gap-y-2 rounded-xl border border-border bg-white px-5 py-4">
                    <span class="flex-none w-2.5 h-2.5 rounded-full border-2 border-border mt-1.5" style="border-color:var(--cat-deep)" aria-hidden="true"></span>
                    <div class="min-w-0 flex-1">
                      <p class="text-body-sm font-bold text-ink">{p.label}</p>
                      <p class="text-body-sm text-muted leading-relaxed mt-0.5">{p.summary}</p>
                    </div>
                    <span class="flex-none label text-muted bg-gray-100 rounded-full px-3 py-1.5">Segera</span>
                  </li>
                ))}
              </ul>
              <p class="text-body-sm text-muted leading-relaxed mt-4">
                Ingin dikabari saat salah satunya dibuka?
                <a
                  href={notifyWa}
                  target="_blank"
                  rel="noopener"
                  data-track="pintu_notify"
                  data-track-pintu={pintu.slug}
                  class="link font-bold text-ink"
                >Titip pesan lewat WhatsApp</a>, nanti kami kabari.
              </p>
            </div>
          )}

          {active.length === 0 && upcoming.length === 0 && (
            <div class="mt-8 rounded-card border border-border bg-white p-6 md:p-7">
              <p class="text-body text-ink leading-relaxed">
                Pintu ini belum punya program yang berjalan. Kami membukanya setelah ada mitra dan penerima yang siap, bukan sebelumnya.
              </p>
              <p class="text-body-sm text-muted leading-relaxed mt-3">
                Kalau kamu punya sumber daya yang cocok untuk pintu ini, cerita ke kami duluan justru membantu pintu ini dibuka lebih cepat.
              </p>
              <a
                href={notifyWa}
                target="_blank"
                rel="noopener"
                data-track="pintu_notify"
                data-track-pintu={pintu.slug}
                class="rail-link inline-flex items-center gap-2 font-bold text-body-sm text-ink mt-5"
              >
                Titip pesan lewat WhatsApp
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ARROW}></path></svg>
              </a>
            </div>
          )}
        </div>

        <!-- CARA BERKONTRIBUSI (hanya pintu yang kontennya sudah diisi) -->
        {content?.contribute && content.contribute.length > 0 && (
          <div data-fade>
            <p class="eyebrow text-muted">Ikut Berbagi</p>
            {/* Judul sengaja tidak menyebut jumlah. `contribute` panjangnya
                bebas per pintu, dan layout di bawah memang sudah menyiapkan
                bentuk 1 dan 2 item, jadi judul berangka pasti berbohong begitu
                editor mengisi pintu lain dengan dua cara ikut serta. */}
            <h2 class="text-heading-sm md:text-heading font-bold text-ink">Pilihan untuk ikut serta</h2>
            <div class:list={['grid gap-4 mt-8', contributeCols]}>
              {content.contribute.map((c, i) => (
                <div class="rounded-card border border-border bg-white p-6">
                  <p class="text-title font-bold tabular-nums text-[var(--cat-deep)] mb-3">
                    {String(i + 1).padStart(2, '0')}
                  </p>
                  <h3 class="text-title-sm font-bold text-ink mb-2">{c.title}</h3>
                  <p class="text-body-sm text-muted leading-relaxed">{c.desc}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- ALUR: alur program kalau pintunya sudah punya, kalau belum jatuh ke
             alur penerimaan tawaran, yang isinya proses percakapan dan bukan
             klaim penyaluran. -->
        <div data-fade>
          <p class="eyebrow text-muted">Alur</p>
          <h2 class="text-heading-sm md:text-heading font-bold text-ink">{flowTitle}</h2>
          <ol class="flow-line flex flex-col mt-8">
            {flowSteps.map((s) => (
              <li class="relative flex gap-5 pb-7 last:pb-0">
                <span class="flow-dot flex-none grid place-items-center w-9 h-9 rounded-full bg-white border border-border text-[var(--cat-deep)]">
                  <span class="w-2.5 h-2.5 rounded-full bg-[var(--cat-deep)]"></span>
                </span>
                <div class="min-w-0">
                  <h3 class="text-title-sm font-bold text-ink">{s.title}</h3>
                  <p class="text-body-sm text-muted leading-relaxed mt-1 max-w-[52ch]">{s.desc}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="text-body-sm text-muted leading-relaxed mt-2 max-w-[58ch]">{flowNote}</p>
        </div>

        <!-- UNTUK SIAPA. Blok `env` ("Bonus Dampak") sengaja tidak ada di sini:
             dua angkanya ditulis tangan di consts.ts dan tidak bisa ditelusuri
             ke satu entri jejak pun, persis alasan yang sama yang membuang
             `stats`. Panel gelapnya ikut hilang, dan itu kebetulan menyelesaikan
             satu hal lagi, yaitu gradient dengan hex mentah di komponen bersama. -->
        {content?.forWhom && content.forWhom.length > 0 && (
          <div data-fade>
            <p class="eyebrow text-muted">Untuk Siapa</p>
            <h2 class="text-heading-sm md:text-heading font-bold text-ink">Siapa yang terbantu</h2>
            <ul class="flex flex-wrap gap-2.5 mt-6">
              {content.forWhom.map((who) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-border bg-white font-semibold text-body-sm text-ink px-4 py-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--cat-deep)]" aria-hidden="true"></span>
                  {who}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- FAQ pintu, tanpa script: <details> bawaan browser. -->
        {content?.faq && content.faq.length > 0 && (
          <div data-fade>
            <p class="eyebrow text-muted">Pertanyaan</p>
            <h2 class="text-heading-sm md:text-heading font-bold text-ink">Yang sering ditanyakan</h2>
            <div class="flex flex-col gap-3 mt-8">
              {content.faq.map((item) => (
                <details class="faq-item group rounded-card border border-border bg-white px-5 py-4">
                  <summary class="flex items-start justify-between gap-4 cursor-pointer list-none text-body font-bold text-ink">
                    {item.q}
                    <span class="faq-mark flex-none grid place-items-center w-6 h-6 rounded-full border border-border text-[var(--cat-deep)] mt-0.5" aria-hidden="true">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
                    </span>
                  </summary>
                  <p class="text-body-sm text-muted leading-relaxed mt-3 max-w-[58ch]">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- PINTU LAIN: selalu tepat empat, jadi gridnya tak pernah bolong. -->
        <div data-fade>
          <p class="eyebrow text-muted">Pintu Lainnya</p>
          <h2 class="text-heading-sm md:text-heading font-bold text-ink">Jalan berbagi yang lain</h2>
          <div class="grid gap-3 sm:grid-cols-2 mt-8">
            {otherPintu.map((p) => (
              <a
                href={`/berbagi-${p.slug}/`}
                style={`--cat:${p.color};--cat-tint:${p.colorTint};--cat-deep:${p.colorDeep}`}
                class="group flex items-center gap-4 rounded-card border border-border bg-white p-4 transition-shadow hover:shadow-cardSm"
              >
                <span class="flex-none w-11 h-11 rounded-xl grid place-items-center text-[var(--cat-deep)]" style="background:var(--cat-tint)">
                  <Icon name={p.icon} size={22} />
                </span>
                <span class="min-w-0">
                  <span class="block font-bold text-body-sm text-ink">{p.label}</span>
                  <span class="block text-micro text-muted leading-snug mt-0.5">{p.blurb}</span>
                </span>
              </a>
            ))}
          </div>
        </div>

        <!-- PENUTUP: panel tint, bukan band warna penuh. Tombol permanen sudah
             ada di rel kiri, jadi penutup ini memikul kalimatnya. -->
        <div data-fade>
          <div class="rounded-card border border-border p-7 md:p-8 flex flex-wrap items-center gap-6" style="background:var(--cat-tint)">
            <div class="flex-1 min-w-64">
              <h2 class="text-title md:text-heading-sm font-bold text-ink">{ctaTitle}</h2>
              <p class="text-body-sm text-muted leading-relaxed mt-2 max-w-[58ch]">{ctaText}</p>
            </div>
            <a
              href={contactWa}
              target="_blank"
              rel="noopener"
              data-track="pintu_cta"
              data-track-pintu={pintu.slug}
              class="cta-solid flex-none rounded-full font-bold text-body-sm text-white px-7 py-3.5 transition-transform hover:-translate-y-0.5"
            >
              Hubungi Kami
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Dua kolom mulai 900px, ambang yang sama dipakai seksi bespoke lain. Di bawah
     itu rel kiri jadi blok atas biasa dan tidak lengket. */
  .rail-grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .rail-grid {
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }

    /* 90px = tinggi header terkunci 74px (Header.astro: margin 10px + pil 64px)
       ditambah napas 16px. Angka 74 terikat ke Header.astro, ubah bersamaan.

       max-height + overflow bikin ekor kartu tetap terjangkau di viewport
       pendek. Kartu pintu makanan sudah sekitar 700px sekarang, sementara
       1024x768 cuma menyisakan 678px, jadi tanpa ini tautan paling bawah tak
       akan pernah bisa dicapai. Metrik jejak bakal bertambah, jadi batasnya
       dipasang sekarang, bukan nanti setelah kepotong. Padding negatif memberi
       ruang buat shadow kartu supaya tidak terpotong scroll container. */
    .rail-col {
      position: sticky;
      top: 90px;
      max-height: calc(100vh - 106px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 6px;
      margin: -6px;
    }
  }

  /* Tombol utama. Teks putih 14,5px bold di atas --cat-deep pintu makanan
     (#C25D0F) cuma 4,32:1, di bawah lantai 4,5:1 untuk teks bold di bawah 19px.
     Digelapkan lewat color-mix dengan `black`, jadi kelima pintu lewat lantai
     tanpa halaman ini memperkenalkan warna baru: yang dipakai tetap warna
     identitas pintu, cuma satu tingkat lebih gelap. Pintu makanan jadi sekitar
     5,3:1, empat pintu lain naik dari posisi yang memang sudah lolos. */
  .cta-solid {
    background: color-mix(in srgb, var(--cat-deep) 88%, black);
  }

  /* Garis penghubung antar langkah alur, digambar di belakang bulatan. Ini satu-
     satunya pemakaian --cat yang tersisa: garis dekoratif tanpa makna, jadi
     boleh memakai aksen terang. Semua penanda yang membawa makna pakai
     --cat-deep. */
  .flow-line li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 36px;
    bottom: 8px;
    width: 2px;
    background: var(--cat);
    opacity: 0.25;
  }

  .flow-dot {
    position: relative;
    z-index: 1;
  }

  /* Idiom tautan beranda: gap melebar saat hover, bukan elemen bergeser. */
  .rail-link {
    transition: gap 0.18s ease, color 0.18s ease;
  }

  .rail-link:hover,
  .rail-link:focus-visible {
    gap: 12px;
    color: var(--cat-deep);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-mark {
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-mark {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-link,
    .faq-mark {
      transition: none;
    }
  }
</style>

<script>
  // Reveal bersama memakai modul yang sudah ada; atributnya cuma [data-fade].
  import '../../scripts/fade-in.js';
</script>
