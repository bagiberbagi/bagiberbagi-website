---
/**
 * VARIAN V5 halaman pintu: "Tipografi Lapang".
 *
 * Bahasa visualnya satu kalimat: judul sangat besar, teks pendek, dan GARIS
 * TIPIS sebagai pemisah menggantikan band warna. Warna identitas pintu tidak
 * pernah jadi bidang besar di sini; ia cuma menyentuh garis, angka, penanda,
 * dan panah tautan. Itu sebabnya varian ini tetap terhormat waktu pintunya
 * kosong: kelapangan memang bahasanya, jadi halaman pendek terbaca sengaja,
 * bukan terbaca bolong.
 *
 * Keputusan yang perlu dicatat, supaya tidak "diperbaiki" tanpa sengaja:
 *
 * 1. Latar cuma tiga keadaan, bukan enam band bergantian: surface-warm untuk
 *    hero dan dua seksi cerita, putih untuk sisanya, ink untuk penutup. Seksi
 *    putih yang bersebelahan dipisah GARIS, bukan pergantian abu-putih, karena
 *    band yang berganti tanpa menandai apa pun cuma bikin halaman berkedip.
 *    Garis itu dipasang otomatis lewat selektor sibling `.pv5-band + .pv5-band`,
 *    bukan lewat class yang ditempel manual per seksi, karena seksi mana yang
 *    bersebelahan berubah tergantung isi pintunya.
 *
 * 2. Foto ada, tapi cuma dua dan keduanya momen. Satu foto full-bleed sesudah
 *    hero, satu lagi menempel pada program yang berjalan. Foto diambil dari peta
 *    PINTU_PHOTOS di bawah, dan peta itu HANYA berisi pintu makanan karena cuma
 *    pintu itu yang punya dokumentasi lapangan. Empat pintu lain jatuh ke seksi
 *    konsep yang menjelaskan pintunya, bukan ke kotak abu penambal. Jangan
 *    memasang foto Jumat Berkah di pintu lain: isinya jelas terbaca sebagai
 *    pembagian nasi kotak.
 *
 * 3. Kartu program aktif tidak lagi setengah lebar. Program yang berjalan
 *    dirender sebagai baris editorial selebar container, dan yang pertama
 *    membawa fotonya. Program yang belum dibuka jadi daftar bergaris di bawah
 *    judul sendiri, jadi tidak ada dua lebar berbeda bertumpuk.
 *
 * 4. Angka yang ditulis tangan di consts.ts SENGAJA tidak dirender, dan itu
 *    berlaku untuk `content.stats` (12.400 porsi, 38 titik) maupun
 *    `content.env.stats` (8,2 t makanan, 3,1 t CO2). Dua-duanya sumbernya sama
 *    dan sama-sama berbenturan dengan angka nyata dari getPintuImpact. Yang
 *    tampil cuma angka yang bisa ditelusuri ke entri jejak. `env.headline`
 *    tetap dipakai karena itu kalimat, bukan angka.
 *
 * 5. `content.howItWorks` tampil sebagai strip alur singkat di kaki seksi
 *    kontribusi, bukan seksi sendiri, karena cara kerja yang sebenarnya berguna
 *    beda per program dan tetap milik halaman program.
 *
 * 6. Semua tombol berlatar ink, bukan berlatar warna pintu. Teks putih di atas
 *    #F4791D cuma 3,0:1 dan di atas #C25D0F 4,3:1, dua-duanya jatuh di bawah
 *    4,5:1 untuk teks 16px bold. Warna pintu cuma dipakai untuk teks yang lolos
 *    ambang TEKS BESAR (22px+ bold atau 24px+, ambangnya 3:1): angka neraca dan
 *    nomor urut `.pv5-step-n`. Nomor urut sempat 15px bold, dan #C25D0F di atas
 *    band hangat #F7F6F3 cuma 3,9:1, jadi ukurannya dinaikkan ke 22px supaya
 *    ambangnya yang berlaku 3:1, bukan 4,5:1. Sisanya penanda non-teks yang
 *    maknanya sudah dibawa label di sebelahnya.
 *
 * 7. Pintu tanpa `CATEGORY_CONTENT` tidak boleh cuma dapat rentetan penyangkalan.
 *    Dulu pintu waktu dan ruang dapat tiga kalimat "belum ada" beruntun dalam
 *    satu gulir. Sekarang keadaan kosong cuma diucapkan SEKALI, di kaki hero,
 *    dan itu pun sebagai kalimat maju. Seksi Program hilang seluruhnya kalau
 *    tidak ada program (kepala seksi tidak pernah dirender tanpa isi), dan
 *    tempat yang tadinya dipakai penyangkalan sekarang diisi seksi konsep dari
 *    peta PINTU_CONCEPT di bawah, yang menjelaskan apa itu pintu ini dan apa
 *    saja bentuk berbaginya.
 *
 * 8. Semua ukuran huruf memakai nilai skala di tailwind.config.mjs
 *    (11/12/13/14/16/18/22/26/30/34/40/56). Nilai clamp boleh, asal kedua
 *    ujungnya nilai token. Judul terbesar berhenti di 56px karena itu step
 *    terbesar yang ada di config; skala baru harus masuk config dulu.
 *    Catatan: tabel type scale di DESIGN_SYSTEM.md sudah basi terhadap config,
 *    jadi config yang dipakai sebagai sumber.
 *
 * Lebar: seluruh halaman memakai tier `wide` (1280), menyimpang dari default
 * `standard` halaman non-beranda. Tipografi sebesar ini butuh ruang, dan tepi
 * kirinya jadi satu garis lurus dari hero sampai penutup.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import type { Pintu, PintuId, CategoryContent } from '../../consts';
import type { Program } from '../../lib/programs';
import type { Impact as PintuImpact } from '../../lib/impact';
import { formatMetric } from '../../lib/format';
import heroJumatBerkah from '../../assets/images/hero-jumat-berkah.png';
import programPromo from '../../assets/images/program-promo.png';

interface Props {
  pintu: Pintu;
  content: CategoryContent | undefined;
  programs: Program[];
  active: Program[];
  upcoming: Program[];
  otherPintu: Pintu[];
  impact: PintuImpact;
  hasImpact: boolean;
  contactWa: string;
  notifyWa: string;
  jejakHref: string;
}

const {
  pintu,
  content,
  active,
  upcoming,
  otherPintu,
  impact,
  hasImpact,
  contactWa,
  notifyWa,
  jejakHref,
} = Astro.props;

/**
 * Foto per pintu. Hanya makanan yang punya, dan itu memang keadaannya di repo:
 * tiga foto lapangan yang semuanya bertema penyaluran makanan siap saji.
 * Pintu tanpa entri di peta ini merender jalur tanpa foto.
 */
interface PintuPhotos {
  lead: ImageMetadata;
  leadAlt: string;
  caption: string;
  program: ImageMetadata;
  programAlt: string;
}

const PINTU_PHOTOS: Partial<Record<PintuId, PintuPhotos>> = {
  food: {
    lead: heroJumatBerkah,
    leadAlt: 'Warga dan anak-anak menerima kotak makan pada penyaluran Jumat Berkah di halaman masjid',
    caption: 'Satu pagi Jumat, satu titik penyaluran, kotak makan yang berpindah tangan.',
    program: programPromo,
    programAlt: 'Relawan bagiberbagi.id menyerahkan tas bantuan kepada warga di gang kampung',
  },
};

const photos = PINTU_PHOTOS[pintu.id];

/**
 * Teks konsep per pintu, dipakai saat `CATEGORY_CONTENT` untuk pintu itu belum
 * ada. Tanpa ini, empat dari lima pintu tidak punya satu pun kalimat yang
 * menjelaskan apa maksud pintunya, dan yang tersisa cuma tagline satu baris di
 * hero. Sengaja tidak memuat angka apa pun: yang belum berjalan tidak punya
 * angka yang bisa ditelusuri.
 *
 * Petanya lengkap lima pintu supaya tidak ada pintu yang diam-diam kosong,
 * walau entri `food` praktis tidak terpakai karena pintu itu sudah punya
 * CATEGORY_CONTENT sendiri.
 */
interface PintuConcept {
  what: string;
  examples: string[];
}

const PINTU_CONCEPT: Record<PintuId, PintuConcept> = {
  food: {
    what: 'Berbagi Makanan menghubungkan dapur yang punya lebih dengan meja yang sedang kurang. Yang berpindah bukan cuma porsi, tapi kepastian bahwa hari itu ada yang dimakan.',
    examples: [
      'Donasi paket makan siap antar',
      'Surplus dapur yang masih layak',
      'Jadi mitra dapur penyalur',
      'Menyiapkan titik penerima',
    ],
  },
  goods: {
    what: 'Berbagi Barang memindahkan yang sudah tidak terpakai di satu rumah ke rumah yang masih memerlukannya. Barangnya tetap sama, yang berubah nilainya bagi yang menerima.',
    examples: [
      'Pakaian layak pakai',
      'Buku dan alat sekolah',
      'Perlengkapan bayi dan rumah tangga',
      'Alat kerja yang masih berfungsi',
    ],
  },
  time: {
    what: 'Berbagi Waktu adalah satu-satunya pintu yang tidak menuntut apa pun selain kehadiran. Keahlian yang kamu pakai sehari-hari sering justru yang paling dicari di kegiatan sosial.',
    examples: [
      'Mengajar dan mendampingi belajar',
      'Membantu penyaluran di lapangan',
      'Konsultasi sesuai keahlian',
      'Mendokumentasikan kegiatan',
    ],
  },
  space: {
    what: 'Berbagi Ruang membuka tempat yang sedang kosong untuk kegiatan yang sedang butuh tempat. Satu aula yang menganggur setengah hari bisa jadi titik penyaluran.',
    examples: [
      'Aula dan ruang pertemuan',
      'Gudang penyimpanan sementara',
      'Dapur bersama',
      'Kendaraan pengantar',
    ],
  },
  money: {
    what: 'Berbagi Dana menutup bagian yang tidak bisa ditutup barang atau tenaga, mulai dari bahan baku sampai ongkos antar. Setiap penyaluran meninggalkan catatan yang bisa dibaca ulang.',
    examples: [
      'Zakat, infak, dan sedekah',
      'Donasi rutin bulanan',
      'Dana CSR perusahaan',
      'Patungan komunitas',
    ],
  },
};

const concept = PINTU_CONCEPT[pintu.id];

const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;

const hasPrograms = active.length > 0 || upcoming.length > 0;

/**
 * Satu kalimat status di kaki hero, diturunkan dari data supaya tidak pernah
 * mengklaim program yang tidak ada. Ini SATU-SATUNYA tempat keadaan kosong
 * diucapkan di halaman ini, jadi cabang ketiganya ditulis sebagai kalimat maju,
 * bukan sebagai penyangkalan. Kalau nanti ada yang menambah kalimat "belum ada"
 * di seksi lain, hapus salah satunya.
 */
const statusLine =
  active.length > 0
    ? `Program yang sudah berjalan lewat pintu ini: ${active.map((p) => p.label).join(', ')}.`
    : upcoming.length > 0
      ? `${upcoming.length} program sedang kami siapkan di pintu ini.`
      : 'Pintu ini kami buka begitu mitra dan titik penerimanya siap. Kabarnya kami kirim lewat WhatsApp.';

const forWhom = content?.forWhom ?? [];
const env = content?.env;
const contribute = content?.contribute ?? [];
const howItWorks = content?.howItWorks ?? [];
const faq = content?.faq ?? [];

// Seksi konsep dirender saat pintu ini belum punya CATEGORY_CONTENT, jadi
// halaman tetap menjelaskan dirinya sendiri walau semua blok lain kosong.
const showConcept = !content;

/**
 * Kepala seksi cerita mengikuti sisi yang benar-benar terisi. Judul lama
 * menjanjikan dua hal sekaligus ("siapa yang terbantu, dan apa yang ikut
 * terselamatkan") padahal seksinya sudah dirender kalau salah satunya saja ada.
 */
const hasStory = forWhom.length > 0 || Boolean(env);
const storyEyebrow = forWhom.length > 0 ? 'Untuk Siapa' : 'Dampak Ikutan';
const storyTitle = forWhom.length > 0 ? 'Siapa yang terbantu' : (env?.headline ?? '');
const storyNote = forWhom.length > 0 ? env?.headline : undefined;

/**
 * Kepala seksi kontribusi ikut blok yang ada. Judul lama mematok angka tiga
 * padahal daftarnya dirender dari `contribute.map` yang panjangnya bebas, dan
 * masih tampil walau yang terisi cuma `howItWorks`.
 */
const contributeEyebrow = contribute.length > 0 ? 'Cara Ikut' : 'Cara Kerja';
const contributeTitle = contribute.length > 0 ? 'Yang bisa kamu bagi' : 'Alur singkatnya';
const contributeLead =
  contribute.length > 0
    ? 'Pilih jalan yang paling dekat dengan yang sudah kamu punya. Semuanya berakhir di penerima yang sama.'
    : 'Garis besarnya sama di semua program, detailnya yang berbeda.';

const ARROW_D = 'M5 12h14';
const ARROW_HEAD = 'm13 6 6 6-6 6';
---

<div class="pv5" style={styleVars}>
  {/* HERO: satu kolom kiri, judul sebesar mungkin, sisanya ruang. Latar warm
      dengan satu sapuan warna pintu yang sangat tipis di kanan atas, jadi
      identitasnya hadir tanpa jadi bidang. Ditarik naik 74px supaya bidangnya
      menembus ke belakang pil navbar (10px margin + 64px pil, lihat Header.astro). */}
  <section class="pv5-hero">
    <Container width="wide" class="pv5-hero-inner">
      <nav class="pv5-crumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href="/#pintu">Pintu Berbagi</a>
        <span aria-hidden="true">/</span>
        <span class="pv5-crumb-now">{pintu.label}</span>
      </nav>

      <p class="pv5-eyebrow" data-fade>{pintu.english}</p>
      <h1 class="pv5-h1" data-fade>{pintu.label}</h1>
      <p class="pv5-lead pv5-lead-hero" data-fade>{pintu.tagline}</p>

      <div class="pv5-actions" data-fade>
        <a
          href={contactWa}
          target="_blank"
          rel="noopener"
          data-track="contact_wa"
          data-track-pintu={pintu.slug}
          class="pv5-btn"
        >
          Hubungi Kami
        </a>
        {/* Tombol kedua tidak pernah menyuruh pengunjung keluar dari halaman ini.
            Ada jejak, ia ke jejak; ada program tapi belum ada jejak, ia turun ke
            seksi program; tidak ada apa-apa, ia jadi jalan untuk dikabari. */}
        {hasImpact ? (
          <a href={jejakHref} class="pv5-btn pv5-btn-ghost">Lihat rekam jejak</a>
        ) : hasPrograms ? (
          <a href="#program" class="pv5-btn pv5-btn-ghost">Lihat program di pintu ini</a>
        ) : (
          <a
            href={notifyWa}
            target="_blank"
            rel="noopener"
            data-track="notify_wa"
            data-track-pintu={pintu.slug}
            class="pv5-btn pv5-btn-ghost"
          >
            Beri tahu saya saat pintu ini dibuka
          </a>
        )}
      </div>

      <div class="pv5-hero-foot" data-fade>
        <p class="pv5-hero-status">{statusLine}</p>
        <span class="pv5-hero-mark" aria-hidden="true">
          <Icon name={pintu.icon} size={26} />
        </span>
      </div>
    </Container>
  </section>

  {/* MOMEN: satu foto full-bleed, cuma untuk pintu yang punya dokumentasi. */}
  {photos && (
    <section class="pv5-moment">
      <Image
        src={photos.lead}
        alt={photos.leadAlt}
        widths={[640, 960, 1280]}
        sizes="100vw"
        loading="eager"
        class="pv5-moment-img"
      />
      <div class="pv5-moment-scrim" aria-hidden="true"></div>
      <Container width="wide" class="pv5-moment-inner">
        <p class="pv5-caption">{photos.caption}</p>
      </Container>
    </section>
  )}

  {/* KONSEP: untuk pintu yang belum punya CATEGORY_CONTENT. Dua kolom yang
      dua-duanya membawa isi (46rem teks di kiri, daftar bentuk berbagi di
      kanan), bukan satu paragraf pendek dengan ikon raksasa mengambang di
      seberangnya. Ini juga yang bikin halaman pintu kosong tetap punya kalimat
      konseptual, bukan cuma tagline satu baris di hero. */}
  {showConcept && (
    <section class="pv5-band py-24 md:py-32">
      <Container width="wide">
        <div class="pv5-concept">
          <div class="pv5-concept-head">
            <p class="pv5-eyebrow" data-fade>Tentang Pintu Ini</p>
            <h2 class="pv5-h2" data-fade>Apa itu {pintu.label}</h2>
            <p class="pv5-lead" data-fade>{concept.what}</p>
          </div>

          <div class="pv5-concept-side" data-fade>
            <p class="pv5-concept-label">Bentuk berbaginya</p>
            <ul class="pv5-concept-list">
              {concept.examples.map((item) => (
                <li>
                  <span aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </Container>
    </section>
  )}

  {/* DAMPAK: dibuka kalimat, angkanya menyusul. Bentuknya baris bergaris, bukan
      grid kartu, jadi 1, 2, atau 5 metrik sama-sama duduk rapi dan tidak ada
      metrik yang diam-diam dibuang lewat slice(). */}
  {hasImpact && (
    <section class="pv5-band py-24 md:py-32">
      <Container width="wide">
        <header class="pv5-head">
          <p class="pv5-eyebrow" data-fade>Rekam Jejak</p>
          <h2 class="pv5-h2" data-fade>Yang sudah tercatat</h2>
          <p class="pv5-lead" data-fade>
            Angka di bawah dijumlahkan dari {impact.jejakCount.toLocaleString('id-ID')} kegiatan yang
            sudah kami dokumentasikan di pintu {pintu.label}. Tiap kegiatan punya halaman sendiri
            berisi foto dan catatan lapangannya.
          </p>
        </header>

        <div class="pv5-ledger">
          {impact.metrics.map((m) => (
            <div class="pv5-metric" data-fade>
              <span class="pv5-num">{formatMetric(m)}</span>
              <span class="pv5-metric-label">{m.label}</span>
            </div>
          ))}
        </div>

        <div class="pv5-foot">
          <p class="pv5-foot-text">
            Setiap angka berasal dari kegiatan yang sudah terjadi dan terdokumentasi, bukan dari
            target.
          </p>
          <a href={jejakHref} class="pv5-link">
            Telusuri jejak {pintu.label}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
          </a>
        </div>
      </Container>
    </section>
  )}

  {/* IKUT BERKONTRIBUSI: daftar bernomor lebar penuh. Alur singkat ditaruh di
      kaki seksi yang sama, bukan seksi sendiri, karena cara kerja yang detail
      milik halaman program. */}
  {(contribute.length > 0 || howItWorks.length > 0) && (
    <section class="pv5-band pv5-band-warm py-24 md:py-32">
      <Container width="wide">
        {/* Judulnya tidak menyebut jumlah, karena daftarnya dirender dari
            `contribute.map` yang panjangnya bebas, dan tidak memakai frasa
            "pintu masuk" karena "pintu" di halaman ini sudah berarti kategori. */}
        <header class="pv5-head">
          <p class="pv5-eyebrow" data-fade>{contributeEyebrow}</p>
          <h2 class="pv5-h2" data-fade>{contributeTitle}</h2>
          <p class="pv5-lead" data-fade>{contributeLead}</p>
        </header>

        {contribute.length > 0 && (
          <ol class="pv5-steps">
            {contribute.map((c, i) => (
              <li class="pv5-step" data-fade>
                <span class="pv5-step-n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="pv5-step-title">{c.title}</h3>
                <p class="pv5-step-desc">{c.desc}</p>
              </li>
            ))}
          </ol>
        )}

        {howItWorks.length > 0 && (
          <div class:list={['pv5-flow', contribute.length === 0 && 'is-lead']}>
            {contribute.length > 0 && <p class="pv5-flow-label">Alur singkatnya</p>}
            <ol class="pv5-flow-list">
              {howItWorks.map((s) => (
                <li class="pv5-flow-item">
                  <span class="pv5-flow-dot" aria-hidden="true"></span>
                  <b>{s.title}</b>
                  <span>{s.desc}</span>
                </li>
              ))}
            </ol>
            <p class="pv5-flow-note">
              Detail cara kerjanya berbeda per program, jadi versi lengkapnya ada di halaman program
              masing-masing.
            </p>
          </div>
        )}
      </Container>
    </section>
  )}

  {/* PROGRAM: baris editorial selebar container. Satu program aktif tidak lagi
      duduk di setengah kolom, dan program pertama membawa fotonya kalau ada.
      Seluruh seksi, kepala seksinya sekalian, cuma dirender kalau ada program.
      Kepala seksi besar di atas satu kalimat "belum punya program" adalah persis
      pola judul-tanpa-isi, dan keadaan itu sudah diucapkan sekali di kaki hero. */}
  {hasPrograms && (
  <section id="program" class="pv5-band py-24 md:py-32">
    <Container width="wide">
      <header class="pv5-head">
        <p class="pv5-eyebrow" data-fade>Program</p>
        <h2 class="pv5-h2" data-fade>Program di pintu {pintu.label}</h2>
        <p class="pv5-lead" data-fade>
          Pintu adalah jalan masuknya, program adalah kegiatan yang benar-benar berjalan di
          lapangan.
        </p>
      </header>

      {active.map((p, i) => {
        const withPhoto = i === 0 && Boolean(photos);
        const withFeatures = !withPhoto && p.detail.features.length > 0;
        return (
          <article
            class:list={['pv5-prog', withPhoto && 'has-photo', withFeatures && 'has-features']}
            data-fade
          >
            {withPhoto && photos && (
              <div class="pv5-prog-photo">
                <Image
                  src={photos.program}
                  alt={photos.programAlt}
                  widths={[420, 640, 900, 1200]}
                  sizes="(min-width: 900px) 620px, 100vw"
                  loading="lazy"
                  class="pv5-prog-img"
                />
              </div>
            )}

            <div class="pv5-prog-body">
              <p class="pv5-tag">
                <span class="pv5-tag-dot" aria-hidden="true"></span>
                Sedang berjalan
              </p>
              <h3 class="pv5-prog-title">{p.label}</h3>
              <p class="pv5-prog-sum">{p.summary}</p>
              {p.href ? (
                <a href={p.href} class="pv5-link" data-track="pintu_program" data-track-program={p.slug}>
                  Lihat halaman program
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
                </a>
              ) : (
                <p class="pv5-prog-note">Halaman programnya sedang kami siapkan.</p>
              )}
            </div>

            {withFeatures && (
              <ul class="pv5-prog-features">
                {p.detail.features.map((f) => (
                  <li><span aria-hidden="true"></span>{f}</li>
                ))}
              </ul>
            )}
          </article>
        );
      })}

      {upcoming.length > 0 && (
        <div class="pv5-next">
          <p class="pv5-next-label">Belum dibuka</p>
          <ul class="pv5-next-list">
            {upcoming.map((p) => (
              <li class="pv5-next-item" data-fade>
                <div class="pv5-next-main">
                  <h3 class="pv5-next-title">{p.label}</h3>
                  <p class="pv5-next-sum">{p.summary}</p>
                </div>
                <span class="pv5-next-badge">Segera</span>
              </li>
            ))}
          </ul>
          <a
            href={notifyWa}
            target="_blank"
            rel="noopener"
            data-track="notify_wa"
            data-track-pintu={pintu.slug}
            class="pv5-link pv5-next-cta"
          >
            Beri tahu saya saat program ini dibuka
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
          </a>
        </div>
      )}

    </Container>
  </section>
  )}

  {/* SIAPA YANG TERBANTU: judul dan eyebrow mengikuti sisi yang benar-benar
      terisi, jadi tidak ada separuh janji waktu cuma salah satu blok yang ada.
      `env.stats` sengaja tidak dirender, alasannya di catatan nomor 4 di kepala
      file; `env.headline` tetap dipakai karena itu kalimat, bukan angka.
      Daftarnya mengalir menyamping, bukan satu baris per item, supaya baris
      sependek "Panti asuhan" tidak menyisakan setengah container kosong. */}
  {hasStory && (
    <section class="pv5-band pv5-band-warm py-24 md:py-32">
      <Container width="wide">
        <header class="pv5-head">
          <p class="pv5-eyebrow" data-fade>{storyEyebrow}</p>
          <h2 class="pv5-h2" data-fade>{storyTitle}</h2>
          {storyNote && <p class="pv5-lead" data-fade>{storyNote}</p>}
        </header>

        {forWhom.length > 0 && (
          <ul class="pv5-who" data-fade>
            {forWhom.map((who) => (
              <li><span aria-hidden="true"></span>{who}</li>
            ))}
          </ul>
        )}
      </Container>
    </section>
  )}

  {/* FAQ: teks utuh, tanpa akordeon. Tiga pertanyaan yang dibaca langsung lebih
      lapang daripada tiga baris yang harus diklik dulu. */}
  {faq.length > 0 && (
    <section class="pv5-band py-24 md:py-32">
      <Container width="wide">
        <header class="pv5-head">
          <p class="pv5-eyebrow" data-fade>Pertanyaan</p>
          <h2 class="pv5-h2" data-fade>Yang paling sering ditanyakan</h2>
        </header>

        <dl class="pv5-faq">
          {faq.map((item) => (
            <div class="pv5-faq-item" data-fade>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </Container>
    </section>
  )}

  {/* PINTU LAIN: daftar indeks selebar container, bukan kartu pendek. Tiap baris
      membawa warnanya sendiri lewat --cat lokal. */}
  <section class="pv5-band py-24 md:py-32">
    <Container width="wide">
      <header class="pv5-head pv5-head-tight">
        <p class="pv5-eyebrow" data-fade>Pintu Lainnya</p>
        <h2 class="pv5-h2" data-fade>Jalan berbagi yang lain</h2>
      </header>

      <ul class="pv5-index">
        {otherPintu.map((p) => (
          <li>
            <a
              href={`/berbagi-${p.slug}/`}
              class="pv5-index-row"
              style={`--cat:${p.color};--cat-tint:${p.colorTint};--cat-deep:${p.colorDeep}`}
            >
              <span class="pv5-index-icon"><Icon name={p.icon} size={20} /></span>
              <span class="pv5-index-main">
                <b>{p.label}</b>
                <span>{p.tagline}</span>
              </span>
              <svg class="pv5-index-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={ARROW_D}></path><path d={ARROW_HEAD}></path></svg>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  {/* PENUTUP: satu-satunya bidang gelap, dan satu-satunya kepala yang boleh
      ditengahkan. Warna pintu jadi watermark dan penanda, tombolnya putih
      karena teks putih di atas warna pintu tidak lolos kontras. */}
  <section class="pv5-close py-24 md:py-32">
    <Container width="wide">
      <div class="pv5-close-inner">
        <p class="pv5-eyebrow pv5-eyebrow-dark" data-fade>{pintu.label}</p>
        <h2 class="pv5-h2 pv5-h2-dark" data-fade>
          {content?.ctaTitle ?? `Ingin berkontribusi lewat ${pintu.label}?`}
        </h2>
        <p class="pv5-lead pv5-lead-dark" data-fade>
          {content?.ctaText ?? 'Ceritakan apa yang bisa kamu bagi, tim kami bantu menyalurkannya.'}
        </p>
        <a
          href={contactWa}
          target="_blank"
          rel="noopener"
          data-track="pintu_cta"
          data-track-pintu={pintu.slug}
          class="pv5-btn pv5-btn-light"
          data-fade
        >
          Hubungi Kami
        </a>
      </div>
      <span class="pv5-close-mark" aria-hidden="true">
        <Icon name={pintu.icon} size={220} />
      </span>
    </Container>
  </section>
</div>

<style>
  /* DUA peran garis, dua nilai, dua-duanya token dari tailwind.config.mjs.
     Sebelumnya ada dua netral bikinan sendiri (#e8e6e1 dan #d6d3cd) yang tidak
     ada padanannya di palet mana pun, dan pembagiannya tidak mengikuti peran.
     Sekarang:
       --line       token `border` #EEF0F3 (gray.50-ish), garis RITME di dalam
                    seksi: baris neraca, baris daftar, baris FAQ. Sengaja nyaris
                    tak terlihat, karena yang memisahkan di situ isinya.
       --line-band  token gray.300 #B4BCC8, pemisah STRUKTUR antar seksi dan di
                    kaki hero. Di halaman yang bahasanya garis, pemisah seksi
                    tidak boleh senyap; #EEF0F3 di atas putih cuma sekitar
                    1,06:1 dan praktis hilang.
     Batas yang membawa makna sebagai batas komponen, yaitu batas tombol, tidak
     memakai dua-duanya tapi gray.400 #687281 supaya lolos ambang 3:1. */
  .pv5 {
    --line: #eef0f3;
    --line-band: #b4bcc8;
  }

  /* ---------- Kepala seksi (rumus yang sama di seluruh halaman) ---------- */
  .pv5-head { max-width: 46rem; margin: 0 0 48px; }
  .pv5-head-tight { margin-bottom: 36px; }

  .pv5-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    /* token eyebrow 13px */
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0f172a;
  }
  .pv5-eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    flex: none;
    background: var(--cat);
  }
  .pv5-eyebrow-dark { color: rgba(255, 255, 255, 0.85); }

  /* Ujung clamp selalu nilai token. H1 berhenti di display-lg 56px, step
     terbesar yang ada di config; sebelumnya 76px, yaitu 20px di luar sistem.
     Kelapangan varian ini tetap datang dari jarak antar elemen dan dari body
     yang kecil, bukan dari judul yang melewati skala. */
  .pv5-h1 {
    margin: 0;
    /* heading-lg 34 → display-lg 56 */
    font-size: clamp(34px, 6.4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: #0f172a;
    text-wrap: balance;
  }
  .pv5-h2 {
    margin: 0;
    /* heading 30 → display 40 */
    font-size: clamp(30px, 4.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: #0f172a;
    text-wrap: balance;
  }
  .pv5-h2-dark { color: #fff; }

  .pv5-lead {
    margin: 18px 0 0;
    /* title-sm 18 → title 22 */
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.62;
    color: #505d6f;
    max-width: 58ch;
    text-wrap: pretty;
  }
  .pv5-lead-hero { margin-top: 24px; }
  .pv5-lead-dark { color: rgba(255, 255, 255, 0.78); }

  /* ---------- Hero ---------- */
  /* -74px = 10px margin atas + 64px pil navbar (Header.astro mengunci angka
     itu). Kalau tinggi header berubah, angka ini ikut. */
  .pv5-hero {
    position: relative;
    margin-top: -74px;
    padding: calc(74px + 72px) 0 96px;
    background: #f7f6f3;
    overflow: hidden;
  }
  .pv5-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 88% 0%, var(--cat-tint), transparent 62%);
    pointer-events: none;
  }
  .pv5-hero > * { position: relative; }
  @media (min-width: 768px) {
    .pv5-hero { padding: calc(74px + 104px) 0 128px; }
  }

  .pv5-crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 56px;
    font-size: 13px;
    font-weight: 600;
    color: #687281;
  }
  .pv5-crumb a { transition: color 0.18s ease; }
  .pv5-crumb a:hover { color: var(--cat-deep); }
  .pv5-crumb span[aria-hidden] { color: #b4bcc8; }
  .pv5-crumb-now { color: #0f172a; }

  .pv5-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .pv5-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    border-radius: 999px;
    background: #0f172a;
    color: #fff;
    font-weight: 700;
    /* token body 16px */
    font-size: 16px;
    border: 1.5px solid #0f172a;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .pv5-btn:hover { transform: translateY(-2px); }
  /* Batas tombol membawa makna, jadi ia harus lolos 3:1. gray.400 #687281 di
     atas hero hangat #F7F6F3 sekitar 4,5:1. Netral bikinan sendiri #d6d3cd
     sebelumnya cuma sekitar 1,5:1 dan tombolnya nyaris tak terlihat. */
  .pv5-btn-ghost {
    background: transparent;
    color: #0f172a;
    border-color: #687281;
  }
  .pv5-btn-ghost:hover { border-color: var(--cat); }
  .pv5-btn-light {
    background: #fff;
    color: #0f172a;
    border-color: #fff;
  }

  .pv5-hero-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 1px solid var(--line-band);
  }
  .pv5-hero-status {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #505d6f;
    max-width: 52ch;
  }
  .pv5-hero-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    /* --cat-deep, bukan --cat: di band hangat, cincin --cat pintu makanan cuma
       sekitar 2,6:1 sementara --cat-deep sekitar 4,0:1. */
    border: 1.5px solid var(--cat-deep);
    color: var(--cat-deep);
  }

  /* ---------- Momen foto ---------- */
  .pv5-moment {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 58vh;
    overflow: hidden;
  }
  .pv5-moment-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .pv5-moment-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 18, 30, 0.78), rgba(10, 18, 30, 0.18) 55%, rgba(10, 18, 30, 0.04));
  }
  .pv5-moment-inner {
    position: relative;
    padding-top: 0;
    padding-bottom: 48px;
  }
  @media (min-width: 768px) {
    .pv5-moment { min-height: 66vh; }
    .pv5-moment-inner { padding-bottom: 72px; }
  }
  .pv5-caption {
    margin: 0;
    padding-top: 18px;
    border-top: 2px solid var(--cat);
    max-width: 46ch;
    /* title-sm 18 → title 22 */
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.45;
    font-weight: 600;
    color: #fff;
    text-wrap: pretty;
  }

  /* ---------- Seksi konsep (pintu tanpa CATEGORY_CONTENT) ---------- */
  /* Dua kolom yang dua-duanya membawa teks, jadi rasionya 1.15fr 1fr sesuai
     DESIGN_SYSTEM. Versi sebelumnya menaruh paragraf 40ch di kiri dan ikon
     200px di kanan dalam band 1280px, dan lubang di tengahnya itu yang bikin
     halaman terbaca bolong. */
  .pv5-concept { display: grid; gap: 44px; }
  @media (min-width: 900px) {
    .pv5-concept { grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: start; }
  }
  .pv5-concept-head { max-width: 46rem; }
  .pv5-concept-side { padding-top: 8px; }
  .pv5-concept-label {
    margin: 0 0 20px;
    /* token label 11px */
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #687281;
  }
  .pv5-concept-list { list-style: none; margin: 0; padding: 0; }
  .pv5-concept-list li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    /* token title-sm 18 → title 22 */
    font-size: clamp(18px, 1.8vw, 22px);
    letter-spacing: -0.015em;
    color: #0f172a;
  }
  .pv5-concept-list li:last-child { border-bottom: 1px solid var(--line); }
  .pv5-concept-list li span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--cat);
  }

  /* ---------- Band umum ---------- */
  .pv5-band { background: #fff; }
  .pv5-band-warm { background: #f7f6f3; }
  /* Dua band berlatar sama yang berturut-turut dipisah garis, bukan pergantian
     abu-putih. Dipasang lewat selektor sibling, bukan class manual, karena seksi
     mana yang berakhir bersebelahan berubah tergantung isi pintunya: pintu tanpa
     foto dan tanpa program sempat menyambungkan dua bidang putih sepanjang
     seribu piksel tanpa satu pemisah pun. Cabang warm+warm belum terjadi hari
     ini, tapi ia terjadi begitu satu pintu punya `contribute` dan `forWhom`
     tanpa program di antaranya. */
  .pv5-band:not(.pv5-band-warm) + .pv5-band:not(.pv5-band-warm),
  .pv5-band-warm + .pv5-band-warm {
    border-top: 1px solid var(--line-band);
  }

  /* ---------- Neraca angka dampak ---------- */
  .pv5-ledger { display: flex; flex-direction: column; }
  /* Angka di tepi kiri, labelnya di tepi kanan, jadi barisnya membentang penuh
     seperti `.pv5-index-row`. Versi rata kiri menyisakan lebih dari separuh
     container kosong di tiap baris, dan barisnya berulang. */
  .pv5-metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .pv5-metric:last-child { border-bottom: 1px solid var(--line); }
  .pv5-num {
    flex: none;
    /* heading-lg 34 → display-lg 56 */
    font-size: clamp(34px, 5.2vw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--cat-deep);
    font-variant-numeric: tabular-nums;
  }
  .pv5-metric-label {
    /* token body 16px */
    font-size: 16px;
    line-height: 1.5;
    color: #505d6f;
    text-align: right;
  }

  .pv5-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
  }
  .pv5-foot-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #505d6f;
    max-width: 62ch;
  }

  /* ---------- Tautan panah ---------- */
  .pv5-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    /* token body 16px */
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
    transition: gap 0.18s ease, text-decoration-color 0.18s ease;
  }
  .pv5-link:hover,
  .pv5-link:focus-visible {
    gap: 14px;
    text-decoration-line: underline;
    text-decoration-color: var(--cat);
  }
  .pv5-link svg {
    width: 17px;
    height: 17px;
    flex: none;
    fill: none;
    stroke: var(--cat-deep);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Daftar cara ikut ---------- */
  .pv5-steps { list-style: none; margin: 0; padding: 0; }
  .pv5-step {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 4px 16px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .pv5-step:last-child { border-bottom: 1px solid var(--line); }
  /* 22px bold, bukan 15px. Nomor urut ini TEKS berwarna --cat-deep di atas band
     hangat #F7F6F3, dan untuk pintu makanan rasionya sekitar 3,9:1. Di bawah
     19px bold ambangnya 4,5:1 dan itu gagal; di 22px bold ambangnya 3:1 dan itu
     lolos. Jangan kecilkan lagi tanpa menukar warnanya ke ink. */
  .pv5-step-n {
    grid-row: span 2;
    /* token title 22px */
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--cat-deep);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .pv5-step-title {
    margin: 0;
    /* title-sm 18 → heading-sm 26 */
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #0f172a;
  }
  .pv5-step-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #505d6f;
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .pv5-step {
      grid-template-columns: 52px minmax(0, 0.85fr) minmax(0, 1.25fr);
      align-items: baseline;
      gap: 32px;
    }
    .pv5-step-n { grid-row: auto; padding-top: 0; }
  }

  .pv5-flow { margin-top: 56px; padding-top: 26px; border-top: 1px solid var(--line); }
  /* Waktu `contribute` kosong, strip alur ini yang jadi isi utama seksinya, jadi
     ia tidak lagi menempel sebagai kaki di bawah garis. */
  .pv5-flow.is-lead { margin-top: 0; padding-top: 0; border-top: 0; }
  .pv5-flow-label {
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #687281;
  }
  .pv5-flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .pv5-flow-list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  }
  .pv5-flow-item {
    display: grid;
    gap: 5px;
    font-size: 14px;
    line-height: 1.55;
    color: #505d6f;
  }
  /* token body 16px */
  .pv5-flow-item b { color: #0f172a; font-weight: 700; font-size: 16px; }
  .pv5-flow-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--cat);
  }
  .pv5-flow-note {
    margin: 24px 0 0;
    /* token body-sm 14px */
    font-size: 14px;
    line-height: 1.6;
    color: #687281;
    max-width: 62ch;
  }

  /* ---------- Program ---------- */
  .pv5-prog {
    display: grid;
    gap: 28px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    /* Kolom pertamanya foto, jadi rasionya 1.5fr 1fr sesuai DESIGN_SYSTEM,
       bukan 1.15fr 1fr yang berlaku untuk dua kolom teks. */
    .pv5-prog.has-photo { grid-template-columns: 1.5fr 1fr; gap: 56px; align-items: center; }
    .pv5-prog.has-features { grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: start; }
  }
  .pv5-prog-photo {
    border-radius: 20px;
    overflow: hidden;
    background: var(--cat-tint);
  }
  .pv5-prog-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .pv5-prog-body { display: flex; flex-direction: column; align-items: flex-start; }
  .pv5-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
  }
  .pv5-tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--cat);
  }
  .pv5-prog-title {
    margin: 0 0 14px;
    /* heading-sm 26 → heading-lg 34 */
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: #0f172a;
    text-wrap: balance;
  }
  .pv5-prog-sum {
    margin: 0 0 22px;
    font-size: 16px;
    line-height: 1.62;
    color: #505d6f;
    max-width: 52ch;
  }
