---
import { getEntry } from 'astro:content';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { breadcrumbsFromUrl } from '@jdevalk/astro-seo-graph';
import { findPageSeo } from '../lib/seo';
import { resolveShareImage } from '../lib/share-image';
import {
  assembleGraph,
  buildBreadcrumbList,
  buildPiece,
  buildWebPage,
  buildWebSite,
  makeIds,
} from '@jdevalk/seo-graph-core';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getAnalytics } from '../lib/analytics';

export interface Props {
  /** Overrides the title from the SEO singleton. Halaman yang isinya sendiri dari CMS (legal) memakai ini. */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of a share image (1200x630 ideal). */
  image?: string;
  /** Hide the page from search engines (e.g. admin routes). */
  noindex?: boolean;
  /** Short name for the last breadcrumb crumb. Defaults to the title minus the site suffix. */
  breadcrumbName?: string;
  /**
   * Jalur breadcrumb antara Beranda dan halaman ini, urut dari yang terluar.
   * Diisi halaman yang jalur nyatanya BEDA dari bentuk URL-nya.
   *
   * Bawaannya diturunkan dari segmen URL, dan untuk sebagian besar halaman itu
   * benar. Halaman program tidak: URL-nya `/program/<slug>/` sehingga tersusun
   * crumb "Program" yang menunjuk `/program/`, padahal alamat itu cuma stub
   * noindex yang melempar ke `/#pintu`. Induk sesungguhnya sebuah program
   * adalah pintunya, dan itulah yang tertulis di breadcrumb yang dilihat
   * pengunjung. Dua representasi yang tak sepakat di satu halaman adalah
   * persis yang diminta Google untuk dihindari.
   */
  breadcrumbTrail?: { name: string; url: string }[];
  /** Extra JSON-LD pieces contributed by the page (e.g. FAQPage), merged into the same @graph. */
  extraSchema?: Record<string, unknown>[];
}

const ORG_SLUG = 'bagiberbagi';

const props = Astro.props;

const seoEntry = await getEntry('seo', 'seo');
if (!seoEntry) throw new Error('seo/seo entry not found');
const seo = seoEntry.data;

// Provider analytics yang aktif (dicentang + ID terisi di Keystatic). Default
// semua mati → <Analytics> tidak merender apa pun.
const analytics = await getAnalytics();

// Halaman statis mengambil teksnya dari singleton `seo`; halaman yang teksnya
// sudah punya sumber sendiri di CMS (legal) menimpanya lewat props.
const page = findPageSeo(seo, Astro.url.pathname);

const rawTitle = props.title ?? page?.title ?? seo.defaultTitle;
const description = props.description ?? page?.description ?? seo.defaultDescription;
const image = props.image ?? page?.image ?? seo.defaultImage;
const noindex = props.noindex ?? page?.noindex ?? false;
const breadcrumbName = props.breadcrumbName ?? page?.breadcrumbName;
const breadcrumbTrail = props.breadcrumbTrail;
const extraSchema = props.extraSchema ?? [];

// <Seo> merender judul lewat `<title set:html={...}>` — tanpa escaping. Karena
// judul datang dari CMS, buang `<`/`>` supaya isian editor tidak bisa menutup
// tag dan menyuntik markup. `&` sengaja dibiarkan: parser HTML5 memperlakukannya
// sebagai teks di dalam <title>, dan meng-escape-nya di sini akan double-escape
// og:title (yang sudah di-escape Astro lewat `content=`).
const title = rawTitle.replace(/[<>]/g, '');

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Satu-satunya tempat nilai gambar share diselesaikan: unggahan editor lewat
// astro:assets, path tetap & route OG generate diteruskan apa adanya.
const shareImage = await resolveShareImage(image, Astro.site);

const site = await getEntry('settings', 'site');
const ids = makeIds({ siteUrl });

// Judul datang sebagai "Halaman | bagiberbagi.id" (atau "Halaman: Subjudul");
// breadcrumb cuma mau bagian halamannya.
const pageName = breadcrumbName || title.split(/\s[|:]\s/)[0].trim();

const organization = site
  ? buildPiece({
      '@type': seo.organization.type,
      '@id': ids.organization(ORG_SLUG),
      name: seo.organization.name,
      url: `${siteUrl}/`,
      logo: new URL(seo.organization.logo, Astro.site).href,
      description: seo.defaultDescription,
      email: site.data.socials.email,
      // WhatsApp adalah kanal donasi sungguhan situs ini, bukan pelengkap, jadi
      // nomornya disebut sebagai contactPoint alih-alih cuma hidup di dalam
      // tautan `wa.me`. Bentuk E.164 dipakai apa adanya dari settings.
      //
      // `address` dan `foundingDate` SENGAJA belum ada di sini. Keduanya berguna
      // untuk entitas organisasi di mata mesin pencari, tapi keduanya juga
      // pernyataan fakta: mengisinya dengan tebakan berarti menerbitkan data
      // palsu yang dibaca mesin sebagai kebenaran. Field-nya sudah disiapkan di
      // Keystatic, tinggal diisi pemilik.
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        telephone: site.data.waNumber,
        email: site.data.socials.email,
        availableLanguage: ['id'],
      },
      // Syaratnya isi, bukan keberadaan: Keystatic menulis objek berisi string
      // kosong saat editor melewatinya, bukan null, jadi `address ? ...` akan
      // menerbitkan alamat hampa yang justru lebih buruk daripada tak ada.
      ...(seo.organization.address?.locality
        ? {
            address: {
              '@type': 'PostalAddress',
              addressLocality: seo.organization.address.locality,
              ...(seo.organization.address.region
                ? { addressRegion: seo.organization.address.region }
                : {}),
              addressCountry: seo.organization.address.country || 'ID',
            },
          }
        : {}),
      ...(seo.organization.foundingDate?.trim()
        ? { foundingDate: seo.organization.foundingDate.trim() }
        : {}),
      sameAs: [
        `https://www.instagram.com/${site.data.socials.instagram}/`,
        `https://www.tiktok.com/@${site.data.socials.tiktok}`,
      ],
    })
  : undefined;

const graph = organization
  ? assembleGraph([
      organization,
      buildWebSite(
        {
          url: `${siteUrl}/`,
          name: seo.siteName,
          description: seo.defaultDescription,
          inLanguage: 'id-ID',
          publisher: { '@id': ids.organization(ORG_SLUG) },
        },
        ids
      ),
      buildWebPage(
        {
          url: canonical,
          name: title,
          description,
          inLanguage: 'id-ID',
          isPartOf: { '@id': ids.website },
          breadcrumb: { '@id': ids.breadcrumb(canonical) },
        },
        ids
      ),
      buildBreadcrumbList(
        {
          url: canonical,
          items: breadcrumbTrail
            ? [
                { name: 'Beranda', url: `${siteUrl}/` },
                ...breadcrumbTrail.map((c) => ({
                  name: c.name,
                  url: new URL(c.url, siteUrl).href,
                })),
                { name: pageName, url: canonical },
              ]
            : breadcrumbsFromUrl({
                url: Astro.url,
                siteUrl,
                pageName,
                homeName: 'Beranda',
              }),
        },
        ids
      ),
      ...extraSchema.map((piece) => buildPiece(piece as Parameters<typeof buildPiece>[0])),
    ])
  : null;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Seo
    title={title}
    description={description}
    canonical={canonical}
    siteName={seo.siteName}
    locale="id_ID"
    ogImage={shareImage?.url}
    ogImageAlt={title}
    ogImageWidth={shareImage?.width}
    ogImageHeight={shareImage?.height}
    twitter={{ card: shareImage ? 'summary_large_image' : 'summary' }}
    noindex={noindex}
    nofollow={noindex}
    graph={graph}
  />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48x48.png" />
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
  <link rel="manifest" href="/favicon/site.webmanifest" />
  <meta name="theme-color" content="#C25D0F" />
  <style>
    html { scroll-behavior: smooth; }
  </style>
  <Analytics analytics={analytics} />
</head>
<body class="m-0 font-sans antialiased text-ink bg-white overflow-x-hidden selection:bg-brand-yellow selection:text-ink">
  <Header />
  <main id="top">
    <slot />
  </main>
  <Footer />
  {analytics.needsConsentBanner && analytics.consentBanner && <ConsentBanner />}
</body>
</html>
