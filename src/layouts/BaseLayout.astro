---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%231D46B9'/%3E%3Cpath d='M16 24s-6.2-3.8-8.3-7.4C6 14 7.3 11 10 11c1.7 0 2.8 1 3.4 1.9.6-.9 1.7-1.9 3.4-1.9 2.7 0 4 3 2.3 5.6C22.2 20.2 16 24 16 24Z' fill='%23FFD900'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    html { scroll-behavior: smooth; }
  </style>
</head>
<body class="m-0 font-sans antialiased text-ink bg-white overflow-x-hidden selection:bg-brand-yellow selection:text-ink">
  <slot />
</body>
</html>
