---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { buildWaLink } from '../lib/format';

export interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  closing: string;
  updatedAt: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, eyebrow, intro, closing, updatedAt, headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const introParagraphs = intro.split('\n\n');
const metaDescription = `${title} bagiberbagi.id — ${introParagraphs[0]}`.slice(0, 160);

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const waLink = buildWaLink(site.data.waNumber);
const emailLink = `mailto:${site.data.socials.email}`;
const websiteUrl = 'https://bagiberbagi.id';
---

<BaseLayout title={`${title} — bagiberbagi.id`} description={metaDescription}>
  <section class="section bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="eyebrow mb-2">{eyebrow}</div>
      <h1 class="text-2xl md:text-heading-xl font-extrabold tracking-tight text-ink mb-2">{title}</h1>
      <p class="text-sm text-muted mb-8">Terakhir diperbarui: {updatedAt}</p>

      <h2 class="text-title-sm font-extrabold text-ink mb-2">Selamat datang di <span class="text-brand-blue">bagiberbagi.id</span></h2>
      <div class="max-w-3xl mb-8">
        {introParagraphs.map((para) => (
          <p class="text-body-sm text-muted leading-relaxed mb-3 last:mb-0">{para}</p>
        ))}
      </div>

      <div class="flex flex-col md:flex-row gap-10 items-start">
        <nav aria-label="Daftar isi" class="w-full md:w-[240px] md:flex-none md:sticky md:top-24">
          <div class="font-bold text-body text-ink mb-4">Daftar Isi:</div>
          <ul class="flex flex-col gap-1">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="block px-3.5 py-2 rounded-lg text-sm border-l-[3px] border-transparent text-muted transition-colors"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div
          class="flex-1 min-w-0 text-body-sm text-muted leading-relaxed
            [&_h2]:scroll-mt-24 [&_h2]:text-title-sm [&_h2]:font-extrabold [&_h2]:text-brand-blue [&_h2]:mt-10 [&_h2]:mb-3 [&_h2:first-child]:mt-0
            [&_p]:mb-3 [&_p:last-child]:mb-0
            [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-1.5
            [&_li]:pl-1 [&_li::marker]:text-brand-orange"
        >
          <slot />

          <div class="flex flex-col gap-3 mt-2">
            <a href={emailLink} class="flex items-center gap-3 text-ink hover:text-brand-blue">
              <span class="w-8 h-8 rounded-full bg-brand-orange/15 text-brand-orange flex items-center justify-center flex-none">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
              </span>
              Email: {site.data.socials.email}
            </a>
            <a href={waLink} target="_blank" rel="noopener" class="flex items-center gap-3 text-ink hover:text-brand-blue">
              <span class="w-8 h-8 rounded-full bg-brand-orange/15 text-brand-orange flex items-center justify-center flex-none">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.6 14.3c-.2.6-1.3 1.2-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.6-.6-2.9-1.3-4.8-4.2-4.9-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.6-.1l.6-.7c.2-.3.4-.2.7-.1.3.1 1.7.8 2 .9.3.1.5.2.6.3.1.2.1.9-.1 1.5Z"></path></svg>
              </span>
              WhatsApp: {site.data.waNumberDisplay}
            </a>
            <a href={websiteUrl} class="flex items-center gap-3 text-ink hover:text-brand-blue">
              <span class="w-8 h-8 rounded-full bg-brand-orange/15 text-brand-orange flex items-center justify-center flex-none">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
              </span>
              Website: {websiteUrl}
            </a>
          </div>

          <p class="text-sm text-muted mt-6">{closing}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/legal-toc-scrollspy.js';
</script>
