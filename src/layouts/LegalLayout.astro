---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  updatedAt: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, eyebrow, intro, updatedAt, headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${title} — bagiberbagi.id`}>
  <Header />
  <section class="section bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="eyebrow">{eyebrow}</div>
      <h1 class="text-2xl md:text-heading-md font-extrabold tracking-tight mb-2">{title}</h1>
      <p class="text-sm text-muted mb-8">Terakhir diperbarui: {updatedAt}</p>

      <p class="text-body font-semibold text-ink leading-relaxed mb-8 max-w-3xl">{intro}</p>

      <div class="flex flex-col md:flex-row gap-10 items-start">
        <nav aria-label="Daftar isi" class="w-full md:w-[240px] md:flex-none md:sticky md:top-24">
          <div class="font-bold text-body mb-3">Daftar Isi</div>
          <ul class="flex flex-col gap-0.5 border-l border-border">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="block pl-4 py-1.5 -ml-px border-l-2 border-transparent text-sm text-muted"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div
          class="flex-1 min-w-0 text-body-sm text-muted leading-relaxed
            [&_h2]:scroll-mt-24 [&_h2]:text-title-sm [&_h2]:font-extrabold [&_h2]:text-ink [&_h2]:mt-10 [&_h2]:mb-3 [&_h2:first-child]:mt-0
            [&_p]:mb-3 [&_p:last-child]:mb-0
            [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-1.5
            [&_li]:pl-1 [&_li::marker]:text-brand-orange"
        >
          <slot />
        </div>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/legal-toc-scrollspy.js';
</script>
