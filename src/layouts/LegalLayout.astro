---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  updatedAt: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, updatedAt, headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${title} — bagiberbagi.id`}>
  <Header />
  <section class="section bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="eyebrow">LEGAL</div>
      <h1 class="text-2xl md:text-heading-md font-extrabold tracking-tight mb-2">{title}</h1>
      <p class="text-sm text-muted mb-8">Terakhir diperbarui: {updatedAt}</p>

      <div class="flex flex-col md:flex-row gap-10 items-start">
        <nav aria-label="Daftar isi" class="w-full md:w-[240px] md:flex-none md:sticky md:top-24">
          <div class="font-bold text-body mb-3">Daftar Isi</div>
          <ul class="flex flex-col gap-0.5 border-l border-border">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="block pl-4 py-1.5 -ml-px border-l-2 border-transparent text-sm text-muted"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="prose-legal flex-1 min-w-0 flex flex-col gap-8 text-body-sm text-muted leading-relaxed">
          <slot />
        </div>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .prose-legal :global(h2) {
    scroll-margin-top: 96px;
  }
  .prose-legal :global(p) {
    margin: 0;
  }
</style>

<script>
  import '../scripts/legal-toc-scrollspy.js';
</script>
