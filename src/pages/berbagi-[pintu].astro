---
import BaseLayout from '../layouts/BaseLayout.astro';
import PintuS1 from '../components/_variants/PintuS1.astro';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';
import { getProgramsByPintu } from '../lib/programs';
import { getPintuImpact } from '../lib/impact';
import { PINTU, CATEGORY_CONTENT } from '../consts';

// Landing pintu (flat /berbagi-[pintu]). Pintu = kategori: halaman ini memikul
// KONSEP/cerita channel + SEO + daftar program + status roadmap. Cara kerja TIDAK
// di sini (itu milik program, karena bisa beda antar program sepintu). Angka
// dampak cuma teaser yang melempar ke showcase /jejak. Tidak ada /berbagi/ hub;
// index pintu = PintuSection di beranda.
export async function getStaticPaths() {
  return PINTU.map((pintu) => ({ params: { pintu: pintu.slug }, props: { pintu } }));
}

const { pintu } = Astro.props;
const content = CATEGORY_CONTENT[pintu.id];
const programs = await getProgramsByPintu(pintu.id);
const active = programs.filter((p) => p.active);
const upcoming = programs.filter((p) => !p.active);
const otherPintu = PINTU.filter((p) => p.id !== pintu.id);

const impact = await getPintuImpact(pintu.id);
const hasImpact = impact.jejakCount > 0 && impact.metrics.length > 0;

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const contactWa = buildWaLink(site.data.waNumber, `Halo, saya ingin berkontribusi di pintu ${pintu.label}.`);
const notifyWa = buildWaLink(site.data.waNumber, `Halo, beri tahu saya saat program ${pintu.label} dibuka.`);

const jejakHref = `/jejak/?berbagi=${pintu.slug}`;
---

<BaseLayout title={`Pintu ${pintu.label} | bagiberbagi.id`} description={pintu.seoDescription} breadcrumbName={pintu.label}>
  <PintuS1
    pintu={pintu}
    content={content}
    programs={programs}
    active={active}
    upcoming={upcoming}
    otherPintu={otherPintu}
    impact={impact}
    hasImpact={hasImpact}
    contactWa={contactWa}
    notifyWa={notifyWa}
    jejakHref={jejakHref}
  />
</BaseLayout>
