---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../../lib/format';
import { getProgramsByPintu } from '../../lib/programs';
import { getJejakByPintu } from '../../lib/jejak';
import { getPintuImpact } from '../../lib/impact';
import { PINTU, CATEGORY_CONTENT } from '../../consts';
import programPromoImage from '../../assets/images/program-promo.png';

// Satu route untuk kelima pintu (kategori program) di /berbagi/[slug]. Slug
// berbahasa Indonesia (makanan/barang/…) supaya URL konsisten satu bahasa;
// id internal (food/goods/…) tetap dipakai taksonomi program. Impact
// dikecualikan (PINTU) — lapisan hasil, bukan channel program.
export async function getStaticPaths() {
  return PINTU.map((pintu) => ({
    params: { category: pintu.slug },
    props: { pintu },
  }));
}

const { pintu } = Astro.props;
const content = CATEGORY_CONTENT[pintu.id];

const programs = await getProgramsByPintu(pintu.id);
const active = programs.filter((p) => p.active);
const upcoming = programs.filter((p) => !p.active);
const otherPintu = PINTU.filter((p) => p.id !== pintu.id);

// Dampak nyata dari jejak pintu ini. Bila sudah ada jejak, statbar memakai
// angka agregat (impact.metrics); bila belum, fallback ke CATEGORY_CONTENT.stats
// statis agar pintu yang belum berjalan tetap tampil rapi.
const jejakPintu = await getJejakByPintu(pintu.id);
const impact = await getPintuImpact(pintu.id);
const hasImpact = jejakPintu.length > 0 && impact.metrics.length > 0;

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const contactWa = buildWaLink(site.data.waNumber, `Halo, saya ingin berkontribusi di pintu ${pintu.label}.`);
const notifyWa = buildWaLink(site.data.waNumber, `Halo, beri tahu saya saat program ${pintu.label} dibuka.`);

const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;
---

<BaseLayout
  title={`${pintu.label} — Pintu Berbagi | bagiberbagi.id`}
  description={pintu.seoDescription}
  breadcrumbName={pintu.label}
>
  <div class="pintu" style={styleVars}>
    <div class="pintu-wrap">
      <!-- breadcrumb: item aktif (terakhir) yang di-highlight -->
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a><span>/</span>Pintu Berbagi<span>/</span><b class="cur">{pintu.label}</b>
      </nav>

      <!-- hero -->
      <header class="hero">
        <span class="pico"><Icon name={pintu.icon} size={34} /></span>
        <div class="eyb">{pintu.english}</div>
        <h1 class="h1">{pintu.label}</h1>
        <p class="tp">{pintu.tagline}</p>
        <div class="hbtns">
          <a class="btn btn-p" href={contactWa} target="_blank" rel="noopener" data-track="contact_wa" data-track-pintu={pintu.slug} data-track-source="berbagi_hero">Hubungi Kami</a>
          <a class="btn btn-o" href={contactWa} target="_blank" rel="noopener" data-track="partner_click" data-track-pintu={pintu.slug}>Jadi Mitra</a>
        </div>
      </header>

      <!-- statistik (mengambang): dampak REAL dari jejak bila ada, jika belum fallback ke stats statis -->
      {hasImpact ? (
        <div class="statbar">
          {impact.metrics.map((m) => (
            <div class="st"><div class="st-n">{m.value.toLocaleString('id-ID')}</div><div class="st-l">{m.label}</div></div>
          ))}
        </div>
      ) : (content?.stats && content.stats.length > 0 && (
        <div class="statbar">
          {content.stats.map((s) => (
            <div class="st"><div class="st-n">{s.value}</div><div class="st-l">{s.label}</div></div>
          ))}
        </div>
      ))}

      <!-- teaser rekam jejak (hanya bila pintu ini punya jejak) -->
      {jejakPintu.length > 0 && (
        <div class="jt-wrap">
          <a class="jt" href={`/berbagi/${pintu.slug}/jejak/`} data-track="jejak_teaser" data-track-pintu={pintu.slug}>
            Sudah berjalan {impact.jejakCount.toLocaleString('id-ID')} kali. Lihat rekam jejak →
          </a>
        </div>
      )}

      <!-- cara berkontribusi -->
      {content?.contribute && content.contribute.length > 0 && (
        <section>
          <div class="sh"><span class="tick"></span><span class="lbl">Cara Berkontribusi</span></div>
          <div class="give">
            {content.contribute.map((c, i) => (
              <div class="g">
                <span class="ghost">{String(i + 1).padStart(2, '0')}</span>
                <div class="gt">{c.title}</div>
                <div class="gd">{c.desc}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- program -->
      <section>
        {active.length > 0 ? (
          <Fragment>
            <div class="sh"><span class="tick"></span><span class="lbl">Program Aktif</span></div>
            <div class="feats">
              {active.map((p) => (
                <div class="feat">
                  <Image src={programPromoImage} alt="" width={900} height={500} class="feat-img" />
                  <div class="feat-scrim"></div>
                  <div class="feat-body">
                    <span class="tagp">Program Aktif</span>
                    <div class="feat-n">{p.label}</div>
                    <p class="feat-d">{p.summary}</p>
                    {p.href && <a class="feat-b" href={p.href}>Lihat Program →</a>}
                  </div>
                </div>
              ))}
            </div>
          </Fragment>
        ) : (
          <Fragment>
            <div class="sh"><span class="tick"></span><span class="lbl">Program</span></div>
            <div class="coming">
              <span class="coming-badge">Segera</span>
              <span class="coming-ic"><Icon name={pintu.icon} size={27} /></span>
              <div class="coming-t">Program di pintu ini segera hadir</div>
              <p class="coming-d">Kami sedang menyiapkan program {pintu.label} bersama relawan dan mitra. Tinggalkan kontak untuk jadi yang pertama tahu, atau bantu kami memulainya.</p>
              <a class="btn btn-p" href={notifyWa} target="_blank" rel="noopener" data-track="notify_click" data-track-pintu={pintu.slug}>Beri tahu saya saat dibuka →</a>
            </div>
          </Fragment>
        )}

        {upcoming.length > 0 && (
          <Fragment>
            <div class="sh"><span class="tick"></span><span class="lbl">Segera Menyusul</span></div>
            <div class="plist">
              {upcoming.map((p) => (
                <div class="prow">
                  <span class="mk"></span>
                  <div><div class="nm">{p.label}</div><div class="dd">{p.summary}</div></div>
                  <span class="soon">Segera</span>
                </div>
              ))}
            </div>
          </Fragment>
        )}
      </section>

      <!-- cara kerja -->
      {content?.howItWorks && content.howItWorks.length > 0 && (
        <section>
          <div class="sh"><span class="tick"></span><span class="lbl">Cara Kerja</span></div>
          <div class="steps" style={`grid-template-columns:repeat(${content.howItWorks.length},1fr)`}>
            {content.howItWorks.map((s, i) => (
              <div class="sp"><div class="cnum">{i + 1}</div><div class="stt">{s.title}</div><div class="std">{s.desc}</div></div>
            ))}
          </div>
        </section>
      )}

      <!-- untuk siapa -->
      {content?.forWhom && content.forWhom.length > 0 && (
        <section>
          <div class="sh"><span class="tick"></span><span class="lbl">Untuk Siapa</span></div>
          <div class="chips">
            {content.forWhom.map((w) => <span class="chip">{w}</span>)}
          </div>
        </section>
      )}

      <!-- dampak lingkungan -->
      {content?.env && (
        <section>
          <div class="sh"><span class="tick"></span><span class="lbl">Dampak Lingkungan</span></div>
          <div class="envband">
            <div><div class="et">Bonus dampak</div><div class="eh">{content.env.headline}</div></div>
            <div class="estats">
              {content.env.stats.map((s) => (
                <div class="es"><b>{s.value}</b><span>{s.label}</span></div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- faq (native details, tanpa JS) -->
      {content?.faq && content.faq.length > 0 && (
        <section>
          <div class="sh"><span class="tick"></span><span class="lbl">Pertanyaan Umum</span></div>
          <div class="faq">
            {content.faq.map((f) => (
              <details class="fq">
                <summary class="fq-head"><span class="q">{f.q}</span><span class="pl" aria-hidden="true"></span></summary>
                <div class="fq-a">{f.a}</div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- pintu lainnya -->
      <section>
        <div class="sh"><span class="tick"></span><span class="lbl">Pintu Lainnya</span></div>
        <div class="doors">
          {otherPintu.map((o) => (
            <a class="door" href={`/berbagi/${o.slug}/`} style={`--dc:${o.color}`}>
              <span class="di"><Icon name={o.icon} size={18} /></span>
              <span class="dn">{o.label}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- cta -->
      <a class="cta" href={contactWa} target="_blank" rel="noopener" data-track="contact_wa" data-track-pintu={pintu.slug} data-track-source="berbagi_cta">
        <div>
          <h3>{content?.ctaTitle ?? `Ingin berkontribusi di ${pintu.label}?`}</h3>
          <p>{content?.ctaText ?? 'Hubungi tim kami untuk memulai atau menjadi mitra penyalur.'}</p>
        </div>
        <span class="cta-b">Hubungi Kami</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .pintu {
    --ci: #141a2b; --cm: #5a626f; --cb: #e7e9f0; --cs: #f7f9fc;
    --dot: radial-gradient(rgba(20, 26, 43, .06) 1.1px, transparent 1.1px);
  }
  .pintu-wrap { max-width: 1000px; margin: 0 auto; padding: 30px 20px 64px; }

  .crumb { font-size: 12.5px; color: #7b8493; font-weight: 600; margin-bottom: 20px; }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: var(--cat); }
  .crumb .cur { color: var(--cat); font-weight: 800; }
  .crumb span { color: #c9cfd8; margin: 0 7px; }

  /* hero */
  .hero { position: relative; overflow: hidden; border-radius: 20px; background: radial-gradient(120% 140% at 78% 0%, var(--cat-tint), #fff 62%); padding: 40px 32px 34px; text-align: center; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: var(--dot); background-size: 17px 17px; -webkit-mask: radial-gradient(80% 90% at 85% 5%, #000, transparent 70%); mask: radial-gradient(80% 90% at 85% 5%, #000, transparent 70%); opacity: .7; pointer-events: none; }
  .hero > * { position: relative; }
  .pico { width: 66px; height: 66px; border-radius: 19px; display: grid; place-items: center; margin: 0 auto 16px; background: #fff; color: var(--cat); box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--cat) 55%, transparent); position: relative; }
  .pico::after { content: ""; position: absolute; right: -5px; bottom: -5px; width: 18px; height: 18px; border-radius: 50%; background: var(--brand-blue, #1D46B9); border: 4px solid #fff; }
  .eyb { color: var(--cat); font-weight: 800; letter-spacing: .18em; font-size: 11px; text-transform: uppercase; }
  .h1 { font-size: 34px; font-weight: 800; letter-spacing: -.03em; margin: 9px 0 12px; color: var(--ci); }
  .tp { font-size: 15.5px; color: var(--cm); line-height: 1.65; max-width: 52ch; margin: 0 auto; }
  .hbtns { margin-top: 20px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 7px; font-weight: 800; font-size: 13.5px; padding: 11px 20px; border-radius: 999px; text-decoration: none; }
  .btn-p { background: var(--cat); color: #fff; box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--cat) 60%, transparent); }
  .btn-o { background: #fff; color: var(--cat-deep); border: 1.5px solid var(--cb); }

  /* stat bar */
  .statbar { position: relative; z-index: 2; margin: -26px 20px 0; background: #fff; border-radius: 16px; box-shadow: 0 22px 44px -24px rgba(20, 26, 43, .3); display: flex; padding: 18px 8px; }
  .st { flex: 1; text-align: center; padding: 4px 10px; }
  .st-n { font-size: 27px; font-weight: 800; letter-spacing: -.02em; color: var(--ci); font-variant-numeric: tabular-nums; line-height: 1.05; }
  .st-n::after { content: ""; display: block; width: 20px; height: 3px; border-radius: 2px; background: var(--cat); margin: 7px auto 0; }
  .st-l { font-size: 11.5px; color: var(--cm); margin-top: 7px; }

  /* teaser rekam jejak */
  .jt-wrap { text-align: center; margin-top: 16px; }
  .jt { display: inline-flex; align-items: center; gap: 8px; padding: 9px 18px; border-radius: 999px; background: var(--cat-tint); color: var(--cat-deep); font-size: 12.5px; font-weight: 800; text-decoration: none; font-variant-numeric: tabular-nums; transition: .16s; }
  .jt:hover { background: color-mix(in srgb, var(--cat) 16%, #fff); transform: translateY(-1px); }

  /* section header */
  .sh { display: flex; align-items: center; gap: 10px; margin: 46px 0 20px; }
  .sh .tick { width: 8px; height: 8px; border-radius: 3px; background: var(--cat); flex: none; }
  .sh .lbl { font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--ci); }

  /* cara berkontribusi (airy) */
  .give { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .g { position: relative; padding: 16px 8px 0; overflow: hidden; }
  .g .ghost { position: absolute; top: -16px; right: 2px; font-size: 74px; font-weight: 800; color: var(--cat); opacity: .13; letter-spacing: -.04em; line-height: 1; }
  .g .gt { font-size: 15.5px; font-weight: 800; color: var(--ci); margin-bottom: 5px; position: relative; }
  .g .gd { font-size: 13px; color: var(--cm); line-height: 1.55; position: relative; }

  /* featured */
  .feats { display: flex; flex-direction: column; gap: 14px; }
  .feat { position: relative; border-radius: 18px; overflow: hidden; min-height: 220px; display: flex; flex-direction: column; justify-content: flex-end; padding: 28px 30px; color: #fff; }
  .feat-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .feat-scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(9, 18, 52, .86), rgba(9, 18, 52, .3)); }
  .feat-body { position: relative; }
  .tagp { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; background: rgba(255, 255, 255, .2); padding: 5px 12px; border-radius: 999px; margin-bottom: 12px; }
  .feat-n { font-size: 24px; font-weight: 800; letter-spacing: -.01em; }
  .feat-d { font-size: 13.5px; color: rgba(255, 255, 255, .88); margin-top: 6px; max-width: 46ch; }
  .feat-b { display: inline-block; margin-top: 18px; background: #fff; color: var(--cat-deep); font-weight: 800; font-size: 12.5px; padding: 10px 18px; border-radius: 999px; text-decoration: none; box-shadow: 0 12px 24px -12px rgba(0, 0, 0, .4); }

  /* segera (airy) */
  .plist { display: flex; flex-direction: column; gap: 3px; margin-top: 14px; }
  .prow { display: flex; align-items: center; gap: 14px; padding: 11px 4px; }
  .prow .mk { flex: none; width: 9px; height: 9px; border-radius: 50%; border: 2px solid #cbd2dc; }
  .prow .nm { font-size: 15px; font-weight: 800; color: #5f6774; }
  .prow .dd { font-size: 13px; color: var(--cm); margin-top: 1px; }
  .prow .soon { margin-left: auto; flex: none; font-size: 9.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #6b7280; background: #eceff3; padding: 4px 9px; border-radius: 999px; }

  /* stepper */
  .steps { display: grid; margin-top: 4px; }
  .sp { text-align: center; padding: 0 10px; position: relative; }
  .sp .cnum { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--cat), color-mix(in srgb, var(--cat) 62%, #fff)); color: #fff; font-weight: 800; font-size: 15px; display: grid; place-items: center; margin: 0 auto 12px; position: relative; z-index: 1; box-shadow: 0 10px 20px -10px color-mix(in srgb, var(--cat) 70%, transparent); }
  .sp:nth-child(even) .cnum { background: linear-gradient(135deg, #1D46B9, #3f63cf); box-shadow: 0 10px 20px -10px rgba(29, 70, 185, .7); }
  .sp::before { content: ""; position: absolute; top: 18px; left: -50%; width: 100%; height: 2px; background: var(--cb); z-index: 0; }
  .sp:first-child::before { display: none; }
  .sp .stt { font-size: 13.5px; font-weight: 800; color: var(--ci); }
  .sp .std { font-size: 12px; color: var(--cm); margin-top: 3px; line-height: 1.5; }

  /* chips */
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 999px; background: var(--cat-tint); color: var(--cat-deep); font-weight: 700; font-size: 13px; }
  .chip::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--cat); }

  /* env band */
  .envband { position: relative; overflow: hidden; background: linear-gradient(135deg, #0f8256, #0a5238); border-radius: 18px; padding: 26px 30px; color: #fff; display: flex; gap: 24px; flex-wrap: wrap; align-items: center; }
  .envband::before { content: ""; position: absolute; right: -30px; bottom: -60px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 255, 255, .14), transparent 66%); }
  .envband > * { position: relative; }
  .envband .et { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; opacity: .82; }
  .envband .eh { font-size: 16.5px; font-weight: 800; margin-top: 5px; max-width: 26ch; line-height: 1.4; }
  .envband .estats { display: flex; gap: 30px; margin-left: auto; }
  .envband .es b { display: block; font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .envband .es span { font-size: 12px; opacity: .85; }

  /* faq (details) */
  .faq { display: flex; flex-direction: column; gap: 10px; margin-top: 2px; }
  .fq { background: var(--cs); border-radius: 13px; transition: background .15s; }
  .fq:hover { background: color-mix(in srgb, var(--cat) 7%, var(--cs)); }
  .fq[open] { background: color-mix(in srgb, var(--cat) 9%, var(--cs)); }
  .fq-head { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 15px 17px; cursor: pointer; list-style: none; }
  .fq-head::-webkit-details-marker { display: none; }
  .fq .q { font-size: 14px; font-weight: 700; color: var(--ci); }
  .fq .pl { flex: none; width: 26px; height: 26px; border-radius: 50%; background: var(--cat-tint); color: var(--cat); display: grid; place-items: center; position: relative; }
  .fq .pl::before, .fq .pl::after { content: ""; position: absolute; background: currentColor; border-radius: 2px; }
  .fq .pl::before { width: 12px; height: 2px; }
  .fq .pl::after { width: 2px; height: 12px; transition: transform .18s; }
  .fq[open] .pl { background: var(--cat); color: #fff; }
  .fq[open] .pl::after { transform: scaleY(0); }
  .fq-a { font-size: 13px; color: var(--cm); line-height: 1.6; padding: 0 17px 16px; }

  /* pintu lain */
  .doors { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .door { display: flex; align-items: center; gap: 11px; padding: 12px 11px; border-radius: 14px; transition: .16s; text-decoration: none; }
  .door:hover { background: var(--cs); transform: translateY(-2px); }
  .door .di { width: 34px; height: 34px; border-radius: 10px; background: color-mix(in srgb, var(--dc) 15%, #fff); color: var(--dc); display: grid; place-items: center; flex: none; }
  .door .dn { font-size: 13px; font-weight: 800; color: var(--ci); }

  /* coming soon */
  .coming { position: relative; overflow: hidden; text-align: center; padding: 40px 28px; border-radius: 18px; background: radial-gradient(120% 140% at 50% 0%, var(--cat-tint), #fff 70%); }
  .coming::before { content: ""; position: absolute; inset: 0; background-image: var(--dot); background-size: 18px 18px; -webkit-mask: radial-gradient(70% 80% at 50% 0%, #000, transparent 70%); mask: radial-gradient(70% 80% at 50% 0%, #000, transparent 70%); opacity: .5; }
  .coming > * { position: relative; }
  .coming-ic { width: 54px; height: 54px; border-radius: 16px; background: #fff; color: var(--cat); display: grid; place-items: center; margin: 0 auto 15px; box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--cat) 55%, transparent); }
  .coming-badge { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--cat); background: #fff; padding: 5px 13px; border-radius: 999px; margin-bottom: 14px; box-shadow: 0 6px 16px -8px rgba(20, 26, 43, .2); }
  .coming-t { font-size: 20px; font-weight: 800; color: var(--ci); letter-spacing: -.01em; }
  .coming-d { font-size: 14px; color: var(--cm); max-width: 46ch; margin: 9px auto 20px; line-height: 1.6; }

  /* cta */
  .cta { position: relative; overflow: hidden; margin-top: 44px; background: linear-gradient(135deg, var(--cat), var(--cat-deep)); border-radius: 20px; padding: 30px 34px; color: #fff; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; text-decoration: none; }
  .cta::before { content: ""; position: absolute; inset: 0; background-image: var(--dot); background-size: 20px 20px; opacity: .16; }
  .cta > * { position: relative; }
  .cta h3 { font-size: 19px; font-weight: 800; margin: 0; letter-spacing: -.01em; }
  .cta p { font-size: 13px; color: rgba(255, 255, 255, .92); margin: 5px 0 0; }
  .cta-b { position: relative; margin-left: auto; background: #fff; color: var(--cat-deep); font-weight: 800; font-size: 13px; padding: 12px 22px; border-radius: 999px; white-space: nowrap; }

  @media (max-width: 760px) {
    .pintu-wrap { padding: 24px 16px 48px; }
    .give { grid-template-columns: 1fr 1fr; gap: 18px; }
    .steps { grid-template-columns: 1fr 1fr !important; gap: 20px 0; }
