---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { PINTU } from '../../../consts';
import { getProgramsByPintu } from '../../../lib/programs';
import { getJejakByPintu } from '../../../lib/jejak';
import { getPintuImpact, getProgramImpact } from '../../../lib/impact';
import { formatRupiah } from '../../../lib/format';

// Halaman rekam jejak agregat per pintu di /berbagi/[slug]/jejak, nested di
// bawah pintu agar menyatu dengan taksonomi. Detail tiap jejak hidup di route
// flat /jejak/[slug]. Satu route untuk kelima pintu.
export async function getStaticPaths() {
  return PINTU.map((pintu) => ({
    params: { category: pintu.slug },
    props: { pintu },
  }));
}

const { pintu } = Astro.props;

const [jejakList, pintuImpact, programs] = await Promise.all([
  getJejakByPintu(pintu.id),
  getPintuImpact(pintu.id),
  getProgramsByPintu(pintu.id),
]);

const labelBySlug = new Map(programs.map((p) => [p.slug, p.label]));
const hrefBySlug = new Map(programs.map((p) => [p.slug, p.href]));

// Kelompokkan jejak per program, lalu hitung agregat dampak tiap program dan
// urutkan menurun berdasar total seluruh nilai metric (dampak tertinggi di atas).
const groups = new Map<string, typeof jejakList>();
for (const j of jejakList) {
  const arr = groups.get(j.program) ?? [];
  arr.push(j);
  groups.set(j.program, arr);
}

const breakdown = await Promise.all(
  [...groups.keys()].map(async (slug) => {
    const impact = await getProgramImpact(slug);
    const primary = [...impact.metrics].sort((a, b) => b.value - a.value)[0];
    const total = impact.metrics.reduce((s, m) => s + m.value, 0);
    return {
      slug,
      label: labelBySlug.get(slug) ?? slug,
      href: hrefBySlug.get(slug),
      count: impact.jejakCount,
      primary,
      total,
    };
  })
);
breakdown.sort((a, b) => b.total - a.total);

// Program di pintu ini yang belum punya jejak terdokumentasi.
const withJejak = new Set(groups.keys());
const soon = programs.filter((p) => !withJejak.has(p.slug));

// Galeri gabungan: kumpulkan cover + gallery dari jejak terbaru (list sudah
// terurut tanggal desc), buang yang kosong, batasi jumlahnya.
const gallery = jejakList
  .flatMap((j) => [j.cover, ...j.gallery])
  .filter((src): src is string => !!src)
  .slice(0, 8);

// Penghitung kejadian: "penyaluran" khusus pintu makanan, "kegiatan" untuk sisanya.
const kaliWord = pintu.id === 'food' ? 'penyaluran' : 'kegiatan';

const hasJejak = jejakList.length > 0;
const fmt = (n: number) => n.toLocaleString('id-ID');
// Metrik berlabel dana/donasi ditampilkan sebagai Rupiah.
const fmtMetric = (m: { label: string; value: number }) =>
  /dana|rupiah|donasi/i.test(m.label) ? formatRupiah(m.value) : fmt(m.value);

const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;
---

<BaseLayout
  title={`Rekam Jejak ${pintu.label} | bagiberbagi.id`}
  description={`Rekam jejak nyata pintu ${pintu.label} bagiberbagi.id: angka dampak terhitung, dokumentasi lapangan, dan rincian per program.`}
  breadcrumbName="Rekam Jejak"
>
  <section class="section bg-white">
    <div class="max-w-5xl mx-auto" style={styleVars}>
      <!-- breadcrumb -->
      <nav class="text-body-sm font-semibold text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--cat)]">Beranda</a>
        <span class="mx-2 text-gray-300">/</span>
        <a href={`/berbagi/${pintu.slug}/`} class="hover:text-[var(--cat)]">{pintu.label}</a>
        <span class="mx-2 text-gray-300">/</span>
        <span class="text-[var(--cat)] font-extrabold">Rekam Jejak</span>
      </nav>

      <!-- header -->
      <div class="flex items-center gap-3 mb-4">
        <span class="w-11 h-11 rounded-xl grid place-items-center flex-none bg-[var(--cat-tint)] text-[var(--cat)]">
          <Icon name={pintu.icon} size={22} />
        </span>
        <div class="eyebrow mb-0 text-[var(--cat)]">Rekam Jejak · {pintu.label}</div>
      </div>
      <h1 class="text-heading md:text-display font-extrabold tracking-tight leading-tight mb-3">
        Jejak yang bisa Anda telusuri
      </h1>
      <p class="text-body-sm text-muted leading-relaxed max-w-2xl mb-10">
        Setiap kali program di pintu {pintu.label} berjalan, kami mencatat hasilnya: angka dampak, penerima, dan bukti dari lapangan.
      </p>

      {hasJejak ? (
        <>
          {/* counter agregat */}
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4 mb-12">
            <div class="rounded-card border border-border bg-gray-50 p-5 text-center">
              <div class="text-heading-md font-extrabold tracking-tight text-ink tabular-nums leading-none">{fmt(pintuImpact.jejakCount)}</div>
              <div class="w-5 h-0.75 rounded bg-[var(--cat)] mx-auto my-2.5"></div>
              <div class="text-body-sm text-muted">kali {kaliWord}</div>
            </div>
            {pintuImpact.metrics.map((m) => (
              <div class="rounded-card border border-border bg-gray-50 p-5 text-center">
                <div class="text-heading-md font-extrabold tracking-tight text-ink tabular-nums leading-none">{fmtMetric(m)}</div>
                <div class="w-5 h-0.75 rounded bg-[var(--cat)] mx-auto my-2.5"></div>
                <div class="text-body-sm text-muted">{m.label}</div>
              </div>
            ))}
          </div>

          {/* galeri gabungan (placeholder kalau foto belum diunggah) */}
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 mb-12">
            {gallery.length > 0
              ? gallery.map((src) => (
                  <img src={src} alt="" loading="lazy" decoding="async" width="400" height="300" class="w-full aspect-[4/3] object-cover rounded-xl bg-gray-100" />
                ))
              : Array.from({ length: 4 }).map(() => (
                  <div class="w-full aspect-[4/3] rounded-xl border-2 border-dashed border-border bg-gray-50 grid place-items-center gap-1.5 text-gray-300">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    <span class="text-micro font-semibold text-gray-400">Foto menyusul</span>
                  </div>
                ))}
          </div>

          {/* breakdown per program */}
          <div class="eyebrow text-[var(--cat)] mb-5">Per Program</div>
          <div class="flex flex-col gap-3">
            {breakdown.map((b, i) => {
              const Tag = (b.href ? 'a' : 'div') as any;
              return (
                <Tag
                  href={b.href}
                  class:list={[
                    'group relative flex items-center gap-4 rounded-card border border-border bg-white p-4 md:p-5 pl-6 shadow-cardSm',
                    b.href && 'transition-shadow hover:shadow-card',
                  ]}
                >
                  <span aria-hidden="true" class="absolute left-0 top-3 bottom-3 w-1 rounded-full bg-[var(--cat)]"></span>
                  <span class="flex-none w-8 text-center text-title font-extrabold text-[var(--cat)] tabular-nums">{i + 1}</span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-title-sm font-bold text-ink truncate">{b.label}</h3>
                    <div class="text-body-sm text-muted mt-0.5">berjalan {fmt(b.count)} kali</div>
                  </div>
                  {b.primary && (
                    <div class="flex-none text-right">
                      <div class="text-heading-sm font-extrabold text-ink tabular-nums leading-none">{fmtMetric(b.primary)}</div>
                      <div class="text-micro text-muted mt-1">{b.primary.label}</div>
                    </div>
                  )}
                  {b.href && (
                    <svg class="flex-none text-gray-300 group-hover:text-[var(--cat)] transition-colors" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                  )}
                </Tag>
              );
            })}
          </div>

          {soon.length > 0 && (
            <div class="mt-3 flex flex-col gap-1">
              {soon.map((p) => (
                <div class="flex items-center gap-4 rounded-card px-6 py-3.5">
                  <span class="flex-none w-2.5 h-2.5 rounded-full border-2 border-gray-300"></span>
                  <div class="min-w-0 flex-1 text-body-sm font-bold text-ink/60 truncate">{p.label}</div>
                  <span class="flex-none text-micro font-bold uppercase tracking-wide text-muted bg-gray-100 rounded-full px-3 py-1">Belum ada jejak</span>
                </div>
              ))}
            </div>
          )}

          {/* cta */}
          <a
            href={`/berbagi/${pintu.slug}/`}
            class="mt-12 flex items-center gap-4 rounded-card p-6 md:p-7 text-white"
            style="background:linear-gradient(135deg,var(--cat),var(--cat-deep))"
          >
            <div class="flex-1">
              <h2 class="text-title font-extrabold tracking-tight">Ingin ikut menambah jejak?</h2>
              <p class="text-body-sm text-white/90 mt-1">Lihat cara berkontribusi di pintu {pintu.label}.</p>
            </div>
            <span class="flex-none bg-white text-[var(--cat-deep)] font-bold text-body-sm px-5 py-3 rounded-full whitespace-nowrap">Buka pintu {pintu.label}</span>
          </a>
        </>
      ) : (
        <div class="rounded-card border border-border p-10 md:p-14 text-center bg-[var(--cat-tint)]">
          <span class="w-16 h-16 rounded-2xl grid place-items-center mx-auto mb-5 bg-white text-[var(--cat)] shadow-cardSm">
            <Icon name={pintu.icon} size={30} />
          </span>
          <h2 class="text-heading-sm font-extrabold tracking-tight text-ink mb-2">Belum ada rekam jejak</h2>
          <p class="text-body-sm text-muted leading-relaxed max-w-md mx-auto mb-7">
            Program di pintu {pintu.label} belum mempunyai jejak terdokumentasi. Begitu kegiatan pertama berjalan, angka dan buktinya akan tampil di sini.
          </p>
          <a
            href={`/berbagi/${pintu.slug}/`}
            class="inline-flex items-center gap-2 font-bold text-body-sm px-6 py-3 rounded-full text-white"
            style="background:var(--cat)"
          >
            Lihat pintu {pintu.label}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
