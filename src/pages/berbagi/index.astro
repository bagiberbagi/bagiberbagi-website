---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { PINTU, PINTU_LABEL } from '../../consts';

// Hub "Pintu Berbagi": halaman induk dari /berbagi/[category]/. Dulu /berbagi/
// tidak punya index (ghost 404) padahal anak-anaknya ada. Halaman ini
// mendaftar kelima pintu sebagai jalan masuk berkontribusi.
---

<BaseLayout
  title={`${PINTU_LABEL} | bagiberbagi.id`}
  description="Lima pintu berbagi di bagiberbagi.id: berbagi makanan, barang, waktu, ruang, dan dana. Pilih pintu untuk melihat program dan cara berkontribusi."
  breadcrumbName={PINTU_LABEL}
>
  <section class="section bg-white">
    <div class="max-w-6xl mx-auto">
      <nav class="text-sm font-semibold text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-orangeDark">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-ink">{PINTU_LABEL}</span>
      </nav>

      <div class="eyebrow">{PINTU_LABEL}</div>
      <h1 class="text-heading md:text-display font-extrabold tracking-tight leading-tight mb-3">Lima jalan untuk berbagi</h1>
      <p class="text-body-sm text-muted leading-relaxed max-w-2xl mb-10">
        Setiap orang punya sesuatu untuk dibagi. Pilih pintu yang paling sesuai, lalu lihat program aktif dan cara ikut berkontribusi.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {PINTU.map((pintu) => (
          <a
            href={`/berbagi/${pintu.slug}/`}
            style={`--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`}
            class="group relative flex flex-col rounded-card bg-white border border-border p-6 pl-7 transition-shadow hover:shadow-card"
          >
            <span class="absolute inset-y-0 left-0 w-1.5 rounded-l-card bg-[var(--cat)]" aria-hidden="true"></span>
            <span class="w-11 h-11 rounded-xl grid place-items-center bg-[var(--cat-tint)] text-[var(--cat)] mb-4">
              <Icon name={pintu.icon} size={22} />
            </span>
            <h2 class="text-title-sm font-bold text-ink mb-1.5">{pintu.label}</h2>
            <p class="text-body-sm text-muted leading-snug flex-1">{pintu.tagline}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 font-bold text-body-sm text-[var(--cat-deep)]">
              Buka pintu
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
