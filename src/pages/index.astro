---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProblemSection from '../components/ProblemSection.astro';
import SolutionSection from '../components/SolutionSection.astro';
import TrustSection from '../components/TrustSection.astro';
import ProgramStage from '../components/ProgramStage.astro';
import ImpactSection from '../components/ImpactSection.astro';
// JejakTerbaru disembunyikan sementara di beranda (desain belum solid dengan
// home saat ini). Komponen & data tetap ada; showcase penuh di /jejak.
// import JejakTerbaru from '../components/JejakTerbaru.astro';
import FaqHome from '../components/FaqHome.astro';
import MissionSection from '../components/MissionSection.astro';
import VisionSection from '../components/VisionSection.astro';
import ClosingSection from '../components/ClosingSection.astro';
---

<BaseLayout>
  {/* Alur narasi: hook + jalur donasi (hero) → keraguan divalidasi (Masalah) →
      dijawab platform (Solusi) → dibuktikan (Kepercayaan) → kenapa mulai dari
      makanan → cara kerja → dampak → tuntasin ragu (FAQ) → ajakan bergabung →
      arah gerakan (lima pintu). */}

  {/* Hero self-contained sekaligus jalur donasi: kartu kanannya memuat program
      berjalan, agenda minggu ini, pemilih porsi, dan tombol WhatsApp. Anchor
      #donasi ada di sana.
      Komponen yang dilepas dari beranda tapi tetap ada di repo: Stats (belum
      dibutuhkan), ProgramFeatures dan ProgramHighlights (pesannya sudah dibawa
      Masalah, Solusi, dan Kepercayaan), serta PintuSection (digantikan
      VisionSection yang memakai id="pintu" yang sama). DonationCalculator dulu
      juga di daftar ini dan sekarang benar-benar dihapus — alasannya di
      components/_parked/README.md. */}
  <Hero />

  {/* Cerita dua bagian "kenapa bagiberbagi ada": keraguan divalidasi dulu,
      baru dijawab dengan platform sebagai infrastruktur. */}
  <ProblemSection />
  <SolutionSection />

  {/* Bukti bahwa alur di atas benar-benar dijalankan, lalu jembatan ke program
      pertama: kenapa gerakan ini dimulai dari makanan. Panggung bergilir ini
      menggantikan WhyFood: slide pertamanya membawa seluruh teks seksi itu
      apa adanya, tiga slide berikutnya memberi wajah pada program lain yang
      juga sedang berjalan. */}
  <TrustSection />
  <ProgramStage />

  <ImpactSection />
  {/* <JejakTerbaru /> disembunyikan sementara (desain belum selaras home). */}
  <FaqHome />
  {/* Keyakinannya dulu, baru rencananya. Dibalik, lima pintu jadi daftar tanpa
      alasan, dan pernyataan misinya jatuh sebagai catatan kaki. */}
  <MissionSection />
  <VisionSection />
  {/* Penutup halaman. Sengaja bukan ajakan donasi kedua: kartu hero sudah
      memegang donasi dan pita footer memegang kontak umum, jadi seksi ini
      menjawab sisanya, yaitu jalur ikut selain menyumbang uang. Menggantikan
      JoinUs yang dulu duduk di tengah halaman. */}
  <ClosingSection />
</BaseLayout>

<script>
  import '../scripts/fade-in.js';
</script>
