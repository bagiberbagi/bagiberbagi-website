---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import { formatMetric } from '../../lib/format';
import { getJejakPages } from '../../lib/jejak';
import { getPrograms } from '../../lib/programs';
import { PINTU } from '../../consts';

// Satu route untuk setiap jejak terbit. Begitu editor menambah jejak di
// Keystatic & mencentang terbit, halamannya ikut ter-generate tanpa file baru.
export async function getStaticPaths() {
  const pages = await getJejakPages();
  return pages.map((jejak) => ({
    params: { slug: jejak.slug },
    props: { jejak },
  }));
}

const { jejak } = Astro.props;

// Program induk + pintu-nya untuk badge dan warna aksen. getJejak sudah menyaring
// jejak yatim, jadi program pasti ada; PINTU dijaga fallback ke pintu pertama.
const programs = await getPrograms();
const program = programs.find((p) => p.slug === jejak.program);
const pintu = PINTU.find((p) => p.id === program?.pintu) ?? PINTU[0];
const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;

const programLabel = program?.label ?? jejak.program;
const ctaHref = program?.href ?? `/berbagi-${pintu.slug}/`;

// Body naratif Markdoc.
const entry = await getEntry('jejak', jejak.slug);
if (!entry) throw new Error(`jejak entry not found: ${jejak.slug}`);
const { Content } = await render(entry);

// Tanggal ISO ('2026-07-18') dirender ramah-baca Indonesia. timeZone UTC agar
// tanggal tidak bergeser sehari saat di-parse sebagai tengah malam UTC.
const dateLabel = new Date(jejak.date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Featured = gambar besar (cover, atau foto pertama bila cover kosong); carousel
// = sisanya. allImages (dedup) jadi sumber lightbox, urut featured lalu sisanya.
const galleryImages = jejak.gallery.filter((g): g is string => Boolean(g));
const allImages = [...new Set([jejak.cover, ...galleryImages].filter((s): s is string => Boolean(s)))];
const featured = allImages[0] ?? null;
const carousel = allImages.slice(1);
---

<BaseLayout title={`${jejak.title} | bagiberbagi.id`} description={jejak.summary} breadcrumbName={jejak.title}>
  <section class="section bg-white" style={styleVars}>
    <div class="max-w-3xl mx-auto">
      <!-- breadcrumb: Beranda / Pintu / Rekam Jejak / judul -->
      <nav class="text-sm font-semibold text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--cat-deep)]">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <a href={`/berbagi-${pintu.slug}/`} class="hover:text-[var(--cat-deep)]">{pintu.label}</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <a href={`/jejak/?pintu=${pintu.id}`} class="hover:text-[var(--cat-deep)]">Rekam Jejak</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-[var(--cat-deep)]">{jejak.title}</span>
      </nav>

      <!-- konteks: pintu (induk) + program (spesifik) -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <a
          href={`/berbagi-${pintu.slug}/`}
          class="inline-flex items-center gap-1.5 rounded-full bg-[var(--cat)] text-white font-bold text-eyebrow tracking-wide px-3.5 py-1.5"
        >
          <Icon name={pintu.icon} size={14} />
          {pintu.label}
        </a>
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 rounded-full bg-[var(--cat-tint)] text-[var(--cat-deep)] font-bold text-eyebrow tracking-wide px-3.5 py-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--cat)]"></span>
          {programLabel}
        </a>
      </div>

      <h1 class="text-heading md:text-display font-bold text-ink mb-4">
        {jejak.title}
      </h1>

      <!-- meta: tanggal + lokasi -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-body-sm text-muted mb-5">
        <span class="inline-flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none text-[var(--cat)]"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
          {dateLabel}
        </span>
        {jejak.location && (
          <span class="inline-flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none text-[var(--cat)]"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            {jejak.location}
          </span>
        )}
      </div>

      <p class="text-body-sm text-muted leading-relaxed mb-7">{jejak.summary}</p>

      <!-- featured image (besar): klik untuk perbesar -->
      {featured ? (
        <button
          type="button"
          data-gallery-item
          data-src={featured}
          aria-label="Buka foto 1"
          class="group relative block w-full rounded-card overflow-hidden bg-gray-100 mb-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)] focus-visible:ring-offset-2"
        >
          <img src={featured} alt={jejak.title} loading="eager" class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
          <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors group-hover:bg-ink/10"></span>
          <span aria-hidden="true" class="absolute bottom-3 right-3 grid place-items-center w-9 h-9 rounded-full bg-ink/55 text-white opacity-0 transition-opacity group-hover:opacity-100">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
          </span>
        </button>
      ) : (
        <div class="w-full aspect-[16/10] rounded-card border-2 border-dashed border-border bg-gray-50 grid place-items-center gap-2 text-gray-300 mb-8">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
          <span class="text-body-sm font-semibold text-gray-400">Foto menyusul</span>
        </div>
      )}

      <!-- carousel foto lain: strip scroll horizontal (nampung berapa pun), klik untuk perbesar -->
      {carousel.length > 0 && (
        <div class="relative mb-8" data-carousel>
          <div
            data-carousel-track
            class="flex gap-3 overflow-x-auto snap-x scroll-smooth pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          >
            {carousel.map((src, i) => (
              <button
                type="button"
                data-gallery-item
                data-src={src}
                aria-label={`Buka foto ${i + 2}`}
                class="snap-start shrink-0 grow-0 basis-[calc((100%-0.75rem)/2)] sm:basis-[calc((100%-1.5rem)/3)] group relative block rounded-2xl overflow-hidden bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)] focus-visible:ring-offset-2"
              >
                <img src={src} alt="" loading="lazy" class="w-full aspect-square object-cover transition-transform duration-300 group-hover:scale-105" />
                <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors group-hover:bg-ink/10"></span>
              </button>
            ))}
          </div>
          <button type="button" data-carousel-prev aria-label="Geser ke kiri" hidden class="absolute left-1 top-1/2 -translate-y-1/2 grid place-items-center w-9 h-9 rounded-full bg-white text-ink shadow-cardSm hover:shadow-card transition disabled:opacity-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6"></path></svg>
          </button>
          <button type="button" data-carousel-next aria-label="Geser ke kanan" hidden class="absolute right-1 top-1/2 -translate-y-1/2 grid place-items-center w-9 h-9 rounded-full bg-white text-ink shadow-cardSm hover:shadow-card transition disabled:opacity-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      )}

      <!-- statistik -->
      {jejak.metrics.length > 0 && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8">
          {jejak.metrics.map((m) => (
            <div class="rounded-card border border-border p-5">
              <div class="text-heading-sm font-bold text-ink tabular-nums leading-none">{formatMetric(m)}</div>
              <div class="mt-1.5 h-0.75 w-6 rounded bg-[var(--cat)]"></div>
              <div class="text-sm text-muted mt-2.5">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- cerita (body Markdoc) -->
      <div
        class="text-body text-muted leading-relaxed
          [&_h2]:text-title-sm [&_h2]:font-bold [&_h2]:text-ink [&_h2]:mt-9 [&_h2]:mb-3 [&_h2:first-child]:mt-0
          [&_h3]:text-body [&_h3]:font-bold [&_h3]:text-ink [&_h3]:mt-6 [&_h3]:mb-2
          [&_p]:mb-4 [&_p:last-child]:mb-0
          [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-1.5
          [&_li]:pl-1 [&_li::marker]:text-[var(--cat)]
          [&_a]:font-semibold [&_a]:text-[var(--cat-deep)] [&_a]:underline [&_a]:underline-offset-2"
      >
        <Content />
      </div>

      <!-- CTA band ke program induk -->
      <a
        href={ctaHref}
        class="mt-10 flex flex-wrap items-center gap-4 rounded-card p-6 md:p-7 text-white no-underline"
        style="background:linear-gradient(135deg,var(--cat),var(--cat-deep))"
      >
        <div class="min-w-0">
          <h2 class="text-title-sm md:text-title font-bold">Dukung {programLabel} berikutnya</h2>
          <p class="text-body-sm text-white/90 mt-1">Jejak seperti ini bisa terus berjalan berkat donasi Anda.</p>
        </div>
        <span class="ml-auto flex-none rounded-full bg-white text-[var(--cat-deep)] font-bold text-body-sm px-6 py-3 whitespace-nowrap">
          Lihat Program
        </span>
      </a>
    </div>
  </section>

  {galleryImages.length > 0 && <Lightbox />}
</BaseLayout>
