---
import { getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import LocationMap from '../../components/LocationMap.astro';
import Container from '../../components/Container.astro';
import { formatMetric } from '../../lib/format';
import { buildJejakVideoSchema, buildJejakPlacesSchema, buildJejakImagesSchema } from '../../lib/schema';
import { getJejakPages, getJejakMedia } from '../../lib/jejak';
import { getPrograms, getProgramCover } from '../../lib/programs';
import { getOrganisasiRefs } from '../../lib/organisasi';
import { PINTU } from '../../consts';

// Satu route untuk setiap jejak terbit. Begitu editor menambah jejak di
// Keystatic & mencentang terbit, halamannya ikut ter-generate tanpa file baru.
export async function getStaticPaths() {
  const pages = await getJejakPages();
  return pages.map((jejak) => ({
    params: { slug: jejak.slug },
    props: { jejak },
  }));
}

const { jejak } = Astro.props;

// Program induk + pintu-nya untuk badge dan warna aksen. getJejak sudah menyaring
// jejak yatim, jadi program pasti ada; PINTU dijaga fallback ke pintu pertama.
const programs = await getPrograms();
const program = programs.find((p) => p.slug === jejak.program);
const pintu = PINTU.find((p) => p.id === program?.pintu) ?? PINTU[0];
const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;

const programLabel = program?.label ?? jejak.program;
const ctaHref = program?.href ?? `/berbagi-${pintu.slug}/`;
// Foto program yang sama dengan yang dipakai kartu hero beranda dan hero
// halaman program, supaya ajakan di bawah memperlihatkan wajah programnya,
// bukan bidang warna tanpa gambar.
const programCover = program ? getProgramCover(program) : null;

// Organisasi yang menggerakkan kegiatan ini, kalau ada. Peta hanya berisi
// organisasi ber-halaman, jadi jejak yang menyebut organisasi nonaktif atau
// terhapus tak menampilkan apa-apa ketimbang menautkan ke halaman yang hilang.
// Relasinya lateral terhadap program (satu organisasi bisa lintas program),
// jadi chip-nya berdiri terpisah dari badge pintu/program dan sengaja tak
// memakai warna pintu: yang ditandai di sini pelakunya, bukan kategorinya.
const organisasiRef = jejak.organisasi ? (await getOrganisasiRefs()).get(jejak.organisasi) ?? null : null;

// Body naratif Markdoc.
const entry = await getEntry('jejak', jejak.slug);
if (!entry) throw new Error(`jejak entry not found: ${jejak.slug}`);
const { Content } = await render(entry);

// Tanggal ISO ('2026-07-18') dirender ramah-baca Indonesia. timeZone UTC agar
// tanggal tidak bergeser sehari saat di-parse sebagai tengah malam UTC.
const dateLabel = new Date(jejak.date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Halaman ini punya SATU slot utama, bukan dua. Kalau jejaknya punya video,
// videonya yang mengisi slot itu dan seluruh foto turun ke carousel; kalau tak
// ada video, foto pertama naik jadi gambar besar seperti semula. Dua blok
// sebesar layar bertumpuk terbaca sebagai dua pembuka yang saling berebut.
//
// Dedup lewat identitas objek, bukan `img.src`: import.meta.glob eager memberi
// modul yang sama untuk path yang sama, dan membaca properti modul gambar
// menandai berkas aslinya "terpakai langsung" sehingga PNG mentahnya ikut
// disalin ke dist.
const video = jejak.video;
const { videoPlayer, videoLink, heroPhoto, posterImg, carousel, clickable } = getJejakMedia(jejak);
const photoLabelOffset = heroPhoto ? 2 : 1;
const mediaGap = carousel.length > 0 ? 'mb-3' : 'mb-8';

// Jumlah kolom grid metrik dipilih supaya baris terakhir tak menyisakan kartu
// yang menggantung sendirian: empat metrik jadi 2x2, bukan 3+1. Tiga kolom cuma
// dipakai saat jumlahnya memang habis dibagi rapi olehnya.
const metricCols =
  jejak.metrics.length === 1
    ? 'grid-cols-1'
    : jejak.metrics.length === 2 || jejak.metrics.length === 4
      ? 'grid-cols-2'
      : 'grid-cols-2 sm:grid-cols-3';

// Lightbox membuka foto sampai memenuhi layar, jadi sumbernya berkas terpisah
// dari yang tampil di halaman: webp seukuran aslinya, bukan PNG mentah. Dibuat
// saat build lewat getImage, satu berkas per foto dan dipakai ulang oleh semua
// tombol yang menunjuk foto sama.
const lightboxSrc = new Map<ImageMetadata, string>(
  await Promise.all(
    clickable.map(
      async (p) => [p.img, (await getImage({ src: p.img, format: 'webp', quality: 80 })).src] as const
    )
  )
);

// JSON-LD halaman ini. Thumbnail video dibuat lewat getImage, bukan dengan
// membaca properti modul gambarnya: membaca `.src` di luar pipeline gambar
// menandai berkas aslinya "terpakai langsung" dan menyalin JPEG mentahnya ke
// dist. jpeg dipilih ketimbang webp karena ini dibaca mesin pencari, bukan
// peramban, dan dukungannya paling luas di sana.
const videoThumb =
  video && posterImg
    ? new URL((await getImage({ src: posterImg, format: 'jpeg', width: 1200 })).src, Astro.site).href
    : undefined;

// Judul jejak ditulis lengkap dan deskriptif ("Jumat Berkah di Panti Asuhan
// Darushsholihat dan Al-Attiqiyah, Bogor"), dan itu memang bagus untuk pembaca.
// Yang tak muat di hasil pencarian justru embel-embel mereknya: menambahkan
// " | bagiberbagi.id" memakan 17 karakter dan mendorong nama tempat kedua keluar
// dari potongan yang tampil. Judul panjang karena itu berdiri sendiri; nama
// situs toh sudah tampil sebagai domain di baris yang sama.
//
// Ambangnya diukur, bukan ditebak: Google memotong sekitar 60 karakter, jadi
// judul yang sudah melewati 45 tak lagi punya ruang untuk suffix itu.
const seoTitle =
  jejak.title.length > 45 ? jejak.title : `${jejak.title} | bagiberbagi.id`;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Foto yang bisa diperbesar saja yang masuk graph, dan URL-nya diambil dari
// peta lightbox yang sudah dibangun di atas. Jadi yang dideklarasikan ke mesin
// pencari benar-benar berkas yang ada di halaman, bukan varian lain yang cuma
// hidup di markup schema.
const imageSchema = buildJejakImagesSchema(
  pageUrl,
  clickable.map((p) => ({
    contentUrl: new URL(lightboxSrc.get(p.img)!, Astro.site).href,
    alt: p.alt,
    caption: p.caption,
  }))
);

const extraSchema = [
  ...(video
    ? [
        buildJejakVideoSchema({
          pageUrl,
          name: jejak.title,
          description: jejak.summary,
          date: jejak.date,
          thumbnailUrl: videoThumb,
          embedUrl: video.source.kind === 'embed' ? video.source.embedUrl : undefined,
          contentUrl: video.source.kind === 'file' ? video.source.src : undefined,
          places: jejak.points,
        }),
      ]
    : buildJejakPlacesSchema(pageUrl, jejak.points)),
  ...imageSchema,
];
---

<BaseLayout
  title={seoTitle}
  description={jejak.summary}
  breadcrumbName={jejak.title}
  extraSchema={extraSchema}
>
  <section class="section bg-white" style={styleVars}>
    {/* Tier `article`: foto besar, carousel, grid metrik, dan teks cerita berbagi
        satu kolom. Mencampur lebar di halaman ini (media lebar, teks sempit) bikin
        blok teks terlihat menggantung, jadi semuanya dijaga satu tepi. */}
    <Container width="article">
      <!-- breadcrumb: Beranda / Jejak / judul — sengaja mengikuti bentuk URL
           (`/` → `/jejak/` → `/jejak/<slug>/`), sama persis dengan BreadcrumbList
           JSON-LD yang diturunkan dari URL di `BaseLayout`. Pintu tidak jadi
           crumb karena bukan induk route-nya, identitasnya sudah dibawa badge
           di bawah ini. -->
      {/* `inline-block py-3` = kotak sentuh 44px tanpa memindahkan hurufnya;
           lihat catatan panjangnya di program/[program].astro. */}
      <nav class="text-sm font-semibold text-muted mb-3" aria-label="Breadcrumb">
        <a href="/" class="inline-block py-3 hover:text-[var(--cat-deep)]">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <a href="/jejak/" class="inline-block py-3 hover:text-[var(--cat-deep)]">Jejak</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-[var(--cat-deep)]">{jejak.title}</span>
      </nav>

      <!-- konteks: pintu (induk) + program (spesifik) -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <a
          href={`/berbagi-${pintu.slug}/`}
          class="inline-flex items-center gap-1.5 rounded-full bg-[var(--cat)] text-white font-bold text-eyebrow tracking-wide px-3.5 py-1.5"
        >
          <Icon name={pintu.icon} size={14} />
          {pintu.label}
        </a>
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 rounded-full bg-[var(--cat-tint)] text-[var(--cat-deep)] font-bold text-eyebrow tracking-wide px-3.5 py-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--cat)]"></span>
          {programLabel}
        </a>
        {organisasiRef && (
          <a
            href={organisasiRef.href}
            data-track="organisasi_click"
            data-track-source="jejak_detail"
            data-track-organisasi={jejak.organisasi}
            class="inline-flex items-center gap-2 rounded-full border border-border bg-white text-ink font-bold text-eyebrow tracking-wide px-3.5 py-1.5 transition-colors hover:border-gray-300"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none text-muted"><circle cx="9" cy="8" r="3"></circle><path d="M3.5 20c0-3.2 2.7-5 5.5-5s5.5 1.8 5.5 5"></path><circle cx="17.5" cy="9" r="2.3"></circle><path d="M16 14.2c2.6.4 4.5 2.1 4.5 5.3"></path></svg>
            bersama {organisasiRef.label}
          </a>
        )}
      </div>

      <h1 class="text-heading md:text-display font-semibold text-ink mb-4">
        {jejak.title}
      </h1>

      <!-- meta: tanggal + lokasi -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-body-sm text-muted mb-5">
        <span class="inline-flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none text-[var(--cat)]"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
          {dateLabel}
        </span>
        {jejak.location && (
          <span class="inline-flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none text-[var(--cat)]"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            {jejak.location}
          </span>
        )}
      </div>

      {/* `body` (16px), sama dengan badan cerita Markdoc di bawah. Sebelumnya
          ringkasan ini `body-sm`, jadi kalimat pembuka halaman terbaca lebih
          kecil daripada cerita yang diperkenalkannya. Yang di sekitarnya tetap
          `body-sm`: breadcrumb, baris tanggal/lokasi, dan satuan angka. */}
      <p class="text-body text-muted leading-relaxed mb-7">{jejak.summary}</p>

      <!-- slot utama: video kalau ada, kalau tidak gambar besar, klik untuk perbesar -->
      {videoPlayer ? (
        <VideoEmbed video={videoPlayer} fallbackPoster={jejak.cover?.img ?? null} title={jejak.title} eager class={mediaGap} />
      ) : heroPhoto ? (
        <button
          type="button"
          data-gallery-item
          data-src={lightboxSrc.get(heroPhoto.img)}
          data-caption={heroPhoto.caption ?? undefined}
          aria-label="Buka foto 1"
          class:list={['group relative block w-full rounded-card overflow-hidden bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)] focus-visible:ring-offset-2', mediaGap]}
        >
          {/* Container tier `article`: 768px termasuk padding md:px-10, jadi isi
              688px di layar lebar. Lebar terbesar 1376px menutup layar 2x DPR
              sekaligus batas resolusi asli foto lapangan. */}
          <Image
            src={heroPhoto.img}
            alt={heroPhoto.alt}
            widths={[480, 688, 1000, 1376]}
            sizes="(min-width: 768px) 688px, 100vw"
            loading="eager"
            class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors group-hover:bg-ink/10"></span>
          <span aria-hidden="true" class="absolute bottom-3 right-3 grid place-items-center w-9 h-9 rounded-full bg-ink/55 text-white opacity-0 transition-opacity group-hover:opacity-100">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
          </span>
        </button>
      ) : (
        <div class="w-full aspect-[16/10] rounded-card border-2 border-dashed border-border bg-gray-50 grid place-items-center gap-2 text-gray-300 mb-8">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
          <span class="text-body-sm font-semibold text-gray-400">Foto menyusul</span>
        </div>
      )}

      {/* Statistik duluan, sebelum galeri: angkanya adalah bukti, jadi dibaca
          sebelum donatur diminta menggulir lebih jauh untuk foto lainnya. */}
      {jejak.metrics.length > 0 && (
        <div class:list={['grid gap-3 mb-8', metricCols]}>
          {jejak.metrics.map((m) => (
            <div class="rounded-card border border-border p-5">
              <div class="text-heading-sm font-semibold text-ink tabular-nums leading-none">{formatMetric(m)}</div>
              <div class="mt-1.5 h-0.75 w-6 rounded bg-[var(--cat)]"></div>
              <div class="text-sm text-muted mt-2.5">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- carousel foto lain: strip scroll horizontal (nampung berapa pun), klik untuk perbesar -->
      {carousel.length > 0 && (
        <div class="relative mb-8" data-carousel>
          <div
            data-carousel-track
            class="flex gap-3 overflow-x-auto snap-x scroll-smooth pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          >
            {carousel.map((photo, i) => (
              <button
                type="button"
                data-gallery-item
                data-src={lightboxSrc.get(photo.img)}
                data-caption={photo.caption ?? undefined}
                aria-label={`Buka foto ${i + photoLabelOffset}`}
                class="snap-start shrink-0 grow-0 basis-[calc((100%-0.75rem)/2)] sm:basis-[calc((100%-1.5rem)/3)] group relative block rounded-2xl overflow-hidden bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--cat)] focus-visible:ring-offset-2"
              >
                {/* Kartu carousel: separuh kolom di mobile, sepertiga di sm+
                    (isi kolom 688px dikurangi 2 gap 12px), jadi sekitar 221px. */}
                <Image
                  src={photo.img}
                  alt={photo.alt}
                  widths={[221, 340, 442, 640]}
                  sizes="(min-width: 640px) 221px, 45vw"
                  loading="lazy"
                  class="w-full aspect-square object-cover transition-transform duration-300 group-hover:scale-105"
                />
                <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors group-hover:bg-ink/10"></span>
              </button>
            ))}
          </div>
          {/* 44x44, bukan 36x36. Ini satu-satunya tombol geser carousel di
              layar sentuh, dan lingkarannya melayang di atas foto, jadi meleset
              sedikit berarti membuka lightbox foto yang sedang ditutupi tombol
              itu sendiri. Ikonnya tetap 20px: yang tumbuh area sentuhnya, bukan
              bobot visualnya. */}
          <button type="button" data-carousel-prev aria-label="Geser ke kiri" hidden class="absolute left-1 top-1/2 -translate-y-1/2 grid place-items-center w-11 h-11 rounded-full bg-white text-ink shadow-cardSm hover:shadow-card transition disabled:opacity-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6"></path></svg>
          </button>
          <button type="button" data-carousel-next aria-label="Geser ke kanan" hidden class="absolute right-1 top-1/2 -translate-y-1/2 grid place-items-center w-11 h-11 rounded-full bg-white text-ink shadow-cardSm hover:shadow-card transition disabled:opacity-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      )}

      {/* Video yang cuma bisa ditonton di situs lain: di bawah foto, bukan di
          slot utama, karena tautan tak bisa jadi pembuka halaman. */}
      {videoLink && <VideoEmbed video={videoLink} title={jejak.title} />}

      <!-- cerita (body Markdoc) -->
      <div
        class="text-body text-muted leading-relaxed
          [&_h2]:text-title-sm [&_h2]:font-bold [&_h2]:text-ink [&_h2]:mt-9 [&_h2]:mb-3 [&_h2:first-child]:mt-0
          [&_h3]:text-body [&_h3]:font-bold [&_h3]:text-ink [&_h3]:mt-6 [&_h3]:mb-2
          [&_p]:mb-4 [&_p:last-child]:mb-0
          [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-1.5
          [&_li]:pl-1 [&_li::marker]:text-[var(--cat)]
          [&_a]:font-semibold [&_a]:text-[var(--cat-deep)] [&_a]:underline [&_a]:underline-offset-2"
      >
        <Content />
      </div>

      {/* Peta menutup bagian faktual, setelah ceritanya dibaca. Ditaruh sebelum
          cerita, ia memotong alur antara ringkasan dan narasi. */}
      {jejak.points.length > 0 && (
        <LocationMap points={jejak.points} location={jejak.location} class="mt-9" />
      )}

      {/* Laporan PDF: unggahan manual editor, tanpa generate otomatis
          (design.md keputusan #6). Section-nya disembunyikan total kalau kosong. */}
      {jejak.reportPdf && (
        <a
          href={jejak.reportPdf}
          target="_blank"
          rel="noopener"
          data-track="report_pdf_download"
          data-track-jejak={jejak.title}
          class="mt-9 flex items-center gap-4 rounded-card border border-border bg-white p-5 transition hover:shadow-card hover:-translate-y-0.5"
        >
          <span class="flex-none grid place-items-center w-11 h-11 rounded-xl bg-[var(--cat-tint)] text-[var(--cat-deep)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><path d="M14 2v6h6"></path></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-body-sm font-semibold text-ink">Unduh Laporan (PDF)</span>
            <span class="block text-sm text-muted">Ringkasan penyaluran dalam format PDF</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ml-auto flex-none text-muted"><path d="M9 6l6 6-6 6"></path></svg>
        </a>
      )}

      <!-- CTA band ke program induk. Fotonya cover program, sama dengan yang
           dipakai kartu hero beranda dan hero halaman program, jadi satu program
           punya satu wajah di seluruh situs. -->
      <a
        href={ctaHref}
        class="group mt-10 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6 rounded-card overflow-hidden text-white no-underline"
        style="background:linear-gradient(135deg,var(--cat),var(--cat-deep))"
      >
        {programCover && (
          /* Lebar tetap 176px di sm+ (thumbnail, bukan pembuka), penuh selebar
             kartu saat menumpuk di mobile. */
          <Image
            src={programCover}
            alt={programLabel}
            widths={[176, 352, 688]}
            sizes="(min-width: 640px) 176px, 100vw"
            loading="lazy"
            class="w-full h-40 sm:w-44 sm:h-36 flex-none object-cover"
          />
        )}
        <div class="min-w-0 px-6 sm:px-0">
          <h2 class="text-title-sm md:text-title font-semibold">Dukung {programLabel} berikutnya</h2>
          <p class="text-body-sm text-white/90 mt-1">Jejak seperti ini bisa terus berjalan berkat donasi Anda.</p>
        </div>
        <span class="mx-6 mb-6 sm:mx-0 sm:mb-0 sm:mr-6 sm:ml-auto flex-none rounded-full bg-white text-[var(--cat-deep)] font-bold text-body-sm px-6 py-3 text-center whitespace-nowrap">
          Lihat Program
        </span>
      </a>
    </Container>
  </section>

  {/* Dulu digantung pada panjang galeri, jadi jejak bercover-tanpa-galeri punya
      tombol perbesar yang tak membuka apa-apa. Yang menentukan adalah jumlah
      foto yang benar-benar bisa diklik. */}
  {clickable.length > 0 && <Lightbox />}
</BaseLayout>
