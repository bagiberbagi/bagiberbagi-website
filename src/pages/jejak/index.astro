---
import { getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import JejakCard from '../../components/JejakCard.astro';
import Container from '../../components/Container.astro';
import { getJejak, dedupePhotos } from '../../lib/jejak';
import { getPrograms } from '../../lib/programs';
import { getOrganisasiRefs } from '../../lib/organisasi';
import { getGlobalImpact } from '../../lib/impact';
import { buildWaLink, formatMetric } from '../../lib/format';
import { PINTU } from '../../consts';

// Showcase global "Jejak & Dampak": angka agregat seluruh situs + feed semua
// kegiatan + filter per pintu. Menjawab pengunjung yang cari bukti/transparansi
// sekaligus yang mau membagikannya. Dampak di sini = agregat jejak (bukan
// entitas tersendiri). Sekaligus mengisi index /jejak (dulu ghost 404).
//
// LEBAR KONTAINER: seluruh seksi halaman ini memakai Container tier `standard`
// (1024, default halaman non-beranda) tanpa kecuali, supaya tepi kiri/kanan tak
// goyang tiap seksi saat halaman ini diedit lagi. Jangan tulis `max-w` mentah di
// markup: kosakata lebar dipegang Container.astro, lihat doc-comment di sana.
// Blok teks di dalam hero/CTA tetap boleh dipersempit ke `max-w-text`, itu batas
// panjang baris demi kenyamanan baca, bukan batas kontainer.
//
// Lebar konten efektif di layar lebar = 1024 dikurangi padding Container
// (md:px-10 kiri-kanan) = 944px. Angka itu yang jadi dasar semua hitungan
// `sizes`/`widths` gambar di bawah; kalau tier seksi diubah, hitung ulang.
const [jejak, programs, impact, organisasiRefs, site] = await Promise.all([
  getJejak(),
  getPrograms(),
  getGlobalImpact(),
  getOrganisasiRefs(),
  getEntry('settings', 'site'),
]);
if (!site) throw new Error('settings/site entry not found');

// Atribusi organisasi di kartu: logo saja, tanpa tautan (akar kartu sudah
// `<a>`). Peta hanya berisi organisasi ber-halaman, jadi jejak yang menyebut
// organisasi nonaktif/terhapus otomatis tak menampilkan atribusi apa pun.
const organisasiOf = (slug: string | null) => (slug ? organisasiRefs.get(slug) : undefined);

const pintuBySlug = new Map(programs.map((p) => [p.slug, p.pintu]));
const pintuById = new Map(PINTU.map((p) => [p.id, p]));
const pintuOf = (programSlug: string) => pintuById.get(pintuBySlug.get(programSlug)!);
const labelBySlug = new Map(programs.map((p) => [p.slug, p.label]));

// Pintu yang benar-benar sudah punya jejak → jadi chip filter (Semua + per pintu).
const activePintuIds = [...new Set(jejak.map((j) => pintuBySlug.get(j.program)).filter(Boolean))];
const filterPintu = PINTU.filter((p) => activePintuIds.includes(p.id));

// Saat baru satu pintu yang berjejak, chip filter tak berguna (cuma "Semua" +
// satu tombol). Ruangnya dipakai baris meta yang menerangkan cakupan feed;
// isinya diturunkan dari data, jadi ikut berubah saat pintu/program bertambah.
const soloPintu = filterPintu.length === 1 ? filterPintu[0] : null;
const recordedPrograms = [...new Set(jejak.map((j) => labelBySlug.get(j.program) ?? j.program))];

// Galeri gabungan: cover + gallery dari semua jejak. DEDUP dulu (foto yang sama
// sering dipakai sebagai cover satu jejak dan isi galeri jejak lain), baru
// dibatasi supaya seksi ini tak jadi dinding foto kembar.
//
// Dedup memakai identitas objek, BUKAN `img.src`. import.meta.glob eager
// mengembalikan modul yang sama untuk path yang sama, jadi Set sudah cukup.
// Membaca properti modul gambar justru berbahaya: Astro membungkusnya dengan
// Proxy dan menandai berkas aslinya "terpakai langsung" begitu ada properti
// yang dibaca di luar pipeline gambar, sehingga PNG mentahnya ikut disalin ke
// dist dan seluruh gunanya optimasi ini hilang.
// Foto membawa alt dan caption-nya sendiri dari lib/jejak.ts, jadi menggabungkan
// lintas jejak di sini tak lagi menghilangkan keterangannya. Jejak pertama yang
// memakai sebuah foto jadi pemiliknya, aturan yang sekarang dipegang satu fungsi
// bersama supaya tak lagi ditulis ulang beda-beda di tiap pemakai.
const gallery = dedupePhotos(jejak.flatMap((j) => [j.cover, ...j.gallery])).slice(0, 8);

// Thumbnail dan sumber lightbox sengaja BEDA berkas: thumbnail hanya beberapa
// ratus piksel, sementara lightbox membuka foto sampai memenuhi layar. Versi
// besar tetap lewat pipeline (webp seukuran aslinya), bukan PNG mentah, supaya
// membuka lightbox tak menarik berkas satu sampai dua megabyte. getImage
// dipanggil saat build, jadi tak ada biaya di sisi pengunjung.
const galleryItems = await Promise.all(
  gallery.map(async (photo) => ({
    ...photo,
    full: (await getImage({ src: photo.img, format: 'webp', quality: 80 })).src,
  }))
);

// Jumlah kolom mengikuti jumlah foto unik supaya baris terakhir tak bolong saat
// dokumentasinya masih sedikit. Di mobile selalu maksimal 2 kolom: 3 kolom di
// layar 390px membuat thumbnail menyusut jadi sekitar 110px dan fotonya tak
// terbaca. Penambahan kolom baru mulai dari sm.
//
// `sizes` thumbnail WAJIB ikut cabang yang sama. Kalau dipatok satu nilai,
// grid 3 kolom (sel 308px) tetap disuguhi berkas 228px dan fotonya terlihat
// buram. Jadi kelas grid dan sizes lahir dari satu variabel yang sama.
// Angka desktop = (944px isi Container `standard` - total gap 10px) / jumlah
// kolom; ambang 1024px = titik kontainer berhenti melebar (lihat catatan lebar
// di atas). Lebar terbesar dipilih dua kali lebar render untuk layar 2x DPR.
const galleryLayout =
  gallery.length <= 2
    ? {
        cols: 'grid-cols-2',
        sizes: '(min-width: 1024px) 467px, 50vw',
        widths: [320, 467, 640, 934],
      }
    : gallery.length === 3 || (gallery.length % 4 !== 0 && gallery.length % 3 === 0)
      ? {
          cols: 'grid-cols-2 sm:grid-cols-3',
          sizes: '(min-width: 1024px) 308px, (min-width: 640px) 33vw, 50vw',
          widths: [240, 308, 460, 616],
        }
      : gallery.length % 4 === 0
        ? {
            cols: 'grid-cols-2 sm:grid-cols-4',
            sizes: '(min-width: 1024px) 228px, (min-width: 640px) 25vw, 50vw',
            widths: [180, 228, 340, 456],
          }
        : {
            cols: 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4',
            sizes:
              '(min-width: 1024px) 228px, (min-width: 768px) 25vw, (min-width: 640px) 33vw, 50vw',
            widths: [180, 228, 340, 456],
          };
const galleryCols = galleryLayout.cols;

// Grid 2 kolom selalu menyisakan satu sel bolong di baris terakhir kalau jumlah
// fotonya ganjil, jadi item terakhir dilebarkan penuh khusus di mobile. Aturannya
// diturunkan dari paritas jumlah foto, bukan dari angka tertentu, supaya tetap
// benar saat dokumentasi bertambah.
const galleryOddTail = gallery.length % 2 === 1;

// Nilai metrik panjang (mis. "Rp 5.500.000") membungkus jadi 2 baris di layar
// sempit dan bikin tinggi kartu angka tak seragam. Sizing sadar-panjang: string
// lebih dari 8 karakter turun satu tingkat ukuran dan dipaksa satu baris, yang
// pendek tetap pakai ukuran besar.
const numClass = (s: string) =>
  s.length > 8 ? 'text-title-sm md:text-title whitespace-nowrap' : 'text-heading-sm md:text-heading-lg';

// Bentuk feed diturunkan dari jumlah jejak supaya tak ada kartu yatim:
//  1 jejak    -> satu kartu unggulan lebar (grid 3 kolom bikin bolong),
//  2 jejak    -> dua kartu setara berdampingan, tanpa unggulan (kalau yang ke-2
//                dilempar ke grid 3 kolom, ia tampak kecil dan yatim di kiri),
//  3-6 jejak  -> kartu unggulan lebar (terbaru) + grid ringkas sisanya,
//  >6 jejak   -> arsip: grid seragam yang dikelompokkan per bulan, TANPA kartu
//                unggulan (satu kartu lebar di tengah arsip berkelompok bikin
//                ritme feed pecah, dan "terbaru" sudah jelas dari heading bulan).
const ARCHIVE_MIN_JEJAK = 7;
const feedMode: 'single' | 'pair' | 'feature' | 'archive' =
  jejak.length >= ARCHIVE_MIN_JEJAK
    ? 'archive'
    : jejak.length >= 3
      ? 'feature'
      : jejak.length === 2
        ? 'pair'
        : 'single';
// Mode "pair" & "archive" sengaja tak punya kartu lebar.
const wideJejak = feedMode === 'single' || feedMode === 'feature' ? jejak[0] : undefined;
const gridJejak = feedMode === 'pair' ? jejak : feedMode === 'feature' ? jejak.slice(1) : [];
const gridClass = feedMode === 'pair' ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
// Kartu setara memuat isi lengkap (termasuk summary); kartu grid panjang ringkas.
const gridVariant = feedMode === 'pair' ? 'stack' : 'compact';

// Arsip dipecah per bulan. `jejak` sudah urut tanggal desc dari getJejak(), jadi
// grup terbentuk sekali jalan tanpa sort ulang.
const monthLabel = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
const monthGroups: { key: string; label: string; items: typeof jejak }[] = [];
if (feedMode === 'archive') {
  for (const j of jejak) {
    const key = j.date.slice(0, 7);
    const last = monthGroups.at(-1);
    if (last && last.key === key) last.items.push(j);
    else monthGroups.push({ key, label: monthLabel(j.date), items: [j] });
  }
}
// Kalau seluruh arsip jatuh di satu bulan, headingnya mubazir: satu label untuk
// semua kartu tak menambah informasi apa pun.
const showMonthHeadings = monthGroups.length > 1;
// Heading bulan mengisi tingkat h3, jadi judul kartu di dalamnya turun ke h4
// supaya hierarki h2 -> h3 -> h4 tak melompat.
const cardTitleLevel = showMonthHeadings ? 4 : 3;

// Batas jumlah kartu yang TERLIHAT saat feed pertama dibuka, sekaligus besar
// satu batch "tampilkan lebih banyak". Semua kartu tetap ada di HTML (SEO +
// deep-link filter); yang dibatasi cuma yang tampil. Ubah satu angka ini saja.
const FEED_REVEAL_STEP = 9;

// Maksimal 4 kartu angka (1 kali-kegiatan + 3 metrik teratas) supaya grid tak
// pecah kalau editor menambah label metrik baru.
const topMetrics = impact.metrics.slice(0, 3);

const donateWa = buildWaLink(
  site.data.waNumber,
  'Halo, saya ingin ikut mendukung penyaluran berikutnya setelah melihat halaman Jejak & Dampak.'
);

const hasJejak = jejak.length > 0;

const STEPS_PENCATATAN = [
  {
    icon: 'camera' as const,
    title: 'Dokumentasi di lapangan',
    desc: 'Foto dan catatan diambil saat penyaluran berjalan, bukan dirapikan setelahnya.',
  },
  {
    icon: 'impact' as const,
    title: 'Angka dicatat per kegiatan',
    desc: 'Porsi, penerima, dan dana tersalur dicatat satu per satu, lalu dijumlahkan jadi angka di halaman ini.',
  },
  {
    icon: 'repeat' as const,
    title: 'Laporan ke donatur',
    desc: 'Bukti penyaluran dikirim ke donatur. Tiap kegiatan punya halaman sendiri yang bisa ditelusuri.',
  },
];
---

<BaseLayout
  title="Jejak & Dampak | bagiberbagi.id"
  description="Rekam jejak nyata bagiberbagi.id: angka dampak terhitung dari setiap kegiatan, galeri lapangan, dan dokumentasi tiap penyaluran. Transparan, bisa ditelusuri."
  breadcrumbName="Jejak & Dampak"
>
  <!-- HERO: latar hangat brand (senada hero pintu), teks tengah. `section-hero`,
       bukan `section`: bidang tint-nya harus menembus ke belakang pil navbar. -->
  <section id="pembuka" class="section-hero bg-linear-[160deg] from-brand-orangeTint to-white to-60%">
    <Container>
      {/* `inline-block py-3` = kotak sentuh 44px tanpa memindahkan hurufnya;
           lihat catatan panjangnya di program/[program].astro. */}
      <nav class="text-sm font-semibold text-muted mb-3" aria-label="Breadcrumb">
        <a href="/" class="inline-block py-3 hover:text-brand-orangeDark">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-ink">Jejak &amp; Dampak</span>
      </nav>

      {/* Blok judul dipersempit ke lebar baca; kontainer seksinya tetap
          `standard` supaya tepi kiri breadcrumb segaris dengan seksi lain. */}
      <div class="text-center max-w-text mx-auto">
        <span class="inline-grid place-items-center w-16 h-16 rounded-2xl bg-white shadow-cardSoft text-brand-orange mb-4">
          <Icon name="impact" size={30} />
        </span>
        <div class="eyebrow">Jejak &amp; Dampak</div>
        <h1 class="text-heading md:text-display font-semibold mb-3">Setiap kebaikan, bisa ditelusuri</h1>
        <p class="text-body md:text-title-sm text-muted leading-relaxed">
          Angka di halaman ini dihitung dari tiap kegiatan yang sudah berjalan, lengkap dengan foto lapangan dan catatan penyalurannya.
        </p>
      </div>
    </Container>
  </section>

  {/* ANGKA AGREGAT: kartu pertama gelap (kali kegiatan = konteks pengali), metrik ber-tint */}
  {hasJejak && (
    <section id="angka" class="py-10 md:py-14 bg-white scroll-mt-24">
      <Container>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4">
          <div class="rounded-card bg-ink p-5 text-center text-white">
            <div class:list={['font-semibold tabular-nums leading-none', numClass(impact.jejakCount.toLocaleString('id-ID'))]}>{impact.jejakCount.toLocaleString('id-ID')}</div>
            <div class="w-5 h-0.75 rounded bg-brand-orange mx-auto my-2.5"></div>
            <div class="text-body-sm text-white/70">kali kegiatan</div>
          </div>
          {topMetrics.map((m) => (
            <div class="rounded-card bg-brand-orangeTint p-5 text-center">
              <div class:list={['font-semibold text-brand-orangeDark tabular-nums leading-none', numClass(formatMetric(m))]}>{formatMetric(m)}</div>
              <div class="w-5 h-0.75 rounded bg-brand-orange mx-auto my-2.5"></div>
              <div class="text-body-sm text-brand-orangeDark/70">{m.label}</div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- FEED JEJAK: bentuknya ikut feedMode (1 kartu lebar / 2 kartu setara /
       unggulan + grid), dengan filter pintu -->
  <section id="rekam-jejak" class="section bg-gray-50 scroll-mt-24">
    <Container>
      <div class="eyebrow">Rekam Jejak</div>
      <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-6">Dokumentasi tiap kegiatan</h2>

      {hasJejak ? (
        <>
          {filterPintu.length > 1 ? (
            <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="Filter pintu">
              <button type="button" data-jfilter="all" aria-pressed="true" class="rounded-full border border-border bg-white px-4 py-1.5 text-body-sm font-bold text-ink transition-colors aria-pressed:bg-ink aria-pressed:text-white hover:border-gray-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2">Semua</button>
              {filterPintu.map((p) => (
                <button
                  type="button"
                  data-jfilter={p.slug}
                  aria-pressed="false"
                  style={`--cat:${p.color};--cat-tint:${p.colorTint};--cat-deep:${p.colorDeep}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-1.5 text-body-sm font-bold text-muted transition-colors aria-pressed:bg-[var(--cat)] aria-pressed:text-white aria-pressed:border-[var(--cat)] hover:border-gray-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2"
                >
                  <Icon name={p.icon} size={13} />
                  {p.label}
                </button>
              ))}
            </div>
          ) : (
            soloPintu && (
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-body-sm text-muted mb-6">
                <span
                  class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-micro font-bold uppercase tracking-wide"
                  style={`color:${soloPintu.color};background:${soloPintu.colorTint}`}
                >
                  <span class="w-1.5 h-1.5 rounded-full" style={`background:${soloPintu.color}`}></span>
                  {soloPintu.label}
                </span>
                <span class="font-semibold text-ink">{jejak.length} jejak</span>
                <span aria-hidden="true" class="text-gray-300">&middot;</span>
                <span>program {recordedPrograms.join(', ')}</span>
              </div>
            )
          )}

          {/* Kartu lebar (unggulan) hanya dirender di mode single & feature; di
              mode pair kedua jejak masuk grid setara supaya tak ada yang yatim,
              di mode archive semuanya seragam per grup bulan.
              Wadah flex-col memberi jarak antar blok tanpa margin di kartu,
              jadi gap ikut hilang saat kartu disembunyikan filter. */}
          <div class="flex flex-col gap-5">
            {wideJejak && (
              <JejakCard
                jejak={wideJejak}
                pintu={pintuOf(wideJejak.program)}
                organisasi={organisasiOf(wideJejak.organisasi)}
                variant="wide"
                featured={feedMode === 'feature'}
                eager
              />
            )}

            {gridJejak.length > 0 && (
              <div class:list={['grid gap-5', gridClass]}>
                {gridJejak.map((j, i) => (
                  <JejakCard
                    jejak={j}
                    pintu={pintuOf(j.program)}
                    organisasi={organisasiOf(j.organisasi)}
                    variant={gridVariant}
                    eager={!wideJejak && i === 0}
                  />
                ))}
              </div>
            )}

            {/* Arsip per bulan. Tiap grup dibungkus [data-jgroup] supaya script
                bisa menyembunyikan headingnya begitu filter/limit mengosongkan
                grup itu: heading bulan menggantung tanpa kartu bikin bingung.
                `[&[hidden]]:hidden` dipakai karena wadah induknya flex dan
                atribut hidden dari UA sheet bisa ditimpa utility display. */}
            {monthGroups.map((g, gi) => (
              <div data-jgroup class="[&[hidden]]:hidden">
                {showMonthHeadings && (
                  <h3 class="text-title-sm font-semibold text-muted mb-3">{g.label}</h3>
                )}
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {g.items.map((j, i) => (
                    <JejakCard
                      jejak={j}
                      pintu={pintuOf(j.program)}
                      organisasi={organisasiOf(j.organisasi)}
                      variant="compact"
                      titleLevel={cardTitleLevel}
                      eager={gi === 0 && i === 0}
                    />
                  ))}
                </div>
              </div>
            ))}
          </div>

          {/* Hasil filter kosong: dimunculkan oleh script saat tak ada kartu lolos */}
          <p data-jempty hidden class="rounded-card border border-border bg-white p-8 text-center text-body text-muted">
            Belum ada jejak untuk pintu ini.
          </p>

          {/* Tombol sengaja dirender `hidden` dan baru dimunculkan script kalau
              memang ada kartu yang disembunyikan. Alasannya: tanpa JS tak ada
              satu kartu pun yang dibatasi (pembatasan dikerjakan script saat
              load), jadi tombol yang tampil justru menyesatkan. Efek sampingnya
              persis yang diminta: saat total kartu <= batas awal, tombol tetap
              tersembunyi. Besar batch ikut lewat data-jstep supaya angkanya
              hidup di satu tempat (FEED_REVEAL_STEP di frontmatter). */}
          <button
            type="button"
            data-jmore
            data-jstep={FEED_REVEAL_STEP}
            hidden
            class="mx-auto mt-7 flex w-fit items-center gap-2 rounded-full border border-border bg-white px-6 py-3 text-body-sm font-bold text-ink transition-colors hover:border-gray-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2 [&[hidden]]:hidden"
          >
            <span data-jmore-label>Tampilkan lebih banyak</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          {/* Region sr-only: hasil klik tombol/chip dibacakan pembaca layar tanpa
              memindahkan apa pun secara visual (position:absolute, tak menambah
              tinggi feed). */}
          <p data-jstatus aria-live="polite" class="sr-only"></p>
        </>
      ) : (
        <p class="rounded-card border border-border bg-white p-10 text-center text-muted">
          Belum ada jejak terpublikasi. Dokumentasi kegiatan pertama akan tampil di sini.
        </p>
      )}
    </Container>
  </section>

  {/* GALERI LAPANGAN: foto unik dari seluruh jejak, klik untuk perbesar */}
  {gallery.length > 0 && (
    <section id="galeri" class="py-10 md:py-14 bg-white scroll-mt-24">
      <Container>
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-5">
          <h2 class="text-title font-semibold text-ink">Galeri lapangan</h2>
          <p class="text-body-sm text-muted">Klik foto untuk perbesar.</p>
        </div>
        <div class:list={['grid gap-2.5', galleryCols]}>
          {galleryItems.map(({ img, alt, caption, full }, i) => (
            <button
              type="button"
              data-gallery-item
              data-src={full}
              data-caption={caption ?? undefined}
              aria-label={`Buka foto ${i + 1} dari ${galleryItems.length}`}
              class:list={[
                'group relative block w-full aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2',
                galleryOddTail && i === galleryItems.length - 1 && 'max-sm:col-span-2',
              ]}
            >
              <Image
                src={img}
                alt={alt}
                widths={galleryLayout.widths}
                sizes={galleryLayout.sizes}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors group-hover:bg-ink/10"></span>
            </button>
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- CARA KAMI MENCATAT: menjelaskan asal angka di atas, tetap tampil walau jejak nol -->
  <section id="cara-pencatatan" class="section bg-gray-50 scroll-mt-24">
    <Container>
      <div class="eyebrow">Cara Pencatatan</div>
      <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-6">Cara kami mencatat</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {STEPS_PENCATATAN.map((s) => (
          <div class="rounded-card bg-white border border-border p-6">
            <span class="inline-grid place-items-center w-11 h-11 rounded-xl bg-brand-orangeTint text-brand-orange mb-4">
              <Icon name={s.icon} size={22} />
            </span>
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{s.title}</h3>
            <p class="text-body text-muted leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA penutup: donasi (primer) + transparansi formal (sekunder) -->
  <section id="penutup" class="section bg-white scroll-mt-24">
    <Container>
      <div class="rounded-card p-7 md:p-10 text-white text-center bg-gradient-to-br from-brand-orange to-brand-orangeDark">
        <h2 class="text-heading-sm md:text-heading font-semibold mb-2.5">Dukung penyaluran berikutnya</h2>
        <p class="text-body text-white/90 leading-relaxed max-w-text mx-auto mb-6">
          Donasi kamu masuk ke kegiatan berikutnya, dan hasilnya dicatat di halaman ini seperti jejak di atas.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href={donateWa}
            target="_blank"
            rel="noopener"
            data-track="donate_click"
            data-track-source="jejak_page"
            class="btn-secondary text-brand-orangeDark"
          >
            Donasi lewat WhatsApp
          </a>
          <a
            href="/transparansi/"
            class="inline-flex items-center rounded-full border-2 border-white/60 px-8 py-4 font-bold text-base text-white transition hover:bg-white/15 hover:-translate-y-0.5"
          >
            Kebijakan &amp; Laporan
          </a>
        </div>
      </div>
    </Container>
  </section>

  {gallery.length > 0 && <Lightbox />}
</BaseLayout>

<script>
  // Feed jejak (client-side; halaman statis, semua kartu dirender lalu
  // disembunyikan). Ada DUA lapis penyaringan yang wajib dihitung bersama:
  //   1. filter pintu lewat chip, dan
  //   2. jendela "tampilkan lebih banyak" (limit) atas kartu yang LOLOS filter.
  // Aturannya: kartu terlihat kalau lolos filter DAN urutannya di antara
  // kartu-kartu yang lolos (urut tanggal desc, sama dengan urutan DOM) masih di
  // dalam limit. Karena limit dihitung terhadap hasil filter, ganti chip selalu
  // me-reset limit: sisa "n lagi" harus dihitung ulang terhadap hasil baru.
  // Kartu unggulan ikut tersaring karena memakai kontrak data-jcard/data-pintu.
  const chips = [...document.querySelectorAll<HTMLElement>('[data-jfilter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-jcard]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-jgroup]')];
  const empty = document.querySelector<HTMLElement>('[data-jempty]');
  const more = document.querySelector<HTMLButtonElement>('[data-jmore]');
  const moreLabel = document.querySelector<HTMLElement>('[data-jmore-label]');
  const status = document.querySelector<HTMLElement>('[data-jstatus]');

  // Fallback ke jumlah kartu: kalau tombol tak ada, limit tak pernah membatasi
  // apa pun, jadi jalur logikanya tetap satu (tak perlu cabang khusus).
  const step = Number(more?.dataset.jstep) || cards.length;
  let filter = 'all';
  let limit = step;

  function render(announce: boolean) {
    chips.forEach((c) => c.setAttribute('aria-pressed', c.dataset.jfilter === filter ? 'true' : 'false'));
    let matched = 0;
    cards.forEach((card) => {
      const pass = filter === 'all' || card.dataset.pintu === filter;
      card.hidden = !(pass && matched < limit);
      if (pass) matched += 1;
    });
    // Heading bulan ikut hilang kalau seluruh kartu di grupnya tak terlihat,
    // entah karena filter atau karena masih di luar jendela reveal.
    groups.forEach((g) => {
      g.hidden = ![...g.querySelectorAll<HTMLElement>('[data-jcard]')].some((c) => !c.hidden);
    });
    const shown = Math.min(matched, limit);
    const rest = matched - shown;
    // Pesan kosong hanya relevan saat filter menyaring habis isi feed.
    if (empty) empty.hidden = matched > 0;
    if (more) {
      more.hidden = rest === 0;
      if (moreLabel) moreLabel.textContent = `Tampilkan lebih banyak (${rest} lagi)`;
    }
    // Diumumkan hanya setelah interaksi; pada load awal tak ada perubahan yang
    // perlu dibacakan dan region live justru berisik.
    if (announce && status) status.textContent = `Menampilkan ${shown} dari ${matched} jejak.`;
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.jfilter as string;
      limit = step; // jendela reveal balik ke batas awal tiap ganti pintu
      render(true);
    })
  );

  more?.addEventListener('click', () => {
    const before = new Set(cards.filter((c) => !c.hidden));
    limit += step;
    render(true);
    // Fokus dipindah ke kartu baru pertama: pada klik terakhir tombolnya jadi
    // hidden, dan tanpa ini fokus keyboard terlempar ke <body>. preventScroll
    // supaya pengguna tetikus tak dilompatkan posisi scroll-nya.
    cards.find((c) => !c.hidden && !before.has(c))?.focus({ preventScroll: true });
  });

  // Deep-link: /jejak/?berbagi=makanan langsung terapkan filter itu bila chip-nya ada.
  const q = new URLSearchParams(location.search).get('berbagi');
  if (q && chips.some((c) => c.dataset.jfilter === q)) filter = q;
  // Render awal juga yang menerapkan pembatasan kartu; markup server tak pernah
  // menyembunyikan kartu, jadi tanpa JS semua jejak tetap terbaca.
  render(false);
</script>
