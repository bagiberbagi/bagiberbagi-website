---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import Container from '../../components/Container.astro';
import { getJejak } from '../../lib/jejak';
import { getPrograms } from '../../lib/programs';
import { getGlobalImpact } from '../../lib/impact';
import { formatMetric } from '../../lib/format';
import { PINTU } from '../../consts';

// Showcase global "Jejak & Dampak": angka agregat seluruh situs + feed semua
// kegiatan + filter per pintu. Menjawab pengunjung yang cari bukti/transparansi
// sekaligus yang mau membagikannya. Dampak di sini = agregat jejak (bukan
// entitas tersendiri). Sekaligus mengisi index /jejak (dulu ghost 404).
const [jejak, programs, impact] = await Promise.all([
  getJejak(),
  getPrograms(),
  getGlobalImpact(),
]);

const pintuBySlug = new Map(programs.map((p) => [p.slug, p.pintu]));
const pintuById = new Map(PINTU.map((p) => [p.id, p]));
const pintuOf = (programSlug: string) => pintuById.get(pintuBySlug.get(programSlug)!);
const labelBySlug = new Map(programs.map((p) => [p.slug, p.label]));

// Pintu yang benar-benar sudah punya jejak → jadi chip filter (Semua + per pintu).
const activePintuIds = [...new Set(jejak.map((j) => pintuBySlug.get(j.program)).filter(Boolean))];
const filterPintu = PINTU.filter((p) => activePintuIds.includes(p.id));

// Galeri gabungan: cover + gallery dari jejak terbaru, buang kosong, batasi.
const gallery = jejak
  .flatMap((j) => [j.cover, ...j.gallery])
  .filter((src): src is string => !!src)
  .slice(0, 12);

const hasJejak = jejak.length > 0;
const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Jejak & Dampak | bagiberbagi.id"
  description="Rekam jejak nyata bagiberbagi.id: angka dampak terhitung dari setiap kegiatan, galeri lapangan, dan dokumentasi tiap penyaluran. Transparan, bisa ditelusuri."
  breadcrumbName="Jejak & Dampak"
>
  <section class="section bg-white">
    <Container>
      <nav class="text-sm font-semibold text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-orangeDark">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-ink">Jejak &amp; Dampak</span>
      </nav>

      <div class="text-center max-w-text mx-auto mb-12">
        <div class="eyebrow">Jejak &amp; Dampak</div>
        <h1 class="text-heading md:text-display font-semibold mb-3">Setiap kebaikan, bisa ditelusuri</h1>
        <p class="text-body-sm md:text-body text-muted leading-relaxed">
          Angka di bawah bukan janji, tapi hasil yang tercatat dari tiap kali program kami berjalan di lapangan. Lengkap dengan foto dan ceritanya.
        </p>
      </div>

      {hasJejak ? (
        <>
          {/* counter agregat global */}
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4 mb-12">
            <div class="rounded-card bg-brand-orangeTint p-5 text-center">
              <div class="text-heading-sm md:text-heading-lg font-semibold text-brand-orangeDark tabular-nums leading-none">{impact.jejakCount.toLocaleString('id-ID')}</div>
              <div class="w-5 h-0.75 rounded bg-brand-orange mx-auto my-2.5"></div>
              <div class="text-body-sm text-brand-orangeDark/70">kali kegiatan</div>
            </div>
            {impact.metrics.map((m) => (
              <div class="rounded-card bg-brand-orangeTint p-5 text-center">
                <div class="text-heading-sm md:text-heading-lg font-semibold text-brand-orangeDark tabular-nums leading-none">{formatMetric(m)}</div>
                <div class="w-5 h-0.75 rounded bg-brand-orange mx-auto my-2.5"></div>
                <div class="text-body-sm text-brand-orangeDark/70">{m.label}</div>
              </div>
            ))}
          </div>

          {/* galeri gabungan: klik untuk perbesar */}
          {gallery.length > 0 && (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 mb-12">
              {gallery.map((src, i) => (
                <button
                  type="button"
                  data-gallery-item
                  data-src={src}
                  aria-label={`Buka foto ${i + 1} dari ${gallery.length}`}
                  class="group relative block w-full aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2"
                >
                  <img src={src} alt="" loading="lazy" decoding="async" width="400" height="300" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                  <span aria-hidden="true" class="absolute inset-0 bg-ink/0 transition-colors group-hover:bg-ink/10"></span>
                </button>
              ))}
            </div>
          )}

          {/* filter pintu (client-side) */}
          {filterPintu.length > 1 && (
            <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="Filter pintu">
              <button type="button" data-jfilter="all" aria-pressed="true" class="rounded-full border border-border px-4 py-1.5 text-body-sm font-bold text-ink transition-colors aria-pressed:bg-ink aria-pressed:text-white hover:border-gray-300">Semua</button>
              {filterPintu.map((p) => (
                <button
                  type="button"
                  data-jfilter={p.slug}
                  aria-pressed="false"
                  style={`--cat:${p.color};--cat-tint:${p.colorTint};--cat-deep:${p.colorDeep}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-border px-4 py-1.5 text-body-sm font-bold text-muted transition-colors aria-pressed:bg-[var(--cat)] aria-pressed:text-white aria-pressed:border-[var(--cat)] hover:border-gray-300"
                >
                  <Icon name={p.icon} size={13} />
                  {p.label}
                </button>
              ))}
            </div>
          )}

          {/* feed jejak */}
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {jejak.map((j) => {
              const pintu = pintuOf(j.program);
              const color = pintu?.color ?? '#F4791D';
              return (
                <a
                  href={j.href}
                  data-jcard
                  data-pintu={pintu?.slug}
                  data-track="jejak_click"
                  data-track-jejak={j.slug}
                  style={`--cat:${color}`}
                  class="group flex flex-col overflow-hidden rounded-card border border-border bg-white shadow-cardSm transition-transform hover:-translate-y-1"
                >
                  {j.cover ? (
                    <img src={j.cover} alt="" loading="lazy" class="aspect-[16/10] w-full object-cover" />
                  ) : (
                    <div class="aspect-[16/10] w-full flex items-center justify-center" style={`background:linear-gradient(135deg, color-mix(in srgb, var(--cat) 16%, #fff), color-mix(in srgb, var(--cat) 6%, #fff))`}>
                      {pintu && (
                        <span class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-cardSm" style={`color:var(--cat)`}>
                          <Icon name={pintu.icon} size={26} />
                        </span>
                      )}
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-5">
                    {pintu && (
                      <div class="mb-3">
                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-micro font-bold uppercase tracking-wide" style={`color:var(--cat);background:${pintu.colorTint}`}>
                          <span class="w-1.5 h-1.5 rounded-full" style={`background:var(--cat)`}></span>
                          {pintu.label}
                        </span>
                      </div>
                    )}
                    <div class="text-micro font-semibold text-muted mb-2">{fmtDate(j.date)} &middot; {j.location}</div>
                    <h3 class="text-title-sm font-semibold text-ink leading-snug mb-4 group-hover:text-brand-orange transition-colors">{j.title}</h3>
                    {j.metrics.length > 0 && (
                      <div class="mt-auto grid grid-cols-3 gap-2">
                        {j.metrics.slice(0, 3).map((m) => (
                          <div class="rounded-xl bg-gray-50 px-2 py-2.5 text-center">
                            <div class="text-title-sm font-bold tabular-nums leading-none" style={`color:var(--cat)`}>{formatMetric(m)}</div>
                            <div class="text-micro text-muted mt-1 truncate">{m.label}</div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>

          {/* jembatan ke transparansi formal (#4) */}
          <p class="mt-12 text-center text-body-sm text-muted">
            Butuh kebijakan &amp; laporan formal? Lihat <a href="/transparansi/" class="font-bold text-brand-orangeDark hover:underline underline-offset-2">halaman Transparansi</a>.
          </p>
        </>
      ) : (
        <div class="rounded-card border border-border bg-gray-50 p-10 text-center text-muted">
          Belum ada jejak terpublikasi. Nantikan dokumentasi kegiatan pertama kami.
        </div>
      )}
    </Container>
  </section>

  {gallery.length > 0 && <Lightbox />}
</BaseLayout>

<script>
  // Filter feed jejak per pintu (client-side; halaman statis, semua kartu
  // dirender lalu disembunyikan sesuai chip aktif).
  const chips = [...document.querySelectorAll('[data-jfilter]')] as HTMLElement[];
  const cards = [...document.querySelectorAll('[data-jcard]')] as HTMLElement[];
  function apply(f: string) {
    chips.forEach((c) => c.setAttribute('aria-pressed', c.dataset.jfilter === f ? 'true' : 'false'));
    cards.forEach((card) => { card.hidden = !(f === 'all' || card.dataset.pintu === f); });
  }
  chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.jfilter as string)));
  // Deep-link: /jejak/?berbagi=makanan langsung terapkan filter itu bila chip-nya ada.
  const q = new URLSearchParams(location.search).get('berbagi');
  if (q && chips.some((c) => c.dataset.jfilter === q)) apply(q);
</script>
