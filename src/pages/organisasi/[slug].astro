---
import { getEntry } from 'astro:content';
import { findPageSeo, ogKeyFromPath } from '../../lib/seo';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Share from '../../components/Share.astro';
import JejakCard from '../../components/JejakCard.astro';
import { getOrganisasiPages } from '../../lib/organisasi';
import { getJejakByOrganisasi } from '../../lib/jejak';
import { getOrganisasiImpact } from '../../lib/impact';
import { getPrograms } from '../../lib/programs';
import { buildWaLink, formatMetric } from '../../lib/format';
import { PINTU } from '../../consts';

// Satu route untuk tiap organisasi ber-halaman, di bawah /organisasi/[slug]/.
// Begitu editor mengaktifkan organisasi di Keystatic & mengisi Detail,
// halamannya ikut ter-generate tanpa membuat file .astro baru — pola sama
// dengan program/[program].astro.
//
// LEBAR KONTAINER: seluruh seksi halaman ini memakai Container tier `standard`
// (1024, default halaman non-beranda). Band biru Dashboard Dampak tetap ikut
// aturan itu: warnanya yang full-bleed, isinya tetap di dalam Container yang
// sama, supaya tepi kiri semua seksi lurus. Jangan tulis `max-w` mentah di
// markup — kosakata lebar dipegang Container.astro.
//
// Lebar konten efektif di layar lebar = 1024 dikurangi padding Container
// (md:px-10 kiri-kanan) = 944px. Angka itu dasar semua hitungan `sizes` gambar
// di bawah; kalau tier seksi diubah, hitung ulang.
export async function getStaticPaths() {
  const organisasi = await getOrganisasiPages();
  return organisasi.map((org) => ({
    params: { slug: org.slug },
    props: { org },
  }));
}

const { org } = Astro.props;
const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Rekam jejak lintas program (design.md keputusan #1) + agregat dampaknya.
const [jejak, impact, programs] = await Promise.all([
  getJejakByOrganisasi(org.slug),
  getOrganisasiImpact(org.slug),
  getPrograms(),
]);

const hasJejak = jejak.length > 0;

// Kegiatan terakhir, isi kartu hero. `jejak` sudah urut tanggal desc.
const latestJejak = jejak[0] ?? null;

// Angka per kegiatan di kartu Rekam Jejak cuma berguna kalau ada beberapa
// kegiatan untuk dibandingkan. Saat organisasi baru punya satu, angka kartunya
// persis sama dengan hasil penjumlahan di band biru tepat di atasnya, jadi
// pengulangannya disembunyikan dan band biru tetap jadi pemilik tunggal angka.
const singleJejak = jejak.length === 1;

// Pintu induk tiap jejak dipetakan lewat programnya: JejakCard butuh entri PINTU
// utuh (warna + ikon), bukan cuma id-nya. Resolusinya sama persis dengan feed
// /jejak supaya kartu yang sama tak pernah beda warna di dua halaman.
const pintuById = new Map(PINTU.map((p) => [p.id, p]));
const pintuBySlug = new Map(programs.map((p) => [p.slug, p.pintuUtama]));
const pintuOf = (programSlug: string) => pintuById.get(pintuBySlug.get(programSlug)!);

// Foto kartu hero: cover jejak terbaru yang benar-benar punya foto. Cuma satu
// foto, jadi tak ada dedup yang perlu dikerjakan di sini. Modul gambarnya
// diteruskan utuh ke <Image> lewat `.img`; jangan sekali pun membaca properti
// modul itu sendiri (mis. `.src`) di luar pipeline, sebab Astro membungkusnya
// dengan Proxy dan menandai berkas aslinya "terpakai langsung" begitu ada
// properti yang dibaca, sehingga berkas mentahnya ikut disalin ke dist dan
// seluruh optimasinya hilang (lihat catatan panjang di jejak/index.astro).
//
// Alt-nya milik foto itu sendiri, bukan kalimat umum "Dokumentasi kegiatan
// bersama <organisasi>" seperti dulu: seluruh halaman ini sudah tentang
// organisasi tersebut, jadi yang belum diketahui pembaca justru isi fotonya.
const heroPhoto = jejak.find((j) => j.cover)?.cover ?? null;

// "Berbagi sejak": isian editor menang kalau ada. Field ini nyaris selalu kosong
// di data sungguhan, dan badge yang hilang diam-diam justru menghapus satu-satunya
// tanda bahwa hubungannya sudah berjalan lama, jadi tanggalnya diturunkan dari
// jejak paling awal. `jejak` sudah urut tanggal desc, jadi elemen terakhir adalah
// yang paling dulu terjadi.
const monthYearFmt = new Intl.DateTimeFormat('id-ID', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const firstDate = jejak.at(-1)?.date ?? null;
const since = org.detail.since.trim() || (firstDate ? monthYearFmt.format(new Date(firstDate)) : '');

// Tanggal kegiatan terakhir untuk kartu hero, ditulis lengkap karena ia berdiri
// sendiri sebagai isi kartu, bukan sebagai baris meta di antara data lain.
const fullDateFmt = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const lastJejakDateLabel = latestJejak ? fullDateFmt.format(new Date(latestJejak.date)) : '';

// Rincian program: lewat program mana saja organisasi ini berkontribusi, dan
// berapa kegiatan di masing-masing. Diurutkan dari yang paling sering karena
// itu yang menerangkan fokus kontribusinya. Program yang punya halaman ikut
// ditautkan, yang belum tampil sebagai chip biasa.
const programBySlug = new Map(programs.map((p) => [p.slug, p]));
const programBreakdown = [...new Set(jejak.map((j) => j.program))]
  .map((slug) => ({
    label: programBySlug.get(slug)?.label ?? slug,
    href: programBySlug.get(slug)?.href,
    count: jejak.filter((j) => j.program === slug).length,
  }))
  .sort((a, b) => b.count - a.count);

// Penjelas per metrik, meniru pola ImpactSection: angka besar yang berdiri
// sendiri tak berarti apa-apa. Label di luar daftar jatuh ke kalimat umum, jadi
// metrik baru dari Keystatic tetap tampil wajar tanpa file ini disentuh.
const METRIC_NOTE: Record<string, string> = {
  porsi: 'Porsi makanan yang sampai ke tangan penerima',
  'mitra umkm': 'Dapur usaha kecil yang menerima pesanan masak',
  relawan: 'Orang yang turun mengantar paket ke lokasi',
  penerima: 'Orang yang menerima paket langsung di lokasi',
  'donasi tersalur': 'Dana yang sudah dibelanjakan dan dilaporkan',
};
const noteFor = (label: string) => METRIC_NOTE[label.trim().toLowerCase()] ?? `Total ${label} yang tercatat`;

// Bentuk daftar jejak diturunkan dari jumlahnya, disiplin yang sama dengan feed
// /jejak: 1 jejak jadi kartu lebar, 2 jadi dua kartu setara berdampingan, 3+
// masuk grid ringkas. Tanpa ini satu kartu sendirian di grid 3 kolom tampak
// yatim di kiri.
const feedMode: 'single' | 'pair' | 'grid' =
  jejak.length === 1 ? 'single' : jejak.length === 2 ? 'pair' : 'grid';

const joinWa = buildWaLink(
  site.data.waNumber,
  'Halo, organisasi/komunitas kami ingin berkontribusi rutin dan didaftarkan sebagai organisasi mitra bagiberbagi.id.'
);

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;

// Share image sendiri, alasannya sama persis dengan di `jejak/[slug].astro`:
// `open-graph/[...route].ts` sudah membangunkan satu untuk tiap organisasi,
// tapi BaseLayout cuma tahu prop eksplisit lalu `seo.pages[]` lalu default
// situs, jadi tanpa baris ini gambar itu dibuat lalu tak dipakai siapa pun.
// Entri kurasi tetap menang kalau suatu saat ada.
const seoEntry = await getEntry('seo', 'seo');
const curated = seoEntry ? findPageSeo(seoEntry.data, Astro.url.pathname) : undefined;
const ownShareImage = curated?.image
  ? undefined
  : `/open-graph/${ogKeyFromPath(Astro.url.pathname)}.png`;

// Nama organisasi saja terlalu pendek untuk judul hasil pencarian ("46Cyclist |
// bagiberbagi.id" cuma 26 karakter) dan tak memberi tahu pencari apa isi
// halamannya. Deskriptornya ditambahkan di judul saja, bukan pada `label`,
// supaya nama organisasi tetap utuh di kartu, breadcrumb, dan atribusi jejak.
// Pengaman panjang yang sama dengan halaman jejak: nama organisasi itu teks
// bebas, jadi yang panjang akan mendorong deskriptor DAN nama situs keluar dari
// potongan yang tampil di hasil pencarian. Yang panjang cukup dapat deskriptor.
const seoTitle =
  org.label.length > 28
    ? `${org.label}: Rekam Jejak Berbagi`
    : `${org.label}: Rekam Jejak Berbagi | bagiberbagi.id`;
---

<BaseLayout
  title={seoTitle}
  description={org.summary}
  image={ownShareImage}
  breadcrumbName={org.label}
>
  <!-- PROFIL: dua kolom, kiri identitas + cerita, kanan kartu putih melayang
       berisi angka utama dan satu foto lapangan. Bentuknya menggemakan hero
       beranda (bidang warna + kartu putih di kanan), jadi separuh layar kanan
       tak lagi kosong seperti versi satu kolom sebelumnya. -->
  <section id="profil" class="section-hero section-lg bg-linear-[160deg] from-brand-blueTint to-white to-60%">
    <Container>
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 mb-8">
        <nav class="text-sm font-semibold text-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-blue">Beranda</a>
          <span class="text-gray-300 mx-1.5">/</span>
          <a href="/organisasi/" class="hover:text-brand-blue">Organisasi</a>
          <span class="text-gray-300 mx-1.5">/</span>
          <span class="text-ink">{org.label}</span>
        </nav>
        <Share url={shareUrl} title={org.label} text={org.summary} compact class="flex-none" />
      </div>

      {/* Kolom kanan cuma ada kalau organisasinya sudah berjejak; tanpa jejak
          kartunya bakal berisi nol semua, dan hero satu kolom lebih jujur. */}
      <div class:list={['grid gap-8 md:gap-10 items-start', hasJejak && 'md:grid-cols-2']}>
        <div>
          <div class="mb-5">
            {org.logo ? (
              <Image
                src={org.logo}
                alt={org.label}
                widths={[72, 144, 216]}
                sizes="72px"
                class="w-18 h-18 rounded-2xl object-contain bg-white border border-border p-2.5 shadow-cardSoft"
              />
            ) : (
              <span class="w-18 h-18 rounded-2xl grid place-items-center bg-white border border-border text-brand-blue font-bold text-heading-sm shadow-cardSoft">
                {org.label.slice(0, 2).toUpperCase()}
              </span>
            )}
          </div>

          <h1 class="section-title font-semibold mb-2">{org.label}</h1>

          {/* "Berbagi sejak" dulu berupa pil biru berikon panah-melingkar di
              samping logo. Tiga hal salah sekaligus: ikonnya berarti "berulang"
              bukan "sejak", warna biru tebalnya berebut perhatian dengan judul
              tepat di bawahnya, dan latar putih separuh tembus di atas gradien
              biru muda terbaca keruh. Sekarang ia baris meta biasa di bawah
              judul, perlakuan yang sama persis dengan kartunya di /organisasi/
              supaya kartu dan halaman terbaca sebagai satu benda. */}
          {since && (
            <p class="text-body-sm font-semibold text-muted mb-5">Berbagi sejak {since}</p>
          )}

          <p class="text-body-sm text-muted leading-relaxed mb-6">{org.detail.description}</p>

          {/* Tautan luar. Bentuknya BUKAN pil putih bergaris seperti sebelumnya.

              Garis tepi `border-border` (#EEF0F3) di atas isian putih, di atas
              gradien biru muda hero, praktis tak terlihat: yang terbaca cuma
              garis samar melayang, bukan sebuah objek. Menambah jarak dan
              memperbesar ikonnya tak menyelesaikan itu, karena masalahnya bukan
              tata letak isi melainkan wadahnya yang tak punya wujud.

              Sekarang memakai perlakuan sosial yang memang sudah dipakai situs
              ini di footer: bidang terisi `bg-black/5` tanpa garis tepi. Ia
              punya wujud di latar terang mana pun, dan tak menambah kosakata
              baru. Tingginya dikunci `h-9` supaya kedua chip rata walau isinya
              beda panjang, dan `leading-none` pada label membuang jarak baris
              bawaan yang menggesernya turun sepersekian piksel dari tengah. */}
          {(org.detail.instagram || org.detail.website) && (
            <div class="flex flex-wrap gap-2.5">
              {org.detail.instagram && (
                <a
                  href={`https://www.instagram.com/${org.detail.instagram.replace(/^@/, '')}/`}
                  target="_blank"
                  rel="noopener"
                  data-track="outbound_social"
                  data-track-network="instagram"
                  data-track-organisasi={org.label}
                  class="inline-flex items-center gap-2 h-9 rounded-full bg-black/5 px-4 text-body-sm font-semibold text-ink transition-colors hover:bg-black/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue focus-visible:ring-offset-2"
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"></circle></svg>
                  <span class="leading-none"><span class="at">@</span>{org.detail.instagram.replace(/^@/, '')}</span>
                </a>
              )}
              {org.detail.website && (
                <a
                  href={org.detail.website}
                  target="_blank"
                  rel="noopener"
                  data-track="outbound_social"
                  data-track-network="website"
                  data-track-organisasi={org.label}
                  class="inline-flex items-center gap-2 h-9 rounded-full bg-black/5 px-4 text-body-sm font-semibold text-ink transition-colors hover:bg-black/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue focus-visible:ring-offset-2"
                >
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><circle cx="12" cy="12" r="9"></circle><path d="M3.5 9h17M3.5 15h17"></path><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"></path></svg>
                  <span class="leading-none">Website</span>
                </a>
              )}
            </div>
          )}
        </div>

        {hasJejak && latestJejak && (
          <a
            href={latestJejak.href}
            data-track="jejak_click"
            data-track-jejak={latestJejak.slug}
            data-track-source="organisasi_hero"
            class="group block rounded-card bg-white shadow-cardSoft overflow-hidden transition-shadow hover:shadow-card"
          >
            {heroPhoto && (
              /* Kolom kanan = separuh grid 2 kolom di Container tier `standard`
                 (isi 944px di layar lebar) dikurangi gap 40px, sekitar 452px di
                 lg+; di antara md dan lg kontainer masih ikut lebar layar.
                 Lebar terbesar dipilih dua kali lebar render untuk layar 2x DPR. */
              <Image
                src={heroPhoto.img}
                alt={heroPhoto.alt}
                widths={[320, 452, 640, 904]}
                sizes="(min-width: 1024px) 452px, (min-width: 768px) 45vw, 100vw"
                loading="eager"
                class="w-full aspect-[16/10] object-cover"
              />
            )}
            {/* Kartu ini SENGAJA tak memuat satu pun angka metrik: band biru di
                bawahnya adalah pemilik tunggal angka. Saat organisasi baru punya
                satu kegiatan, penjumlahan di band itu menghasilkan angka yang
                identik dengan angka kegiatan itu sendiri, jadi menaruhnya di
                sini juga membuat "40 porsi" muncul tiga kali dalam satu layar.

                Judul kegiatannya ikut ditulis karena saat cuma ada satu jejak,
                seksi "Rekam Jejak" di bawah tidak dirender sama sekali (lihat
                alasannya di sana) dan kartu inilah satu-satunya jalan ke
                halaman dokumentasinya. */}
            <div class="p-6 md:p-7">
              <p class="label text-muted">Kegiatan terakhir</p>
              <div class="text-title font-semibold text-ink leading-snug mt-2 transition-colors group-hover:text-brand-blue">
                {singleJejak ? latestJejak.title : lastJejakDateLabel}
              </div>
              <div class="flex items-start gap-2 text-body-sm text-muted mt-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none mt-0.5 text-brand-blue"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                <span>
                  {lastJejakDateLabel}
                  {latestJejak.location && <Fragment> &middot; {latestJejak.location}</Fragment>}
                </span>
              </div>
              <span class="inline-flex items-center gap-1.5 font-bold text-body-sm text-brand-blue mt-4">
                Lihat dokumentasi lengkap
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
              </span>
            </div>
          </a>
        )}
      </div>
    </Container>
  </section>

  <!-- DASHBOARD DAMPAK: band biru penuh, angka kuning besar. Nadanya sengaja
       sama dengan ImpactSection di beranda supaya "angka yang sudah tercatat"
       selalu muncul di bidang yang sama di seluruh situs. Grafik riaknya TIDAK
       ikut ke sini: itu milik beranda. -->
  {hasJejak && (
    <section id="dampak" class="od section section-lg bg-brand-blue text-white scroll-mt-24">
      <div aria-hidden="true" class="od-glow od-glow-top"></div>
      <div aria-hidden="true" class="od-glow od-glow-bottom"></div>

      <Container class="relative">
        <div class="eyebrow text-brand-yellow">Dashboard Dampak</div>
        <h2 class="od-h2">Kontribusi {org.label}</h2>
        {/* Kalimat pengantar cukup menerangkan ASAL angkanya, tanpa mengulang
            jumlah kegiatan: hitungan itu sudah dibawa chip program di bawah,
            dan sebelumnya sempat muncul tiga kali dalam satu layar. */}
        <p class="od-lead">
          Dihitung dari catatan tiap penyaluran yang dijalankan bersama {org.label}, bukan dari pembukuan terpisah.
        </p>

        {impact.metrics.length > 0 && (
          <div class="od-stats">
            {impact.metrics.map((m) => (
              <div>
                <div class="od-value">{formatMetric(m)}</div>
                <div class="od-label">{m.label}</div>
                <p class="od-note">{noteFor(m.label)}.</p>
              </div>
            ))}
          </div>
        )}

        {programBreakdown.length > 0 && (
          <div class="od-foot">
            <p class="label od-foot-title">Program yang dijalani</p>
            <div class="od-chips">
              {programBreakdown.map((p) =>
                p.href ? (
                  <a
                    href={p.href}
                    data-track="program_click"
                    data-track-program={p.label}
                    data-track-source="organisasi_detail"
                    class="od-chip"
                  >
                    {p.label}
                    {/* Hitungan cuma ditulis kalau memang lebih dari satu:
                        "1 kegiatan" di sebelah satu-satunya program tak
                        menambah apa pun selain angka yang sudah ada di tempat
                        lain. */}
                    {p.count > 1 && <span class="od-chip-n">{p.count} kegiatan</span>}
                  </a>
                ) : (
                  <span class="od-chip">
                    {p.label}
                    {p.count > 1 && <span class="od-chip-n">{p.count} kegiatan</span>}
                  </span>
                )
              )}
            </div>
          </div>
        )}
      </Container>
    </section>
  )}

  {/* REKAM JEJAK: kartu foto yang sama dengan feed /jejak, bukan kartu strip
      bespoke tanpa foto. Bentuk daftarnya ikut jumlah jejak (lihat feedMode).

      TIDAK DIRENDER saat cuma ada satu kegiatan. Daftar berisi satu kartu itu
      memajang ulang foto, tanggal, lokasi, dan judul yang sama persis dengan
      kartu di hero, hanya beberapa ratus piksel di bawahnya — halaman jadi
      terasa mengulang-ulang padahal isinya memang cuma satu kegiatan. Kartu
      hero sudah menautkan ke dokumentasinya, jadi tak ada jalan yang hilang.
      Seksi ini muncul sendiri begitu kegiatan kedua tercatat, dan sejak titik
      itu daftarnya memang membawa isi baru. */}
  {jejak.length > 1 ? (
    <section id="rekam-jejak" class="section section-lg bg-white scroll-mt-24">
      <Container>
        <div class="eyebrow">Rekam Jejak</div>
        <h2 class="section-title font-semibold mb-8">Jejak {org.label}</h2>

        <div class:list={['grid gap-5', feedMode === 'pair' ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
          {jejak.map((j) => (
            <JejakCard
              jejak={j}
              pintu={pintuOf(j.program)}
              variant={feedMode === 'pair' ? 'stack' : 'compact'}
            />
          ))}
        </div>
      </Container>
    </section>
  ) : !hasJejak ? (
    <section id="rekam-jejak" class="section section-lg bg-white scroll-mt-24">
      <Container>
        <div class="eyebrow">Rekam Jejak</div>
        <h2 class="section-title font-semibold mb-8">Jejak {org.label}</h2>

        <p class="rounded-card border border-border bg-white p-8 text-center text-muted">
          Belum ada jejak tercatat untuk organisasi ini.
        </p>
      </Container>
    </section>
  ) : null}

  {/* CTA: ajak organisasi lain bergabung. Bentuknya sama persis dengan CTA di
      /organisasi/, dan alasan gradien oranye dibuang ditulis lengkap di sana.

      Krem, sewarna dengan footer, sama seperti CTA di direktori. Konsekuensinya
      seksi Rekam Jejak di atasnya dipindah ke putih: dua bidang krem berurutan
      menghapus batasnya, dan seksi Rekam Jejak memang tidak selalu ada (ia
      hilang saat kegiatannya baru satu), jadi yang harus selalu benar adalah
      pasangan CTA dengan apa pun yang kebetulan berdiri sebelum ia. */}
  <section id="bergabung" class="section section-lg bg-surface-warm scroll-mt-24">
    <Container>
      <div class="text-center max-w-text mx-auto">
        <div class="eyebrow">Bergabung</div>
        <h2 class="section-title font-semibold mb-4">
          Organisasimu juga bisa punya <span class="text-brand-orange">halaman seperti ini</span>.
        </h2>
        <p class="section-lead text-muted mb-8">
          Komunitas atau perusahaan yang berkontribusi berkelanjutan dicatat di sini, lengkap dengan dashboard dampak dan rekam jejaknya sendiri.
        </p>
        <a
          href={joinWa}
          target="_blank"
          rel="noopener"
          data-track="organisasi_join_click"
          data-track-source="organisasi_detail"
          data-track-organisasi={org.label}
