---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Icon from '../../components/Icon.astro';
import Share from '../../components/Share.astro';
import { getOrganisasiPages } from '../../lib/organisasi';
import { getJejakByOrganisasi } from '../../lib/jejak';
import { getOrganisasiImpact } from '../../lib/impact';
import { getPrograms } from '../../lib/programs';
import { buildWaLink, formatMetric } from '../../lib/format';

// Satu route untuk tiap organisasi ber-halaman, di bawah /organisasi/[slug]/.
// Begitu editor mengaktifkan organisasi di Keystatic & mengisi Detail,
// halamannya ikut ter-generate tanpa membuat file .astro baru — pola sama
// dengan program/[program].astro.
export async function getStaticPaths() {
  const organisasi = await getOrganisasiPages();
  return organisasi.map((org) => ({
    params: { slug: org.slug },
    props: { org },
  }));
}

const { org } = Astro.props;
const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Rekam jejak lintas program (design.md keputusan #1) + agregat dampaknya.
const [jejak, impact, programs] = await Promise.all([
  getJejakByOrganisasi(org.slug),
  getOrganisasiImpact(org.slug),
  getPrograms(),
]);
const labelBySlug = new Map(programs.map((p) => [p.slug, p.label]));
const mainMetric = impact.metrics[0];
const jejakDateFmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const joinWa = buildWaLink(
  site.data.waNumber,
  'Halo, organisasi/komunitas kami ingin berkontribusi rutin dan didaftarkan sebagai organisasi mitra bagiberbagi.id.'
);

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  title={`${org.label} | bagiberbagi.id`}
  description={org.summary}
  breadcrumbName={org.label}
>
  <!-- PROFIL -->
  <section class="section-hero bg-linear-[160deg] from-brand-blueTint to-white to-60%">
    <Container>
      <nav class="text-sm font-semibold text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-blue">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <a href="/organisasi/" class="hover:text-brand-blue">Organisasi</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-ink">{org.label}</span>
      </nav>

      <div class="flex flex-wrap items-start gap-5 mb-6">
        {org.logo ? (
          <img
            src={org.logo}
            alt={org.label}
            width="72"
            height="72"
            class="w-18 h-18 rounded-2xl object-contain bg-white border border-border p-2.5 shadow-cardSoft flex-none"
          />
        ) : (
          <span class="w-18 h-18 rounded-2xl grid place-items-center bg-white border border-border text-brand-blue font-bold text-heading-sm shadow-cardSoft flex-none">
            {org.label.slice(0, 2).toUpperCase()}
          </span>
        )}
        <div class="min-w-0">
          {org.detail.since && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/70 border border-brand-blue/30 text-brand-blue font-bold text-eyebrow tracking-wide px-3 py-1 mb-2">
              <Icon name="repeat" size={13} />
              Berkontribusi sejak {org.detail.since}
            </span>
          )}
          <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
            <h1 class="text-heading md:text-display font-semibold">{org.label}</h1>
            <Share url={shareUrl} title={org.label} text={org.summary} compact class="flex-none mt-1.5" />
          </div>
        </div>
      </div>

      <p class="text-body-sm text-muted leading-relaxed max-w-text mb-5">{org.detail.description}</p>

      {(org.detail.instagram || org.detail.website) && (
        <div class="flex flex-wrap gap-3">
          {org.detail.instagram && (
            <a
              href={`https://www.instagram.com/${org.detail.instagram.replace(/^@/, '')}/`}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-2 text-body-sm font-semibold text-ink hover:border-gray-300 transition-colors"
            >
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"></circle></svg>
              @{org.detail.instagram.replace(/^@/, '')}
            </a>
          )}
          {org.detail.website && (
            <a
              href={org.detail.website}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-2 text-body-sm font-semibold text-ink hover:border-gray-300 transition-colors"
            >
              Website
            </a>
          )}
        </div>
      )}
    </Container>
  </section>

  <!-- DASHBOARD DAMPAK -->
  <section class="section bg-white">
    <Container>
      <div class="eyebrow">Dashboard Dampak</div>
      <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-4">Kontribusi {org.label}</h2>
      <p class="text-body-sm text-muted leading-relaxed mb-8 max-w-text">
        Sudah berkontribusi lewat <strong class="text-ink">{jejak.length} kegiatan</strong>{impact.programCount > 0 && (
          <Fragment>, di <strong class="text-ink">{impact.programCount} program</strong> berbeda</Fragment>
        )}{mainMetric && (
          <Fragment>, dengan total <strong class="text-ink">{formatMetric(mainMetric)} {mainMetric.label}</strong></Fragment>
        )}.
      </p>

      {impact.metrics.length > 0 && (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          {impact.metrics.map((m) => (
            <div class="rounded-card bg-brand-blueTint p-5">
              <div class="text-heading-sm font-semibold tabular-nums text-brand-blue">{formatMetric(m)}</div>
              <div class="text-body-sm text-brand-blue/70 mt-0.5">{m.label}</div>
            </div>
          ))}
        </div>
      )}
    </Container>
  </section>

  <!-- REKAM JEJAK -->
  <section class="section bg-gray-50">
    <Container>
      <div class="eyebrow">Rekam Jejak</div>
      <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-6">Jejak {org.label}</h2>

      {jejak.length > 0 ? (
        <div class="flex flex-col gap-3">
          {jejak.map((j) => (
            <a href={j.href} class="group relative flex overflow-hidden rounded-card bg-white border border-border transition hover:shadow-card hover:-translate-y-0.5">
              <span class="absolute inset-y-0 left-0 w-1.5 bg-brand-blue" aria-hidden="true"></span>
              <div class="flex-1 pl-6 pr-5 py-5 md:pl-7 md:pr-6 md:py-6">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-micro font-bold uppercase tracking-wide text-muted mb-1.5">
                  <span>{jejakDateFmt.format(new Date(j.date))}</span>
                  <span aria-hidden="true" class="text-gray-300">&middot;</span>
                  <span class="text-brand-blue">{labelBySlug.get(j.program) ?? j.program}</span>
                </div>
                <h3 class="text-title-sm font-semibold mb-1.5 transition-colors group-hover:text-brand-blue">{j.title}</h3>
                <p class="text-body-sm text-muted leading-snug mb-3">{j.summary}</p>
                {j.metrics.length > 0 && (
                  <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-body-sm">
                    {j.metrics.map((m) => (
                      <span class="inline-flex items-baseline gap-1.5">
                        <strong class="font-bold tabular-nums text-ink">{formatMetric(m)}</strong>
                        <span class="text-muted">{m.label}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="rounded-card border border-border bg-white p-8 text-center text-muted">
          Belum ada jejak tercatat untuk organisasi ini.
        </p>
      )}
    </Container>
  </section>

  <!-- CTA: ajak organisasi lain bergabung -->
  <section class="section bg-white">
    <Container>
      <div class="rounded-card p-7 md:p-10 text-white text-center bg-gradient-to-br from-brand-orange to-brand-orangeDark">
        <h2 class="text-heading-sm md:text-heading font-semibold mb-2.5">Organisasimu juga ingin punya dashboard seperti ini?</h2>
        <p class="text-body-sm md:text-body text-white/90 leading-relaxed max-w-text mx-auto mb-6">
          Komunitas atau perusahaan yang berkontribusi berkelanjutan bisa didaftarkan sebagai organisasi mitra.
        </p>
        <a
          href={joinWa}
          target="_blank"
          rel="noopener"
          data-track="organisasi_join_click"
          data-track-source="organisasi_detail"
          data-track-organisasi={org.label}
          class="btn-secondary text-brand-orangeDark"
        >
          Diskusikan lewat WhatsApp
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
