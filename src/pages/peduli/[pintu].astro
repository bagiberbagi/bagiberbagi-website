---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PintuS1 from '../../components/_variants/PintuS1.astro';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../../lib/format';
import { getProgramsByPintu } from '../../lib/programs';
import { getPintuImpact } from '../../lib/impact';
import { getAksiByPintu, resolvePintuHref } from '../../lib/aksi';
import { PINTU, CATEGORY_CONTENT } from '../../consts';

// Landing pintu (/peduli/[pintu]). Pintu = peruntukan: halaman ini memikul
// KONSEP/cerita channel + SEO + daftar program + status roadmap. Cara kerja TIDAK
// di sini (itu milik program, karena bisa beda antar program sepintu). Angka
// dampak cuma teaser yang melempar ke showcase /jejak.
//
// Sekarang ADA hub-nya di /peduli/ (index.astro sebelah). Dulu sengaja tidak
// ada, dengan alasan pintu cuma kategori/filter dan bukan entitas pemilik
// halaman — itu benar selama pintu berdampingan dengan program sebagai
// penyaring. Begitu pintu memikul navigasi utama, premisnya gugur, dan hub-nya
// sekaligus membuat remah roti halaman ini bisa diturunkan dari URL.
export async function getStaticPaths() {
  return PINTU.map((pintu) => ({ params: { pintu: pintu.slug }, props: { pintu } }));
}

const { pintu } = Astro.props;
const content = CATEGORY_CONTENT[pintu.id];
const programs = await getProgramsByPintu(pintu.id);
const active = programs.filter((p) => p.active);
const upcoming = programs.filter((p) => !p.active);
const otherPintu = PINTU.filter((p) => p.id !== pintu.id);

const impact = await getPintuImpact(pintu.id);
const hasImpact = impact.jejakCount > 0 && impact.metrics.length > 0;

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');
const contactWa = buildWaLink(site.data.waNumber, `Halo, saya ingin berkontribusi di pintu ${pintu.label}.`);
const notifyWa = buildWaLink(site.data.waNumber, `Halo, beri tahu saya saat program ${pintu.label} dibuka.`);

const jejakHref = `/jejak/?peduli=${pintu.slug}`;

// Daftar "cara ikut" pintu ini, plus tujuan tombolnya. Tautan dirakit DI SINI,
// bukan di dalam PintuS1: komponen itu sudah menerima `contactWa` dan
// `notifyWa` dalam keadaan jadi, dan menjaganya bebas dari perakitan tautan
// berarti ia tak perlu tahu nomor WhatsApp sama sekali.
//
// `href` null berarti aksinya tidak punya tombol, dan itu keadaan yang sah,
// bukan kegagalan: mekanisme "none" adalah tempat parkir aksi yang pesannya
// belum ditulis. Lima belas dari delapan belas aksi ada di keadaan itu hari
// ini, jadi daftarnya masih persis seperti sebelum perubahan ini.
const AKSI_CTA_LABEL = {
  conversation: 'Hubungi lewat WhatsApp',
  quantity: 'Hitung donasi',
} as const;

const aksiItems = (await getAksiByPintu(pintu.id))
  .filter((a) => a.showOnPintu)
  .map((a) => {
    const href = resolvePintuHref(a, site.data.waNumber);
    const label = a.mechanism.kind === 'none' ? null : AKSI_CTA_LABEL[a.mechanism.kind];
    return {
      title: a.title,
      desc: a.desc,
      cta: href && label ? { href, label, external: a.mechanism.kind === 'conversation' } : null,
    };
  });
---

<BaseLayout title={`Pintu ${pintu.label} | bagiberbagi.id`} description={pintu.seoDescription} breadcrumbName={pintu.label}>
  <PintuS1
    pintu={pintu}
    content={content}
    aksiItems={aksiItems}
    programs={programs}
    active={active}
    upcoming={upcoming}
    otherPintu={otherPintu}
    impact={impact}
    hasImpact={hasImpact}
    contactWa={contactWa}
    notifyWa={notifyWa}
    jejakHref={jejakHref}
  />
</BaseLayout>
