---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const privacy = await getEntry('legal', 'privacy');
if (!privacy) throw new Error('legal/privacy entry not found');
const { Content, headings } = await render(privacy);
---

<LegalLayout title={privacy.data.title} eyebrow={privacy.data.eyebrow} intro={privacy.data.intro} closing={privacy.data.closing} updatedAt={privacy.data.updatedAt} headings={headings}>
  <Content />
</LegalLayout>
