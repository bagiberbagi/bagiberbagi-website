---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Icon from '../../components/Icon.astro';
import Share from '../../components/Share.astro';
import Ajakan from '../../components/Ajakan.astro';
import Ketentuan from '../../components/Ketentuan.astro';
import ProgramCover from '../../components/ProgramCover.astro';
import { buildWaLink, formatMetric } from '../../lib/format';
import { getProgramPages, getProgramsByPintu } from '../../lib/programs';
import { getAjakan } from '../../lib/ajakan';
import { getKetentuan } from '../../lib/ketentuan';
import { getJejakByProgram } from '../../lib/jejak';
import { getProgramImpact } from '../../lib/impact';
import { findPageSeo, ogKeyFromPath } from '../../lib/seo';
import { PINTU, CATEGORY_CONTENT, pintuPath } from '../../consts';

// Satu route untuk semua program aktif ber-halaman, di bawah /program/[slug]/.
// Begitu editor mengaktifkan program di Keystatic & mengisi Detail, halamannya
// ikut ter-generate tanpa membuat file .astro baru.
export async function getStaticPaths() {
  const programs = await getProgramPages();
  return programs.map((program) => ({
    params: { program: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Halaman ini dulu tak pernah mengirim title/description sendiri ke
// BaseLayout, jadi program tanpa entri kurasi di `seo.pages[]` (semua kecuali
// Jumat Berkah) diam-diam jatuh ke title/description default situs — baru
// kelihatan sekarang program aktif bertambah dari satu jadi empat. Dicek dulu
// di sini: kalau entri kurasi ADA (mis. Jumat Berkah), biarkan menang seperti
// semula (props di bawah dikosongkan, BaseLayout jatuh ke `page` bukan default
// situs); kalau TIDAK ada, kirim title/description turunan program supaya
// tetap unik per halaman.
const seoEntry = await getEntry('seo', 'seo');
const hasCuratedSeo = seoEntry ? Boolean(findPageSeo(seoEntry.data, Astro.url.pathname)) : false;

// Identitas pintu induk: warna aksen (CSS var --cat) + tautan hub pintu, supaya
// halaman jelas "dari pintu apa". Fallback ke pintu pertama bila tak ketemu.
const pintu = PINTU.find((p) => p.id === program.pintuUtama) ?? PINTU[0];
const styleVars = `--cat:${pintu.color};--cat-tint:${pintu.colorTint};--cat-deep:${pintu.colorDeep}`;
const pintuHref = pintuPath(pintu.slug);
const jejakHref = `/jejak/?peduli=${pintu.slug}`;

// Cabang CTA: self-serve (harga tetap) vs inquiry (paket custom/negosiasi),
// berbasis slug program, bukan field schema — baru 2 program inquiry di rilis
// ini (design.md keputusan #4; field eksplisit menyusul kalau jumlahnya
// bertambah, lihat Open Questions).
const ajakan = await getAjakan(program.slug);

// Kemitraan menempel ke program (mis. dapur mitra Jumat Berkah), jadi CTA mitra
// hidup di halaman program. Sekunder: satu tautan halus, tak menyaingi Donasi.
const mitraWa = buildWaLink(site.data.waNumber, `Halo, saya ingin menjadi mitra untuk program ${program.label}.`);

// Langkah "cara kerja" spesifik pintu (mis. Makanan: Order, Kurasi, Penyaluran,
// Laporan). Kosong untuk pintu yang belum diisi, blok-nya lalu disembunyikan.
const steps = CATEGORY_CONTENT[program.pintuUtama]?.howItWorks ?? [];

// Ketentuan program: butir khas program ini digabung dengan butir yang berlaku
// untuk semua program. Kosong dua-duanya = seksinya tak dirender, dan tautan di
// panel donasi ikut hilang supaya tak menunjuk id yang tak ada.
const ketentuan = await getKetentuan(program.detail.ketentuan);

// Program lain di pintu yang sama, untuk memperlihatkan keterkaitan. Ditampilkan
// maksimal 3 (yang aktif/ber-halaman didahulukan); selebihnya lewat tautan
// "lihat semua" ke halaman pintu yang mendaftar seluruh programnya.
const siblings = (await getProgramsByPintu(program.pintuUtama)).filter((p) => p.slug !== program.slug);
const siblingsShown = [...siblings].sort((a, b) => Number(!!b.href) - Number(!!a.href)).slice(0, 3);

// Rekam jejak pelaksanaan program ini (terbaru dulu) + agregat dampaknya.
const jejak = await getJejakByProgram(program.slug);
const impact = await getProgramImpact(program.slug);
const mainMetric = impact.metrics[0];
const jejakDateFmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// URL kanonik penuh untuk tombol bagikan.
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  title={hasCuratedSeo ? undefined : `${program.label} | bagiberbagi.id`}
  description={hasCuratedSeo ? undefined : program.summary}
  image={hasCuratedSeo ? undefined : `/open-graph/${ogKeyFromPath(Astro.url.pathname)}.png`}
  breadcrumbName={program.label}
  breadcrumbTrail={[{ name: pintu.label, url: pintuHref }]}
>
  <!-- HERO: dua kolom, latar hangat tint pintu, foto ber-glow warna pintu -->
  <section class="section-hero" style={`${styleVars};background:linear-gradient(150deg,var(--cat-tint),#ffffff 58%)`}>
    <Container>
      {/* `inline-block py-3` pada tiap tautan: kotak baris 20px + 24px padding
          = 44px, tanpa satu piksel pun mengubah ukuran atau posisi hurufnya.
          Inline-block-nya bukan hiasan — kalau tautannya tetap inline, padding
          tetap ikut area sentuh tapi TIDAK menambah tinggi baris, jadi di 320px
          (breadcrumb ini membungkus jadi dua baris) dua kotak 44px bertumpuk
          24px dan satu ketukan bisa mendarat di tautan yang salah.
          `mb-6` turun ke `mb-3` supaya jarak yang TERLIHAT antara crumb dan isi
          di bawahnya tetap 24px seperti semula; yang tersisa cuma 12px padding
          atas yang mendorong isi halaman turun. */}
      <nav class="text-sm font-semibold text-muted mb-3" aria-label="Breadcrumb">
        <a href="/" class="inline-block py-3 hover:text-[var(--cat-deep)]">Beranda</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <a href={pintuHref} class="inline-block py-3 hover:text-[var(--cat-deep)]">{pintu.label}</a>
        <span class="text-gray-300 mx-1.5">/</span>
        <span class="text-[var(--cat-deep)]">{program.label}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2 mb-4">
        <a href={pintuHref} class="inline-flex items-center gap-1.5 rounded-full border border-[var(--cat)]/40 bg-white/70 text-[var(--cat-deep)] font-semibold text-eyebrow tracking-wide px-3 py-1 transition-colors hover:bg-white">
          <Icon name={pintu.icon} size={13} />
          {pintu.label}
        </a>
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-white/70 text-ink font-bold text-micro tracking-wide px-3 py-1.5">
          <span class="relative flex w-2 h-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-green-500/70 motion-safe:animate-ping"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-600"></span>
          </span>
          {program.detail.eyebrow}
        </span>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3 mb-8">
        <h1 class="text-heading md:text-display font-semibold">{program.label}</h1>
        <Share url={shareUrl} title={program.label} text={program.summary} compact class="flex-none mt-1.5" />
      </div>

      {/* Pecah dua kolom di `wide` (900px), bukan di `md` (768px). Seluruh situs
          berganti bentuk di 900 sejak ambang itu dinamai di tailwind.config.mjs,
          dan halaman ini satu-satunya yang masih pecah 132px lebih awal. Yang
          didapat kolom di 768 cuma 320px: cover jadi bilah tinggi kurus, dan
          panel donasi dapat kotak selebar ponsel padahal isinya dirancang untuk
          slot yang lebih lebar (chip "6 porsi" jadi dua baris, "Lainnya"
          terpotong). Di bawah 900 halaman ini sekarang satu kolom penuh. */}
      <div class="grid wide:grid-cols-2 gap-10 wide:gap-12 items-stretch">
        <div>
          {/* `body` (16px), bukan `body-sm`. Ini paragraf pembuka halaman, dan
              di halaman ini `body-sm` sempat jadi bawaan sampai tak ada satu pun
              teks 16px tersisa: yang seharusnya jadi pengecualian malah jadi
              aturan. Peran `body-sm` tetap ada, cuma kembali ke label, baris
              meta, satuan angka, dan tulisan pendukung. */}
          <p class="text-body text-muted leading-relaxed mb-6">{program.detail.description}</p>

          {program.detail.features.length > 0 && (
            <div class="flex flex-col gap-2.5 mb-7">
              {program.detail.features.map((feature) => (
                <div class="flex gap-2.5 text-body text-ink/80">
                  <span class="flex-none mt-0.5 grid place-items-center w-5 h-5 rounded-full bg-[var(--cat-tint)] text-[var(--cat-deep)]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                  </span>
                  {feature}
                </div>
              ))}
            </div>
          )}

          <!-- Panel CTA: harga (nilai) dan tombol (aksi) menyatu; hierarki
               dijaga lewat peran, bukan dua kotak bersaing. Percabangan
               self-serve vs custom sudah TIDAK di sini lagi: kartunya sendiri
               yang bercabang di mekanisme aksinya, jadi halaman ini tak perlu
               tahu program mana yang punya harga tetap dan mana yang tidak. -->
          {ajakan && (
            <Ajakan
              id="donasi"
              ajakan={ajakan}
              eyebrow="Hitung donasi"
              note="Sudah termasuk pengantaran dan dokumentasi foto serta video penyaluran."
              trackSource="program_page"
            >
              <Fragment slot="foot">
                {/* Tautan ke seksi ketentuan hanya dirender kalau seksinya ada,
                    jadi ia tak pernah menunjuk id yang tak dirender. Ia duduk
                    di atas baris mitra karena urusannya donasi yang sedang
                    dipertimbangkan, bukan jalur sekunder. */}
                {ketentuan.length > 0 && (
                  <p class="text-sm text-muted">
                    <a href="#ketentuan" class="font-bold text-[var(--cat-deep)] hover:underline underline-offset-2">Baca ketentuan program</a>{' '}
                    sebelum donasi.
                  </p>
                )}
                <p class:list={['text-sm text-muted', ketentuan.length > 0 && 'mt-1.5']}>
                  {/* Spasi ditulis eksplisit. Astro memampatkan baris baru antara
                      teks dan elemen, tidak seperti HTML biasa, jadi tanpa ini
                      kalimatnya terbaca "relawan?Jadi mitra" tanpa jeda. */}
                  Mitra UMKM atau relawan?{' '}
                  <a href={mitraWa} target="_blank" rel="noopener" data-track="partner_click" data-track-program={program.label} class="font-bold text-[var(--cat-deep)] hover:underline underline-offset-2">Jadi mitra {program.label}</a>
                </p>
              </Fragment>
            </Ajakan>
          )}
        </div>

        {/* `wide:order-last`, bukan `md:order-last`, dan ini bukan sekadar ikut
            rapi: begitu gridnya jadi satu kolom sampai 900px, `md:order-last`
            akan melempar cover ke BAWAH kolom teks di rentang 768-899, jadi
            halaman dibuka dengan paragraf dan fotonya baru muncul setelah panel
            donasi. Urutannya harus berganti di ambang yang sama dengan
            kolomnya. */}
        <div class="order-first wide:order-last">
          {/* Kolom foto = separuh grid 2 kolom di Container tier `standard`
              (isi 944px di layar lebar) dikurangi gap 48px, sekitar 448px di
              atas 1024. Antara 900 dan 1024 kontainer masih ikut lebar layar,
              dan di bawah 900 kolomnya selebar kontainer penuh.

              Lewat `ProgramCover`, bukan lewat `getProgramCover` langsung,
              supaya program tanpa cover sendiri tampil dengan ikon pintunya.
              `getProgramCover` memulangkan `program-promo.png` untuk kasus itu,
              dan tiga halaman program (Ramadhan Berbagi, Community Giving, CSR
              Food Program) karena itu sempat memajang foto penyaluran yang
              bukan kegiatan mereka sebagai wajah mereka sendiri. Bentuk dan
              ukurannya tidak berubah sedikit pun. */}
          <ProgramCover program={program} pintu={pintu} variant="hero" alt={program.label} />
        </div>
      </div>
    </Container>
  </section>

  <!-- CARA KERJA: timeline tersambung, nomor bulat selang-seling pintu/biru -->
  {steps.length > 0 && (
    <section id="cara-kerja" class="section bg-white scroll-mt-24" style={styleVars}>
      <Container>
        <div class="text-center max-w-text mx-auto mb-12">
          <div class="eyebrow text-[var(--cat)]">Cara Kerja</div>
          <h2 class="text-heading-sm md:text-heading-lg font-semibold">Dari donasi sampai ke penerima</h2>
        </div>
        <ol class="grid gap-8 md:grid-cols-4 md:gap-3">
          {steps.map((step, i) => (
            <li class="relative md:text-center before:content-[''] before:absolute before:hidden md:before:block before:top-[23px] before:right-1/2 before:w-[calc(100%+0.75rem)] before:h-0.5 before:bg-border first:before:hidden">
              <div class="flex items-center gap-4 md:block">
                <span
                  class="relative z-10 flex-none w-12 h-12 rounded-full flex items-center justify-center text-white text-title-sm font-bold tabular-nums md:mx-auto shadow-cardSm"
                  style={i % 2 === 0 ? 'background:var(--cat)' : 'background:#1D46B9'}
                >{i + 1}</span>
                <div class="md:mt-4">
                  <h3 class="text-title-sm font-semibold mb-1 md:mb-1.5">{step.title}</h3>
                  <p class="text-body text-muted leading-relaxed md:px-1">{step.desc}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </Container>
    </section>
  )}

  <!-- KETENTUAN: operasional, bukan dokumen hukum kedua. Duduk sebelum Rekam
       Jejak: pengunjung sudah tahu programnya apa dan jalannya bagaimana, dan
       keputusan ikut atau tidak diambil di sini, sebelum buktinya dipajang. -->
  <Ketentuan items={ketentuan} pintu={pintu} />

  <!-- REKAM JEJAK -->
  {jejak.length > 0 && (
    <section id="rekam-jejak" class="section bg-gray-50 scroll-mt-24" style={styleVars}>
      <Container>
        <div class="eyebrow text-[var(--cat)]">Rekam Jejak</div>
        <h2 class="text-heading-sm md:text-heading-lg font-semibold mb-4">Jejak {program.label}</h2>
        <p class="text-body text-muted leading-relaxed mb-8 max-w-text">
          Program ini sudah berjalan <strong class="text-ink">{jejak.length} kali</strong>{mainMetric && (
            <Fragment>, dengan total <strong class="text-ink">{formatMetric(mainMetric)} {mainMetric.label}</strong></Fragment>
          )}. Berikut dokumentasi tiap pelaksanaannya beserta angka dampaknya.
        </p>

        {impact.metrics.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-9">
            {impact.metrics.map((m) => (
              <div class="rounded-card bg-[var(--cat-tint)] p-5">
                <div class="text-heading-sm font-semibold tabular-nums text-[var(--cat-deep)]">{formatMetric(m)}</div>
                <div class="text-body-sm text-[var(--cat-deep)]/70 mt-0.5">{m.label}</div>
              </div>
            ))}
          </div>
        )}

        <div class="flex flex-col gap-3">
          {jejak.map((j) => (
            <a href={j.href} class="group relative flex overflow-hidden rounded-card bg-white border border-border transition hover:shadow-card hover:-translate-y-0.5">
              <span class="absolute inset-y-0 left-0 w-1.5 bg-[var(--cat)]" aria-hidden="true"></span>
              <div class="flex-1 pl-6 pr-5 py-5 md:pl-7 md:pr-6 md:py-6">
                <div class="text-micro font-bold uppercase tracking-wide text-muted mb-1.5">{jejakDateFmt.format(new Date(j.date))}</div>
                <h3 class="text-title-sm font-semibold mb-1.5 transition-colors group-hover:text-[var(--cat-deep)]">{j.title}</h3>
                <p class="text-body text-muted leading-snug mb-3">{j.summary}</p>
                {j.metrics.length > 0 && (
                  <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-body-sm">
                    {j.metrics.map((m) => (
                      <span class="inline-flex items-baseline gap-1.5">
                        <strong class="font-bold tabular-nums text-ink">{formatMetric(m)}</strong>
                        <span class="text-muted">{m.label}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8">
          <a href={jejakHref} class="inline-flex items-center gap-2 rounded-full border border-[var(--cat)] text-[var(--cat-deep)] font-bold text-body-sm px-5 py-2.5 hover:bg-[var(--cat)] hover:text-white transition-colors">
            Lihat semua jejak
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </Container>
    </section>
  )}

  <!-- PROGRAM LAIN SEPINTU -->
  {siblings.length > 0 && (
    <section id="program-lain" class="section bg-white scroll-mt-24" style={styleVars}>
      <Container>
        <div class="text-center max-w-text mx-auto mb-12">
          <div class="eyebrow text-[var(--cat)]">Masih di {pintu.label}</div>
          <h2 class="text-heading-sm md:text-heading-lg font-semibold">Program lain satu pintu</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {siblingsShown.map((p) => {
            const Tag = (p.href ? 'a' : 'div') as any;
            return (
              <Tag href={p.href} class:list={['group flex flex-col rounded-card border border-border bg-white p-6', p.href && 'transition hover:shadow-card hover:-translate-y-0.5']}>
                <span class="w-11 h-11 rounded-xl grid place-items-center bg-[var(--cat-tint)] text-[var(--cat)] mb-4">
                  <Icon name={pintu.icon} size={20} />
                </span>
                <h3 class="text-title-sm font-semibold text-ink mb-1.5">{p.label}</h3>
                <p class="text-body text-muted leading-snug flex-1">{p.summary}</p>
                <span class:list={['mt-4 inline-flex items-center gap-1.5 font-bold text-body-sm', p.href ? 'text-[var(--cat-deep)]' : 'text-muted']}>
                  {p.href ? 'Lihat program' : 'Segera hadir'}
                  {p.href && <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>}
                </span>
              </Tag>
            );
          })}
        </div>

        <div class="mt-8 text-center">
          <a href={pintuHref} class="inline-flex items-center gap-2 rounded-full border border-[var(--cat)] text-[var(--cat-deep)] font-bold text-body-sm px-5 py-2.5 hover:bg-[var(--cat)] hover:text-white transition-colors">
            Lihat semua program {pintu.label}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </Container>
    </section>
  )}
</BaseLayout>
