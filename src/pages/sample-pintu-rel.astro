---
/**
 * Halaman banding tiga sintesis rel halaman pintu (S1, S2, S3).
 *
 * Alat kerja, bukan halaman publik: `noindex` lewat prop BaseLayout yang sudah
 * ada, dan tidak pernah ditautkan dari navigasi mana pun. Ia berdiri sendiri
 * dan tidak menyentuh `sample-pintu.astro` yang memuat V1 sampai V5, maupun
 * `sample-pintu-s2.astro` yang menilai S2 sendirian di empat keadaan data.
 *
 * Dua keadaan dirender sekaligus, dua-duanya server-side:
 * - pintu BERISI, memakai `food` (punya program aktif, jejak, dan foto)
 * - pintu KOSONG, memakai `goods` (belum punya apa-apa)
 * Yang ditukar tombol mode cuma visibilitasnya. Ini disengaja: tiap sintesis
 * harus bisa dinilai dalam keadaan terburuknya, dan menilai itu butuh
 * perbandingan langsung tanpa pindah halaman.
 *
 * Logika penyiapan data disalin apa adanya dari `berbagi-[pintu].astro`, tidak
 * di-refactor jadi modul bersama, supaya halaman contoh ini tidak menyentuh
 * halaman yang sudah jalan.
 *
 * ---------------------------------------------------------------------------
 * KENAPA PEMBUNGKUS DI FILE INI SENGAJA POLOS
 *
 * Dua dari tiga sintesis (S1 dan S3) menaruh relnya di `position: sticky`, dan
 * sticky mati tanpa satu pun pesan error kalau ada leluhur yang punya `overflow`
 * selain `visible`, atau punya `transform`, `filter`, `perspective`, `contain`,
 * atau `backdrop-filter`. Kalau itu terjadi di sini, halaman banding ini tidak
 * ada gunanya: relnya diam di puncak, dan yang dinilai user justru bukan
 * desainnya.
 *
 * Jadi aturannya di file ini:
 *
 * 1. Tiap sintesis dirender sebagai anak langsung dari `.spr-pane`, tanpa
 *    pembungkus tambahan. Pita penanda adalah SAUDARA komponen, bukan
 *    pembungkusnya, jadi latar bergarisnya tidak pernah masuk ke rantai leluhur
 *    rel.
 * 2. `.spr-pane` menyatakan `overflow: visible` secara eksplisit supaya siapa
 *    pun yang nanti menambah gaya di sini melihat bahwa nilai itu memang
 *    dipegang, bukan kebetulan warisan.
 * 3. `.spr-pane` TIDAK menyatakan `display` sama sekali. Ini bukan kelalaian:
 *    pane yang tidak aktif disembunyikan lewat atribut `hidden`, dan
 *    `[hidden] { display: none }` dari stylesheet peramban kalah spesifisitas
 *    melawan selektor class. Menulis `display: block` di sini akan membuat
 *    ketiga pane tampil sekaligus. Aturan `[hidden]` di bawah dipasang sebagai
 *    jaring pengaman kalau suatu saat `display` benar-benar dibutuhkan.
 * 4. Panel kendali dan pita penanda berdiri di luar aliran komponen, jadi
 *    `overflow` atau `transform` di dalamnya aman. Tidak ada satu pun dari
 *    keduanya yang membungkus komponen.
 *
 * Rantai leluhur di atas `.spr-pane` juga bersih: `main` di BaseLayout tidak
 * punya gaya sendiri, dan `overflow-x: hidden` pada `body` diteruskan ke
 * viewport (html-nya `visible`), jadi `body` tidak menjadi scroll container dan
 * sticky tetap mengacu ke viewport. Ini rantai yang sama yang dipakai varian 3
 * di `sample-pintu.astro`, tempat relnya memang lengket.
 * ---------------------------------------------------------------------------
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';
import { getProgramsByPintu } from '../lib/programs';
import { getPintuImpact } from '../lib/impact';
import { PINTU, CATEGORY_CONTENT, type PintuId } from '../consts';

import PintuS1 from '../components/_variants/PintuS1.astro';
import PintuS2 from '../components/_variants/PintuS2.astro';
import PintuS3 from '../components/_variants/PintuS3.astro';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Persis alur frontmatter berbagi-[pintu].astro, dibungkus fungsi supaya bisa
// dipanggil dua kali (satu pintu berisi, satu pintu kosong).
async function buildPintuData(id: PintuId) {
  const pintu = PINTU.find((p) => p.id === id);
  if (!pintu) throw new Error(`pintu ${id} tidak ada di PINTU`);

  const content = CATEGORY_CONTENT[pintu.id];
  const programs = await getProgramsByPintu(pintu.id);
  const active = programs.filter((p) => p.active);
  const upcoming = programs.filter((p) => !p.active);
  const otherPintu = PINTU.filter((p) => p.id !== pintu.id);

  const impact = await getPintuImpact(pintu.id);
  const hasImpact = impact.jejakCount > 0 && impact.metrics.length > 0;

  const contactWa = buildWaLink(
    site!.data.waNumber,
    `Halo, saya ingin berkontribusi di pintu ${pintu.label}.`
  );
  const notifyWa = buildWaLink(
    site!.data.waNumber,
    `Halo, beri tahu saya saat program ${pintu.label} dibuka.`
  );
  const jejakHref = `/jejak/?berbagi=${pintu.slug}`;

  return {
    pintu,
    content,
    programs,
    active,
    upcoming,
    otherPintu,
    impact,
    hasImpact,
    contactWa,
    notifyWa,
    jejakHref,
  };
}

const modes = [
  {
    key: 'food',
    label: 'Pintu berisi (Makanan)',
    note: 'punya program aktif, jejak, dan foto lapangan',
    data: await buildPintuData('food'),
  },
  {
    key: 'goods',
    label: 'Pintu kosong (Barang)',
    note: 'belum punya program berjalan, jejak, maupun foto',
    data: await buildPintuData('goods'),
  },
];

const syntheses = [
  {
    code: 'S1',
    name: 'Rel Garis',
    rel: 'kepala berjalan di kolom kanan, ditandai satu garis tegak warna pintu',
    Component: PintuS1,
  },
  {
    code: 'S2',
    name: 'Rel Tenang',
    rel: 'kolom margin bertint yang ikut menggulir, berujung potret tinggi',
    Component: PintuS2,
  },
  {
    code: 'S3',
    name: 'Rel Menjelma',
    rel: 'hero yang menyusut jadi kolom kiri, dan tidak ada sama sekali di satu kolom',
    Component: PintuS3,
  },
];
---

<BaseLayout
  title="Banding Rel Sticky"
  description="Halaman kerja internal untuk membandingkan tiga sintesis rel pada halaman pintu."
  noindex={true}
  breadcrumbName="Banding Rel Sticky"
>
  <!-- PANEL KENDALI. Sengaja bergaya lain sama sekali dari isi situs (bidang
       ink, huruf mono, sudut tajam) supaya tidak pernah tertukar sebagai
       bagian dari desain yang sedang dinilai. -->
  <div class="spr-panel" id="spr-atas">
    <div class="spr-panel-inner">
      <div class="spr-panel-head">
        <span class="spr-tag">Halaman kerja</span>
        <h1 class="spr-panel-title">Banding rel sticky halaman pintu</h1>
        <p class="spr-panel-sub">
          Tiga sintesis dirender berurutan di bawah, semuanya menjawab pertanyaan yang
          sama: rel itu hidup sebagai apa di halaman yang lapang. Tukar mode untuk
          melihat tiap sintesis saat pintunya masih kosong.
        </p>
      </div>

      <div class="spr-row">
        <span class="spr-row-label">Mode</span>
        <div class="spr-mode" role="group" aria-label="Mode pintu">
          {modes.map((m, i) => (
            <button
              type="button"
              class="spr-mode-btn"
              data-spr-mode={m.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {m.label}
              <span class="spr-mode-note">{m.note}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="spr-row">
        <span class="spr-row-label">Lompat</span>
        <div class="spr-jump">
          {syntheses.map((s) => (
            <button type="button" class="spr-jump-btn" data-spr-jump={s.code}>
              <b>{s.code}</b> {s.name}
            </button>
          ))}
        </div>
      </div>

      <div class="spr-row">
        <span class="spr-row-label">Banding</span>
        <div class="spr-jump">
          <a class="spr-link" href="/sample-pintu/">
            <svg
              class="spr-link-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5" />
              <path d="m12 19-7-7 7-7" />
            </svg>
            Lima varian sebelumnya (V1 sampai V5)
          </a>
        </div>
      </div>
    </div>
  </div>

  {modes.map((m, i) => (
    // Pane polos: tanpa transform, tanpa overflow tersembunyi, tanpa filter.
    // Lihat catatan panjang di kepala file soal kenapa itu wajib.
    <div class="spr-pane" data-spr-pane={m.key} hidden={i !== 0}>
      {syntheses.map(({ code, name, rel, Component }) => (
        <>
          {/* Pita penanda, saudara komponen dan bukan pembungkusnya. */}
          <div class="spr-ribbon" data-spr-anchor={code}>
            <div class="spr-ribbon-inner">
              <span class="spr-ribbon-code">Sintesis {code.slice(1)}</span>
              <span class="spr-ribbon-name">{name}</span>
              <span class="spr-ribbon-rel">{rel}</span>
              <span class="spr-ribbon-mode">{m.label}</span>
              <a class="spr-ribbon-top" href="#spr-atas">ke atas</a>
            </div>
          </div>
          <Component {...m.data} />
        </>
      ))}

      <div class="spr-ribbon spr-ribbon-end">
        <div class="spr-ribbon-inner">
          <span class="spr-ribbon-code">Selesai</span>
          <span class="spr-ribbon-name">Ujung daftar sintesis</span>
          <a class="spr-ribbon-top" href="#spr-atas">ke atas</a>
        </div>
      </div>
    </div>
  ))}
</BaseLayout>

<style>
  /* Semua gaya di file ini diberi awalan spr- dan hidup scoped di halaman ini
     saja, jadi tidak ada satu pun token atau class situs yang tersentuh. */

  /* Pembungkus tiap mode. Nilai overflow ditulis eksplisit supaya niatnya
     terbaca: ini rantai leluhur rel sticky di S1 dan S3, dan overflow selain
     visible di sini mematikan keduanya diam-diam. Tidak ada `display` di sini
     dengan sengaja, karena akan mengalahkan atribut `hidden`. */
  .spr-pane {
    overflow: visible;
  }
  .spr-pane[hidden] {
    display: none;
  }

  .spr-panel {
    background: #0f172a;
    color: #e2e8f0;
    border-bottom: 4px solid #38bdf8;
  }
  .spr-panel-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .spr-panel-inner {
      padding: 2.5rem 2.5rem 2rem;
    }
  }
  .spr-panel-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .spr-tag {
    align-self: flex-start;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
    background: #38bdf8;
    padding: 0.25rem 0.6rem;
  }
  .spr-panel-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: #f8fafc;
  }
  .spr-panel-sub {
    font-size: 14px;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 66ch;
  }
  .spr-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .spr-row-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #64748b;
    padding-top: 0.6rem;
    width: 4.5rem;
    flex: none;
  }
  .spr-mode,
  .spr-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1 1 20rem;
  }
  .spr-mode-btn {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
    font-size: 14px;
    font-weight: 700;
    color: #cbd5e1;
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }
  .spr-mode-btn[aria-pressed='true'] {
    background: #38bdf8;
    border-color: #38bdf8;
    color: #0f172a;
  }
  .spr-mode-note {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.75;
  }
  .spr-jump-btn {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #cbd5e1;
    background: transparent;
    border: 1px dashed #475569;
    padding: 0.5rem 0.8rem;
    cursor: pointer;
  }
  .spr-jump-btn b {
    color: #38bdf8;
  }
  .spr-jump-btn:hover,
  .spr-mode-btn:hover,
  .spr-link:hover {
    border-color: #38bdf8;
  }

  /* Tautan kembali ke halaman banding lima varian. Bentuknya sengaja sama
     dengan tombol lompat supaya panel kendali tetap terbaca satu keluarga. */
  .spr-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #38bdf8;
    border: 1px dashed #475569;
    padding: 0.5rem 0.8rem;
    text-decoration: none;
  }
  .spr-link-icon {
    width: 14px;
    height: 14px;
    flex: none;
  }

  /* Pita penanda antar sintesis. */
  .spr-ribbon {
    background: repeating-linear-gradient(
      135deg,
      #0f172a,
      #0f172a 12px,
      #16233d 12px,
      #16233d 24px
    );
    border-top: 4px solid #38bdf8;
    border-bottom: 4px solid #38bdf8;
  }
  .spr-ribbon-end {
    border-top-color: #475569;
    border-bottom-color: #475569;
  }
  .spr-ribbon-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  @media (min-width: 768px) {
    .spr-ribbon-inner {
      padding: 1.25rem 2.5rem;
    }
  }
  .spr-ribbon-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
    background: #38bdf8;
    padding: 0.25rem 0.6rem;
  }
  .spr-ribbon-name {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
  }
  .spr-ribbon-rel,
  .spr-ribbon-mode {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #94a3b8;
  }
  .spr-ribbon-rel {
    color: #64748b;
  }
  .spr-ribbon-top {
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #38bdf8;
    text-decoration: underline;
  }
</style>

<script>
  // Dua mode dirender penuh dari server; script ini cuma menukar mana yang
  // terlihat, lalu mengarahkan tombol lompat ke pita di dalam mode aktif.
  const panes = document.querySelectorAll<HTMLElement>('[data-spr-pane]');
  const modeBtns = document.querySelectorAll<HTMLButtonElement>('[data-spr-mode]');
  const jumpBtns = document.querySelectorAll<HTMLButtonElement>('[data-spr-jump]');

  let activeMode = modeBtns[0]?.dataset.sprMode ?? '';

  function setMode(mode: string) {
    activeMode = mode;
    panes.forEach((pane) => {
      pane.hidden = pane.dataset.sprPane !== mode;
    });
    modeBtns.forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.sprMode === mode ? 'true' : 'false');
    });
  }

  modeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.sprMode;
      if (mode) setMode(mode);
    });
  });

  jumpBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = document.querySelector<HTMLElement>(
        `[data-spr-pane="${activeMode}"] [data-spr-anchor="${btn.dataset.sprJump}"]`
      );
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
