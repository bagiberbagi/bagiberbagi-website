---
/**
 * Halaman banding untuk sintesis S2 ("Rel Tenang").
 *
 * Alat kerja, bukan halaman publik: `noindex`, tidak pernah ditautkan dari
 * navigasi mana pun. Ia berdiri sendiri dan tidak menyentuh `sample-pintu.astro`
 * yang memuat V1 sampai V5.
 *
 * EMPAT keadaan dirender, bukan dua, dan itu koreksi paling penting dari halaman
 * banding sebelumnya. Di sana pintu "kosong" diwakili `goods`, padahal
 * `src/content/programs/` punya dua entri ber-pintu goods (bantuan-bencana,
 * buku-alat-sekolah). Keduanya `active: false`, jadi goods tetap merender blok
 * Program lengkap dengan kepala dan daftar "Belum dibuka". Yang benar-benar
 * telanjang justru `time` dan `space`: nol entri program, nol jejak, nol
 * CATEGORY_CONTENT, nol foto, dan tidak satu pun dirender di halaman banding
 * mana pun. Keputusan varian jadi diambil atas halaman yang lebih berisi
 * daripada dua halaman yang paling sedikit isinya.
 *
 * Logika penyiapan data disalin apa adanya dari `berbagi-[pintu].astro`,
 * termasuk definisi `hasImpact` yang rapuh itu, supaya varian dinilai persis
 * dengan prop yang akan diterimanya di produksi.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';
import { getProgramsByPintu } from '../lib/programs';
import { getPintuImpact } from '../lib/impact';
import { PINTU, CATEGORY_CONTENT, type PintuId } from '../consts';

import PintuS2 from '../components/_variants/PintuS2.astro';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

async function buildPintuData(id: PintuId) {
  const pintu = PINTU.find((p) => p.id === id);
  if (!pintu) throw new Error(`pintu ${id} tidak ada di PINTU`);

  const content = CATEGORY_CONTENT[pintu.id];
  const programs = await getProgramsByPintu(pintu.id);
  const active = programs.filter((p) => p.active);
  const upcoming = programs.filter((p) => !p.active);
  const otherPintu = PINTU.filter((p) => p.id !== pintu.id);

  const impact = await getPintuImpact(pintu.id);
  const hasImpact = impact.jejakCount > 0 && impact.metrics.length > 0;

  const contactWa = buildWaLink(
    site!.data.waNumber,
    `Halo, saya ingin berkontribusi di pintu ${pintu.label}.`
  );
  const notifyWa = buildWaLink(
    site!.data.waNumber,
    `Halo, beri tahu saya saat program ${pintu.label} dibuka.`
  );
  const jejakHref = `/jejak/?berbagi=${pintu.slug}`;

  return {
    pintu,
    content,
    programs,
    active,
    upcoming,
    otherPintu,
    impact,
    hasImpact,
    contactWa,
    notifyWa,
    jejakHref,
  };
}

const modes = [
  {
    key: 'food',
    label: 'Berisi (Makanan)',
    note: '1 program berjalan, 2 jejak, konsep lengkap, 3 foto',
    data: await buildPintuData('food'),
  },
  {
    key: 'goods',
    label: 'Separuh (Barang)',
    note: '2 program belum dibuka, nol jejak, nol konten, nol foto',
    data: await buildPintuData('goods'),
  },
  {
    key: 'space',
    label: 'Kosong (Ruang)',
    note: 'nol program, nol jejak, nol konten, nol foto',
    data: await buildPintuData('space'),
  },
  {
    key: 'time',
    label: 'Kosong (Waktu)',
    note: 'sama kosongnya dengan Ruang, dipasang berdampingan supaya kembarannya kelihatan',
    data: await buildPintuData('time'),
  },
];
---

<BaseLayout
  title="Banding Visual Pintu S2"
  description="Halaman kerja internal untuk menilai sintesis S2 halaman pintu di empat keadaan data."
  noindex={true}
  breadcrumbName="Banding Visual Pintu S2"
>
  <!-- PANEL KENDALI. Sengaja bergaya lain sama sekali dari isi situs (bidang
       ink, huruf mono, sudut tajam) supaya tidak pernah tertukar sebagai bagian
       dari desain yang sedang dinilai. -->
  <div class="s2p-panel" id="s2p-atas">
    <div class="s2p-panel-inner">
      <div class="s2p-panel-head">
        <span class="s2p-tag">Halaman kerja</span>
        <h1 class="s2p-panel-title">Sintesis S2: Rel Tenang</h1>
        <p class="s2p-panel-sub">
          Satu varian, empat keadaan data. Dua yang terakhir adalah pintu yang benar-benar
          telanjang di repo hari ini, dan itu keadaan terburuk yang harus dinilai lebih dulu
          sebelum halaman Makanan yang penuh foto ikut menilaikan dirinya sendiri.
        </p>
      </div>

      <div class="s2p-row">
        <span class="s2p-row-label">Keadaan</span>
        <div class="s2p-mode" role="group" aria-label="Keadaan pintu">
          {modes.map((m, i) => (
            <button
              type="button"
              class="s2p-mode-btn"
              data-s2p-mode={m.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {m.label}
              <span class="s2p-mode-note">{m.note}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  {modes.map((m, i) => (
    <div data-s2p-pane={m.key} hidden={i !== 0}>
      <div class="s2p-ribbon">
        <div class="s2p-ribbon-inner">
          <span class="s2p-ribbon-code">S2</span>
          <span class="s2p-ribbon-name">Rel Tenang</span>
          <span class="s2p-ribbon-mode">{m.label}: {m.note}</span>
          <a class="s2p-ribbon-top" href="#s2p-atas">ke atas</a>
        </div>
      </div>
      <PintuS2 {...m.data} />
    </div>
  ))}
</BaseLayout>

<style>
  /* Semua gaya di file ini diberi awalan s2p- dan hidup scoped di halaman ini
     saja, jadi tidak ada satu pun token atau class situs yang tersentuh. */
  .s2p-panel {
    background: #0f172a;
    color: #e2e8f0;
    border-bottom: 4px solid #38bdf8;
  }
  .s2p-panel-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .s2p-panel-inner {
      padding: 2.5rem 2.5rem 2rem;
    }
  }
  .s2p-panel-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .s2p-tag {
    align-self: flex-start;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
    background: #38bdf8;
    padding: 0.25rem 0.6rem;
  }
  .s2p-panel-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: #f8fafc;
  }
  .s2p-panel-sub {
    font-size: 14px;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 70ch;
  }
  .s2p-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .s2p-row-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #64748b;
    padding-top: 0.6rem;
    width: 5.5rem;
    flex: none;
  }
  .s2p-mode {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1 1 20rem;
  }
  .s2p-mode-btn {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
    max-width: 22rem;
    font-size: 14px;
    font-weight: 700;
    color: #cbd5e1;
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }
  .s2p-mode-btn[aria-pressed='true'] {
    background: #38bdf8;
    border-color: #38bdf8;
    color: #0f172a;
  }
  .s2p-mode-btn:hover {
    border-color: #38bdf8;
  }
  .s2p-mode-note {
    font-size: 11px;
    font-weight: 500;
    line-height: 1.45;
    opacity: 0.75;
  }

  .s2p-ribbon {
    background: repeating-linear-gradient(
      135deg,
      #0f172a,
      #0f172a 12px,
      #16233d 12px,
      #16233d 24px
    );
    border-top: 4px solid #38bdf8;
    border-bottom: 4px solid #38bdf8;
  }
  .s2p-ribbon-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  @media (min-width: 768px) {
    .s2p-ribbon-inner {
      padding: 1.25rem 2.5rem;
    }
  }
  .s2p-ribbon-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
    background: #38bdf8;
    padding: 0.25rem 0.6rem;
  }
  .s2p-ribbon-name {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
  }
  .s2p-ribbon-mode {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #94a3b8;
  }
  .s2p-ribbon-top {
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #38bdf8;
    text-decoration: underline;
  }
</style>

<script>
  // Empat keadaan dirender penuh dari server; script ini cuma menukar mana yang
  // terlihat, jadi tidak ada satu pun keputusan tampilan yang bergantung padanya.
  const panes = document.querySelectorAll<HTMLElement>('[data-s2p-pane]');
  const modeBtns = document.querySelectorAll<HTMLButtonElement>('[data-s2p-mode]');

  function setMode(mode: string) {
    panes.forEach((pane) => {
      pane.hidden = pane.dataset.s2pPane !== mode;
    });
    modeBtns.forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.s2pMode === mode ? 'true' : 'false');
    });
  }

  modeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.s2pMode;
      if (mode) setMode(mode);
    });
  });
</script>
