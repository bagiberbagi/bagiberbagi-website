---
/**
 * Halaman banding visual lima varian halaman pintu.
 *
 * Ini alat kerja, bukan halaman publik: dipakai supaya user bisa melihat
 * kelima varian berurutan lalu memilih satu. Karena itu ia menandai dirinya
 * `noindex` lewat prop BaseLayout yang sudah ada, dan tidak pernah ditautkan
 * dari navigasi mana pun.
 *
 * Dua keadaan dirender sekaligus, dua-duanya server-side:
 * - pintu BERISI, memakai `food` (punya program aktif, jejak, dan foto)
 * - pintu KOSONG, memakai `goods` (belum punya apa-apa)
 * Yang ditukar tombol mode cuma visibilitasnya. Ini disengaja: tiap varian
 * harus bisa dinilai dalam keadaan terburuknya, dan menilai itu butuh
 * perbandingan langsung tanpa pindah halaman.
 *
 * Logika penyiapan data disalin apa adanya dari `berbagi-[pintu].astro`, tidak
 * di-refactor jadi modul bersama, supaya halaman contoh ini tidak menyentuh
 * halaman yang sudah jalan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { buildWaLink } from '../lib/format';
import { getProgramsByPintu } from '../lib/programs';
import { getPintuImpact } from '../lib/impact';
import { PINTU, CATEGORY_CONTENT, type PintuId } from '../consts';

import PintuV1 from '../components/_variants/PintuV1.astro';
import PintuV2 from '../components/_variants/PintuV2.astro';
import PintuV3 from '../components/_variants/PintuV3.astro';
import PintuV4 from '../components/_variants/PintuV4.astro';
import PintuV5 from '../components/_variants/PintuV5.astro';

const site = await getEntry('settings', 'site');
if (!site) throw new Error('settings/site entry not found');

// Persis alur frontmatter berbagi-[pintu].astro, dibungkus fungsi supaya bisa
// dipanggil dua kali (satu pintu berisi, satu pintu kosong).
async function buildPintuData(id: PintuId) {
  const pintu = PINTU.find((p) => p.id === id);
  if (!pintu) throw new Error(`pintu ${id} tidak ada di PINTU`);

  const content = CATEGORY_CONTENT[pintu.id];
  const programs = await getProgramsByPintu(pintu.id);
  const active = programs.filter((p) => p.active);
  const upcoming = programs.filter((p) => !p.active);
  const otherPintu = PINTU.filter((p) => p.id !== pintu.id);

  const impact = await getPintuImpact(pintu.id);
  const hasImpact = impact.jejakCount > 0 && impact.metrics.length > 0;

  const contactWa = buildWaLink(
    site!.data.waNumber,
    `Halo, saya ingin berkontribusi di pintu ${pintu.label}.`
  );
  const notifyWa = buildWaLink(
    site!.data.waNumber,
    `Halo, beri tahu saya saat program ${pintu.label} dibuka.`
  );
  const jejakHref = `/jejak/?berbagi=${pintu.slug}`;

  return {
    pintu,
    content,
    programs,
    active,
    upcoming,
    otherPintu,
    impact,
    hasImpact,
    contactWa,
    notifyWa,
    jejakHref,
  };
}

const modes = [
  {
    key: 'food',
    label: 'Pintu berisi (Makanan)',
    note: 'punya program aktif, jejak, dan foto lapangan',
    data: await buildPintuData('food'),
  },
  {
    key: 'goods',
    label: 'Pintu kosong (Barang)',
    note: 'belum punya program, jejak, maupun foto',
    data: await buildPintuData('goods'),
  },
];

const variants = [
  { code: 'V1', name: 'Editorial Foto', Component: PintuV1 },
  { code: 'V2', name: 'Kanvas Hangat', Component: PintuV2 },
  { code: 'V3', name: 'Rel Lengket', Component: PintuV3 },
  { code: 'V4', name: 'Bukti Dulu', Component: PintuV4 },
  { code: 'V5', name: 'Tipografi Lapang', Component: PintuV5 },
];
---

<BaseLayout
  title="Banding Visual Pintu"
  description="Halaman kerja internal untuk membandingkan lima varian tampilan halaman pintu."
  noindex={true}
  breadcrumbName="Banding Visual Pintu"
>
  <!-- PANEL KENDALI. Sengaja bergaya lain sama sekali dari isi situs (bidang
       ink, huruf mono, sudut tajam) supaya tidak pernah tertukar sebagai
       bagian dari desain yang sedang dinilai. -->
  <div class="bv-panel" id="bv-atas">
    <div class="bv-panel-inner">
      <div class="bv-panel-head">
        <span class="bv-tag">Halaman kerja</span>
        <h1 class="bv-panel-title">Banding visual halaman pintu</h1>
        <p class="bv-panel-sub">
          Lima varian dirender berurutan di bawah. Tukar mode untuk melihat tiap varian
          saat pintunya masih kosong.
        </p>
      </div>

      <div class="bv-row">
        <span class="bv-row-label">Mode</span>
        <div class="bv-mode" role="group" aria-label="Mode pintu">
          {modes.map((m, i) => (
            <button
              type="button"
              class="bv-mode-btn"
              data-bv-mode={m.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {m.label}
              <span class="bv-mode-note">{m.note}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="bv-row">
        <span class="bv-row-label">Lompat</span>
        <div class="bv-jump">
          {variants.map((v) => (
            <button type="button" class="bv-jump-btn" data-bv-jump={v.code}>
              <b>{v.code}</b> {v.name}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  {modes.map((m, i) => (
    <div data-bv-pane={m.key} hidden={i !== 0}>
      {variants.map(({ code, name, Component }) => (
        <>
          <!-- Pita penanda varian, bukan bagian desain varian. -->
          <div class="bv-ribbon" data-bv-anchor={code}>
            <div class="bv-ribbon-inner">
              <span class="bv-ribbon-code">Varian {code.slice(1)}</span>
              <span class="bv-ribbon-name">{name}</span>
              <span class="bv-ribbon-mode">{m.label}</span>
              <a class="bv-ribbon-top" href="#bv-atas">ke atas</a>
            </div>
          </div>
          <Component {...m.data} />
        </>
      ))}

      <div class="bv-ribbon bv-ribbon-end">
        <div class="bv-ribbon-inner">
          <span class="bv-ribbon-code">Selesai</span>
          <span class="bv-ribbon-name">Ujung daftar varian</span>
          <a class="bv-ribbon-top" href="#bv-atas">ke atas</a>
        </div>
      </div>
    </div>
  ))}
</BaseLayout>

<style>
  /* Semua gaya di file ini diberi awalan bv- dan hidup scoped di halaman ini
     saja, jadi tidak ada satu pun token atau class situs yang tersentuh. */
  .bv-panel {
    background: #0f172a;
    color: #e2e8f0;
    border-bottom: 4px solid #38bdf8;
  }
  .bv-panel-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .bv-panel-inner {
      padding: 2.5rem 2.5rem 2rem;
    }
  }
  .bv-panel-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .bv-tag {
    align-self: flex-start;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
    background: #38bdf8;
    padding: 0.25rem 0.6rem;
  }
  .bv-panel-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: #f8fafc;
  }
  .bv-panel-sub {
    font-size: 14px;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 56ch;
  }
  .bv-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .bv-row-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #64748b;
    padding-top: 0.6rem;
    width: 4.5rem;
    flex: none;
  }
  .bv-mode,
  .bv-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1 1 20rem;
  }
  .bv-mode-btn {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
    font-size: 14px;
    font-weight: 700;
    color: #cbd5e1;
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }
  .bv-mode-btn[aria-pressed='true'] {
    background: #38bdf8;
    border-color: #38bdf8;
    color: #0f172a;
  }
  .bv-mode-note {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.75;
  }
  .bv-jump-btn {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #cbd5e1;
    background: transparent;
    border: 1px dashed #475569;
    padding: 0.5rem 0.8rem;
    cursor: pointer;
  }
  .bv-jump-btn b {
    color: #38bdf8;
  }
  .bv-jump-btn:hover,
  .bv-mode-btn:hover {
    border-color: #38bdf8;
  }

  /* Pita penanda antar varian. */
  .bv-ribbon {
    background: repeating-linear-gradient(
      135deg,
      #0f172a,
      #0f172a 12px,
      #16233d 12px,
      #16233d 24px
    );
    border-top: 4px solid #38bdf8;
    border-bottom: 4px solid #38bdf8;
  }
  .bv-ribbon-end {
    border-top-color: #475569;
    border-bottom-color: #475569;
  }
  .bv-ribbon-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  @media (min-width: 768px) {
    .bv-ribbon-inner {
      padding: 1.25rem 2.5rem;
    }
  }
  .bv-ribbon-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f172a;
    background: #38bdf8;
    padding: 0.25rem 0.6rem;
  }
  .bv-ribbon-name {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
  }
  .bv-ribbon-mode {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #94a3b8;
  }
  .bv-ribbon-top {
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #38bdf8;
    text-decoration: underline;
  }
</style>

<script>
  // Dua mode dirender penuh dari server; script ini cuma menukar mana yang
  // terlihat, lalu mengarahkan tombol lompat ke pita di dalam mode aktif.
  const panes = document.querySelectorAll<HTMLElement>('[data-bv-pane]');
  const modeBtns = document.querySelectorAll<HTMLButtonElement>('[data-bv-mode]');
  const jumpBtns = document.querySelectorAll<HTMLButtonElement>('[data-bv-jump]');

  let activeMode = modeBtns[0]?.dataset.bvMode ?? '';

  function setMode(mode: string) {
    activeMode = mode;
    panes.forEach((pane) => {
      pane.hidden = pane.dataset.bvPane !== mode;
    });
    modeBtns.forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.bvMode === mode ? 'true' : 'false');
    });
  }

  modeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.bvMode;
      if (mode) setMode(mode);
    });
  });

  jumpBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = document.querySelector<HTMLElement>(
        `[data-bv-pane="${activeMode}"] [data-bv-anchor="${btn.dataset.bvJump}"]`
      );
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
