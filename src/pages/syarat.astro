---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const terms = await getEntry('legal', 'terms');
if (!terms) throw new Error('legal/terms entry not found');
const { Content } = await render(terms);
---

<BaseLayout title={`${terms.data.title} — bagiberbagi.id`}>
  <Header />
  <section class="section bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="eyebrow">LEGAL</div>
      <h1 class="text-2xl md:text-heading-md font-extrabold tracking-tight mb-4">{terms.data.title}</h1>
      <div class="prose-legal flex flex-col gap-3 text-body-sm text-muted leading-relaxed">
        <Content />
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .prose-legal :global(p) {
    margin: 0;
  }
</style>
