---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const terms = await getEntry('legal', 'terms');
if (!terms) throw new Error('legal/terms entry not found');
const { Content, headings } = await render(terms);
---

<LegalLayout title={terms.data.title} updatedAt={terms.data.updatedAt} headings={headings}>
  <Content />
</LegalLayout>
