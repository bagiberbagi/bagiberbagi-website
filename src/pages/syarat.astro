---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const terms = await getEntry('legal', 'terms');
if (!terms) throw new Error('legal/terms entry not found');
const { Content, headings } = await render(terms);
---

<LegalLayout title={terms.data.title} eyebrow={terms.data.eyebrow} intro={terms.data.intro} closing={terms.data.closing} updatedAt={terms.data.updatedAt} headings={headings} seo={terms.data.seo}>
  <Content />
</LegalLayout>
