---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import ClosingSection from '../components/ClosingSection.astro';

const about = await getEntry('about', 'about');
if (!about) throw new Error('about/about entry not found');

// SEO halaman ini menempel di entri kontennya sendiri, bukan di daftar terpusat
// — judul hero dipakai kalau blok SEO-nya dikosongkan.
const seo = about.data.seo;
---

<BaseLayout
  title={seo?.title || `${about.data.hero.title} | bagiberbagi.id`}
  description={seo?.description || about.data.hero.paragraphs[0]}
  image={seo?.image || undefined}
  breadcrumbName="Tentang Kami"
>
  <About />
  {/* Penutup yang sama dengan beranda, bukan varian sendiri. Halaman ini dulu
      tutup dengan kartu biru dua tombol (Mitra Dapur dan Relawan), yang isinya
      dua dari empat peran yang ditawarkan seksi ini, jadi ia bagian yang
      diulang, bukan pelengkap. Kartunya dibuang bersama field `cta` di
      Keystatic supaya editor tak mengisi sesuatu yang tak lagi dibaca. */}
  <ClosingSection kick="Setelah kenal kami" source="closing_tentang" />
</BaseLayout>

<script>
  import '../scripts/fade-in.js';
</script>
