---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const transparency = await getEntry('legal', 'transparency');
if (!transparency) throw new Error('legal/transparency entry not found');
const { Content, headings } = await render(transparency);
---

<LegalLayout title={transparency.data.title} eyebrow={transparency.data.eyebrow} intro={transparency.data.intro} closing={transparency.data.closing} updatedAt={transparency.data.updatedAt} headings={headings} seo={transparency.data.seo}>
  <Content />
</LegalLayout>
